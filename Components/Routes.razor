@using MiniFinance.Components.Account.Shared
@using Microsoft.AspNetCore.Components.Authorization
<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized Context="routeAuth">
                    @if (routeAuth.User.Identity?.IsAuthenticated == true)
                    {
                        <RedirectToAccessDenied />
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Страница не найдена — MiniFinance</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <div class="empty-state" style="margin-top:3rem">
                    <h1>Страница не найдена</h1>
                    <p class="text-muted" role="alert">По этому адресу ничего нет.</p>
                    <a href="/" class="btn btn-primary mt-3">На главную</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

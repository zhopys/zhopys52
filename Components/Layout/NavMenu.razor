@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using MiniFinance.Services
@implements IDisposable
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthState

@if (_snapshot.IsAuthenticated)
{
    <nav class="sidebar-nav">
        <div class="nav-section">
            <div class="nav-section-label">Основное</div>
            <ul class="nav-list">
                @if (_snapshot.CanAccessFinances)
                {
                    <li class="nav-item">
                        <NavLink href="/" Match="NavLinkMatch.All">
                            <i class="bi bi-speedometer2 nav-icon" aria-hidden="true"></i>
                            <span>Главная</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink href="/counterparties">
                            <i class="bi bi-people nav-icon" aria-hidden="true"></i>
                            <span>Контрагенты</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink href="/debts">
                            <i class="bi bi-arrow-left-right nav-icon" aria-hidden="true"></i>
                            <span>Долги</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink href="/import">
                            <i class="bi bi-cloud-upload nav-icon" aria-hidden="true"></i>
                            <span>Импорт</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink href="/transactions">
                            <i class="bi bi-receipt nav-icon" aria-hidden="true"></i>
                            <span>Транзакции</span>
                        </NavLink>
                    </li>
                }
                @if (_snapshot.CanManageTaxes && !_snapshot.CanAccessFinances)
                {
                    <li class="nav-item">
                        <NavLink href="/taxes" Match="NavLinkMatch.All">
                            <i class="bi bi-percent nav-icon" aria-hidden="true"></i>
                            <span>Налоги</span>
                        </NavLink>
                    </li>
                }
            </ul>
        </div>

        @if (_snapshot.CanViewReports)
        {
            <div class="nav-section">
                <div class="nav-section-label">Отчёты</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <NavLink href="/reports">
                            <i class="bi bi-file-earmark-bar-graph nav-icon" aria-hidden="true"></i>
                            <span>Отчёты</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink href="/analytics">
                            <i class="bi bi-graph-up-arrow nav-icon" aria-hidden="true"></i>
                            <span>Аналитика</span>
                        </NavLink>
                    </li>
                </ul>
            </div>
        }

        @if (_snapshot.CanAccessFinances)
        {
            <div class="nav-section">
                <div class="nav-section-label">Финансы</div>
                <ul class="nav-list">
                    @if (_snapshot.CanManageTaxes)
                    {
                        <li class="nav-item">
                            <NavLink href="/taxes">
                                <i class="bi bi-wallet2 nav-icon" aria-hidden="true"></i>
                                <span>Налоги и счета</span>
                            </NavLink>
                        </li>
                    }
                    <li class="nav-item">
                        <NavLink href="/payment-calendar">
                            <i class="bi bi-calendar3 nav-icon" aria-hidden="true"></i>
                            <span>Платёжный календарь</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink href="/cash-forecast">
                            <i class="bi bi-cash-stack nav-icon" aria-hidden="true"></i>
                            <span>Прогноз кассы</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink href="/reminders">
                            <i class="bi bi-bell nav-icon" aria-hidden="true"></i>
                            <span>Напоминания</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink href="/categories">
                            <i class="bi bi-tags nav-icon" aria-hidden="true"></i>
                            <span>Категории</span>
                        </NavLink>
                    </li>
                </ul>
            </div>
        }

        <div class="nav-section">
            <div class="nav-section-label">Управление</div>
            <ul class="nav-list">
                @if (_snapshot.CanManageUsers)
                {
                    <li class="nav-item">
                        <NavLink href="/team">
                            <i class="bi bi-person-badge nav-icon" aria-hidden="true"></i>
                            <span>Команда и роли</span>
                        </NavLink>
                    </li>
                }
                @if (_snapshot.CanAccessFinances)
                {
                    <li class="nav-item">
                        <NavLink href="/projects">
                            <i class="bi bi-kanban nav-icon" aria-hidden="true"></i>
                            <span>Проекты</span>
                        </NavLink>
                    </li>
                }
            </ul>
        </div>

        <div class="nav-footer">
            @if (!string.IsNullOrEmpty(_snapshot.PrimaryRole))
            {
                <div class="nav-user-role">
                    <div class="nav-user-role-label">Ваша роль</div>
                    <RoleBadge Role="@_snapshot.PrimaryRole" />
                </div>
            }
            <ul class="nav-list">
                <li class="nav-item">
                    <NavLink href="/profile">
                        <i class="bi bi-person-circle nav-icon" aria-hidden="true"></i>
                        <span>Профиль</span>
                    </NavLink>
                </li>
                @if (_snapshot.CanManageSettings)
                {
                    <li class="nav-item">
                        <NavLink href="/settings">
                            <i class="bi bi-gear nav-icon" aria-hidden="true"></i>
                            <span>Настройки</span>
                        </NavLink>
                    </li>
                }
            </ul>
            <button class="nav-logout" @onclick="Logout">
                <i class="bi bi-box-arrow-right nav-icon" aria-hidden="true"></i>
                <span>Выйти</span>
            </button>
        </div>
    </nav>
}
else
{
    <nav class="sidebar-nav">
        <ul class="nav-list">
            <li class="nav-item">
                <NavLink href="/login">
                    <i class="bi bi-box-arrow-in-right nav-icon" aria-hidden="true"></i>
                    <span>Вход</span>
                </NavLink>
            </li>
        </ul>
    </nav>
}

@code {
    private RoleAccessSnapshot _snapshot;

    protected override async Task OnInitializedAsync()
    {
        AuthState.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await ApplyAuthStateAsync();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> _)
    {
        await ApplyAuthStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyAuthStateAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _snapshot = RoleAccessSnapshot.FromPrincipal(state.User);
    }

    private void Logout() => NavigationManager.NavigateTo("/do-logout", forceLoad: true);

    public void Dispose() => AuthState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
}

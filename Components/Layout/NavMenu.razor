@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using MiniFinance.Services
@implements IDisposable
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthState

@if (_snapshot.IsAuthenticated)
{
    <nav class="sidebar-nav">
        <div class="nav-section">
            <div class="nav-section-label">Основное</div>
            <ul class="nav-list">
                @if (_snapshot.CanAccessFinances)
                {
                    <li class="nav-item">
                        <NavLink href="/" Match="NavLinkMatch.All"><span>Главная</span></NavLink>
                    </li>
                    <li class="nav-item"><NavLink href="/counterparties"><span>Контрагенты</span></NavLink></li>
                    <li class="nav-item"><NavLink href="/debts"><span>Долги</span></NavLink></li>
                    <li class="nav-item"><NavLink href="/import"><span>Импорт</span></NavLink></li>
                    <li class="nav-item"><NavLink href="/transactions"><span>Транзакции</span></NavLink></li>
                }
                @* Налоги — только для налогового специалиста без финансового раздела *@
                @if (_snapshot.CanManageTaxes && !_snapshot.CanAccessFinances)
                {
                    <li class="nav-item">
                        <NavLink href="/taxes" Match="NavLinkMatch.All"><span>Налоги</span></NavLink>
                    </li>
                }
            </ul>
        </div>

        @if (_snapshot.CanViewReports)
        {
            <div class="nav-section">
                <div class="nav-section-label">Отчёты</div>
                <ul class="nav-list">
                    <li class="nav-item"><NavLink href="/reports"><span>Отчёты</span></NavLink></li>
                    <li class="nav-item"><NavLink href="/analytics"><span>Аналитика</span></NavLink></li>
                </ul>
            </div>
        }

        @if (_snapshot.CanAccessFinances)
        {
            <div class="nav-section">
                <div class="nav-section-label">Финансы</div>
                <ul class="nav-list">
                    @if (_snapshot.CanManageTaxes)
                    {
                        <li class="nav-item"><NavLink href="/taxes"><span>Налоги и счета</span></NavLink></li>
                    }
                    <li class="nav-item"><NavLink href="/payment-calendar"><span>Платёжный календарь</span></NavLink></li>
                    <li class="nav-item"><NavLink href="/cash-forecast"><span>Прогноз кассы</span></NavLink></li>
                    <li class="nav-item"><NavLink href="/reminders"><span>Напоминания</span></NavLink></li>
                    <li class="nav-item"><NavLink href="/categories"><span>Категории</span></NavLink></li>
                </ul>
            </div>
        }

        <div class="nav-section">
            <div class="nav-section-label">Управление</div>
            <ul class="nav-list">
                @if (_snapshot.IsAdministrator)
                {
                    <li class="nav-item"><NavLink href="/team"><span>Команда</span></NavLink></li>
                }
                @if (_snapshot.CanAccessFinances)
                {
                    <li class="nav-item"><NavLink href="/projects"><span>Проекты</span></NavLink></li>
                }
            </ul>
        </div>

        <div class="nav-footer">
            @if (!string.IsNullOrEmpty(_snapshot.PrimaryRole))
            {
                <div class="nav-user-role">
                    <div class="nav-user-role-label">Ваша роль</div>
                    <RoleBadge Role="@_snapshot.PrimaryRole" />
                </div>
            }
            <ul class="nav-list">
                <li class="nav-item"><NavLink href="/profile"><span>Профиль</span></NavLink></li>
                @if (_snapshot.IsAdministrator)
                {
                    <li class="nav-item"><NavLink href="/settings"><span>Настройки</span></NavLink></li>
                }
            </ul>
            <button class="nav-logout" @onclick="Logout">Выйти</button>
        </div>
    </nav>
}
else
{
    <nav class="sidebar-nav">
        <ul class="nav-list">
            <li class="nav-item"><NavLink href="/login"><span>Вход</span></NavLink></li>
        </ul>
    </nav>
}

@code {
    private RoleAccessSnapshot _snapshot;

    protected override async Task OnInitializedAsync()
    {
        AuthState.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await ApplyAuthStateAsync();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> _)
    {
        await ApplyAuthStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyAuthStateAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _snapshot = RoleAccessSnapshot.FromPrincipal(state.User);
    }

    private void Logout() => NavigationManager.NavigateTo("/do-logout", forceLoad: true);

    public void Dispose() => AuthState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
}

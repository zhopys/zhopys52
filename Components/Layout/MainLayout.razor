@inherits LayoutComponentBase

<div class="app-shell">
    <header class="header glass-header">
        <a href="/" class="brand">
            <span class="brand-mark" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 18V8l5 4 5-6 6 8v4H4z" fill="currentColor" opacity="0.95"/>
                    <path d="M4 20h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </span>
            <span class="brand-text">MiniFinance</span>
        </a>
        <button type="button" class="nav-toggle" id="nav-toggle" aria-controls="app-sidebar" aria-expanded="false" aria-label="Открыть меню">
            <span class="nav-toggle-bar" aria-hidden="true"></span>
            <span class="nav-toggle-bar" aria-hidden="true"></span>
            <span class="nav-toggle-bar" aria-hidden="true"></span>
        </button>
        <div class="header-spacer"></div>
        <HeaderUserInfo />
        <div class="theme-toggle">
            <button class="theme-toggle-btn" onclick="window.toggleTheme && window.toggleTheme()" title="Переключить тему">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="5"/>
                    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                </svg>
            </button>
        </div>
    </header>

    <div class="container content">
        <div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>
        <aside class="sidebar glass-sidebar" id="app-sidebar">
            <NavMenu />
        </aside>
        <main class="main">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла необработанная ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss" onclick="document.getElementById('blazor-error-ui').style.display='none'">&times;</span>
</div>

@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using MiniFinance.Data
@using MiniFinance.Services
@implements IDisposable
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager

<AuthorizeView>
    <Authorized>
        @if (!string.IsNullOrEmpty(_role))
        {
            <a href="/profile" class="header-user" title="@_email">
                <span class="header-user-avatar" aria-hidden="true">@_initials</span>
                <span class="header-user-email">@_displayName</span>
                <RoleBadge Role="@_role" Title="Ваша роль в системе" />
            </a>
        }
    </Authorized>
</AuthorizeView>

@code {
    private string _role = "";
    private string _email = "";
    private string _displayName = "";
    private string _initials = "?";

    protected override async Task OnInitializedAsync()
    {
        AuthState.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await ApplyAuthStateAsync();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> _)
    {
        await ApplyAuthStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyAuthStateAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            _role = "";
            return;
        }

        var snapshot = RoleAccessSnapshot.FromPrincipal(state.User);
        _role = snapshot.PrimaryRole;

        var user = await UserManager.GetUserAsync(state.User);
        if (user == null) return;

        _email = user.Email ?? user.UserName ?? "";
        var name = $"{user.FirstName} {user.LastName}".Trim();
        _displayName = string.IsNullOrEmpty(name) ? _email : name;
        _initials = GetInitials(_displayName);
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
        return char.ToUpperInvariant(name.Trim()[0]).ToString();
    }

    public void Dispose() => AuthState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
}

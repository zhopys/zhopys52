@page "/team"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using MiniFinance.Data
@using MiniFinance.Services
@inject ITeamService TeamService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS
@attribute [Authorize(Policy = AuthorizationPolicies.CanManageUsers)]

<PageTitle>Команда — MiniFinance</PageTitle>

<div class="page-header">
    <div class="title">
        <h1>Команда и роли</h1>
        <div class="meta text-muted">Приглашение, назначение ролей, удаление участников</div>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" @onclick="() => _showInvite = !_showInvite">
            @(_showInvite ? "Скрыть форму" : "Пригласить участника")
        </button>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <p class="small text-muted mb-2">
            <strong>Администратор</strong> — полный доступ и управление пользователями.
            <strong>Бухгалтер</strong> — финансы, отчёты, импорт (без налогов и пользователей).
            <strong>Налоговый специалист</strong> — налоги, формулы, расчёты и отчёты (без обычных финансов).
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
            <RoleBadge Role="@AppRoles.Administrator" />
            <RoleBadge Role="@AppRoles.Accountant" />
            <RoleBadge Role="@AppRoles.TaxSpecialist" />
        </div>
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3 mb-0">@_message</div>
        }
    </div>
</div>

@if (_showInvite)
{
    <div class="card mb-3">
        <div class="card-header">Новый участник</div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Email *</label>
                    <input class="form-input" type="email" @bind="_invite.Email" placeholder="user@company.by" />
                </div>
                <div class="form-group">
                    <label class="form-label">Пароль *</label>
                    <input class="form-input" type="password" @bind="_invite.Password" placeholder="мин. 8 символов" />
                </div>
                <div class="form-group">
                    <label class="form-label">Роль</label>
                    <select class="form-input" @bind="_invite.Role">
                        <option value="@AppRoles.Accountant">@AppRoles.GetDisplayName(AppRoles.Accountant)</option>
                        <option value="@AppRoles.TaxSpecialist">@AppRoles.GetDisplayName(AppRoles.TaxSpecialist)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Имя</label>
                    <input class="form-input" @bind="_invite.FirstName" />
                </div>
                <div class="form-group">
                    <label class="form-label">Фамилия</label>
                    <input class="form-input" @bind="_invite.LastName" />
                </div>
                <div class="form-group">
                    <label class="form-label">Отдел</label>
                    <input class="form-input" @bind="_invite.Department" placeholder="Финансы, Бухгалтерия…" />
                </div>
            </div>
            <div class="mt-3" style="display:flex;gap:.5rem">
                <button class="btn btn-primary" @onclick="InviteMember" disabled="@_busy">Создать участника</button>
                <button class="btn btn-outline" @onclick="() => _showInvite = false">Отмена</button>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">Участники (@_members.Count)</div>
    <div class="card-body" style="padding:0">
        @if (_members.Count == 0)
        {
            <p class="text-muted p-3 mb-0">Нет участников</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Участник</th>
                        <th>Роль в системе</th>
                        <th>Отдел</th>
                        <th class="text-muted">Создан</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _members)
                    {
                        <tr>
                            <td>
                                <strong>@(DisplayName(m))</strong>
                                <div class="small text-muted">@m.Email</div>
                            </td>
                            <td>
                                <div style="display:flex;flex-direction:column;align-items:flex-start;gap:6px">
                                    <RoleBadge Role="@m.Role" />
                                    @if (m.Role != AppRoles.Administrator)
                                    {
                                        <select class="input input-sm" value="@m.Role" @onchange="e => SetRole(m, e)" aria-label="Сменить роль">
                                            <option value="@AppRoles.Accountant">@AppRoles.GetDisplayName(AppRoles.Accountant)</option>
                                            <option value="@AppRoles.TaxSpecialist">@AppRoles.GetDisplayName(AppRoles.TaxSpecialist)</option>
                                            <option value="@AppRoles.Administrator">@AppRoles.GetDisplayName(AppRoles.Administrator)</option>
                                        </select>
                                    }
                                </div>
                            </td>
                            <td>
                                <input class="input input-sm" value="@(m.Department ?? "")"
                                       @onchange="e => SetDepartment(m, e.Value?.ToString())" />
                            </td>
                            <td class="small text-muted">@(m.CreatedAt?.ToLocalTime().ToString("dd.MM.yyyy") ?? "—")</td>
                            <td class="text-end" style="white-space:nowrap">
                                @if (m.Id == _currentUserId)
                                {
                                    <span class="badge badge-info">Вы</span>
                                }
                                else if (m.Role != AppRoles.Administrator)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveMember(m)">Удалить</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<TeamMemberDto> _members = new();
    private string _currentUserId = "";
    private string? _message;
    private bool _isError;
    private bool _showInvite;
    private bool _busy;
    private InviteMemberRequest _invite = new() { Role = AppRoles.Accountant };

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        var me = await UserManager.GetUserAsync(auth.User);
        if (me == null) return;
        _currentUserId = me.Id;
        await LoadAsync();
    }

    private async Task LoadAsync() => _members = await TeamService.ListMembersAsync(_currentUserId);

    private async Task InviteMember()
    {
        _busy = true;
        _message = null;
        var (ok, err) = await TeamService.InviteMemberAsync(_invite, _currentUserId);
        _busy = false;
        if (ok)
        {
            _message = $"Участник {_invite.Email.Trim()} добавлен";
            _isError = false;
            _invite = new InviteMemberRequest { Role = AppRoles.Accountant };
            _showInvite = false;
            await LoadAsync();
        }
        else
        {
            _message = err;
            _isError = true;
        }
    }

    private async Task SetRole(TeamMemberDto m, ChangeEventArgs e)
    {
        var role = e.Value?.ToString() ?? AppRoles.Accountant;
        if (role == m.Role) return;

        var (ok, err) = await TeamService.SetRoleAsync(m.Id, role, _currentUserId);
        if (ok)
        {
            _message = m.Id == _currentUserId
                ? $"Ваша роль изменена на «{AppRoles.GetDisplayName(role)}». Меню обновится автоматически."
                : $"Роль обновлена: {m.Email}. У участника права обновятся без повторного входа.";
            _isError = false;
        }
        else
        {
            _message = err;
            _isError = true;
        }
        await LoadAsync();
    }

    private async Task SetDepartment(TeamMemberDto m, string? dept)
    {
        var (ok, err) = await TeamService.SetDepartmentAsync(m.Id, dept, _currentUserId);
        if (!ok) { _message = err; _isError = true; }
        else await LoadAsync();
    }

    private async Task RemoveMember(TeamMemberDto m)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Удалить участника {m.Email}?"))
            return;
        var (ok, err) = await TeamService.RemoveMemberAsync(m.Id, _currentUserId);
        _message = ok ? $"Удалён: {m.Email}" : err;
        _isError = !ok;
        await LoadAsync();
    }

    private static string DisplayName(TeamMemberDto m)
    {
        var n = $"{m.FirstName} {m.LastName}".Trim();
        return string.IsNullOrEmpty(n) ? m.Email : n;
    }
}

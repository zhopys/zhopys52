@* Страница «Команда» временно скрыта из UI. Полная реализация — в истории git (Team.razor). *@
@page "/team"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Команда — MiniFinance</PageTitle>

<div class="page-header">
    <div class="title">
        <h1>Команда и роли</h1>
        <div class="meta text-muted">Раздел временно недоступен</div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <p class="text-muted mb-0">Управление участниками и ролями будет включено позже. Код страницы и сервисов в проекте сохранён.</p>
    </div>
</div>

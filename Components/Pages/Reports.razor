@page "/reports"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using MiniFinance.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject IReportService ReportService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>Отчёты - MiniFinance</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="page-header">
            <div class="title">
                <h1>Финансовые отчёты</h1>
                <div class="meta text-muted">P&L, Cash Flow, Оборотно-сальдовая ведомость</div>
            </div>
            <div class="page-actions">
                <button class="btn btn-outline" @onclick="ExportCsv">CSV</button>
                <button class="btn btn-outline" @onclick="ExportXlsx">Excel</button>
            </div>
        </div>

        <!-- Period selector -->
        <div class="card mb-3">
            <div class="card-body">
                <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap">
                    <div>
                        <label class="label">Период</label>
                        <select class="input" @bind="selectedMonth" style="width:200px">
                            @foreach (var m in availableMonths)
                            {
                                <option value="@m">@m.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="tabs mb-3">
            <button class="tab @(activeTab == "pl" ? "active" : "")" @onclick="SetPlTab">Прибыли и убытки</button>
            <button class="tab @(activeTab == "cashflow" ? "active" : "")" @onclick="SetCashflowTab">Движение денег</button>
            <button class="tab @(activeTab == "trial" ? "active" : "")" @onclick="SetTrialTab">Оборотно-сальдовая</button>
            <button class="tab @(activeTab == "book" ? "active" : "")" @onclick="SetBookTab">Книга доходов/расходов</button>
        </div>

        <!-- P&L Tab -->
        @if (activeTab == "pl")
        {
            <div class="card mb-3">
                <div class="card-header">Прибыли и убытки</div>
                <div class="card-body" style="padding:0">
                    @if (plReport == null)
                    {
                        <div class="empty-state">Нет данных за выбранный период</div>
                    }
                    else
                    {
                        <!-- Summary -->
                        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;padding:1rem;border-bottom:1px solid var(--border)">
                            <div>
                                <div class="metric-label">Доходы</div>
                                <div class="metric-value text-success">@plReport.TotalIncome.ToString("N0") Br</div>
                            </div>
                            <div>
                                <div class="metric-label">Расходы</div>
                                <div class="metric-value text-danger">@plReport.TotalExpense.ToString("N0") Br</div>
                            </div>
                            <div>
                                <div class="metric-label">Чистая прибыль</div>
                                <div class="metric-value" style="color:@(plReport.NetProfit >= 0 ? "var(--success)" : "var(--danger)")">
                                    @plReport.NetProfit.ToString("N0") Br
                                </div>
                            </div>
                            <div>
                                <div class="metric-label">Маржинальность</div>
                                <div class="metric-value" style="color:@(plReport.ProfitMargin >= 0 ? "var(--success)" : "var(--danger)")">
                                    @plReport.ProfitMargin.ToString("F1")%
                                </div>
                            </div>
                        </div>

                        <!-- Expense breakdown -->
                        @if (plReport.ExpenseByCategory.Any())
                        {
                            <div style="padding:1rem">
                                <h4 style="margin-bottom:0.5rem">Расходы по категориям</h4>
                                @foreach (var cat in plReport.ExpenseByCategory)
                                {
                                    <div style="margin-bottom:0.5rem">
                                        <div style="display:flex;justify-content:space-between;margin-bottom:2px">
                                            <span>@cat.Category</span>
                                            <span class="text-danger">@cat.Amount.ToString("N0") Br (@cat.Percentage.ToString("F0")%)</span>
                                        </div>
                                        <div class="progress-bar-container" style="height:6px">
                                            <div class="progress-bar-fill" style="width:@cat.Percentage%;background:var(--danger)"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Income breakdown -->
                        @if (plReport.IncomeByCategory.Any())
                        {
                            <div style="padding:1rem;border-top:1px solid var(--border)">
                                <h4 style="margin-bottom:0.5rem">Доходы по категориям</h4>
                                @foreach (var cat in plReport.IncomeByCategory)
                                {
                                    <div style="margin-bottom:0.5rem">
                                        <div style="display:flex;justify-content:space-between;margin-bottom:2px">
                                            <span>@cat.Category</span>
                                            <span class="text-success">@cat.Amount.ToString("N0") Br (@cat.Percentage.ToString("F0")%)</span>
                                        </div>
                                        <div class="progress-bar-container" style="height:6px">
                                            <div class="progress-bar-fill" style="width:@cat.Percentage%;background:var(--success)"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }

        <!-- Cash Flow Tab -->
        @if (activeTab == "cashflow")
        {
            <div class="card mb-3">
                <div class="card-header">Движение денежных средств</div>
                <div class="card-body" style="padding:0">
                    @if (cashFlowStatement == null)
                    {
                        <div class="empty-state">Нет данных за выбранный период</div>
                    }
                    else
                    {
                        <!-- Cash flow summary by activity -->
                        <div style="padding:1rem;border-bottom:1px solid var(--border)">
                            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem">
                                <div style="background:var(--surface-hover);padding:1rem;border-radius:var(--radius)">
                                    <div class="metric-label">Операционная деятельность</div>
                                    <div class="metric-value" style="font-size:1.2rem;color:@(cashFlowStatement.OperatingCashFlow >= 0 ? "var(--success)" : "var(--danger)")">
                                        @cashFlowStatement.OperatingCashFlow.ToString("N0") Br
                                    </div>
                                    <div class="text-muted" style="font-size:0.8rem">Приход: @cashFlowStatement.OperatingIncome.ToString("N0") | Расход: @cashFlowStatement.OperatingExpenses.ToString("N0")</div>
                                </div>
                                <div style="background:var(--surface-hover);padding:1rem;border-radius:var(--radius)">
                                    <div class="metric-label">Инвестиционная деятельность</div>
                                    <div class="metric-value" style="font-size:1.2rem;color:@(cashFlowStatement.InvestmentCashFlow >= 0 ? "var(--success)" : "var(--danger)")">
                                        @cashFlowStatement.InvestmentCashFlow.ToString("N0") Br
                                    </div>
                                    <div class="text-muted" style="font-size:0.8rem">Приход: @cashFlowStatement.InvestmentIncome.ToString("N0") | Расход: @cashFlowStatement.InvestmentExpenses.ToString("N0")</div>
                                </div>
                                <div style="background:var(--surface-hover);padding:1rem;border-radius:var(--radius)">
                                    <div class="metric-label">Финансовая деятельность</div>
                                    <div class="metric-value" style="font-size:1.2rem;color:@(cashFlowStatement.FinancingCashFlow >= 0 ? "var(--success)" : "var(--danger)")">
                                        @cashFlowStatement.FinancingCashFlow.ToString("N0") Br
                                    </div>
                                    <div class="text-muted" style="font-size:0.8rem">Приход: @cashFlowStatement.FinancingIncome.ToString("N0") | Расход: @cashFlowStatement.FinancingExpenses.ToString("N0")</div>
                                </div>
                            </div>
                            <div style="margin-top:1rem;padding:1rem;background:var(--surface-hover);border-radius:var(--radius);text-align:center">
                                <div class="metric-label">Чистый денежный поток</div>
                                <div class="metric-value" style="color:@(cashFlowStatement.NetCashFlow >= 0 ? "var(--success)" : "var(--danger)")">
                                    @cashFlowStatement.NetCashFlow.ToString("N0") Br
                                </div>
                            </div>
                        </div>

                        <!-- Category details -->
                        @if (cashFlowStatement.CategoryDetails.Any())
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Категория</th>
                                        <th class="text-end">Приход</th>
                                        <th class="text-end">Расход</th>
                                        <th class="text-end">Нетто</th>
                                        <th class="text-end">Операций</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cat in cashFlowStatement.CategoryDetails)
                                    {
                                        <tr>
                                            <td>@cat.Category</td>
                                            <td class="text-end text-success">@cat.Income.ToString("N0") Br</td>
                                            <td class="text-end text-danger">@cat.Expense.ToString("N0") Br</td>
                                            <td class="text-end fw-bold @(cat.NetFlow >= 0 ? "text-success" : "text-danger")">
                                                @cat.NetFlow.ToString("N0") Br
                                            </td>
                                            <td class="text-end text-muted">@cat.TransactionCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            </div>

            <!-- Daily cashflow table -->
            <div class="card">
                <div class="card-header">Помесячный денежный поток</div>
                <div class="card-body" style="padding:0">
                    @if (!monthlyCashflow.Any())
                    {
                        <div class="empty-state">Нет данных</div>
                    }
                    else
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Месяц</th>
                                    <th class="text-end">Приход</th>
                                    <th class="text-end">Расход</th>
                                    <th class="text-end">Остаток нарастающим</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in monthlyCashflow)
                                {
                                    <tr>
                                        <td class="text-muted">@c.Date.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</td>
                                        <td class="text-end text-success">@c.Income.ToString("N2") Br</td>
                                        <td class="text-end text-danger">@c.Expense.ToString("N2") Br</td>
                                        <td class="text-end fw-bold @(c.Balance >= 0 ? "text-success" : "text-danger")">
                                            @c.Balance.ToString("N2") Br
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }

        <!-- Trial Balance Tab -->
        @if (activeTab == "trial")
        {
            <div class="card">
                <div class="card-header">Оборотно-сальдовая ведомость</div>
                <div class="card-body" style="padding:0">
                    @if (trialBalance == null)
                    {
                        <div class="empty-state">Нет данных за выбранный период</div>
                    }
                    else
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Категория</th>
                                    <th class="text-end">Нач. остаток</th>
                                    <th class="text-end">Дебет (приход)</th>
                                    <th class="text-end">Кредит (расход)</th>
                                    <th class="text-end">Кон. остаток</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in trialBalance.Entries)
                                {
                                    <tr>
                                        <td>@entry.Category</td>
                                        <td class="text-end @(entry.OpeningBalance >= 0 ? "text-success" : "text-danger")">
                                            @entry.OpeningBalance.ToString("N2") Br
                                        </td>
                                        <td class="text-end text-success">@entry.Debit.ToString("N2") Br</td>
                                        <td class="text-end text-danger">@entry.Credit.ToString("N2") Br</td>
                                        <td class="text-end fw-bold @(entry.ClosingBalance >= 0 ? "text-success" : "text-danger")">
                                            @entry.ClosingBalance.ToString("N2") Br
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td class="fw-bold">Итого</td>
                                    <td class="text-end fw-bold">@trialBalance.TotalOpeningBalance.ToString("N2") Br</td>
                                    <td class="text-end fw-bold text-success">@trialBalance.TotalDebit.ToString("N2") Br</td>
                                    <td class="text-end fw-bold text-danger">@trialBalance.TotalCredit.ToString("N2") Br</td>
                                    <td class="text-end fw-bold">@trialBalance.TotalClosingBalance.ToString("N2") Br</td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>
            </div>
        }

        <!-- Book Tab -->
        @if (activeTab == "book")
        {
            <div class="card">
                <div class="card-header">Книга доходов и расходов</div>
                <div class="card-body" style="padding:0">
                    @if (incomeExpenseBook == null || !incomeExpenseBook.Any())
                    {
                        <div class="empty-state">Нет данных за выбранный период</div>
                    }
                    else
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>№</th>
                                    <th>Дата</th>
                                    <th>Документ</th>
                                    <th>Контрагент</th>
                                    <th>Описание</th>
                                    <th class="text-end">Доход</th>
                                    <th class="text-end">Расход</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in incomeExpenseBook)
                                {
                                    <tr>
                                        <td>@entry.EntryNumber</td>
                                        <td>@entry.Date.ToString("dd.MM.yyyy")</td>
                                        <td class="text-muted">@entry.DocumentNumber</td>
                                        <td>@entry.Counterparty</td>
                                        <td>@entry.Description</td>
                                        <td class="text-end text-success">@(entry.Income > 0 ? entry.Income.ToString("N2") + " Br" : "—")</td>
                                        <td class="text-end text-danger">@(entry.Expense > 0 ? entry.Expense.ToString("N2") + " Br" : "—")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="fw-bold">Итого</td>
                                    <td class="text-end fw-bold text-success">@incomeExpenseBook.Sum(e => e.Income).ToString("N2") Br</td>
                                    <td class="text-end fw-bold text-danger">@incomeExpenseBook.Sum(e => e.Expense).ToString("N2") Br</td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private List<Transaction> transactions = new();
    private string activeTab = "pl";
    private DateTime selectedMonth = DateTime.Today;
    private List<DateTime> availableMonths = new();

    // P&L
    private ProfitLossReport? plReport;
    // Cash flow
    private List<CashflowEntry> cashflow = new();
    private List<CashflowEntry> monthlyCashflow = new();
    private CashFlowStatementReport? cashFlowStatement;
    // Trial balance
    private TrialBalanceReport? trialBalance;
    // Book
    private List<IncomeExpenseBookEntry>? incomeExpenseBook;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            transactions = await DbContext.Transactions
                .Where(t => t.UserId == user.Id)
                .OrderByDescending(t => t.Date)
                .ToListAsync();

            availableMonths = transactions
                .GroupBy(t => new { t.Date.Year, t.Date.Month })
                .Select(g => new DateTime(g.Key.Year, g.Key.Month, 1))
                .OrderByDescending(d => d)
                .ToList();

            if (availableMonths.Any())
            {
                selectedMonth = availableMonths.First();
            }
            else
            {
                availableMonths.Add(DateTime.Today);
            }

            LoadReports();
        }
    }

    private void LoadReports()
    {
        var start = new DateTime(selectedMonth.Year, selectedMonth.Month, 1);
        var end = start.AddMonths(1).AddDays(-1);
        var monthTx = transactions.Where(t => t.Date >= start && t.Date <= end).ToList();

        // P&L
        plReport = ReportService.GetProfitLossReport(monthTx, start, end);

        // Cash flow - daily
        cashflow = ReportService.GetCashflow(monthTx);

        // Cash flow - monthly (for the second table)
        var monthlyTx = transactions
            .Where(t => t.Date <= end)
            .GroupBy(t => new { t.Date.Year, t.Date.Month })
            .OrderBy(g => g.Key.Year)
            .ThenBy(g => g.Key.Month)
            .Select(g => new CashflowEntry
            {
                Date = new DateTime(g.Key.Year, g.Key.Month, 1),
                Income = g.Where(t => t.Amount > 0).Sum(t => t.Amount),
                Expense = Math.Abs(g.Where(t => t.Amount < 0).Sum(t => t.Amount)),
                Balance = g.Sum(t => t.Amount)
            })
            .ToList();
        decimal running = 0;
        foreach (var e in monthlyTx) { running += e.Balance; e.Balance = running; }
        monthlyCashflow = monthlyTx;

        // Cash flow statement
        cashFlowStatement = ReportService.GetCashFlowStatement(monthTx, start, end);

        // Trial balance
        trialBalance = ReportService.GetTrialBalanceReport(monthTx, start, end);

        // Book
        incomeExpenseBook = ReportService.GetIncomeExpenseBook(monthTx, start, end);
    }

    protected override void OnParametersSet()
    {
        LoadReports();
    }

    private void ExportCsv()
    {
        var start = new DateTime(selectedMonth.Year, selectedMonth.Month, 1);
        var end = start.AddMonths(1).AddDays(-1);
        NavigationManager.NavigateTo($"/reports/export/csv?start={start:yyyy-MM-dd}&end={end:yyyy-MM-dd}", forceLoad: true);
    }

    private void ExportXlsx()
    {
        var start = new DateTime(selectedMonth.Year, selectedMonth.Month, 1);
        var end = start.AddMonths(1).AddDays(-1);
        NavigationManager.NavigateTo($"/reports/export/xlsx?start={start:yyyy-MM-dd}&end={end:yyyy-MM-dd}", forceLoad: true);
    }

    private void SetPlTab() => activeTab = "pl";
    private void SetCashflowTab() => activeTab = "cashflow";
    private void SetTrialTab() => activeTab = "trial";
    private void SetBookTab() => activeTab = "book";
}

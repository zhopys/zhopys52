@page "/reports"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Components.Shared.Reports
@using MiniFinance.Data
@using MiniFinance.Data.Models
@using MiniFinance.Services
@inject IReportAnalyticsService AnalyticsService
@inject IExtendedReportService ExtendedReportService
@inject IBalanceReportService BalanceReportService
@inject ITransactionService TransactionService
@inject ITaxFinanceSummaryService FinanceSummary
@inject IUserContextService UserContext
@inject IDataScopeService DataScope
@inject ICategorizationService CategorizationService
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize(Policy = AuthorizationPolicies.CanViewReports)]

<PageTitle>Отчёты — MiniFinance</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="page-header">
            <div class="title">
                <h1>@(_taxOnlyMode ? "Налоговые отчёты" : "Финансовые отчёты")</h1>
                <div class="meta text-muted">
                    @if (_taxOnlyMode)
                    {
                        <span>Налоговая сводка · @GetPeriodRange().start.ToString("dd.MM.yyyy") — @GetPeriodRange().end.ToString("dd.MM.yyyy")</span>
                    }
                    else if (_snapshot != null)
                    {
                        <span>@_snapshot.Filters.Start.ToString("dd.MM.yyyy") — @_snapshot.Filters.End.ToString("dd.MM.yyyy")</span>
                        @if (!string.IsNullOrEmpty(GetActiveFilterSummary()))
                        {
                            <span> · @GetActiveFilterSummary()</span>
                        }
                    }
                    else
                    {
                        <span>Учётные формы — P&amp;L, движение денег, ОСВ, книга, налоги, баланс</span>
                    }
                </div>
            </div>
            @if (!_taxOnlyMode && _snapshot != null)
            {
                <div class="page-actions">
                    <a href="/analytics" class="btn btn-outline btn-sm">Аналитика</a>
                </div>
            }
        </div>

        @if (_taxOnlyMode)
        {
            <div class="alert alert-info small mb-3">
                Доходы и расходы для расчёта налогов берутся из агрегатов учёта организации. Детализация по операциям доступна бухгалтеру и администратору.
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-error reports-alert mb-3" role="alert">
                <strong>Ошибка.</strong> @_errorMessage
            </div>
        }

        <ReportsToolbar PeriodType="@_periodType"
                        PeriodTypeChanged="OnPeriodTypeChanged"
                        SelectedMonthKey="@_selectedMonthKey"
                        SelectedMonthKeyChanged="OnMonthKeyChanged"
                        CustomStart="@_customStart"
                        CustomStartChanged="OnCustomStartChanged"
                        CustomEnd="@_customEnd"
                        CustomEndChanged="OnCustomEndChanged"
                        CompareMode="none"
                        ProjectId="@_projectId"
                        ProjectIdChanged="OnProjectIdChanged"
                        SelectedCategory="@_selectedCategory"
                        SelectedCategoryChanged="OnCategoryChanged"
                        AvailableMonths="@_availableMonths"
                        Projects="@(_taxOnlyMode ? Array.Empty<Project>() : _projects)"
                        Categories="@(_taxOnlyMode ? Array.Empty<string>() : _categoryNames)"
                        OnFiltersChanged="ReloadAsync"
                        OnReset="ResetFiltersAsync"
                        OnExport="ExportAsync"
                        Disabled="@_loading"
                        HideProjectFilter="@_taxOnlyMode"
                        HideCategoryFilter="@_taxOnlyMode"
                        HideCompareMode="true"
                        HideExport="@_taxOnlyMode" />

        @if (_taxOnlyMode && _extended?.Tax != null)
        {
            @if (_taxPeriodTotals != null)
            {
                <p class="text-muted small mb-3">
                    База для расчёта: доход @_taxPeriodTotals.Income.ToString("N0") <Byn />
                    · расход @_taxPeriodTotals.Expenses.ToString("N0") <Byn />
                    · @_taxPeriodTotals.OperationCount операций в учёте
                </p>
            }
            <TaxReportPanel Report="@_extended.Tax" />
        }

        @if (_loading && _snapshot == null && !(_taxOnlyMode && _extended != null))
        {
            <div class="loading-state"><div class="spinner"></div></div>
        }
        else if (!_taxOnlyMode && _snapshot != null && !_snapshot.DataStatus.HasData)
        {
            <div class="empty-state reports-empty-state">
                <div class="empty-state-icon reports-empty-icon" aria-hidden="true"></div>
                <div class="empty-state-title">Нет данных для отчётов</div>
                <p class="text-muted">Импортируйте выписку из банка в формате CSV или добавьте операции вручную.</p>
                <div class="page-actions" style="justify-content:center;margin-top:1rem">
                    <a href="/import" class="btn btn-primary">Импорт CSV</a>
                    <a href="/transactions" class="btn btn-outline">Добавить операцию</a>
                </div>
            </div>
        }
        else if (_taxOnlyMode && _extended == null && !_loading)
        {
            <div class="empty-state reports-empty-state">
                <div class="empty-state-title">Нет данных за период</div>
                <p class="text-muted">За выбранный период нет подтверждённых операций в учёте организации.</p>
            </div>
        }
        else if (_snapshot != null)
        {
            @if (_snapshot.UncategorizedTransactions.Any())
            {
                <div class="alert alert-warning small mb-3">
                    @_snapshot.UncategorizedTransactions.Count операций без категории — это влияет на точность отчётов.
                    <a href="/transactions" class="ms-1">Разобрать в транзакциях →</a>
                </div>
            }

            <div class="tabs reports-tabs mb-3 @(_refreshing ? "reports-refreshing" : "")">
                <button type="button" class="tab @(_activeTab == "pl" ? "active" : "")" @onclick='() => SetTab("pl")'>Прибыли и убытки</button>
                <button type="button" class="tab @(_activeTab == "cashflow" ? "active" : "")" @onclick='() => SetTab("cashflow")'>Денежный поток</button>
                <button type="button" class="tab @(_activeTab == "trial" ? "active" : "")" @onclick='() => SetTab("trial")'>ОСВ</button>
                <button type="button" class="tab @(_activeTab == "book" ? "active" : "")" @onclick='() => SetTab("book")'>Книга учёта</button>
                <button type="button" class="tab @(_activeTab == "tax" ? "active" : "")" @onclick='() => SetTab("tax")'>Налоги</button>
                <button type="button" class="tab @(_activeTab == "balance" ? "active" : "")" @onclick='() => SetTab("balance")'>Баланс</button>
            </div>

            <p class="reports-tab-hint text-muted small mb-3">@GetTabHint()</p>

            @if (_activeTab == "pl")
            {
                <PlReportPanel Report="@_snapshot.ProfitLoss" />
            }
            else if (_activeTab == "cashflow")
            {
                <CashFlowPanel Statement="@_snapshot.CashFlow" MonthlyCashflow="@_snapshot.MonthlyCashflow" />
            }
            else if (_activeTab == "trial")
            {
                <div class="card mb-3">
                    <div class="card-header">
                        Оборотно-сальдовая ведомость
                        <span class="text-muted small ms-2">остатки и обороты по категориям</span>
                    </div>
                    <div class="card-body" style="padding:0">
                        @if (_snapshot.TrialBalance == null || !_snapshot.TrialBalance.Entries.Any())
                        {
                            <div class="empty-state small">Нет данных за период</div>
                        }
                        else
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Категория</th>
                                        <th class="text-end">Сальдо на начало</th>
                                        <th class="text-end">Дебет</th>
                                        <th class="text-end">Кредит</th>
                                        <th class="text-end">Сальдо на конец</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var e in _snapshot.TrialBalance.Entries)
                                    {
                                        <tr>
                                            <td>@e.Category</td>
                                            <td class="text-end">@e.OpeningBalance.ToString("N2")</td>
                                            <td class="text-end text-success">@e.Debit.ToString("N2")</td>
                                            <td class="text-end text-danger">@e.Credit.ToString("N2")</td>
                                            <td class="text-end fw-bold">@e.ClosingBalance.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold">
                                        <td>Итого</td>
                                        <td class="text-end">@_snapshot.TrialBalance.TotalOpeningBalance.ToString("N2")</td>
                                        <td class="text-end">@_snapshot.TrialBalance.TotalDebit.ToString("N2")</td>
                                        <td class="text-end">@_snapshot.TrialBalance.TotalCredit.ToString("N2")</td>
                                        <td class="text-end">@_snapshot.TrialBalance.TotalClosingBalance.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        }
                    </div>
                </div>
            }
            else if (_activeTab == "book")
            {
                <div class="card mb-3">
                    <div class="card-header">
                        Книга учёта доходов и расходов
                        <span class="text-muted small ms-2">хронологический список операций</span>
                    </div>
                    <div class="card-body" style="padding:0">
                        @if (!_snapshot.IncomeExpenseBook.Any())
                        {
                            <div class="empty-state small">Нет данных за период</div>
                        }
                        else
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>№</th>
                                        <th>Дата</th>
                                        <th>Описание</th>
                                        <th class="text-end">Доход</th>
                                        <th class="text-end">Расход</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var e in _snapshot.IncomeExpenseBook)
                                    {
                                        <tr>
                                            <td>@e.EntryNumber</td>
                                            <td>@e.Date.ToString("dd.MM.yyyy")</td>
                                            <td>@e.Description</td>
                                            <td class="text-end text-success">@(e.Income > 0 ? e.Income.ToString("N2") : "—")</td>
                                            <td class="text-end text-danger">@(e.Expense > 0 ? e.Expense.ToString("N2") : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            }
            else if (_activeTab == "tax" && _extended != null)
            {
                <TaxReportPanel Report="@_extended.Tax" />
            }
            else if (_activeTab == "balance" && _balance != null)
            {
                @if (_snapshot.TaxReserve > 0)
                {
                    <div class="alert alert-warning small mb-3">
                        Налоговый резерв @_snapshot.TaxReserve.ToString("N0") <Byn />
                        · свободные деньги <strong>@_snapshot.FreeCash.ToString("N0") <Byn /></strong>
                    </div>
                }
                <BalanceReportPanel Report="@_balance" />
            }
        }
    </Authorized>
</AuthorizeView>

@code {
    private ReportAnalyticsSnapshot? _snapshot;
    private ExtendedAnalyticsDto? _extended;
    private TaxPeriodTotalsDto? _taxPeriodTotals;
    private BalanceReportDto? _balance;
    private string _userId = "";
    private string _dataUserId = "";
    private bool _taxOnlyMode;
    private bool _loading = true;
    private bool _refreshing;
    private string? _errorMessage;
    private string _activeTab = "pl";
    private string _periodType = "Month";
    private DateTime _selectedMonth = DateTime.Today;
    private string _selectedMonthKey = "";
    private DateTime _customStart;
    private DateTime _customEnd = DateTime.Today;
    private List<DateTime> _availableMonths = new();
    private List<string> _categoryNames = new();
    private List<Project> _projects = new();
    private int? _projectId;
    private string? _selectedCategory;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user == null) return;

        _userId = user.Id;
        _dataUserId = await DataScope.GetDataOwnerUserIdAsync(user.Id);
        var ctx = await UserContext.GetContextAsync(user.Id);
        _taxOnlyMode = UserContext.IsTaxSpecialistOnly(ctx);

        if (!_taxOnlyMode)
        {
            _categoryNames = await CategorizationService.GetCategoryNamesAsync();
            _projects = await DbContext.Projects
                .Where(p => p.UserId == user.Id || p.UserId == null)
                .Where(p => !p.IsDefault)
                .OrderBy(p => p.Name)
                .ToListAsync();
        }

        var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _customStart = monthStart;
        _customEnd = monthStart.AddMonths(1).AddDays(-1);

        await LoadAvailableAnchorsAsync();
        await ReloadAsync();
    }

    private async Task LoadAvailableAnchorsAsync()
    {
        if (_taxOnlyMode)
        {
            _availableMonths = (await FinanceSummary.GetAvailablePeriodAnchorsAsync(_dataUserId, _periodType)).ToList();
        }
        else
        {
            var transactions = await TransactionService.ListAsync(_userId);

            _availableMonths = _periodType switch
            {
                "Year" => transactions
                    .GroupBy(t => t.Date.Year)
                    .Select(g => new DateTime(g.Key, 1, 1))
                    .OrderByDescending(d => d)
                    .ToList(),
                "Quarter" => transactions
                    .GroupBy(t => new { t.Date.Year, Q = (t.Date.Month - 1) / 3 })
                    .Select(g => new DateTime(g.Key.Year, g.Key.Q * 3 + 1, 1))
                    .OrderByDescending(d => d)
                    .ToList(),
                _ => transactions
                    .GroupBy(t => new { t.Date.Year, t.Date.Month })
                    .Select(g => new DateTime(g.Key.Year, g.Key.Month, 1))
                    .OrderByDescending(d => d)
                    .ToList()
            };
        }

        if (!_availableMonths.Any())
            _availableMonths.Add(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1));

        if (!_availableMonths.Any(m => ToMonthKey(m) == _selectedMonthKey))
        {
            _selectedMonth = _availableMonths[0];
            _selectedMonthKey = ToMonthKey(_selectedMonth);
        }
    }

    private ReportFilters BuildFilters(string? exportReport = null)
    {
        var (start, end) = GetPeriodRange();
        return new ReportFilters
        {
            Start = start,
            End = end,
            PeriodType = _periodType,
            CompareMode = "none",
            ForecastDays = 90,
            ProjectId = _projectId,
            Categories = string.IsNullOrEmpty(_selectedCategory) ? Array.Empty<string>() : new[] { _selectedCategory },
            ExportReport = exportReport ?? "full"
        };
    }

    private async Task ReloadAsync()
    {
        if (string.IsNullOrEmpty(_userId)) return;

        _errorMessage = null;
        _loading = _taxOnlyMode ? _extended == null : _snapshot == null;
        _refreshing = _taxOnlyMode ? _extended != null : _snapshot != null;
        StateHasChanged();

        try
        {
            if (!string.IsNullOrEmpty(_selectedMonthKey) && _periodType != "Custom")
                _selectedMonth = ParseMonthKey(_selectedMonthKey);

            var filters = BuildFilters();
            if (_taxOnlyMode)
            {
                _snapshot = null;
                _balance = null;
                _taxPeriodTotals = await FinanceSummary.GetPeriodTotalsAsync(_dataUserId, filters.Start, filters.End);
                _extended = await ExtendedReportService.BuildAsync(_dataUserId, filters, null);
            }
            else
            {
                _taxPeriodTotals = null;
                _snapshot = await AnalyticsService.BuildSnapshotAsync(_userId, filters);
                _extended = await ExtendedReportService.BuildAsync(_userId, filters, null);
                _balance = await BalanceReportService.BuildAsync(_userId, filters);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = GetRussianErrorMessage(ex);
            System.Diagnostics.Debug.WriteLine(ex);
        }
        finally
        {
            _loading = false;
            _refreshing = false;
            StateHasChanged();
        }
    }

    private async Task ResetFiltersAsync()
    {
        _periodType = "Month";
        _projectId = null;
        _selectedCategory = null;
        _selectedMonth = _availableMonths.Count > 0 ? _availableMonths[0] : DateTime.Today;
        _selectedMonthKey = ToMonthKey(_selectedMonth);
        var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _customStart = monthStart;
        _customEnd = monthStart.AddMonths(1).AddDays(-1);
        await ReloadAsync();
    }

    private async Task OnPeriodTypeChanged(string value)
    {
        _periodType = value;
        await LoadAvailableAnchorsAsync();
        await ReloadAsync();
    }

    private async Task OnMonthKeyChanged(string key)
    {
        _selectedMonthKey = key;
        await ReloadAsync();
    }

    private async Task OnCustomStartChanged(DateTime d)
    {
        _customStart = d;
        await ReloadAsync();
    }

    private async Task OnCustomEndChanged(DateTime d)
    {
        _customEnd = d;
        await ReloadAsync();
    }

    private async Task OnProjectIdChanged(int? id)
    {
        _projectId = id;
        await ReloadAsync();
    }

    private async Task OnCategoryChanged(string? cat)
    {
        _selectedCategory = cat;
        await ReloadAsync();
    }

    private void SetTab(string tab) => _activeTab = tab;

    private string GetTabHint() => _activeTab switch
    {
        "pl" => "Доходы и расходы по категориям за период.",
        "cashflow" => "Движение денег по видам деятельности — каждая транзакция классифицируется автоматически.",
        "trial" => "Обороты и сальдо по категориям.",
        "book" => "Хронологический журнал доходов и расходов.",
        "tax" => "Начисленные и уплаченные налоги за период.",
        "balance" => "Активы, обязательства и чистая позиция на дату.",
        _ => ""
    };

    private void ExportAsync((string Format, string? Report) request) =>
        ExportReport(request.Format, request.Report);

    private void ExportReport(string format, string? report = null)
    {
        var exportReport = report ?? "full";
        var qs = BuildFilters(exportReport).ToQueryString(format, exportReport);
        NavigationManager.NavigateTo($"/api/reports/export?{qs}", forceLoad: true);
    }

    private (DateTime start, DateTime end) GetPeriodRange()
    {
        if (_periodType == "Custom")
            return ReportFilters.ResolvePeriodRange(_selectedMonth, _periodType, _customStart, _customEnd);
        return ReportFilters.ResolvePeriodRange(_selectedMonth, _periodType);
    }

    private static string ToMonthKey(DateTime d) => d.ToString("yyyy-MM", CultureInfo.InvariantCulture);

    private static DateTime ParseMonthKey(string key)
    {
        if (DateTime.TryParseExact(key + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d))
            return d;
        return DateTime.Today;
    }

    private string? GetActiveFilterSummary()
    {
        var parts = new List<string>();
        if (_projectId.HasValue)
        {
            var name = _projects.FirstOrDefault(p => p.Id == _projectId)?.Name;
            if (!string.IsNullOrEmpty(name))
                parts.Add($"проект: {name}");
        }
        if (!string.IsNullOrEmpty(_selectedCategory))
            parts.Add($"категория: {_selectedCategory}");
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    private static string GetRussianErrorMessage(Exception ex) => ex switch
    {
        Microsoft.EntityFrameworkCore.DbUpdateException =>
            "Не удалось прочитать данные из базы. Перезапустите приложение или обратитесь к администратору.",
        TimeoutException =>
            "Превышено время ожидания. Сузьте период отчёта или повторите попытку позже.",
        InvalidOperationException op when !string.IsNullOrWhiteSpace(op.Message) && op.Message.Any(c => c >= '\u0400') =>
            op.Message,
        _ =>
            "Не удалось построить отчёт. Проверьте выбранные фильтры и нажмите «Применить», либо обновите страницу."
    };

}

@page "/projects"
@rendermode InteractiveServer
@using MiniFinance.Data.Models
@using MiniFinance.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject ApplicationDbContext DbContext
@inject IJSRuntime JS
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDataScopeService DataScope
@attribute [Authorize]

<PageTitle>Проекты - MiniFinance</PageTitle>

<!-- Заголовок с навигацией -->
<div class="page-header">
    <div class="page-header-left">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Главная</a></li>
                <li class="breadcrumb-item active" aria-current="page">Проекты</li>
            </ol>
        </nav>
        <h1 class="page-title">Проекты</h1>
        <p class="page-subtitle">Управление проектами, отслеживание рентабельности и ключевых метрик</p>
    </div>
    <div class="page-header-right">
        <button class="btn btn-outline" @onclick="LoadProjects" title="Обновить данные">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M23 4v6h-6M1 20v-6h6"/>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
            </svg>
            <span class="btn-text">Обновить</span>
        </button>
        <button class="btn btn-primary" @onclick="ToggleCreateForm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            <span class="btn-text">Новый проект</span>
        </button>
    </div>
</div>

<!-- Уведомления -->
@if (showMessage)
{
    <div class="notification success">
        <div class="notification-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11"/></svg>
        </div>
        <div class="notification-content">
            <strong>Успешно!</strong>
            <p>@message</p>
        </div>
        <button class="notification-close" @onclick="() => showMessage = false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>
}

@if (showError)
{
    <div class="notification error">
        <div class="notification-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </div>
        <div class="notification-content">
            <strong>Ошибка!</strong>
            <p>@errorMessage</p>
        </div>
        <button class="notification-close" @onclick="() => showError = false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>
}

<!-- Форма создания/редактирования проекта -->
@if (showCreateForm)
{
    <div class="modal-overlay" @onclick="CancelForm">
        <div class="modal-content modal-lg" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(editId == 0 ? "Создание проекта" : "Редактирование проекта")</h3>
                <button class="modal-close" @onclick="CancelForm">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Название проекта <span class="required">*</span></label>
                        <input class="form-input" 
                               placeholder="Введите название проекта" 
                               @bind="newProject.Name"
                               @bind:event="oninput" />
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Статус проекта</label>
                        <select class="form-select" @bind="newProject.Status">
                            <option value="@ProjectStatus.Planning">Планирование</option>
                            <option value="@ProjectStatus.Active">Активный</option>
                            <option value="@ProjectStatus.OnHold">Приостановлен</option>
                            <option value="@ProjectStatus.Completed">Завершен</option>
                            <option value="@ProjectStatus.Cancelled">Отменен</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Бюджет проекта (Br)</label>
                        <input type="number" class="form-input" 
                               placeholder="Плановый бюджет" 
                               @bind="newProject.Budget" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Плановая доходность (%)</label>
                        <input type="number" class="form-input" 
                               placeholder="Ожидаемая ROI" 
                               @bind="newProject.TargetROI" 
                               step="0.1" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Дата начала</label>
                        <input type="date" class="form-input" @bind="newProject.StartDate" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Дата завершения</label>
                        <input type="date" class="form-input" @bind="newProject.EndDate" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Приоритет</label>
                        <select class="form-select" @bind="newProject.Priority">
                            <option value="">Не указан</option>
                            <option value="@ProjectPriority.Low">Низкий</option>
                            <option value="@ProjectPriority.Medium">Средний</option>
                            <option value="@ProjectPriority.High">Высокий</option>
                            <option value="@ProjectPriority.Critical">Критический</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Менеджер проекта</label>
                        <input class="form-input"
                               placeholder="ФИО менеджера"
                               @bind="newProject.ProjectManager" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Отдел / Департамент</label>
                        <input class="form-input"
                               placeholder="Например: Маркетинг, Разработка"
                               @bind="newProject.Department" />
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">Описание проекта</label>
                        <textarea class="form-input" 
                                  placeholder="Опишите цели, задачи и особенности проекта"
                                  @bind="newProject.Description"
                                  rows="3"></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">Ключевые показатели (KPI)</label>
                        <textarea class="form-input" 
                                  placeholder="Например: увеличение продаж на 20%, снижение затрат на 15%"
                                  @bind="newProject.KPI"
                                  rows="2"></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">Риски проекта</label>
                        <textarea class="form-input" 
                                  placeholder="Опишите потенциальные риски"
                                  @bind="newProject.Risks"
                                  rows="2"></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">Заметки / Комментарии</label>
                        <textarea class="form-input" 
                                  placeholder="Дополнительная информация"
                                  @bind="newProject.Notes"
                                  rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CancelForm">Отмена</button>
                <button class="btn btn-primary" @onclick="SaveProject">
                    @(editId == 0 ? "Создать проект" : "Сохранить изменения")
                </button>
            </div>
        </div>
    </div>
}

<!-- Дашборд сводной статистики -->
@if (projects != null && projects.Any())
{
    var totalBudget = projects.Sum(p => p.Budget ?? 0);
    var totalActualCost = projectStats.Sum(s => s.TotalExpense);
    var totalActualIncome = projectStats.Sum(s => s.TotalIncome);
    var activeProjects = projects.Count(p => p.Status == ProjectStatus.Active);
    var completedProjects = projects.Count(p => p.Status == ProjectStatus.Completed);

    <div class="dashboard-stats">
        <div class="stat-card" data-animate>
            <div class="stat-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            </div>
            <div class="stat-content">
                <div class="stat-label">Всего проектов</div>
                <div class="stat-value">@projects.Count</div>
                <div class="stat-trend">
                    <span class="trend-badge">@activeProjects активных</span>
                    <span class="trend-badge">@completedProjects завершено</span>
                </div>
            </div>
        </div>
        <div class="stat-card" data-animate>
            <div class="stat-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div class="stat-content">
                <div class="stat-label">Общий бюджет</div>
                <div class="stat-value">@totalBudget.ToString("N0") Br</div>
                <div class="stat-trend">Плановый</div>
            </div>
        </div>
        <div class="stat-card" data-animate>
            <div class="stat-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            </div>
            <div class="stat-content">
                <div class="stat-label">Факт. доходы</div>
                <div class="stat-value positive">+@totalActualIncome.ToString("N0") Br</div>
                <div class="stat-trend">За все время</div>
            </div>
        </div>
        <div class="stat-card" data-animate>
            <div class="stat-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/></svg>
            </div>
            <div class="stat-content">
                <div class="stat-label">Факт. расходы</div>
                <div class="stat-value negative">-@totalActualCost.ToString("N0") Br</div>
                <div class="stat-trend">За все время</div>
            </div>
        </div>
    </div>

    <!-- Department summaries -->
    @if (departmentSummaries.Any())
    {
        <div class="card mb-3">
            <div class="card-header">Анализ по отделам</div>
            <div class="card-body" style="padding:0">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Отдел</th>
                            <th class="text-center">Проектов</th>
                            <th class="text-center">Активных</th>
                            <th class="text-end">Доходы</th>
                            <th class="text-end">Расходы</th>
                            <th class="text-end">Прибыль</th>
                            <th class="text-end">Маржа</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dept in departmentSummaries)
                        {
                            <tr class="@(dept.TotalProfit < 0 ? "negative-balance" : null)" data-balance="@dept.TotalProfit.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <td><strong>@dept.Department</strong></td>
                                <td class="text-center">@dept.ProjectCount</td>
                                <td class="text-center">@dept.ActiveProjects</td>
                                <td class="text-end text-success">@dept.TotalIncome.ToString("N0") Br</td>
                                <td class="text-end text-danger">@dept.TotalExpense.ToString("N0") Br</td>
                                <td class="text-end fw-bold @(dept.TotalProfit >= 0 ? "text-success" : "text-danger")">
                                    @dept.TotalProfit.ToString("N0") Br
                                </td>
                                <td class="text-end">
                                    <span class="@(dept.AvgMargin >= 0 ? "text-success" : "text-danger")">
                                        @dept.AvgMargin.ToString("F1")%
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Profitability comparison table -->
    @if (profitabilityMetrics.Any())
    {
        <div class="card mb-3">
            <div class="card-header">Сравнительная рентабельность проектов</div>
            <div class="card-body" style="padding:0">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Проект</th>
                            @if (!string.IsNullOrWhiteSpace(profitabilityMetrics.FirstOrDefault()?.Department))
                            {
                                <th>Отдел</th>
                            }
                            <th class="text-end">Доход</th>
                            <th class="text-end">Расход</th>
                            <th class="text-end">Прибыль</th>
                            <th class="text-end">Маржа</th>
                            <th class="text-end">ROI</th>
                            <th class="text-end">Ср./мес</th>
                            <th class="text-center">Статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in profitabilityMetrics)
                        {
                            <tr class="@(m.Profit < 0 ? "negative-balance" : null)" data-balance="@m.Profit.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <td><strong>@m.ProjectName</strong></td>
                                @if (!string.IsNullOrWhiteSpace(m.Department))
                                {
                                    <td><span class="badge badge-info">@m.Department</span></td>
                                }
                                <td class="text-end text-success">@m.TotalIncome.ToString("N0")</td>
                                <td class="text-end text-danger">@m.TotalExpense.ToString("N0")</td>
                                <td class="text-end fw-bold @(m.Profit >= 0 ? "text-success" : "text-danger")">
                                    @m.Profit.ToString("N0") Br
                                </td>
                                <td class="text-end">
                                    <span class="@(m.Margin >= 0 ? "text-success" : "text-danger")">
                                        @m.Margin.ToString("F1")%
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span class="@(m.ROI >= 1 ? "text-success" : "text-danger")">
                                        @m.ROI.ToString("F2")x
                                    </span>
                                </td>
                                <td class="text-end">@m.AvgMonthlyProfit.ToString("N0") Br</td>
                                <td class="text-center">
                                    @if (m.IsOnTrack)
                                    {
                                        <span class="badge badge-success">В плане</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">Отставание</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<!-- Основной контент -->
<div class="projects-container">
    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner-wrapper">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3 text-muted">Загрузка проектов...</p>
            </div>
        </div>
    }
    else if (projects == null || !projects.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h3 class="empty-state-title">Нет проектов</h3>
            <p class="empty-state-text">Создайте первый проект для организации ваших финансовых операций</p>
            <button class="btn btn-primary btn-lg" @onclick="ToggleCreateForm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Создать проект
            </button>
        </div>
    }
    else
    {
        <div class="projects-grid">
            @foreach (var proj in projects)
            {
                var stats = projectStats.FirstOrDefault(s => s.ProjectId == proj.Id);
                var profitability = stats != null && stats.TotalIncome > 0 
                    ? ((stats.Profit / stats.TotalIncome) * 100) 
                    : 0;
                var budgetVariance = proj.Budget.HasValue && proj.Budget > 0 && stats != null
                    ? ((stats.TotalExpense / proj.Budget.Value) * 100)
                    : 0;
                var daysRemaining = proj.EndDate.HasValue && proj.Status == ProjectStatus.Active
                    ? (proj.EndDate.Value - DateTime.Today).Days 
                    : (int?)null;

                <div class="project-card" data-animate>
                    <!-- Заголовок карточки со статусом -->
                    <div class="project-header">
                        <div class="project-title-section">
                            <div class="title-row">
                                <h3 class="project-name">@proj.Name</h3>
                                <span class="status-badge status-@proj.Status.ToString().ToLower()">
                                    @GetStatusText(proj.Status)
                                </span>
                            </div>
                            @if (proj.IsDefault)
                            {
                                <span class="project-badge default">По умолчанию</span>
                            }
                            @if (proj.Priority.HasValue)
                            {
                                <span class="priority-badge priority-@proj.Priority.Value.ToString().ToLower()">
                                    @GetPriorityText(proj.Priority.Value)
                                </span>
                            }
                        </div>
                        
                        <div class="project-actions">
                            <button type="button" class="btn btn-sm btn-outline" @onclick="() => OpenDetail(proj.Id)">Подробнее</button>
                            <button class="project-action" @onclick="() => StartEdit(proj)" title="Редактировать" disabled="@(proj.UserId != null && proj.UserId != userId && !proj.IsDefault)">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
                                </svg>
                            </button>
                            @if (!proj.IsDefault)
                            {
                                <button class="project-action delete" @onclick="() => ConfirmDelete(proj.Id)" title="Удалить" disabled="@(proj.UserId != null && proj.UserId != userId)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                    </svg>
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Мета-информация -->
                    <div class="project-meta">
                        @if (!string.IsNullOrWhiteSpace(proj.ProjectManager))
                        {
                            <span class="meta-item">@proj.ProjectManager</span>
                        }
                        @if (proj.StartDate.HasValue)
                        {
                            <span class="meta-item">Начало: @proj.StartDate.Value.ToString("dd.MM.yyyy")</span>
                        }
                        @if (daysRemaining.HasValue && daysRemaining > 0)
                        {
                            <span class="meta-item">@daysRemaining дн. осталось</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(proj.Description))
                    {
                        <p class="project-description">@proj.Description</p>
                    }

                    <!-- Краткая статистика -->
                    @if (stats != null)
                    {
                        <div class="project-stats">
                            <div class="stat-item">
                                <span class="stat-label">Операций</span>
                                <span class="stat-value">@stats.TransactionCount</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Доходы</span>
                                <span class="stat-value positive">+@stats.TotalIncome.ToString("N0") Br</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Расходы</span>
                                <span class="stat-value negative">@stats.TotalExpense.ToString("N0") Br</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Прибыль</span>
                                <span class="stat-value @(stats.Profit >= 0 ? "positive" : "negative")">
                                    @(stats.Profit >= 0 ? "+" : "")@stats.Profit.ToString("N0") Br
                                </span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Факт. ROI</span>
                                <span class="stat-value @(profitability >= 0 ? "positive" : "negative")">
                                    @profitability.ToString("F1")%
                                </span>
                            </div>
                        </div>

                        <!-- Прогресс-бары -->
                        @if (proj.Budget.HasValue && proj.Budget > 0 && stats.TotalExpense > 0)
                        {
                            <div class="progress-section">
                                <div class="progress-label">
                                    <span>Использовано бюджета</span>
                                    <span>@budgetVariance.ToString("F1")%</span>
                                </div>
                                <div class="progress-bar-container">
                                    <div class="progress-bar-fill @(budgetVariance > 100 ? "over-budget" : "")" 
                                         style="width: @Math.Min(budgetVariance, 100)%;"></div>
                                </div>
                            </div>
                        }

                        @if (proj.TargetROI.HasValue && proj.TargetROI > 0 && profitability != 0)
                        {
                            var targetProgress = (profitability / proj.TargetROI.Value) * 100;
                            <div class="progress-section">
                                <div class="progress-label">
                                    <span>Целевой ROI (@proj.TargetROI.Value%)</span>
                                    <span>@targetProgress.ToString("F1")%</span>
                                </div>
                                <div class="progress-bar-container">
                                    <div class="progress-bar-fill target" 
                                         style="width: @Math.Min(targetProgress, 100)%;"></div>
                                </div>
                            </div>
                        }
                    }

                </div>
            }
        </div>
    }
</div>

<ProjectDetailsPanel ProjectId="@_detailProjectId"
                     UserId="@(userId ?? "")"
                     IsOpen="@_detailOpen"
                     OnClose="CloseDetail"
                     OnEdit="EditFromDetail" />

@code {
    private List<Project>? projects;
    private string? userId;
    private bool isLoading = true;
    private bool showCreateForm = false;
    private bool showMessage = false;
    private string message = string.Empty;
    private bool showError = false;
    private string errorMessage = string.Empty;

    private ProjectEditModel newProject = new();
    private int editId = 0;
    private int _detailProjectId;
    private bool _detailOpen;

    private List<ProjectStats> projectStats = new();
    private Dictionary<int, List<CategoryTransaction>> transactionsByCategory = new();
    private List<MiniFinance.Services.ProjectProfitabilityService.DepartmentSummary> departmentSummaries = new();
    private List<MiniFinance.Services.ProjectProfitabilityService.ProjectProfitabilityMetrics> profitabilityMetrics = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("uiEnhance.refresh");
        }
        catch
        {
            // ui.js may not be loaded yet on first paint
        }
    }

    private async Task LoadProjects()
    {
        isLoading = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);

            if (user == null) return;
            userId = await DataScope.GetDataOwnerUserIdAsync(user.Id);

            projects = await DbContext.Projects
                .Where(p => p.UserId == userId || p.IsDefault)
                .OrderBy(p => p.IsDefault ? 0 : 1)
                .ThenBy(p => p.Status == ProjectStatus.Active ? 0 : 1)
                .ThenBy(p => p.Name)
                .ToListAsync();

            // Load statistics for each project
            projectStats = new();
            transactionsByCategory = new();

            foreach (var proj in projects)
            {
                var tx = await DbContext.Transactions
                    .Where(t => t.ProjectId == proj.Id && t.UserId == userId)
                    .ToListAsync();

                projectStats.Add(new ProjectStats
                {
                    ProjectId = proj.Id,
                    ProjectName = proj.Name,
                    TransactionCount = tx.Count,
                    TotalIncome = tx.Where(t => t.Amount > 0).Sum(t => t.Amount),
                    TotalExpense = Math.Abs(tx.Where(t => t.Amount < 0).Sum(t => t.Amount))
                });

                // Group by category
                var catGroups = tx
                    .GroupBy(t => t.Category)
                    .Select(g => new CategoryTransaction
                    {
                        Category = g.Key,
                        Amount = g.Sum(t => t.Amount),
                        Count = g.Count()
                    })
                    .OrderByDescending(c => Math.Abs(c.Amount))
                    .ToList();

                transactionsByCategory[proj.Id] = catGroups;
            }

            var userTransactions = await DbContext.Transactions
                .Where(t => t.UserId == userId)
                .ToListAsync();

            profitabilityMetrics = MiniFinance.Services.ProjectProfitabilityService.ComputeMetrics(projects, userTransactions);
            departmentSummaries = MiniFinance.Services.ProjectProfitabilityService.ComputeDepartmentSummaries(projects, userTransactions);
        }
        catch (Exception ex)
        {
            // Surface the root cause to help debugging (inner exception from EF/SQLite)
            var baseMsg = ex.GetBaseException()?.Message ?? ex.Message;
            errorMessage = $"Ошибка загрузки: {baseMsg}";
            showError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
        if (!showCreateForm)
        {
            CancelForm();
        }
    }

    private void CancelForm()
    {
        newProject = new();
        editId = 0;
        showCreateForm = false;
    }

    private async Task SaveProject()
    {
        if (string.IsNullOrWhiteSpace(newProject.Name))
        {
            errorMessage = "Введите название проекта";
            showError = true;
            return;
        }

        showError = false;
        showMessage = false;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (user == null) return;

            if (editId == 0)
            {
                // Create new: check for name uniqueness per user
                var trimmedName = newProject.Name.Trim();
                if (await DbContext.Projects.AnyAsync(p => p.UserId == userId && p.Name == trimmedName && !p.IsDefault))
                {
                    errorMessage = "У вас уже есть проект с таким названием";
                    showError = true;
                    return;
                }

                var project = new Project
                {
                    Name = newProject.Name.Trim(),
                    Description = newProject.Description,
                    Status = newProject.Status,
                    Budget = newProject.Budget,
                    TargetROI = newProject.TargetROI,
                    StartDate = newProject.StartDate,
                    EndDate = newProject.EndDate,
                    Priority = newProject.Priority,
                    ProjectManager = newProject.ProjectManager,
                    Department = newProject.Department,
                    KPI = newProject.KPI,
                    Risks = newProject.Risks,
                    Notes = newProject.Notes
                };

                project.UserId = userId;
                DbContext.Projects.Add(project);
                message = "Проект создан успешно";
            }
            else
            {
                // Edit existing
                var proj = await DbContext.Projects.FindAsync(editId);
                if (proj == null)
                {
                    errorMessage = "Проект не найден";
                    showError = true;
                    return;
                }

                // Ensure ownership: only owner or default projects editable
                if (proj.UserId != null && proj.UserId != userId && !proj.IsDefault)
                {
                    errorMessage = "Нет прав на редактирование этого проекта";
                    showError = true;
                    return;
                }

                // Check for duplicate name per user
                var trimmedName = newProject.Name.Trim();
                if (proj.Name != trimmedName && 
                    await DbContext.Projects.AnyAsync(p => p.UserId == userId && p.Name == trimmedName && !p.IsDefault))
                {
                    errorMessage = "У вас уже есть проект с таким названием";
                    showError = true;
                    return;
                }

                proj.Name = newProject.Name.Trim();
                proj.Description = newProject.Description;
                proj.Status = newProject.Status;
                proj.Budget = newProject.Budget;
                proj.TargetROI = newProject.TargetROI;
                proj.StartDate = newProject.StartDate;
                proj.EndDate = newProject.EndDate;
                proj.Priority = newProject.Priority;
                proj.ProjectManager = newProject.ProjectManager;
                proj.Department = newProject.Department;
                proj.KPI = newProject.KPI;
                proj.Risks = newProject.Risks;
                proj.Notes = newProject.Notes;
                
                message = "Проект обновлён успешно";
            }

            await DbContext.SaveChangesAsync();
            showMessage = true;
            CancelForm();
            await LoadProjects();
        }
        catch (Exception ex)
        {
            var baseMsg = ex.GetBaseException()?.Message ?? ex.Message;
            errorMessage = $"Ошибка: {baseMsg}";
            showError = true;
        }
    }

    private void StartEdit(Project p)
    {
        editId = p.Id;
        newProject = new ProjectEditModel
        {
            Name = p.Name,
            Description = p.Description,
            Status = p.Status,
            Budget = p.Budget,
            TargetROI = p.TargetROI,
            StartDate = p.StartDate,
            EndDate = p.EndDate,
            Priority = p.Priority,
            ProjectManager = p.ProjectManager,
            Department = p.Department,
            KPI = p.KPI,
            Risks = p.Risks,
            Notes = p.Notes
        };
        showCreateForm = true;
    }

    private async Task ConfirmDelete(int id)
    {
        var hasTx = await DbContext.Transactions.AnyAsync(t => t.ProjectId == id);
        if (hasTx)
        {
            errorMessage = "Нельзя удалить проект с транзакциями. Сначала удалите или переассоциируйте операции.";
            showError = true;
            return;
        }

        var ok = await JS.InvokeAsync<bool>("confirm", "Удалить проект? Это действие нельзя отменить.");
        if (!ok) return;

        await DeleteProject(id);
    }

    private async Task DeleteProject(int id)
    {
        try
        {
            var p = await DbContext.Projects.FindAsync(id);
            if (p == null) return;
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (user == null) return;

            if (p.UserId != null && p.UserId != userId && !p.IsDefault)
            {
                errorMessage = "Нет прав на удаление этого проекта";
                showError = true;
                return;
            }

            DbContext.Projects.Remove(p);
            await DbContext.SaveChangesAsync();
            message = "Проект удалён";
            showMessage = true;
            await LoadProjects();
        }
        catch (Exception ex)
        {
            var baseMsg = ex.GetBaseException()?.Message ?? ex.Message;
            errorMessage = $"Ошибка при удалении: {baseMsg}";
            showError = true;
        }
    }

    private void OpenDetail(int projectId)
    {
        _detailProjectId = projectId;
        _detailOpen = true;
    }

    private void CloseDetail()
    {
        _detailOpen = false;
        _detailProjectId = 0;
    }

    private async Task EditFromDetail(int projectId)
    {
        CloseDetail();
        var proj = projects?.FirstOrDefault(p => p.Id == projectId);
        if (proj != null)
            StartEdit(proj);
        await Task.CompletedTask;
    }

    private string GetStatusText(ProjectStatus status)
    {
        return status switch
        {
            ProjectStatus.Active => "Активный",
            ProjectStatus.Planning => "Планирование",
            ProjectStatus.OnHold => "Приостановлен",
            ProjectStatus.Completed => "Завершен",
            ProjectStatus.Cancelled => "Отменен",
            _ => status.ToString()
        };
    }

    private string GetPriorityText(ProjectPriority priority)
    {
        return priority switch
        {
            ProjectPriority.Low => "Низкий",
            ProjectPriority.Medium => "Средний",
            ProjectPriority.High => "Высокий",
            ProjectPriority.Critical => "Критический",
            _ => priority.ToString()
        };
    }

    private class ProjectStats
    {
        public int ProjectId { get; set; }
        public string ProjectName { get; set; } = string.Empty;
        public int TransactionCount { get; set; }
        public decimal TotalIncome { get; set; }
        public decimal TotalExpense { get; set; }
        public decimal Profit => TotalIncome - TotalExpense;
    }

    private class CategoryTransaction
    {
        public string Category { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public int Count { get; set; }
    }

    private class ProjectEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public ProjectStatus Status { get; set; } = ProjectStatus.Planning;
        public decimal? Budget { get; set; }
        public decimal? TargetROI { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public ProjectPriority? Priority { get; set; }
        public string? ProjectManager { get; set; }
        public string? Department { get; set; }
        public string? KPI { get; set; }
        public string? Risks { get; set; }
        public string? Notes { get; set; }
    }
}
@page "/projects"
@rendermode InteractiveServer
@using MiniFinance.Data.Models
@using MiniFinance.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject ApplicationDbContext DbContext
@inject IJSRuntime JS
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>Проекты - MiniFinance</PageTitle>

<!-- Заголовок с навигацией -->
<div class="page-header">
    <div class="page-header-left">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Главная</a></li>
                <li class="breadcrumb-item active" aria-current="page">Проекты</li>
            </ol>
        </nav>
        <h1 class="page-title">Проекты</h1>
        <p class="page-subtitle">Управление проектами, отслеживание рентабельности и ключевых метрик</p>
    </div>
    <div class="page-header-right">
        <button class="btn btn-outline" @onclick="LoadProjects" title="Обновить данные">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M23 4v6h-6M1 20v-6h6"/>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
            </svg>
            <span class="btn-text">Обновить</span>
        </button>
        <button class="btn btn-primary" @onclick="ToggleCreateForm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            <span class="btn-text">Новый проект</span>
        </button>
    </div>
</div>

<!-- Уведомления -->
@if (showMessage)
{
    <div class="notification success animate-slide-down">
        <div class="notification-icon">✅</div>
        <div class="notification-content">
            <strong>Успешно!</strong>
            <p>@message</p>
        </div>
        <button class="notification-close" @onclick="() => showMessage = false">✕</button>
    </div>
}

@if (showError)
{
    <div class="notification error animate-slide-down">
        <div class="notification-icon">❌</div>
        <div class="notification-content">
            <strong>Ошибка!</strong>
            <p>@errorMessage</p>
        </div>
        <button class="notification-close" @onclick="() => showError = false">✕</button>
    </div>
}

<!-- Форма создания/редактирования проекта -->
@if (showCreateForm)
{
    <div class="modal-overlay" @onclick="CancelForm">
        <div class="modal-content modal-lg" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(editId == 0 ? "Создание проекта" : "Редактирование проекта")</h3>
                <button class="modal-close" @onclick="CancelForm">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Название проекта <span class="required">*</span></label>
                        <input class="form-input" 
                               placeholder="Введите название проекта" 
                               @bind="newProject.Name"
                               @bind:event="oninput" />
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Статус проекта</label>
                        <select class="form-select" @bind="newProject.Status">
                            <option value="@ProjectStatus.Planning">Планирование</option>
                            <option value="@ProjectStatus.Active">Активный</option>
                            <option value="@ProjectStatus.OnHold">Приостановлен</option>
                            <option value="@ProjectStatus.Completed">Завершен</option>
                            <option value="@ProjectStatus.Cancelled">Отменен</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Бюджет проекта (₽)</label>
                        <input type="number" class="form-input" 
                               placeholder="Плановый бюджет" 
                               @bind="newProject.Budget" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Плановая доходность (%)</label>
                        <input type="number" class="form-input" 
                               placeholder="Ожидаемая ROI" 
                               @bind="newProject.TargetROI" 
                               step="0.1" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Дата начала</label>
                        <input type="date" class="form-input" @bind="newProject.StartDate" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Дата завершения</label>
                        <input type="date" class="form-input" @bind="newProject.EndDate" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Приоритет</label>
                        <select class="form-select" @bind="newProject.Priority">
                            <option value="">Не указан</option>
                            <option value="@ProjectPriority.Low">Низкий</option>
                            <option value="@ProjectPriority.Medium">Средний</option>
                            <option value="@ProjectPriority.High">Высокий</option>
                            <option value="@ProjectPriority.Critical">Критический</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Менеджер проекта</label>
                        <input class="form-input" 
                               placeholder="ФИО менеджера" 
                               @bind="newProject.ProjectManager" />
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">Описание проекта</label>
                        <textarea class="form-input" 
                                  placeholder="Опишите цели, задачи и особенности проекта"
                                  @bind="newProject.Description"
                                  rows="3"></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">Ключевые показатели (KPI)</label>
                        <textarea class="form-input" 
                                  placeholder="Например: увеличение продаж на 20%, снижение затрат на 15%"
                                  @bind="newProject.KPI"
                                  rows="2"></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">Риски проекта</label>
                        <textarea class="form-input" 
                                  placeholder="Опишите потенциальные риски"
                                  @bind="newProject.Risks"
                                  rows="2"></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">Заметки / Комментарии</label>
                        <textarea class="form-input" 
                                  placeholder="Дополнительная информация"
                                  @bind="newProject.Notes"
                                  rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CancelForm">Отмена</button>
                <button class="btn btn-primary" @onclick="SaveProject">
                    @(editId == 0 ? "Создать проект" : "Сохранить изменения")
                </button>
            </div>
        </div>
    </div>
}

<!-- Дашборд сводной статистики -->
@if (projects != null && projects.Any())
{
    var totalBudget = projects.Sum(p => p.Budget ?? 0);
    var totalActualCost = projectStats.Sum(s => s.TotalExpense);
    var totalActualIncome = projectStats.Sum(s => s.TotalIncome);
    var activeProjects = projects.Count(p => p.Status == ProjectStatus.Active);
    var completedProjects = projects.Count(p => p.Status == ProjectStatus.Completed);

    <div class="dashboard-stats">
        <div class="stat-card">
            <div class="stat-icon">📊</div>
            <div class="stat-content">
                <div class="stat-label">Всего проектов</div>
                <div class="stat-value">@projects.Count</div>
                <div class="stat-trend">
                    <span class="trend-badge">@activeProjects активных</span>
                    <span class="trend-badge">@completedProjects завершено</span>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💰</div>
            <div class="stat-content">
                <div class="stat-label">Общий бюджет</div>
                <div class="stat-value">@totalBudget.ToString("N0") ₽</div>
                <div class="stat-trend">Плановый</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">📈</div>
            <div class="stat-content">
                <div class="stat-label">Факт. доходы</div>
                <div class="stat-value positive">+@totalActualIncome.ToString("N0") ₽</div>
                <div class="stat-trend">За все время</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">📉</div>
            <div class="stat-content">
                <div class="stat-label">Факт. расходы</div>
                <div class="stat-value negative">-@totalActualCost.ToString("N0") ₽</div>
                <div class="stat-trend">За все время</div>
            </div>
        </div>
    </div>
}

<!-- Основной контент -->
<div class="projects-container">
    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner-wrapper">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3 text-muted">Загрузка проектов...</p>
            </div>
        </div>
    }
    else if (projects == null || !projects.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">📁</div>
            <h3 class="empty-state-title">Нет проектов</h3>
            <p class="empty-state-text">Создайте первый проект для организации ваших финансовых операций</p>
            <button class="btn btn-primary btn-lg" @onclick="ToggleCreateForm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Создать проект
            </button>
        </div>
    }
    else
    {
        <div class="projects-grid">
            @foreach (var proj in projects)
            {
                var stats = projectStats.FirstOrDefault(s => s.ProjectId == proj.Id);
                var profitability = stats != null && stats.TotalIncome > 0 
                    ? ((stats.Profit / stats.TotalIncome) * 100) 
                    : 0;
                var budgetVariance = proj.Budget.HasValue && proj.Budget > 0 && stats != null
                    ? ((stats.TotalExpense / proj.Budget.Value) * 100)
                    : 0;
                var daysRemaining = proj.EndDate.HasValue && proj.Status == ProjectStatus.Active
                    ? (proj.EndDate.Value - DateTime.Today).Days 
                    : (int?)null;

                <div class="project-card @(expandedProjectId == proj.Id ? "expanded" : "")">
                    <!-- Заголовок карточки со статусом -->
                    <div class="project-header">
                        <div class="project-title-section">
                            <div class="title-row">
                                <h3 class="project-name">@proj.Name</h3>
                                <span class="status-badge status-@proj.Status.ToString().ToLower()">
                                    @GetStatusText(proj.Status)
                                </span>
                            </div>
                            @if (proj.IsDefault)
                            {
                                <span class="project-badge default">По умолчанию</span>
                            }
                            @if (proj.Priority.HasValue)
                            {
                                <span class="priority-badge priority-@proj.Priority.Value.ToString().ToLower()">
                                    @GetPriorityText(proj.Priority.Value)
                                </span>
                            }
                        </div>
                        
                        <div class="project-actions">
                            <button class="project-action" @onclick="() => ExpandProject(proj.Id)" 
                                    title="@(expandedProjectId == proj.Id ? "Скрыть детали" : "Показать детали")">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    @if (expandedProjectId == proj.Id)
                                    {
                                        <polyline points="18 15 12 9 6 15"/>
                                    }
                                    else
                                    {
                                        <polyline points="6 9 12 15 18 9"/>
                                    }
                                </svg>
                            </button>
                            <button class="project-action" @onclick="() => StartEdit(proj)" title="Редактировать">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
                                </svg>
                            </button>
                            @if (!proj.IsDefault)
                            {
                                <button class="project-action delete" @onclick="() => ConfirmDelete(proj.Id)" title="Удалить">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                    </svg>
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Мета-информация -->
                    <div class="project-meta">
                        @if (!string.IsNullOrWhiteSpace(proj.ProjectManager))
                        {
                            <span class="meta-item">👤 @proj.ProjectManager</span>
                        }
                        @if (proj.StartDate.HasValue)
                        {
                            <span class="meta-item">📅 Начало: @proj.StartDate.Value.ToString("dd.MM.yyyy")</span>
                        }
                        @if (daysRemaining.HasValue && daysRemaining > 0)
                        {
                            <span class="meta-item">⏳ Осталось: @daysRemaining дн.</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(proj.Description))
                    {
                        <p class="project-description">@proj.Description</p>
                    }

                    <!-- Краткая статистика -->
                    @if (stats != null)
                    {
                        <div class="project-stats">
                            <div class="stat-item">
                                <span class="stat-label">Операций</span>
                                <span class="stat-value">@stats.TransactionCount</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Доходы</span>
                                <span class="stat-value positive">+@stats.TotalIncome.ToString("N0") ₽</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Расходы</span>
                                <span class="stat-value negative">@stats.TotalExpense.ToString("N0") ₽</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Прибыль</span>
                                <span class="stat-value @(stats.Profit >= 0 ? "positive" : "negative")">
                                    @(stats.Profit >= 0 ? "+" : "")@stats.Profit.ToString("N0") ₽
                                </span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Факт. ROI</span>
                                <span class="stat-value @(profitability >= 0 ? "positive" : "negative")">
                                    @profitability.ToString("F1")%
                                </span>
                            </div>
                        </div>

                        <!-- Прогресс-бары -->
                        @if (proj.Budget.HasValue && proj.Budget > 0 && stats.TotalExpense > 0)
                        {
                            <div class="progress-section">
                                <div class="progress-label">
                                    <span>Использовано бюджета</span>
                                    <span>@budgetVariance.ToString("F1")%</span>
                                </div>
                                <div class="progress-bar-container">
                                    <div class="progress-bar-fill @(budgetVariance > 100 ? "over-budget" : "")" 
                                         style="width: @Math.Min(budgetVariance, 100)%;"></div>
                                </div>
                            </div>
                        }

                        @if (proj.TargetROI.HasValue && proj.TargetROI > 0 && profitability != 0)
                        {
                            var targetProgress = (profitability / proj.TargetROI.Value) * 100;
                            <div class="progress-section">
                                <div class="progress-label">
                                    <span>Целевой ROI (@proj.TargetROI.Value%)</span>
                                    <span>@targetProgress.ToString("F1")%</span>
                                </div>
                                <div class="progress-bar-container">
                                    <div class="progress-bar-fill target" 
                                         style="width: @Math.Min(targetProgress, 100)%;"></div>
                                </div>
                            </div>
                        }
                    }

                    <!-- Детальная информация (разворачивается) -->
                    @if (expandedProjectId == proj.Id && stats != null)
                    {
                        <div class="project-details">
                            <div class="details-grid">
                                <!-- Финансовые метрики -->
                                <div class="metrics-grid">
                                    <div class="metric-card">
                                        <div class="metric-label">Средняя операция</div>
                                        <div class="metric-value">
                                            @(stats.TransactionCount > 0 
                                                ? ((stats.TotalIncome + Math.Abs(stats.TotalExpense)) / stats.TransactionCount).ToString("N0") 
                                                : "0") ₽
                                        </div>
                                    </div>
                                    <div class="metric-card">
                                        <div class="metric-label">ROI (Возврат)</div>
                                        <div class="metric-value @(stats.TotalExpense > 0 && (stats.TotalIncome / stats.TotalExpense) >= 1 ? "positive" : "negative")">
                                            @(stats.TotalExpense > 0 ? (stats.TotalIncome / stats.TotalExpense).ToString("F2") : "N/A")x
                                        </div>
                                    </div>
                                    <div class="metric-card">
                                        <div class="metric-label">Маржа</div>
                                        <div class="metric-value @(stats.TotalIncome > 0 && stats.Profit >= 0 ? "positive" : "negative")">
                                            @(stats.TotalIncome > 0 ? (stats.Profit / stats.TotalIncome * 100).ToString("F1") : "0")%
                                        </div>
                                    </div>
                                </div>

                                <!-- KPI и риски -->
                                @if (!string.IsNullOrWhiteSpace(proj.KPI) || !string.IsNullOrWhiteSpace(proj.Risks))
                                {
                                    <div class="info-grid">
                                        @if (!string.IsNullOrWhiteSpace(proj.KPI))
                                        {
                                            <div class="info-card">
                                                <div class="info-title">🎯 Ключевые показатели</div>
                                                <div class="info-content">@proj.KPI</div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(proj.Risks))
                                        {
                                            <div class="info-card">
                                                <div class="info-title">⚠️ Риски проекта</div>
                                                <div class="info-content">@proj.Risks</div>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Заметки -->
                                @if (!string.IsNullOrWhiteSpace(proj.Notes))
                                {
                                    <div class="notes-section">
                                        <div class="notes-title">📝 Заметки</div>
                                        <div class="notes-content">@proj.Notes</div>
                                    </div>
                                }

                                <!-- Категории операций -->
                                @if (transactionsByCategory.ContainsKey(proj.Id) && transactionsByCategory[proj.Id].Any())
                                {
                                    <div class="categories-section">
                                        <h4 class="section-title">Операции по категориям</h4>
                                        <div class="categories-list">
                                            @foreach (var cat in transactionsByCategory[proj.Id].Take(5))
                                            {
                                                <div class="category-item">
                                                    <div class="category-info">
                                                        <span class="category-name">@cat.Category</span>
                                                        <span class="category-count">@cat.Count оп.</span>
                                                    </div>
                                                    <div class="category-amount @(cat.Amount >= 0 ? "positive" : "negative")">
                                                        @(cat.Amount >= 0 ? "+" : "")@cat.Amount.ToString("N0") ₽
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Project>? projects;
    private bool isLoading = true;
    private bool showCreateForm = false;
    private bool showMessage = false;
    private string message = string.Empty;
    private bool showError = false;
    private string errorMessage = string.Empty;

    private ProjectEditModel newProject = new();
    private int editId = 0;
    private int? expandedProjectId = null;

    private List<ProjectStats> projectStats = new();
    private Dictionary<int, List<CategoryTransaction>> transactionsByCategory = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        isLoading = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);

            if (user == null) return;

            projects = await DbContext.Projects
                .OrderBy(p => p.IsDefault ? 0 : 1)
                .ThenBy(p => p.Status == ProjectStatus.Active ? 0 : 1)
                .ThenBy(p => p.Name)
                .ToListAsync();

            // Load statistics for each project
            projectStats = new();
            transactionsByCategory = new();

            foreach (var proj in projects)
            {
                var tx = await DbContext.Transactions
                    .Where(t => t.ProjectId == proj.Id && t.UserId == user.Id)
                    .ToListAsync();

                projectStats.Add(new ProjectStats
                {
                    ProjectId = proj.Id,
                    ProjectName = proj.Name,
                    TransactionCount = tx.Count,
                    TotalIncome = tx.Where(t => t.Amount > 0).Sum(t => t.Amount),
                    TotalExpense = Math.Abs(tx.Where(t => t.Amount < 0).Sum(t => t.Amount))
                });

                // Group by category
                var catGroups = tx
                    .GroupBy(t => t.Category)
                    .Select(g => new CategoryTransaction
                    {
                        Category = g.Key,
                        Amount = g.Sum(t => t.Amount),
                        Count = g.Count()
                    })
                    .OrderByDescending(c => Math.Abs(c.Amount))
                    .ToList();

                transactionsByCategory[proj.Id] = catGroups;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки: {ex.Message}";
            showError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
        if (!showCreateForm)
        {
            CancelForm();
        }
    }

    private void CancelForm()
    {
        newProject = new();
        editId = 0;
        showCreateForm = false;
    }

    private async Task SaveProject()
    {
        if (string.IsNullOrWhiteSpace(newProject.Name))
        {
            errorMessage = "Введите название проекта";
            showError = true;
            return;
        }

        showError = false;
        showMessage = false;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (user == null) return;

            if (editId == 0)
            {
                // Create new
                if (await DbContext.Projects.AnyAsync(p => p.Name == newProject.Name.Trim()))
                {
                    errorMessage = "Проект с таким названием уже существует";
                    showError = true;
                    return;
                }

                var project = new Project
                {
                    Name = newProject.Name.Trim(),
                    Description = newProject.Description,
                    Status = newProject.Status,
                    Budget = newProject.Budget,
                    TargetROI = newProject.TargetROI,
                    StartDate = newProject.StartDate,
                    EndDate = newProject.EndDate,
                    Priority = newProject.Priority,
                    ProjectManager = newProject.ProjectManager,
                    KPI = newProject.KPI,
                    Risks = newProject.Risks,
                    Notes = newProject.Notes
                };

                DbContext.Projects.Add(project);
                message = "✅ Проект создан успешно";
            }
            else
            {
                // Edit existing
                var proj = await DbContext.Projects.FindAsync(editId);
                if (proj == null)
                {
                    errorMessage = "Проект не найден";
                    showError = true;
                    return;
                }

                // Check for duplicate name
                if (proj.Name != newProject.Name.Trim() && 
                    await DbContext.Projects.AnyAsync(p => p.Name == newProject.Name.Trim()))
                {
                    errorMessage = "Проект с таким названием уже существует";
                    showError = true;
                    return;
                }

                proj.Name = newProject.Name.Trim();
                proj.Description = newProject.Description;
                proj.Status = newProject.Status;
                proj.Budget = newProject.Budget;
                proj.TargetROI = newProject.TargetROI;
                proj.StartDate = newProject.StartDate;
                proj.EndDate = newProject.EndDate;
                proj.Priority = newProject.Priority;
                proj.ProjectManager = newProject.ProjectManager;
                proj.KPI = newProject.KPI;
                proj.Risks = newProject.Risks;
                proj.Notes = newProject.Notes;
                
                message = "✅ Проект обновлён успешно";
            }

            await DbContext.SaveChangesAsync();
            showMessage = true;
            CancelForm();
            await LoadProjects();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
            showError = true;
        }
    }

    private void StartEdit(Project p)
    {
        editId = p.Id;
        newProject = new ProjectEditModel
        {
            Name = p.Name,
            Description = p.Description,
            Status = p.Status,
            Budget = p.Budget,
            TargetROI = p.TargetROI,
            StartDate = p.StartDate,
            EndDate = p.EndDate,
            Priority = p.Priority,
            ProjectManager = p.ProjectManager,
            KPI = p.KPI,
            Risks = p.Risks,
            Notes = p.Notes
        };
        showCreateForm = true;
    }

    private async Task ConfirmDelete(int id)
    {
        var hasTx = await DbContext.Transactions.AnyAsync(t => t.ProjectId == id);
        if (hasTx)
        {
            errorMessage = "Нельзя удалить проект с транзакциями. Сначала удалите или переассоциируйте операции.";
            showError = true;
            return;
        }

        var ok = await JS.InvokeAsync<bool>("confirm", "Удалить проект? Это действие нельзя отменить.");
        if (!ok) return;

        await DeleteProject(id);
    }

    private async Task DeleteProject(int id)
    {
        try
        {
            var p = await DbContext.Projects.FindAsync(id);
            if (p == null) return;

            DbContext.Projects.Remove(p);
            await DbContext.SaveChangesAsync();
            message = "✅ Проект удалён";
            showMessage = true;
            await LoadProjects();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка при удалении: {ex.Message}";
            showError = true;
        }
    }

    private void ExpandProject(int projectId)
    {
        expandedProjectId = expandedProjectId == projectId ? null : projectId;
    }

    private string GetStatusText(ProjectStatus status)
    {
        return status switch
        {
            ProjectStatus.Active => "Активный",
            ProjectStatus.Planning => "Планирование",
            ProjectStatus.OnHold => "Приостановлен",
            ProjectStatus.Completed => "Завершен",
            ProjectStatus.Cancelled => "Отменен",
            _ => status.ToString()
        };
    }

    private string GetPriorityText(ProjectPriority priority)
    {
        return priority switch
        {
            ProjectPriority.Low => "Низкий",
            ProjectPriority.Medium => "Средний",
            ProjectPriority.High => "Высокий",
            ProjectPriority.Critical => "Критический",
            _ => priority.ToString()
        };
    }


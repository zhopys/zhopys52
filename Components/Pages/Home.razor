@page "/"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using MiniFinance.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MiniFinance.Data.Models
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject IForecastingService ForecastingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Главная — MiniFinance</PageTitle>

<AuthorizeView Context="authContext">
    <Authorized>
        <div class="dashboard">
            <header class="dashboard-header">
                <div>
                    <h1>Обзор капитала</h1>
                    <div class="dashboard-meta">
                        <span class="live-pill">Live</span>
                        <span>@DateTime.Now.ToString("dd MMMM yyyy · HH:mm", new System.Globalization.CultureInfo("ru-RU"))</span>
                    </div>
                </div>
                <div class="page-actions">
                    <a href="/transactions/create" class="btn btn-primary">
                        <span>+</span> Новая операция
                    </a>
                </div>
            </header>

            @if (isLoading)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                </div>
            }
            else
            {
                @if (cashGaps.Any())
                {
                    <div class="alert-glass">
                        <span class="alert-glass-icon" aria-hidden="true">⚠</span>
                        <div style="flex: 1">
                            <div class="fw-bold">Риск кассового разрыва</div>
                            <div class="small text-muted">Ближайший дефицит — @cashGaps.First().StartDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <a href="/cash-forecast" class="btn btn-sm btn-danger">Подробнее</a>
                    </div>
                }

                <section class="capital-monitor" aria-label="Статус капитала">
                    <div class="capital-monitor-inner">
                        <div class="capital-monitor-top">
                            <div>
                                <p class="capital-label">Общий капитал</p>
                                <div class="capital-value @(balance >= 0 ? "positive" : "text-danger")">
                                    @(balance >= 0 ? "" : "−")@Math.Abs(balance).ToString("N0")
                                    <span class="capital-currency">Br</span>
                                </div>
                            </div>
                            <span class="live-pill">Обновлено сейчас</span>
                        </div>
                        <div class="capital-stats">
                            <div>
                                <div class="capital-stat-label">Доход за месяц</div>
                                <div class="capital-stat-value text-success">+@CurrentMonthIncome.ToString("N0") <small class="text-muted">Br</small></div>
                            </div>
                            <div>
                                <div class="capital-stat-label">Расход за месяц</div>
                                <div class="capital-stat-value text-danger">@CurrentMonthExpense.ToString("N0") <small class="text-muted">Br</small></div>
                            </div>
                            <div>
                                <div class="capital-stat-label">Чистый поток</div>
                                <div class="capital-stat-value @(monthNet >= 0 ? "text-success" : "text-danger")">
                                    @(monthNet >= 0 ? "+" : "")@monthNet.ToString("N0") <small class="text-muted">Br</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="dashboard-kpi-row">
                    <div class="dashboard-kpi accent-teal">
                        <div class="kpi-label">Операций за месяц</div>
                        <div class="kpi-value">@monthTransactionCount</div>
                    </div>
                    <div class="dashboard-kpi accent-blue">
                        <div class="kpi-label">Средняя операция</div>
                        <div class="kpi-value" style="font-size: 22px;">@avgTransaction.ToString("N0") <small class="text-muted" style="font-size: 14px">Br</small></div>
                    </div>
                    <div class="dashboard-kpi accent-rose">
                        <div class="kpi-label">Прогноз риска</div>
                        <div class="kpi-value @(cashGaps.Any() ? "text-danger" : "text-success")" style="font-size: 22px;">
                            @(cashGaps.Any() ? "Есть" : "Нет")
                        </div>
                    </div>
                </div>

                <div class="dashboard-grid">
                    <div style="min-width: 0;">
                        @if (monthlyData.Any())
                        {
                            <div class="card chart-panel mb-4">
                                <div class="card-header">
                                    <span>Динамика прибыли</span>
                                    <div class="chart-legend">
                                        <span class="chart-legend-item"><span class="chart-legend-dot teal"></span> Прибыль</span>
                                        <span class="chart-legend-item"><span class="chart-legend-dot blue"></span> Доход</span>
                                    </div>
                                </div>
                                <div class="chart-canvas-wrap">
                                    <canvas id="profitChart" aria-label="График динамики прибыли"></canvas>
                                </div>
                            </div>
                        }

                        <div class="card glass-card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>Последние транзакции</span>
                                <a href="/transactions" class="btn btn-ghost btn-sm">Все →</a>
                            </div>
                            <div class="table-responsive tx-table">
                                <table class="table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Дата</th>
                                            <th>Контрагент</th>
                                            <th class="text-end">Сумма</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in recentTransactions)
                                        {
                                            <tr>
                                                <td class="small text-muted">@t.Date.ToString("dd.MM")</td>
                                                <td>
                                                    <div class="fw-bold">@(string.IsNullOrEmpty(t.Counterparty) ? "—" : t.Counterparty)</div>
                                                    <div class="small text-muted">@t.Description</div>
                                                </td>
                                                <td class="text-end tx-amount @(t.Amount >= 0 ? "text-success" : "text-danger")">
                                                    @(t.Amount >= 0 ? "+" : "")@t.Amount.ToString("N2")
                                                </td>
                                            </tr>
                                        }
                                        @if (!recentTransactions.Any())
                                        {
                                            <tr><td colspan="3" class="text-center py-4 text-muted">Нет операций</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="side-stack">
                        <div class="card glass-card" style="@(upcomingTaxes.Any() ? "border-left: 3px solid var(--warning)" : "")">
                            <div class="card-header">Налоги к оплате</div>
                            <div class="card-body p-0">
                                @foreach (var tax in upcomingTaxes.Take(4))
                                {
                                    <div class="tax-row">
                                        <div>
                                            <div class="fw-bold small">@tax.Name</div>
                                            <div class="small text-muted">до @tax.DueDate.ToString("dd.MM.yyyy")</div>
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-bold">@tax.Amount.ToString("N0") Br</div>
                                            <a href="/taxes" class="small" style="color: var(--accent)">Оплатить</a>
                                        </div>
                                    </div>
                                }
                                @if (!upcomingTaxes.Any())
                                {
                                    <div class="p-3 text-center small text-muted">Налогов не запланировано</div>
                                }
                            </div>
                        </div>

                        <div class="cta-glass">
                            <div class="cta-icon" aria-hidden="true">◈</div>
                            <h4 class="mb-2" style="font-size: 16px; font-weight: 600;">Финансовая аналитика</h4>
                            <p class="small text-muted mb-3">Рентабельность, тренды и прогноз кассовых разрывов в реальном времени.</p>
                            <a href="/analytics" class="btn btn-primary w-100">Открыть аналитику</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool isLoading = true;
    private List<Transaction> transactions = new();
    private List<Transaction> recentTransactions = new();
    private List<MonthlyDataPoint> monthlyData = new();
    private List<CashGap> cashGaps = new();
    private List<TaxPayment> upcomingTaxes = new();

    private decimal CurrentMonthIncome => transactions
        .Where(t => t.Date.Year == DateTime.Today.Year && t.Date.Month == DateTime.Today.Month && t.Amount > 0)
        .Sum(t => t.Amount);

    private decimal CurrentMonthExpense => transactions
        .Where(t => t.Date.Year == DateTime.Today.Year && t.Date.Month == DateTime.Today.Month && t.Amount < 0)
        .Sum(t => t.Amount);

    private decimal balance => transactions.Sum(t => t.Amount);
    private decimal monthNet => CurrentMonthIncome + CurrentMonthExpense;
    private int monthTransactionCount => transactions.Count(t => t.Date.Year == DateTime.Today.Year && t.Date.Month == DateTime.Today.Month);
    private decimal avgTransaction => monthTransactionCount > 0
        ? Math.Abs(transactions.Where(t => t.Date.Year == DateTime.Today.Year && t.Date.Month == DateTime.Today.Month).Average(t => t.Amount))
        : 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            transactions = await DbContext.Transactions
                .Where(t => t.UserId == user.Id)
                .OrderByDescending(t => t.Date)
                .ToListAsync();

            recentTransactions = transactions.Take(6).ToList();

            var ruCulture = new System.Globalization.CultureInfo("ru-RU");
            for (int i = 5; i >= 0; i--)
            {
                var month = DateTime.Today.AddMonths(-i);
                var monthTx = transactions.Where(t => t.Date.Year == month.Year && t.Date.Month == month.Month).ToList();
                var income = monthTx.Where(t => t.Amount > 0).Sum(t => t.Amount);
                var expense = Math.Abs(monthTx.Where(t => t.Amount < 0).Sum(t => t.Amount));
                monthlyData.Add(new MonthlyDataPoint
                {
                    Label = month.ToString("MMM", ruCulture),
                    Value = monthTx.Sum(t => t.Amount),
                    Income = income,
                    Expense = expense
                });
            }

            var reminders = await DbContext.Reminders.Where(r => r.UserId == user.Id).ToListAsync();
            var confirmedTx = transactions.Where(t => t.IsConfirmed).ToList();
            cashGaps = ForecastingService.DetectCashGaps(confirmedTx, reminders, 90, 0);

            upcomingTaxes = await DbContext.TaxPayments
                .Where(t => t.UserId == user.Id && !t.IsPaid && t.DueDate >= DateTime.Today)
                .OrderBy(t => t.DueDate)
                .ToListAsync();
        }

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && monthlyData.Any())
        {
            await RenderProfitChart();
        }
    }

    private async Task RenderProfitChart()
    {
        try
        {
            var labels = monthlyData.Select(m => m.Label).ToArray();
            var profit = monthlyData.Select(m => (double)m.Value).ToArray();
            var income = monthlyData.Select(m => (double)m.Income).ToArray();
            var expense = monthlyData.Select(m => (double)m.Expense).ToArray();
            await JS.InvokeVoidAsync("dashboardCharts.renderProfitChart", "profitChart", labels, profit, income, expense);
        }
        catch { }
    }

    private class MonthlyDataPoint
    {
        public string Label { get; set; } = string.Empty;
        public decimal Value { get; set; }
        public decimal Income { get; set; }
        public decimal Expense { get; set; }
    }
}

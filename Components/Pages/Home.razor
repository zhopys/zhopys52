@page "/"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using MiniFinance.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MiniFinance.Data.Models
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject IForecastingService ForecastingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>Главная — MiniFinance</PageTitle>

<div class="main">
    <AuthorizeView Context="authContext">
        <Authorized>
            <div class="page-header">
                <div class="title">
                    <h1>Обзор</h1>
                    <div class="meta">@DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</div>
                </div>
                <div class="page-actions">
                    <a href="/transactions/create" class="btn btn-primary">
                        <span>+</span> Новая операция
                    </a>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                </div>
            }
            else
            {
                @if (cashGaps.Any())
                {
                    <div class="alert alert-danger d-flex align-items-center mb-4">
                        <div style="font-size: 1.5rem; margin-right: 12px;">⚠️</div>
                        <div style="flex: 1">
                            <div class="fw-bold">Внимание: Риск кассового разрыва</div>
                            <div class="small">Ближайший дефицит ожидается @cashGaps.First().StartDate.ToString("dd MMM").</div>
                        </div>
                        <a href="/cash-forecast" class="btn btn-sm btn-danger text-white">Подробнее</a>
                    </div>
                }

                <div class="kpi-grid mb-4">
                    <div class="kpi-card">
                        <div class="kpi-label">Общий баланс</div>
                        <div class="kpi-value @(balance >= 0 ? "text-success" : "text-danger")">
                            @balance.ToString("N0") <small class="text-muted">Br</small>
                        </div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-label">Доход за месяц</div>
                        <div class="kpi-value text-success">
                            +@CurrentMonthIncome.ToString("N0") <small style="font-size: 14px">Br</small>
                        </div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-label">Расход за месяц</div>
                        <div class="kpi-value text-danger">
                            -@Math.Abs(CurrentMonthExpense).ToString("N0") <small style="font-size: 14px">Br</small>
                        </div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px;">
                    <div style="min-width: 0;">
                        @if (monthlyData.Any())
                        {
                            <div class="card mb-4">
                                <div class="card-header">Динамика (последние 6 месяцев)</div>
                                <div class="card-body">
                                    <div class="chart-bar-container">
                                        @foreach (var m in monthlyData)
                                        {
                                            var maxVal = monthlyData.Max(x => Math.Abs(x.Value));
                                            var height = maxVal > 0 ? (int)(Math.Abs(m.Value) / maxVal * 120) : 0;
                                            <div class="chart-bar">
                                                <div class="chart-bar-fill @(m.Value >= 0 ? "income" : "expense")" 
                                                     style="height:@(height + 2)px" 
                                                     title="@m.Value.ToString("N0") Br"></div>
                                                <div class="chart-bar-label">@m.Label</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>Последние транзакции</span>
                                <a href="/transactions" class="btn btn-ghost btn-sm">Все</a>
                            </div>
                            <div class="table-responsive">
                                <table class="table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Дата</th>
                                            <th>Контрагент / Описание</th>
                                            <th class="text-end">Сумма</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in recentTransactions)
                                        {
                                            <tr>
                                                <td class="small text-muted">@t.Date.ToString("dd.MM")</td>
                                                <td>
                                                    <div class="fw-bold">@(string.IsNullOrEmpty(t.Counterparty) ? "—" : t.Counterparty)</div>
                                                    <div class="small text-muted">@t.Description</div>
                                                </td>
                                                <td class="text-end fw-bold @(t.Amount >= 0 ? "text-success" : "text-danger")">
                                                    @(t.Amount >= 0 ? "+" : "")@t.Amount.ToString("N2")
                                                </td>
                                            </tr>
                                        }
                                        @if (!recentTransactions.Any())
                                        {
                                            <tr><td colspan="3" class="text-center py-4 text-muted">Нет операций</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="card mb-4" style="@(upcomingTaxes.Any() ? "border-left: 3px solid var(--warning)" : "")">
                            <div class="card-header">Налоги к оплате</div>
                            <div class="card-body p-0">
                                @foreach (var tax in upcomingTaxes.Take(4))
                                {
                                    <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold small">@tax.Name</div>
                                            <div class="small text-muted">до @tax.DueDate.ToString("dd.MM.yyyy")</div>
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-bold">@tax.Amount.ToString("N0") Br</div>
                                            <a href="/taxes" class="small text-accent">Оплатить</a>
                                        </div>
                                    </div>
                                }
                                @if (!upcomingTaxes.Any())
                                {
                                    <div class="p-3 text-center small text-muted">Налогов не запланировано</div>
                                }
                            </div>
                        </div>

                        <div class="card" style="background: var(--surface-hover); border: none;">
                            <div class="card-body text-center p-4">
                                <div style="font-size: 2rem; margin-bottom: 8px;">📊</div>
                                <h4 class="mb-2">Аналитика роста</h4>
                                <p class="small text-muted mb-3">Узнайте, насколько эффективно масштабируется ваш бизнес.</p>
                                <a href="/insights" class="btn btn-outline w-100">Открыть отчет</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private bool isLoading = true;
    private List<Transaction> transactions = new();
    private List<Transaction> recentTransactions = new();
    private List<MonthlyDataPoint> monthlyData = new();
    private List<CashGap> cashGaps = new();
    private List<TaxPayment> upcomingTaxes = new();

    private decimal CurrentMonthIncome => transactions
        .Where(t => t.Date.Year == DateTime.Today.Year && t.Date.Month == DateTime.Today.Month && t.Amount > 0)
        .Sum(t => t.Amount);

    private decimal CurrentMonthExpense => transactions
        .Where(t => t.Date.Year == DateTime.Today.Year && t.Date.Month == DateTime.Today.Month && t.Amount < 0)
        .Sum(t => t.Amount);

    private decimal balance => transactions.Sum(t => t.Amount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            transactions = await DbContext.Transactions
                .Where(t => t.UserId == user.Id)
                .OrderByDescending(t => t.Date)
                .ToListAsync();

            recentTransactions = transactions.Take(6).ToList();

            // Динамика за 6 месяцев
            var ruCulture = new System.Globalization.CultureInfo("ru-RU");
            for (int i = 5; i >= 0; i--)
            {
                var month = DateTime.Today.AddMonths(-i);
                var monthTx = transactions.Where(t => t.Date.Year == month.Year && t.Date.Month == month.Month).ToList();
                monthlyData.Add(new MonthlyDataPoint
                {
                    Label = month.ToString("MMM", ruCulture),
                    Value = monthTx.Sum(t => t.Amount)
                });
            }

            // Прогноз
            var reminders = await DbContext.Reminders.Where(r => r.UserId == user.Id).ToListAsync();
            cashGaps = ForecastingService.DetectCashGaps(transactions, reminders, 90, 0);

            // Налоги
            upcomingTaxes = await DbContext.TaxPayments
                .Where(t => t.UserId == user.Id && !t.IsPaid && t.DueDate >= DateTime.Today)
                .OrderBy(t => t.DueDate)
                .ToListAsync();
        }

        isLoading = false;
    }

    private class MonthlyDataPoint
    {
        public string Label { get; set; } = string.Empty;
        public decimal Value { get; set; }
    }
}
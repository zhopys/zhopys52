@page "/analytics"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using MiniFinance.Data.Models
@using MiniFinance.Components.Shared.Reports
@using MiniFinance.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject IReportAnalyticsService AnalyticsService
@inject IExtendedReportService ExtendedReportService
@inject ITransactionService TransactionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize(Policy = AuthorizationPolicies.CanViewReports)]

<PageTitle>Аналитика — MiniFinance</PageTitle>

<div class="page-header">
    <div class="title">
        <h1>Аналитика</h1>
        <div class="meta text-muted">
            @if (_snapshot != null)
            {
                <span>@_snapshot.Filters.Start.ToString("dd.MM.yyyy") — @_snapshot.Filters.End.ToString("dd.MM.yyyy")</span>
                <span> · графики, сравнение и структура расходов</span>
            }
            else
            {
                <span>Графики, сравнение периодов и анализ по проектам</span>
            }
        </div>
    </div>
    <div class="page-actions analytics-toolbar">
        <select class="input" style="width:auto" @bind="_periodType" @bind:after="ReloadAsync">
            <option value="Month">Месяц</option>
            <option value="Quarter">Квартал</option>
            <option value="Year">Год</option>
            <option value="Custom">Произвольный</option>
        </select>
        @if (_periodType == "Custom")
        {
            <input type="date" class="input" @bind="_customStart" @bind:after="ReloadAsync" />
            <span class="text-muted">—</span>
            <input type="date" class="input" @bind="_customEnd" @bind:after="ReloadAsync" />
        }
        else
        {
            <input type="month" class="input" value="@_selectedMonthKey" @onchange="OnMonthInputChanged" />
        }
        <select class="input" style="width:auto" @bind="_compareMode" @bind:after="ReloadAsync">
            <option value="mom">Месяц к месяцу</option>
            <option value="yoy">Год к году</option>
            <option value="none">Без сравнения</option>
        </select>
        <a href="/reports" class="btn btn-outline btn-sm">Отчёты</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-error mb-3">@_error</div>
}

@if (_loading && _snapshot == null)
{
    <div class="loading-state"><div class="spinner"></div></div>
}
else if (_snapshot != null && !_snapshot.DataStatus.HasData)
{
    <div class="empty-state">
        <div class="empty-state-title">Недостаточно данных</div>
        <p class="text-muted">Добавьте или импортируйте транзакции для построения аналитики.</p>
        <div class="page-actions" style="justify-content:center;margin-top:1rem">
            <a href="/import" class="btn btn-primary">Импорт CSV</a>
            <a href="/transactions" class="btn btn-outline">Операции</a>
        </div>
    </div>
}
else if (_snapshot != null)
{
    @if (_periodHasNoActivity && _hasAnyTransactions)
    {
        <div class="alert alert-info mb-3 small">
            В выбранном периоде нет операций.
            <button type="button" class="btn btn-sm btn-outline ms-2" @onclick="JumpToLatestPeriodAsync">Последний месяц с данными</button>
        </div>
    }

    <div class="tabs reports-tabs mb-3">
        <button type="button" class="tab @(_tab == "expenses" ? "active" : "")" @onclick='() => SetTab("expenses")'>Структура расходов</button>
        <button type="button" class="tab @(_tab == "compare" ? "active" : "")" @onclick='() => SetTab("compare")'>Сравнение</button>
        <button type="button" class="tab @(_tab == "weekday" ? "active" : "")" @onclick='() => SetTab("weekday")'>По дням</button>
        <button type="button" class="tab @(_tab == "projects" ? "active" : "")" @onclick='() => SetTab("projects")'>Проекты</button>
    </div>

    <p class="reports-tab-hint text-muted small mb-3">@GetTabHint()</p>

    <div class="@(_refreshing ? "hub-refreshing" : "")">
        @if (_tab == "expenses")
        {
            <CategoryDonutChart Chart="@_snapshot.ExpenseChart"
                                SelectedCategory="@_selectedCategory"
                                OnCategorySelected="OnCategoryFilter" />

            @if (_extended?.Forecast.Anomalies.Any() == true)
            {
                <div class="card mt-3">
                    <div class="card-header">Нетипичные расходы</div>
                    <div class="card-body" style="padding:0">
                        <table class="table mb-0">
                            <thead>
                                <tr><th>Дата</th><th>Описание</th><th>Категория</th><th class="text-end">Сумма</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var a in _extended.Forecast.Anomalies.Take(8))
                                {
                                    <tr>
                                        <td>@a.Date.ToString("dd.MM.yyyy")</td>
                                        <td>@a.Description</td>
                                        <td>@a.Category</td>
                                        <td class="text-end text-danger">@a.Amount.ToString("N0") <Byn /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <p class="small text-muted mt-3 mb-0">
                Учётные формы (P&amp;L, денежный поток, ОСВ) — на странице <a href="/reports">Отчёты</a>.
                Прогноз кассы — <a href="/cash-forecast">Прогноз кассовых разрывов</a>.
            </p>
        }
        else if (_tab == "compare")
        {
            @if (_compareMode == "none")
            {
                <div class="alert alert-info mb-3 small">Выберите «Месяц к месяцу» или «Год к году» в фильтрах выше.</div>
            }
            <PeriodComparisonPanel Comparison="@(_extended?.PeriodComparison ?? new())" />
        }
        else if (_tab == "weekday" && _extended != null)
        {
            <WeekdayExpensePanel Data="@_extended.WeekdayExpenses" />
        }
        else if (_tab == "projects")
        {
            <ProfitabilityMatrix Rows="@_snapshot.ProfitabilityMatrix" />
            @if (_snapshot.Projects.Any())
            {
                <ProjectProfitTable Rows="@_snapshot.Projects" />
            }
            else
            {
                <div class="empty-state small mt-3">Нет операций, привязанных к проектам за период.</div>
            }
        }
    </div>
}

@code {
    private string _userId = "";
    private string _tab = "expenses";
    private bool _loading = true;
    private bool _refreshing;
    private string? _error;

    private ReportAnalyticsSnapshot? _snapshot;
    private ExtendedAnalyticsDto? _extended;

    private string _periodType = "Month";
    private string _compareMode = "mom";
    private string _selectedMonthKey = "";
    private DateTime _customStart;
    private DateTime _customEnd;
    private string? _selectedCategory;
    private bool _periodHasNoActivity;
    private bool _hasAnyTransactions;
    private List<DateTime> _availableMonths = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user == null) return;
        _userId = user.Id;
        await LoadAvailableMonthsAsync();
        var m = _availableMonths.FirstOrDefault();
        if (m == default)
            m = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _selectedMonthKey = $"{m:yyyy-MM}";
        _customStart = m;
        _customEnd = m.AddMonths(1).AddDays(-1);
        await ReloadAsync();
    }

    private async Task LoadAvailableMonthsAsync()
    {
        var txs = await TransactionService.ListAsync(_userId);
        _hasAnyTransactions = txs.Count > 0;
        _availableMonths = txs
            .GroupBy(t => new { t.Date.Year, t.Date.Month })
            .Select(g => new DateTime(g.Key.Year, g.Key.Month, 1))
            .OrderByDescending(d => d)
            .ToList();
        if (_availableMonths.Count == 0)
            _availableMonths.Add(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1));
    }

    private async Task JumpToLatestPeriodAsync()
    {
        if (_availableMonths.Count == 0) return;
        var m = _availableMonths[0];
        _selectedMonthKey = $"{m:yyyy-MM}";
        _periodType = "Month";
        _customStart = m;
        _customEnd = m.AddMonths(1).AddDays(-1);
        await ReloadAsync();
    }

    private async Task OnMonthInputChanged(ChangeEventArgs e)
    {
        _selectedMonthKey = e.Value?.ToString() ?? _selectedMonthKey;
        if (DateTime.TryParse(_selectedMonthKey + "-01", out var d))
        {
            _customStart = new DateTime(d.Year, d.Month, 1);
            _customEnd = _customStart.AddMonths(1).AddDays(-1);
        }
        await ReloadAsync();
    }

    private void SetTab(string tab) => _tab = tab;

    private string GetTabHint() => _tab switch
    {
        "expenses" => "Доли категорий в расходах и нетипичные операции.",
        "compare" => "Изменение ключевых показателей относительно прошлого периода.",
        "weekday" => "В какие дни недели тратите больше всего.",
        "projects" => "Выручка, маржа и затраты по проектам.",
        _ => ""
    };

    private ReportFilters BuildFilters()
    {
        var (start, end) = _periodType == "Custom"
            ? (_customStart.Date, _customEnd.Date)
            : ReportFilters.ResolvePeriodRange(
                DateTime.TryParse(_selectedMonthKey + "-01", out var a) ? a : DateTime.Today,
                _periodType,
                _customStart,
                _customEnd);

        return new ReportFilters
        {
            Start = start,
            End = end,
            PeriodType = _periodType,
            CompareMode = _compareMode,
            ForecastDays = 90,
            Categories = string.IsNullOrEmpty(_selectedCategory) ? Array.Empty<string>() : new[] { _selectedCategory },
            ExportReport = "full"
        };
    }

    private async Task ReloadAsync()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        _error = null;
        _loading = _snapshot == null;
        _refreshing = _snapshot != null;
        StateHasChanged();

        try
        {
            var filters = BuildFilters();
            _snapshot = await AnalyticsService.BuildSnapshotAsync(_userId, filters);
            _extended = await ExtendedReportService.BuildAsync(_userId, filters, null);
            _periodHasNoActivity = _snapshot.Kpi
                .Where(k => k.Key is "revenue" or "opex" or "capex")
                .All(k => k.Value == 0);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            _refreshing = false;
        }
    }

    private async Task OnCategoryFilter(string? category)
    {
        _selectedCategory = _selectedCategory == category ? null : category;
        await ReloadAsync();
    }
}

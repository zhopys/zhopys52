@page "/analytics"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using MiniFinance.Data.Models
@using MiniFinance.Components.Shared.Reports
@using MiniFinance.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject IReportAnalyticsService AnalyticsService
@inject IExtendedReportService ExtendedReportService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize(Policy = AuthorizationPolicies.CanViewReports)]

<PageTitle>Финансовая аналитика — MiniFinance</PageTitle>

<div class="page-header">
    <div class="title">
        <h1>Финансовая аналитика</h1>
        <div class="meta text-muted">P&amp;L, движение денег, графики и сравнение периодов</div>
    </div>
    <div class="page-actions analytics-toolbar">
        <select class="input" style="width:auto" @bind="_periodType" @bind:after="ReloadAsync">
            <option value="Month">Месяц</option>
            <option value="Quarter">Квартал</option>
            <option value="Year">Год</option>
            <option value="Custom">Произвольный</option>
        </select>
        @if (_periodType == "Custom")
        {
            <input type="date" class="input" @bind="_customStart" @bind:after="ReloadAsync" />
            <span class="text-muted">—</span>
            <input type="date" class="input" @bind="_customEnd" @bind:after="ReloadAsync" />
        }
        else
        {
            <input type="month" class="input" value="@_selectedMonthKey" @onchange="OnMonthInputChanged" />
        }
        <select class="input" style="width:auto" @bind="_compareMode" @bind:after="ReloadAsync">
            <option value="mom">Месяц к месяцу</option>
            <option value="yoy">Год к году</option>
            <option value="none">Без сравнения</option>
        </select>
        <button class="btn btn-outline" @onclick="ReloadAsync" disabled="@_loading">Обновить</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-error mb-3">@_error</div>
}

@if (_loading && _snapshot == null)
{
    <div class="loading-state"><div class="spinner"></div></div>
}
else if (_snapshot != null && !_snapshot.DataStatus.HasData)
{
    <div class="empty-state">
        <div class="empty-state-title">Недостаточно данных</div>
        <p class="text-muted">Добавьте или импортируйте транзакции для построения отчётов.</p>
        <div class="page-actions" style="justify-content:center;margin-top:1rem">
            <a href="/import" class="btn btn-primary">Импорт CSV</a>
            <a href="/transactions" class="btn btn-outline">Операции</a>
        </div>
    </div>
}
else if (_snapshot != null)
{
    <div class="reports-period-banner mb-3">
        <span class="reports-period-dates">
            @_snapshot.Filters.Start.ToString("dd.MM.yyyy") — @_snapshot.Filters.End.ToString("dd.MM.yyyy")
        </span>
    </div>

    <ReportsKpiGrid Metrics="@_snapshot.Kpi" Loading="@_refreshing" />

    <div class="hub-layout mt-3">
        <nav class="hub-nav card">
            <button type="button" class="hub-nav-item @(_tab == "pl" ? "active" : "")" @onclick='() => SetTab("pl")'>P&amp;L отчёт</button>
            <button type="button" class="hub-nav-item @(_tab == "cashflow" ? "active" : "")" @onclick='() => SetTab("cashflow")'>Cash Flow</button>
            <button type="button" class="hub-nav-item @(_tab == "charts" ? "active" : "")" @onclick='() => SetTab("charts")'>Графики</button>
            <button type="button" class="hub-nav-item @(_tab == "compare" ? "active" : "")" @onclick='() => SetTab("compare")'>Сравнение</button>
            <button type="button" class="hub-nav-item @(_tab == "export" ? "active" : "")" @onclick='() => SetTab("export")'>Экспорт</button>
        </nav>

        <div class="hub-content @(_refreshing ? "hub-refreshing" : "")">
            @if (_tab == "pl")
            {
                <PlReportPanel Report="@_snapshot.ProfitLoss" />
            }
            else if (_tab == "cashflow")
            {
                <CashFlowPanel Statement="@_snapshot.CashFlow" MonthlyCashflow="@_snapshot.MonthlyCashflow" />
            }
            else if (_tab == "charts")
            {
                <CategoryDonutChart Chart="@_snapshot.ExpenseChart"
                                    SelectedCategory="@_selectedCategory"
                                    OnCategorySelected="OnCategoryFilter" />
                <p class="small text-muted mt-2">
                    Прогноз кассы и порог остатка — на странице <a href="/cash-forecast">Прогноз кассовых разрывов</a>.
                </p>
                @if (_extended?.Forecast.Anomalies.Any() == true)
                {
                    <div class="card mt-3">
                        <div class="card-header">Аномалии расходов</div>
                        <div class="card-body" style="padding:0">
                            <table class="table mb-0">
                                <thead>
                                    <tr><th>Дата</th><th>Описание</th><th>Категория</th><th class="text-end">Сумма</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in _extended.Forecast.Anomalies.Take(10))
                                    {
                                        <tr>
                                            <td>@a.Date.ToString("dd.MM.yyyy")</td>
                                            <td>@a.Description</td>
                                            <td>@a.Category</td>
                                            <td class="text-end text-danger">@a.Amount.ToString("N0") <Byn /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
            else if (_tab == "compare")
            {
                <PeriodComparisonPanel Comparison="@(_extended?.PeriodComparison ?? new())" />
                @if (_compareMode == "none")
                {
                    <div class="alert alert-info mt-3">Выберите «Месяц к месяцу» или «Год к году» в фильтрах выше.</div>
                }
            }
            else if (_tab == "export")
            {
                <div class="card">
                    <div class="card-header">Экспорт отчётов</div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">
                            Период: @_snapshot.Filters.Start.ToString("dd.MM.yyyy") — @_snapshot.Filters.End.ToString("dd.MM.yyyy")
                        </p>
                        <div class="export-actions-grid">
                            <button class="btn btn-primary" @onclick='() => Export("pdf", "full")'>PDF — полный (все разделы + транзакции)</button>
                            <button class="btn btn-outline" @onclick='() => Export("pdf", "transactions")'>PDF — все транзакции</button>
                            <button class="btn btn-outline" @onclick='() => Export("pdf", "pl")'>PDF — P&amp;L</button>
                            <button class="btn btn-outline" @onclick='() => Export("pdf", "cashflow")'>PDF — Cash Flow</button>
                            <button class="btn btn-outline" @onclick='() => Export("pdf", "trial")'>PDF — ОСВ</button>
                            <button class="btn btn-outline" @onclick='() => Export("pdf", "book")'>PDF — книга учёта</button>
                            <button class="btn btn-outline" @onclick='() => Export("pdf", "profitability")'>PDF — рентабельность</button>
                            <button class="btn btn-outline" @onclick='() => Export("xlsx", "full")'>Excel — всё</button>
                            <button class="btn btn-outline" @onclick='() => Export("csv", "transactions")'>CSV — транзакции</button>
                        </div>
                        <p class="small text-muted mt-3">
                            Также доступны отчёты на странице <a href="/reports">Финансовые отчёты</a>.
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private string _userId = "";
    private string _tab = "pl";
    private bool _loading = true;
    private bool _refreshing;
    private string? _error;

    private ReportAnalyticsSnapshot? _snapshot;
    private ExtendedAnalyticsDto? _extended;

    private string _periodType = "Month";
    private string _compareMode = "mom";
    private string _selectedMonthKey = "";
    private DateTime _customStart;
    private DateTime _customEnd;
    private string? _selectedCategory;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user == null) return;
        _userId = user.Id;
        var m = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _selectedMonthKey = $"{m:yyyy-MM}";
        _customStart = m;
        _customEnd = m.AddMonths(1).AddDays(-1);
        await ReloadAsync();
    }

    private async Task OnMonthInputChanged(ChangeEventArgs e)
    {
        _selectedMonthKey = e.Value?.ToString() ?? _selectedMonthKey;
        if (DateTime.TryParse(_selectedMonthKey + "-01", out var d))
        {
            _customStart = new DateTime(d.Year, d.Month, 1);
            _customEnd = _customStart.AddMonths(1).AddDays(-1);
        }
        await ReloadAsync();
    }

    private void SetTab(string tab) => _tab = tab;

    private ReportFilters BuildFilters(string? exportReport = null)
    {
        var (start, end) = _periodType == "Custom"
            ? (_customStart.Date, _customEnd.Date)
            : ReportFilters.ResolvePeriodRange(
                DateTime.TryParse(_selectedMonthKey + "-01", out var a) ? a : DateTime.Today,
                _periodType,
                _customStart,
                _customEnd);

        return new ReportFilters
        {
            Start = start,
            End = end,
            PeriodType = _periodType,
            CompareMode = _compareMode,
            ForecastDays = 90,
            Categories = string.IsNullOrEmpty(_selectedCategory) ? Array.Empty<string>() : new[] { _selectedCategory },
            ExportReport = exportReport ?? _tab switch
            {
                "pl" => "pl",
                "cashflow" => "cashflow",
                _ => "full"
            }
        };
    }

    private async Task ReloadAsync()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        _error = null;
        _loading = _snapshot == null;
        _refreshing = _snapshot != null;
        StateHasChanged();

        try
        {
            var filters = BuildFilters();
            _snapshot = await AnalyticsService.BuildSnapshotAsync(_userId, filters);
            _extended = await ExtendedReportService.BuildAsync(_userId, filters, null);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            _refreshing = false;
        }
    }

    private async Task OnCategoryFilter(string? category)
    {
        _selectedCategory = _selectedCategory == category ? null : category;
        await ReloadAsync();
    }

    private void Export(string format, string report)
    {
        var qs = BuildFilters(report).ToQueryString(format, report);
        NavigationManager.NavigateTo($"/api/reports/export?{qs}", forceLoad: true);
    }
}

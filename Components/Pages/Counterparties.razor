@page "/counterparties"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using MiniFinance.Data
@using MiniFinance.Data.Models
@using MiniFinance.Services
@inject ICounterpartyService CounterpartyService
@using CounterpartySvc = MiniFinance.Services.CounterpartyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider Auth
@inject ConfirmDialogService ConfirmDialog
@attribute [Authorize(Policy = AuthorizationPolicies.CanAccessFinances)]

<PageTitle>Контрагенты — MiniFinance</PageTitle>

<div class="page-header">
    <div class="title">
        <h1>Контрагенты</h1>
        <div class="meta text-muted">Справочник клиентов и поставщиков</div>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" @onclick="OpenCreate">Добавить</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") mb-3">@_message</div>
}

@if (_showForm)
{
    <div class="card mb-3">
        <div class="card-header">@(_editId.HasValue ? "Редактирование" : "Новый контрагент")</div>
        <div class="card-body">
            <div class="cp-form-grid">
                <div><label class="label">Название *</label><input class="input" @bind="_form.Name" /></div>
                <div>
                    <label class="label">Тип</label>
                    <select class="input" @bind="_form.Type">
                        <option value="@CounterpartyType.Client">Клиент</option>
                        <option value="@CounterpartyType.Supplier">Поставщик</option>
                        <option value="@CounterpartyType.Both">Клиент и поставщик</option>
                    </select>
                </div>
                <div>
                    <label class="label">URL логотипа</label>
                    <input class="input" @bind="_form.LogoUrl" placeholder="https://…" />
                    <span class="small text-muted">Если пусто — аватар по имени</span>
                </div>
                <div><label class="label">Контакт</label><input class="input" @bind="_form.ContactPerson" /></div>
                <div><label class="label">Email</label><input class="input" type="email" @bind="_form.Email" /></div>
                <div><label class="label">Телефон</label><input class="input" @bind="_form.Phone" /></div>
                <div><label class="label">УНП</label><input class="input" @bind="_form.TaxId" placeholder="123456789" /></div>
            </div>
            <div class="mt-2"><label class="label">Заметки</label><textarea class="input" rows="2" @bind="_form.Notes"></textarea></div>
            @if (!string.IsNullOrWhiteSpace(_form.Name))
            {
                <div class="mt-2 d-flex align-items-center gap-2">
                    <img src="@CounterpartySvc.GetDisplayLogoUrl(_form)" alt="" class="cp-avatar" width="40" height="40" referrerpolicy="no-referrer" />
                    <span class="small text-muted">Предпросмотр</span>
                </div>
            }
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="Save">Сохранить</button>
                <button class="btn btn-outline" @onclick="() => _showForm = false">Отмена</button>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        @if (_list == null)
        {
            <div class="empty-state small">Загрузка...</div>
        }
        else if (!_list.Any())
        {
            <div class="empty-state">Нет контрагентов</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table cp-table mb-0">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Название</th>
                            <th>Тип</th>
                            <th>Контакт</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <Virtualize Items="_list" Context="c" ItemSize="56" OverscanCount="10">
                            <tr class="cp-table-row" @onclick="() => OpenDetail(c.Id)">
                                <td style="width:52px" @onclick:stopPropagation="true">
                                    <img src="@CounterpartySvc.GetDisplayLogoUrl(c)" alt="" class="cp-avatar" width="36" height="36" loading="lazy" referrerpolicy="no-referrer" />
                                </td>
                                <td class="fw-bold">
                                    <a href="#" @onclick="() => OpenDetail(c.Id)" @onclick:preventDefault>@c.Name</a>
                                </td>
                                <td><span class="badge badge-info">@TypeLabel(c.Type)</span></td>
                                <td class="text-muted small cp-contact-cell">
                                    @if (!string.IsNullOrWhiteSpace(c.ContactPerson))
                                    {
                                        <span>@c.ContactPerson</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(c.Email))
                                    {
                                        <span class="d-block">@c.Email</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(c.Phone))
                                    {
                                        <span class="d-block">@c.Phone</span>
                                    }
                                    @if (string.IsNullOrWhiteSpace(c.ContactPerson) && string.IsNullOrWhiteSpace(c.Email) && string.IsNullOrWhiteSpace(c.Phone))
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td class="text-end" style="white-space:nowrap" @onclick:stopPropagation="true">
                                    <button class="btn btn-sm btn-outline" @onclick="() => OpenDetail(c.Id)">Подробнее</button>
                                    <button class="btn btn-sm btn-outline" @onclick="() => Edit(c)">Изменить</button>
                                    <button class="btn btn-sm btn-outline text-danger" @onclick="() => ConfirmDelete(c)">Удалить</button>
                                </td>
                            </tr>
                        </Virtualize>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<CounterpartyDetailsPanel CounterpartyId="@_detailId" UserId="@_userId" IsOpen="@_detailOpen"
                         OnClose="CloseDetail" OnEdit="EditFromDetail" />

@code {
    private string _userId = "";
    private List<CounterpartyRecord>? _list;
    private int _detailId;
    private bool _detailOpen;
    private bool _showForm;
    private int? _editId;
    private CounterpartyRecord _form = new();
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user == null) return;
        _userId = user.Id;
        await LoadAsync();
    }

    private async Task LoadAsync() => _list = await CounterpartyService.ListAsync(_userId);

    private void OpenCreate()
    {
        _editId = null;
        _form = new CounterpartyRecord { Type = CounterpartyType.Both };
        _showForm = true;
    }

    private void Edit(CounterpartyRecord c)
    {
        _editId = c.Id;
        _form = new CounterpartyRecord
        {
            Id = c.Id, Name = c.Name, Type = c.Type, LogoUrl = c.LogoUrl,
            ContactPerson = c.ContactPerson, Email = c.Email, Phone = c.Phone,
            TaxId = c.TaxId, Notes = c.Notes
        };
        _showForm = true;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _message = "Укажите название контрагента.";
            _isError = true;
            return;
        }

        try
        {
            if (_editId.HasValue)
            {
                _form.Id = _editId.Value;
                await CounterpartyService.UpdateAsync(_form, _userId);
            }
            else
                await CounterpartyService.CreateAsync(_form, _userId);
            _showForm = false;
            _message = "Сохранено";
            _isError = false;
            await LoadAsync();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }

    private async Task ConfirmDelete(CounterpartyRecord c)
    {
        var ok = await ConfirmDialog.ConfirmDeleteAsync($"контрагента «{c.Name}»");
        if (!ok) return;
        await CounterpartyService.DeleteAsync(c.Id, _userId);
        await LoadAsync();
    }

    private void OpenDetail(int id) { _detailId = id; _detailOpen = true; }
    private void CloseDetail() { _detailId = 0; _detailOpen = false; }

    private void EditFromDetail(int id)
    {
        CloseDetail();
        var c = _list?.FirstOrDefault(x => x.Id == id);
        if (c != null) Edit(c);
    }

    private static string TypeLabel(CounterpartyType t) => t switch
    {
        CounterpartyType.Client => "Клиент",
        CounterpartyType.Supplier => "Поставщик",
        _ => "Клиент и поставщик"
    };
}

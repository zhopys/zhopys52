@page "/insights"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using MiniFinance.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject IReportService ReportService
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>Аналитика роста — MiniFinance</PageTitle>

<div class="main">
    <AuthorizeView>
        <Authorized>
            <div class="page-header">
                <div class="title">
                    <ul class="breadcrumb">
                        <li><a href="/">Главная</a></li>
                        <li>Аналитика</li>
                    </ul>
                    <h1>Аналитика роста</h1>
                    <div class="meta text-muted">Стратегические показатели масштабируемости</div>
                </div>
                <div class="page-actions">
                    <select class="form-select input" style="width: auto;" @onchange="OnPeriodChanged" value="@currentPeriod">
                        <option value="30">30 дней</option>
                        <option value="90">90 дней</option>
                        <option value="180">6 месяцев</option>
                        <option value="365">Год</option>
                        <option value="0">Все время</option>
                    </select>
                    <button class="btn btn-outline" @onclick="RefreshData">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="loading-state"><div class="spinner"></div></div>
            }
            else if (!hasData)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">📈</div>
                    <div class="empty-state-title">Недостаточно данных</div>
                    <div class="empty-state-text">Добавьте больше транзакций для глубокого анализа роста.</div>
                    <a class="btn btn-primary mt-3" href="/transactions">Добавить операции</a>
                </div>
            }
            else
            {
                <div class="dashboard-stats mb-4">
                    <div class="stat-card">
                        <div class="stat-icon" style="color:var(--accent)">📊</div>
                        <div class="stat-content">
                            <div class="stat-label">Маржинальность</div>
                            <div class="stat-value @(profitMargin > 0 ? "text-success" : "text-danger")">
                                @profitMargin.ToString("F1")%
                            </div>
                            <div class="trend-badge">@GetProfitabilityHint()</div>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon" style="color:var(--warning)">💎</div>
                        <div class="stat-content">
                            <div class="stat-label">Средний чек</div>
                            <div class="stat-value">@averageTransaction.ToString("N0") <small>Br</small></div>
                            <div class="stat-trend">@transactionCount транзакций</div>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon" style="color:var(--success)">💰</div>
                        <div class="stat-content">
                            <div class="stat-label">Чистая прибыль</div>
                            <div class="stat-value @(netProfit > 0 ? "text-success" : "text-danger")">
                                @netProfit.ToString("N0") <small>Br</small>
                            </div>
                            <div class="stat-trend">за выбранный период</div>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon" style="color:var(--info)">🌊</div>
                        <div class="stat-content">
                            <div class="stat-label">Cash Flow</div>
                            <div class="stat-value @(cashFlow > 0 ? "text-info" : "text-danger")">
                                @cashFlow.ToString("N0") <small>Br</small>
                            </div>
                            <div class="stat-trend">@(cashFlow > 0 ? "Положительный" : "Дефицит")</div>
                        </div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 24px;">
                    
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span>Рекомендуемая стратегия</span>
                            @{ var (phase, _) = GetScalingPhase(); }
                            <span class="badge badge-accent">Этап: @phase</span>
                        </div>
                        <div class="card-body">
                            <div class="phase-actions">
                                @foreach (var action in GetScalingPhase().actions)
                                {
                                    <div class="action-item mb-3 p-3" style="border-left: 4px solid var(--accent); background: var(--bg);">
                                        <div class="action-title fw-bold" style="color: var(--accent)">@action.Title</div>
                                        <div class="action-description small text-secondary">@action.Description</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">Драйверы роста (по маржинальности)</div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Категория</th>
                                            <th>Маржа</th>
                                            <th class="text-end">Доход</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cat in topCategories.Take(5))
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold">@cat.Category</div>
                                                    <div class="small text-muted">@cat.TransactionCount оп.</div>
                                                </td>
                                                <td>
                                                    <div class="progress" style="height: 6px; width: 80px; background: var(--border);">
                                                        <div class="progress-bar-fill" style="width: @Math.Max(5, (int)cat.Profitability)%; background: var(--success);"></div>
                                                    </div>
                                                    <span class="small fw-bold">@cat.Profitability.ToString("F0")%</span>
                                                </td>
                                                <td class="text-end text-success fw-bold">
                                                    +@cat.Income.ToString("N0")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="mt-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px;">
                    
                    @* Инсайт по Рентабельности *@
                    <div class="card insight-card border-top" style="border-top: 3px solid @(profitMargin > 15 ? "var(--success)" : "var(--warning)") !important">
                        <div class="card-body">
                            <h3 class="h6 fw-bold mb-3">Здоровье прибыли</h3>
                            <p class="small text-secondary mb-3">Ваша маржа составляет @profitMargin.ToString("F1")%. Это @(profitMargin > 20 ? "отличный" : "тревожный") показатель для роста.</p>
                            <ul class="recommendations small ps-3">
                                @if (profitMargin >= 30) {
                                    <li>Идеальное время для найма персонала.</li>
                                    <li>Рассмотрите возможность захвата новых ниш.</li>
                                } else {
                                    <li>Проверьте "скрытые" расходы в топ-категориях.</li>
                                    <li>Масштабирование сейчас может сжечь капитал.</li>
                                }
                            </ul>
                        </div>
                    </div>

                    @* Инсайт по Среднему чеку *@
                    <div class="card insight-card border-top" style="border-top: 3px solid var(--warning) !important">
                        <div class="card-body">
                            <h3 class="h6 fw-bold mb-3">Потенциал чека</h3>
                            <p class="small text-secondary mb-3">Средняя сделка — @averageTransaction.ToString("N0") Br. Увеличение чека на 10% даст прирост прибыли в @((netProfit * 0.15m).ToString("N0")) Br.</p>
                            <ul class="recommendations small ps-3">
                                <li>Внедрите пакетные предложения (Bundle).</li>
                                <li>Добавьте сопутствующие услуги к лидерам продаж.</li>
                            </ul>
                        </div>
                    </div>

                    @* Инсайт по Инвестициям *@
                    <div class="card insight-card border-top" style="border-top: 3px solid var(--accent) !important">
                        <div class="card-body">
                            <h3 class="h6 fw-bold mb-3">Инвест-потенциал</h3>
                            @{ decimal inv = netProfit * 0.2m; }
                            <p class="small text-secondary mb-3">Вы можете безболезненно реинвестировать до <strong>@(inv > 0 ? inv.ToString("N0") : "0") Br</strong> в развитие маркетинга.</p>
                            <ul class="recommendations small ps-3">
                                <li>Фокус на категории: @(topCategories.FirstOrDefault()?.Category ?? "Основные").</li>
                                <li>Создайте резервный фонд на 3 месяца.</li>
                            </ul>
                        </div>
                    </div>

                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private bool isLoading = true;
    private bool hasData = false;
    private string currentPeriod = "30";

    private decimal profitMargin = 0;
    private decimal averageTransaction = 0;
    private int transactionCount = 0;
    private decimal netProfit = 0;
    private decimal cashFlow = 0;
    private decimal totalIncome = 0;
    private decimal totalExpense = 0;

    private List<MonthlyTrend> monthlyData = new();
    private List<CategoryMetrics> topCategories = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task RefreshData() => await LoadData();

    private async Task OnPeriodChanged(ChangeEventArgs e)
    {
        currentPeriod = e.Value?.ToString() ?? "30";
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (user == null) return;

            DateTime startDate = currentPeriod == "0" ? DateTime.MinValue : DateTime.Today.AddDays(-int.Parse(currentPeriod));

            var transactions = await DbContext.Transactions
                .Where(t => t.UserId == user.Id && t.Date >= startDate)
                .ToListAsync();

            if (!transactions.Any()) { hasData = false; return; }

            totalIncome = transactions.Where(t => t.Amount > 0).Sum(t => t.Amount);
            totalExpense = Math.Abs(transactions.Where(t => t.Amount < 0).Sum(t => t.Amount));
            netProfit = totalIncome - totalExpense;
            cashFlow = transactions.Sum(t => t.Amount);
            transactionCount = transactions.Count;
            profitMargin = totalIncome > 0 ? (netProfit / totalIncome) * 100 : 0;
            averageTransaction = transactionCount > 0 ? Math.Abs(transactions.Average(t => t.Amount)) : 0;

            // Группировка по категориям
            topCategories = transactions
                .GroupBy(t => t.Category)
                .Select(g => {
                    var inc = g.Where(t => t.Amount > 0).Sum(t => t.Amount);
                    var exp = Math.Abs(g.Where(t => t.Amount < 0).Sum(t => t.Amount));
                    return new CategoryMetrics {
                        Category = g.Key,
                        Income = inc,
                        Expense = exp,
                        TransactionCount = g.Count(),
                        Profitability = inc > 0 ? ((inc - exp) / inc) * 100 : 0
                    };
                })
                .OrderByDescending(c => c.Profitability)
                .ToList();

            hasData = true;
        }
        finally { isLoading = false; }
    }

    private string GetProfitabilityHint() => profitMargin switch {
        >= 30 => "Отлично",
        >= 15 => "Стабильно",
        > 0 => "Низкая",
        _ => "Убыток"
    };

    private (string phase, List<ScalingAction> actions) GetScalingPhase()
    {
        if (netProfit <= 0) return ("Стабилизация", new() {
            new("Стоп-расходы", "Заморозьте все необязательные траты до выхода в плюс."),
            new("Анализ цен", "Ваш средний чек может быть ниже себестоимости.")
        });

        if (profitMargin >= 30) return ("Агрессивный рост", new() {
            new("Масштабирование", "Увеличивайте рекламный бюджет в 2 раза."),
            new("Новые кадры", "Пора делегировать операционку.")
        });

        return ("Оптимизация", new() {
            new("LTV", "Работайте над повторными продажами."),
            new("Процессы", "Автоматизируйте рутину перед расширением.")
        });
    }

    public class CategoryMetrics {
        public string Category { get; set; } = "";
        public decimal Income { get; set; }
        public decimal Expense { get; set; }
        public int TransactionCount { get; set; }
        public decimal Profitability { get; set; }
    }

    public class ScalingAction {
        public string Title { get; set; }
        public string Description { get; set; }
        public ScalingAction(string t, string d) { Title = t; Description = d; }
    }
}
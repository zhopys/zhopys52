@page "/settings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using MiniFinance.Data.Models
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDataScopeService DataScope
@inject IUserContextService UserContext
@inject ITaxAutoRuleService TaxAutoRuleService
@inject IJSRuntime JS
@* Роли временно отключены: @attribute [Authorize(Policy = "CanManageSettings")] *@
@attribute [Authorize]

<PageTitle>Настройки — MiniFinance</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="page-header">
            <div class="title">
                <h1>Настройки</h1>
                <div class="meta text-muted">Организация, прогноз кассы и оформление</div>
            </div>
        </div>

        @if (showMessage) { <div class="alert alert-success mb-3">@_message</div> }
        @if (showError) { <div class="alert alert-error mb-3">@_errorMessage</div> }

        <div class="hub-layout">
            <nav class="hub-nav card">
                <button type="button" class="hub-nav-item @(_tab == "general" ? "active" : "")" @onclick='() => _tab = "general"'>Основные</button>
                <button type="button" class="hub-nav-item @(_tab == "appearance" ? "active" : "")" @onclick='() => _tab = "appearance"'>Внешний вид</button>
            </nav>

            <div class="hub-content">
                @if (_tab == "general")
                {
                    <div class="card mb-3">
                        <div class="card-header">Организация</div>
                        <div class="card-body">
                            <div class="form-grid">
                                <div class="form-group">
                                    <label class="form-label">Название компании</label>
                                    <input class="form-input" @bind="companyName" placeholder='ООО "Компания"' />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">УНП</label>
                                    <input class="form-input" @bind="unp" placeholder="123456789" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Система налогообложения</label>
                                    <select class="form-input" @bind="taxSystem">
                                        <option value="USN">УСН</option>
                                        <option value="OSN">ОСН</option>
                                    </select>
                                    <span class="small text-muted">Используется в разделе «Налоги»</span>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Минимальный остаток (BYN)</label>
                                    <input type="number" class="form-input" @bind="minCashBalance" step="100" min="0" />
                                    <span class="small text-muted">Порог на графике прогноза кассы и предупреждениях</span>
                                </div>
                            </div>
                            <div class="mt-3">
                                <button class="btn btn-primary" @onclick="SaveGeneral" disabled="@_saving">Сохранить</button>
                            </div>
                        </div>
                    </div>

                    @* Команда — временно скрыто
                    <div class="card">
                        <div class="card-header">Команда</div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">Пользователи и роли — на отдельной странице.</p>
                            <a href="/team" class="btn btn-outline">Открыть «Команда»</a>
                        </div>
                    </div>
                    *@
                }
                else
                {
                    <div class="card">
                        <div class="card-header">Тема интерфейса</div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">Сохраняется в браузере на этом устройстве.</p>
                            <div style="display:flex;gap:12px;flex-wrap:wrap">
                                <button class="btn btn-outline" @onclick="() => SetTheme(false)">Светлая</button>
                                <button class="btn btn-outline" @onclick="() => SetTheme(true)">Тёмная</button>
                                <button class="btn btn-primary" @onclick="ToggleTheme">
                                    Сейчас: @(isDark ? "тёмная" : "светлая")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private string _tab = "general";
    private string _userId = "";
    private string companyName = "";
    private string unp = "";
    private string taxSystem = "USN";
    private decimal minCashBalance = 1000;
    private bool isDark;
    private bool showMessage;
    private bool showError;
    private string _message = "";
    private string _errorMessage = "";
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user == null) return;
        _userId = await DataScope.GetDataOwnerUserIdAsync(user.Id);

        var settings = await DbContext.OrganizationSettings.FirstOrDefaultAsync(s => s.UserId == _userId);
        if (settings != null)
        {
            companyName = settings.CompanyName;
            unp = settings.UNP;
            taxSystem = settings.TaxSystem.ToString();
            minCashBalance = settings.MinCashBalance;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            isDark = await JS.InvokeAsync<string>("eval", "document.documentElement.getAttribute('data-theme')") == "dark";
            StateHasChanged();
        }
        catch { }
    }

    private async Task SaveGeneral()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user != null)
        {
            // Роли временно отключены
            // var ctx = await UserContext.GetContextAsync(user.Id);
            // if (!UserContext.CanAccessSettings(ctx))
            // {
            //     _errorMessage = "Изменять настройки организации может только владелец";
            //     showError = true;
            //     return;
            // }
        }

        _saving = true;
        showError = false;
        try
        {
            if (!Enum.TryParse<TaxSystem>(taxSystem, out var parsedTax))
                parsedTax = TaxSystem.USN;

            var settings = await DbContext.OrganizationSettings.FirstOrDefaultAsync(s => s.UserId == _userId);
            var previousTaxSystem = settings?.TaxSystem;
            if (settings == null)
            {
                settings = new OrganizationSettings { UserId = _userId };
                DbContext.OrganizationSettings.Add(settings);
            }

            settings.CompanyName = companyName.Trim();
            settings.UNP = unp.Trim();
            settings.TaxSystem = parsedTax;
            settings.MinCashBalance = minCashBalance;

            await DbContext.SaveChangesAsync();

            if (previousTaxSystem != parsedTax)
                await TaxAutoRuleService.SyncRulesForTaxSystemAsync(_userId, parsedTax, replaceExisting: true);

            ShowMessage(previousTaxSystem != parsedTax
                ? "Настройки сохранены. Правила автоматических налогов обновлены под новую систему."
                : "Настройки сохранены");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            showError = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SetTheme(bool dark)
    {
        isDark = dark;
        var theme = dark ? "dark" : "light";
        await JS.InvokeVoidAsync("eval", $"window.themeUtils && window.themeUtils.set('{theme}');");
    }

    private async Task ToggleTheme() => await SetTheme(!isDark);

    private void ShowMessage(string msg)
    {
        _message = msg;
        showMessage = true;
        showError = false;
    }
}

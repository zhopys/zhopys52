@page "/reminders"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using MiniFinance.Data.Models
@inject ApplicationDbContext DbContext
@inject IJSRuntime JsRuntime
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>Напоминания - MiniFinance</PageTitle>

<!-- Простые кнопки для переключения табов -->
<div style="margin-bottom: 20px;">
    <button class="btn @(_activeTab == "upcoming" ? "btn-primary" : "btn-outline")" @onclick="@(() => SetTab("upcoming"))">
        Предстоящие
    </button>
    <button class="btn @(_activeTab == "overdue" ? "btn-primary" : "btn-outline")" @onclick="@(() => SetTab("overdue"))">
        Просроченные
    </button>
    <button class="btn @(_activeTab == "paid" ? "btn-primary" : "btn-outline")" @onclick="@(() => SetTab("paid"))">
        Оплаченные
    </button>
    <button class="btn @(_activeTab == "all" ? "btn-primary" : "btn-outline")" @onclick="@(() => SetTab("all"))">
        Все
    </button>
</div>

<!-- Кнопка создания -->
<button class="btn btn-success" @onclick="@(() => _showCreateForm = true)">+ Создать напоминание</button>

<!-- Форма создания -->
@if (_showCreateForm)
{
    <div style="border: 1px solid #ccc; padding: 20px; margin: 20px 0;">
        <h3>@(_editId == 0 ? "Создать" : "Редактировать")</h3>
        
        <div>
            <label>Название:</label>
            <input type="text" @bind="_newName" />
        </div>
        
        <div>
            <label>Сумма:</label>
            <input type="number" @bind="_newAmount" />
        </div>
        
        <div>
            <label>Категория:</label>
            <select @bind="_newCategory">
                <option value="">---</option>
                @foreach (var c in _categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
        
        <div>
            <label>Периодичность:</label>
            <select @bind="_newFrequency">
                <option value="@ReminderFrequency.OneTime">Разово</option>
                <option value="@ReminderFrequency.Monthly">Ежемесячно</option>
                <option value="@ReminderFrequency.Yearly">Ежегодно</option>
            </select>
        </div>
        
        <div>
            <label>Дата:</label>
            <input type="date" @bind="_newDate" />
        </div>
        
        <div>
            <label>Проект:</label>
            <select @bind="_newProjectId">
                <option value="">---</option>
                @foreach (var p in _projects)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
        </div>
        
        <div>
            <label>Заметки:</label>
            <textarea @bind="_newNotes"></textarea>
        </div>
        
        <button class="btn btn-primary" @onclick="@SaveReminder">Сохранить</button>
        <button class="btn btn-secondary" @onclick="@CancelForm">Отмена</button>
    </div>
}

<!-- Список напоминаний -->
<div>
    @if (_reminders == null)
    {
        <p>Загрузка...</p>
    }
    else if (!GetFilteredReminders().Any())
    {
        <p>Нет напоминаний</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Сумма</th>
                    <th>Дата</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in GetFilteredReminders())
                {
                    <tr>
                        <td>@r.Name</td>
                        <td>@r.Amount</td>
                        <td>@r.Date.ToString("dd.MM.yyyy")</td>
                        <td>@(r.IsPaid ? "Оплачено" : "Ожидает")</td>
                        <td>
                            @if (!r.IsPaid)
                            {
                                <button class="btn btn-sm btn-success" @onclick="@(() => MarkPaid(r.Id))">✓</button>
                            }
                            <button class="btn btn-sm btn-primary" @onclick="@(() => EditReminder(r))">✎</button>
                            <button class="btn btn-sm btn-danger" @onclick="@(() => ConfirmDelete(r.Id))">🗑</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Reminder>? _reminders;
    private List<string> _categories = new();
    private List<Project> _projects = new();

    private bool _showCreateForm;
    private string _message = string.Empty;
    private string _errorMessage = string.Empty;

    private string _activeTab = "upcoming";

    private int _editId;
    private string _newName = string.Empty;
    private decimal _newAmount;
    private string _newCategory = string.Empty;
    private ReminderFrequency _newFrequency = ReminderFrequency.OneTime;
    private DateTime _newDate = DateTime.Today;
    private int? _newProjectId;
    private string _newNotes = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadProjects();
        await LoadReminders();
    }

    private async Task LoadCategories()
    {
        _categories = await DbContext.Categories
            .Select(c => c.Name)
            .ToListAsync();
    }

    private async Task LoadProjects()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            _projects = await DbContext.Projects.ToListAsync();
        }
    }

    private async Task LoadReminders()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            _reminders = await DbContext.Reminders
                .Where(r => r.UserId == user.Id)
                .ToListAsync();
        }
    }

    private IEnumerable<Reminder> GetFilteredReminders()
    {
        if (_reminders == null) return Enumerable.Empty<Reminder>();

        return _activeTab switch
        {
            "upcoming" => _reminders.Where(r => !r.IsPaid && r.Date >= DateTime.Today),
            "overdue" => _reminders.Where(r => !r.IsPaid && r.Date < DateTime.Today),
            "paid" => _reminders.Where(r => r.IsPaid),
            _ => _reminders
        };
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
    }

    private void CancelForm()
    {
        _editId = 0;
        _newName = string.Empty;
        _newAmount = 0;
        _newCategory = string.Empty;
        _newFrequency = ReminderFrequency.OneTime;
        _newDate = DateTime.Today;
        _newProjectId = null;
        _newNotes = string.Empty;
        _showCreateForm = false;
    }

    private async Task SaveReminder()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;

        if (_editId == 0)
        {
            var r = new Reminder
            {
                Name = _newName,
                Amount = _newAmount,
                Category = _newCategory,
                Frequency = _newFrequency,
                Date = _newDate,
                ProjectId = _newProjectId,
                Notes = _newNotes,
                UserId = user.Id,
                IsPaid = false
            };
            DbContext.Reminders.Add(r);
        }
        else
        {
            var r = await DbContext.Reminders.FindAsync(_editId);
            if (r != null)
            {
                r.Name = _newName;
                r.Amount = _newAmount;
                r.Category = _newCategory;
                r.Frequency = _newFrequency;
                r.Date = _newDate;
                r.ProjectId = _newProjectId;
                r.Notes = _newNotes;
            }
        }

        await DbContext.SaveChangesAsync();
        CancelForm();
        await LoadReminders();
    }

    private void EditReminder(Reminder r)
    {
        _editId = r.Id;
        _newName = r.Name;
        _newAmount = r.Amount;
        _newCategory = r.Category;
        _newFrequency = r.Frequency;
        _newDate = r.Date;
        _newProjectId = r.ProjectId;
        _newNotes = r.Notes ?? string.Empty;
        _showCreateForm = true;
    }

    private async Task ConfirmDelete(int id)
    {
        var ok = await JsRuntime.InvokeAsync<bool>("confirm", "Удалить?");
        if (ok)
        {
            await DeleteReminder(id);
        }
    }

    private async Task DeleteReminder(int id)
    {
        var r = await DbContext.Reminders.FindAsync(id);
        if (r != null)
        {
            DbContext.Reminders.Remove(r);
            await DbContext.SaveChangesAsync();
            await LoadReminders();
        }
    }

    private async Task MarkPaid(int id)
    {
        var r = await DbContext.Reminders.FindAsync(id);
        if (r == null) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;

        var tx = new Transaction
        {
            Date = r.Date,
            Amount = -Math.Abs(r.Amount),
            Description = $"Оплата: {r.Name}",
            Category = r.Category ?? string.Empty,
            ProjectId = r.ProjectId,
            UserId = user.Id
        };

        DbContext.Transactions.Add(tx);

        if (r.Frequency == ReminderFrequency.OneTime)
        {
            r.IsPaid = true;
            r.PaidDate = DateTime.Now;
        }
        else if (r.Frequency == ReminderFrequency.Monthly)
        {
            r.Date = r.Date.AddMonths(1);
        }
        else if (r.Frequency == ReminderFrequency.Yearly)
        {
            r.Date = r.Date.AddYears(1);
        }

        await DbContext.SaveChangesAsync();
        await LoadReminders();
    }
}
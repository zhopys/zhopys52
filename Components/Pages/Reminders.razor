@page "/reminders"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using MiniFinance.Data.Models
@using MiniFinance.Services
@inject ApplicationDbContext DbContext
@inject ITransactionService TransactionService
@inject ConfirmDialogService ConfirmDialog
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDataScopeService DataScope
@inject MiniFinance.Services.INotificationEmailService EmailService
@attribute [Authorize(Policy = AuthorizationPolicies.CanAccessFinances)]

<PageTitle>Напоминания - MiniFinance</PageTitle>

<div class="page-header">
    <div class="title">
        <h1>Напоминания</h1>
        <div class="meta text-muted">Управление платежами и счетами</div>
    </div>
    <div class="page-actions">
        <button class="btn btn-outline" @onclick="SendNotifications" disabled="@_sendingNotifications">
            @if (_sendingNotifications) { <span class="spinner" style="width:14px;height:14px;border-width:2px"></span> }
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 2L11 13"/><path d="M22 2L15 22L11 13L2 9L22 2Z"/>
            </svg>
            Отправить уведомления
        </button>
        <button class="btn btn-primary" @onclick="@(() => _showCreateForm = true)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Создать
        </button>
    </div>
</div>

@if (_showMessage)
{
    <div class="alert alert-success">@_message</div>
}

@if (_showError)
{
    <div class="alert alert-error">@_errorMessage</div>
}

<!-- Tabs -->
<div class="card mb-3">
    <div class="card-body" style="padding: 0.5rem;">
        <div class="tab-bar">
            <button class="tab @(_activeTab == "upcoming" ? "active" : "")" @onclick="@(() => SetTab("upcoming"))">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Предстоящие
                @if (_upcomingCount > 0) { <span class="tab-count">@_upcomingCount</span> }
            </button>
            <button class="tab @(_activeTab == "overdue" ? "active" : "")" @onclick="@(() => SetTab("overdue"))">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                Просроченные
                @if (_overdueCount > 0) { <span class="tab-count tab-count-danger">@_overdueCount</span> }
            </button>
            <button class="tab @(_activeTab == "paid" ? "active" : "")" @onclick="@(() => SetTab("paid"))">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Оплаченные
            </button>
            <button class="tab @(_activeTab == "all" ? "active" : "")" @onclick="@(() => SetTab("all"))">
                Все
            </button>
            <button class="tab @(_activeTab == "snoozed" ? "active" : "")" @onclick="@(() => SetTab("snoozed"))">
                Отложенные
                @if (_snoozedCount > 0) { <span class="tab-count">@_snoozedCount</span> }
            </button>
            <button class="tab @(_activeTab == "archive" ? "active" : "")" @onclick="@(() => SetTab("archive"))">
                Архив
            </button>
        </div>
    </div>
</div>

<!-- Create / Edit form -->
@if (_showCreateForm)
{
    <div class="card mb-3">
        <div class="card-header">@(_editId == 0 ? "Новое напоминание" : "Редактирование")</div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Название <span class="required">*</span></label>
                    <input type="text" class="form-input" @bind="_newName" placeholder="Например: Аренда офиса" />
                </div>
                <div class="form-group">
                    <label class="form-label">Сумма <span class="required">*</span></label>
                    <input type="number" class="form-input" @bind="_newAmount" placeholder="0" step="100" />
                </div>
                <div class="form-group">
                    <label class="form-label">Категория</label>
                    <select class="form-select form-input" @bind="_newCategory">
                        <option value="">Выберите категорию</option>
                        @foreach (var c in _categories) { <option value="@c">@c</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Тип</label>
                    <select class="form-select form-input" @bind="_newReminderType">
                        <option value="@ReminderType.Tax">Налоги</option>
                        <option value="@ReminderType.Bill">Счета</option>
                        <option value="@ReminderType.Salary">Зарплата</option>
                        <option value="@ReminderType.Rent">Аренда</option>
                        <option value="@ReminderType.Subscription">Подписки</option>
                        <option value="@ReminderType.Other">Другое</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Периодичность</label>
                    <select class="form-select form-input" @bind="_newFrequency">
                        <option value="@ReminderFrequency.OneTime">Разово</option>
                        <option value="@ReminderFrequency.Daily">Ежедневно</option>
                        <option value="@ReminderFrequency.Weekly">Еженедельно</option>
                        <option value="@ReminderFrequency.Monthly">Ежемесячно</option>
                        <option value="@ReminderFrequency.Quarterly">Ежеквартально</option>
                        <option value="@ReminderFrequency.Yearly">Ежегодно</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Напомнить за (дней)</label>
                    <input type="number" class="form-input" @bind="_newNotifyDays" min="0" max="90" step="1" />
                    <span class="small text-muted">За сколько дней до даты платежа отправлять email (0 — в день платежа)</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Дата</label>
                    <input type="date" class="form-input" @bind="_newDate" />
                </div>
                <div class="form-group">
                    <label class="form-label">Проект</label>
                    <select class="form-select form-input" @bind="_newProjectId">
                        <option value="">Без проекта</option>
                        @foreach (var p in _projects) { <option value="@p.Id">@p.Name</option> }
                    </select>
                </div>
                <div class="form-group full-width">
                    <label class="form-label">Заметки</label>
                    <textarea class="form-input" @bind="_newNotes" placeholder="Дополнительная информация" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-3" style="display:flex;gap:0.5rem;justify-content:flex-end">
                <button class="btn btn-primary" @onclick="SaveReminder">@(_editId == 0 ? "Создать" : "Сохранить")</button>
                <button class="btn btn-outline" @onclick="CancelForm">Отмена</button>
            </div>
        </div>
    </div>
}

<!-- Summary cards -->
@if (_reminders != null && _activeTab == "upcoming")
{
    var upcoming = _reminders.Where(r => !r.IsPaid && r.Date >= DateTime.Today).OrderBy(r => r.Date).ToList();
    if (upcoming.Any())
    {
        var totalDue = upcoming.Sum(r => r.Amount);
        var nextDue = upcoming.FirstOrDefault();
        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-label">К оплате</div>
                <div class="kpi-value">@totalDue.ToString("N0") <Byn /></div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Ближайший</div>
                <div class="kpi-value" style="font-size:20px">@nextDue?.Name</div>
                <div class="text-muted small">@nextDue?.Date.ToString("dd.MM.yyyy") · @nextDue?.Amount.ToString("N0") <Byn /></div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Количество</div>
                <div class="kpi-value">@upcoming.Count</div>
            </div>
        </div>
    }
}

<!-- List -->
<div class="card">
    <div class="card-header">
        @if (_reminders != null)
        {
            <span class="text-muted small">Всего: @GetFilteredReminders().Count()</span>
        }
    </div>
    <div class="card-body" style="padding:0">
        @if (_reminders == null)
        {
            <div class="loading-state">
                <div class="spinner-wrapper">
                    <div class="spinner"></div>
                    <p class="text-muted mt-3">Загрузка...</p>
                </div>
            </div>
        }
        else if (!GetFilteredReminders().Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--text-tertiary)">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                </div>
                <div class="empty-state-title">@GetEmptyTitle()</div>
                <div class="empty-state-text">@GetEmptyMessage()</div>
                @if (_activeTab == "all" || _activeTab == "upcoming")
                {
                    <button class="btn btn-primary" @onclick="@(() => _showCreateForm = true)">Создать напоминание</button>
                }
            </div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Категория</th>
                        <th class="text-end">Сумма</th>
                        <th>Дата</th>
                        <th>Периодичность</th>
                        <th>Статус</th>
                        <th class="text-center">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in GetFilteredReminders().OrderBy(r => r.Date))
                    {
                        var isOverdue = !r.IsPaid && r.Date < DateTime.Today;
                        var daysUntil = (int)(r.Date - DateTime.Today).TotalDays;
                        <tr>
                            <td>
                                <strong>@r.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(r.Notes))
                                {
                                    <br /><small class="text-muted">@r.Notes</small>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(r.Category))
                                {
                                    <span class="badge">@r.Category</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end fw-bold">@r.Amount.ToString("N0") <Byn /></td>
                            <td>
                                <div class="@(isOverdue ? "text-danger" : "")">
                                    @r.Date.ToString("dd.MM.yyyy")
                                </div>
                                @if (ReminderScheduleHelper.IsSnoozedActive(r))
                                {
                                    <div class="small text-muted">Отложено до @r.SnoozedUntil!.Value.ToString("dd.MM.yyyy")</div>
                                }
                                else if (!r.IsPaid)
                                {
                                    <div class="small @(isOverdue ? "text-danger" : "text-muted")">
                                        @if (isOverdue)
                                        {
                                            @($"Просрочено на {Math.Abs(daysUntil)} дн.")
                                        }
                                        else if (daysUntil == 0)
                                        {
                                            <span class="text-danger">Сегодня!</span>
                                        }
                                        else if (daysUntil == 1)
                                        {
                                            <span>Завтра</span>
                                        }
                                        else
                                        {
                                            @($"Через {daysUntil} дн.")
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="small text-muted">@GetFrequencyText(r.Frequency)</span>
                            </td>
                            <td>
                                @if (r.IsPaid)
                                {
                                    <span class="badge badge-success">Оплачено</span>
                                    @if (r.PaidDate.HasValue)
                                    {
                                        <br /><span class="small text-muted">@r.PaidDate.Value.ToString("dd.MM.yyyy")</span>
                                    }
                                }
                                else if (isOverdue)
                                {
                                    <span class="badge badge-danger">Просрочено</span>
                                }
                                else
                                {
                                    <span class="badge badge-info">Ожидает</span>
                                }
                            </td>
                            <td class="text-center" style="white-space: nowrap;">
                                @if (ReminderScheduleHelper.IsSnoozedActive(r) && _activeTab == "snoozed")
                                {
                                    <button class="btn btn-sm btn-outline" @onclick="@(() => ClearSnooze(r))" title="Вернуть в список">Вернуть</button>
                                }
                                @if (!r.IsPaid && _activeTab != "archive")
                                {
                                    <button class="btn btn-sm btn-outline" @onclick="@(() => Postpone(r, 1))" title="Перенести дату на 1 день">+1д</button>
                                    <button class="btn btn-sm btn-outline" @onclick="@(() => Postpone(r, 3))" title="Перенести на 3 дня">+3д</button>
                                    <button class="btn btn-sm btn-outline" @onclick="@(() => Postpone(r, 7))" title="Перенести на неделю">+7д</button>
                                    <button class="btn btn-sm btn-success" @onclick="@(() => MarkPaid(r.Id))" title="Отметить как оплаченное">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline" @onclick="@(() => EditReminder(r))" title="Редактировать">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="@(() => ConfirmDelete(r.Id))" title="Удалить">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<Reminder>? _reminders;
    private List<string> _categories = new();
    private List<Project> _projects = new();

    private bool _showCreateForm;
    private string _message = string.Empty;
    private bool _showMessage;
    private string _errorMessage = string.Empty;
    private bool _showError;
    private bool _sendingNotifications;

    private string _activeTab = "upcoming";
    private int _upcomingCount;
    private int _overdueCount;
    private int _snoozedCount;
    private string _dataUserId = "";

    private int _editId;
    private string _newName = string.Empty;
    private decimal _newAmount;
    private string _newCategory = string.Empty;
    private ReminderFrequency _newFrequency = ReminderFrequency.OneTime;
    private DateTime _newDate = DateTime.Today;
    private int? _newProjectId;
    private string _newNotes = string.Empty;
    private ReminderType _newReminderType = ReminderType.Other;
    private int _newNotifyDays = 3;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadProjects();
        await LoadReminders();
    }

    private async Task LoadCategories()
    {
        _categories = await DbContext.Categories
            .Select(c => c.Name)
            .ToListAsync();
    }

    private async Task LoadProjects()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            var dataId = await DataScope.GetDataOwnerUserIdAsync(user.Id);
            _projects = await DbContext.Projects
                .Where(p => p.UserId == dataId || p.IsDefault)
                .ToListAsync();
        }
    }

    private async Task LoadReminders()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            _dataUserId = await DataScope.GetDataOwnerUserIdAsync(user.Id);
            _reminders = await DbContext.Reminders
                .Where(r => r.UserId == _dataUserId)
                .ToListAsync();

            var today = DateTime.Today;
            _upcomingCount = _reminders.Count(r => ReminderScheduleHelper.MatchesUpcoming(r, today));
            _overdueCount = _reminders.Count(r => ReminderScheduleHelper.MatchesOverdue(r, today));
            _snoozedCount = _reminders.Count(r => ReminderScheduleHelper.IsSnoozedActive(r, today));
        }
    }

    private IEnumerable<Reminder> GetFilteredReminders()
    {
        if (_reminders == null) return Enumerable.Empty<Reminder>();

        var today = DateTime.Today;
        return _activeTab switch
        {
            "upcoming" => _reminders.Where(r => ReminderScheduleHelper.MatchesUpcoming(r, today)),
            "overdue" => _reminders.Where(r => ReminderScheduleHelper.MatchesOverdue(r, today)),
            "paid" => _reminders.Where(r => !r.IsArchived && r.IsPaid),
            "snoozed" => _reminders.Where(r => !r.IsArchived && !r.IsPaid && ReminderScheduleHelper.IsSnoozedActive(r, today)),
            "archive" => _reminders.Where(r => r.IsArchived),
            _ => _reminders.Where(r => !r.IsArchived)
        };
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
    }

    private void CancelForm()
    {
        _editId = 0;
        _newName = string.Empty;
        _newAmount = 0;
        _newCategory = string.Empty;
        _newReminderType = ReminderType.Other;
        _newFrequency = ReminderFrequency.OneTime;
        _newNotifyDays = 3;
        _newDate = DateTime.Today;
        _newProjectId = null;
        _newNotes = string.Empty;
        _showCreateForm = false;
    }

    private async Task SaveReminder()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            _errorMessage = "Укажите название";
            _showError = true;
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;

        if (_editId == 0)
        {
            var ownerId = await DataScope.GetDataOwnerUserIdAsync(user.Id);
            var r = new Reminder
            {
                Name = _newName,
                Amount = _newAmount,
                Category = _newCategory,
                ReminderType = _newReminderType,
                Frequency = _newFrequency,
                NotifyDaysBefore = _newNotifyDays,
                Date = _newDate,
                ProjectId = _newProjectId,
                Notes = _newNotes,
                UserId = ownerId,
                IsPaid = false
            };
            DbContext.Reminders.Add(r);
        }
        else
        {
            var r = await DbContext.Reminders.FindAsync(_editId);
            if (r != null)
            {
                r.Name = _newName;
                r.Amount = _newAmount;
                r.Category = _newCategory;
                r.ReminderType = _newReminderType;
                r.Frequency = _newFrequency;
                r.NotifyDaysBefore = _newNotifyDays;
                r.Date = _newDate;
                r.ProjectId = _newProjectId;
                r.Notes = _newNotes;
                r.SnoozedUntil = null;
                r.IsArchived = false;
            }
        }

        await DbContext.SaveChangesAsync();
        CancelForm();
        await LoadReminders();
        _message = _editId == 0 ? "Напоминание создано" : "Напоминание обновлено";
        _showMessage = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        _showMessage = false;
        await InvokeAsync(StateHasChanged);
    }

    private void EditReminder(Reminder r)
    {
        _editId = r.Id;
        _newName = r.Name;
        _newAmount = r.Amount;
        _newCategory = r.Category;
        _newReminderType = r.ReminderType;
        _newFrequency = r.Frequency;
        _newNotifyDays = r.NotifyDaysBefore;
        _newDate = r.Date;
        _newProjectId = r.ProjectId;
        _newNotes = r.Notes ?? string.Empty;
        _showCreateForm = true;
    }

    private async Task Postpone(Reminder r, int days)
    {
        if (days <= 0) return;
        ReminderScheduleHelper.PostponeByDays(r, days);
        DbContext.Reminders.Update(r);
        await DbContext.SaveChangesAsync();
        await LoadReminders();
        _message = $"Дата перенесена на {r.Date:dd.MM.yyyy}";
        _showMessage = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearSnooze(Reminder r)
    {
        r.SnoozedUntil = null;
        await DbContext.SaveChangesAsync();
        await LoadReminders();
    }

    private async Task ConfirmDelete(int id)
    {
        var r = await DbContext.Reminders.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
        var label = r != null ? $"напоминание «{r.Name}»" : "напоминание";
        var ok = await ConfirmDialog.ConfirmDeleteAsync(label);
        if (ok)
            await DeleteReminder(id);
    }

    private async Task DeleteReminder(int id)
    {
        var r = await DbContext.Reminders.FindAsync(id);
        if (r != null)
        {
            DbContext.Reminders.Remove(r);
            await DbContext.SaveChangesAsync();
            await LoadReminders();
        }
    }

    private async Task SendNotifications()
    {
        _sendingNotifications = true;
        _showError = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (user == null || string.IsNullOrEmpty(user.Email))
            {
                _errorMessage = "Email не найден в профиле пользователя";
                _showError = true;
                return;
            }

            var ownerId = await DataScope.GetDataOwnerUserIdAsync(user.Id);
            var now = DateTime.Today;

            var upcomingReminders = (await DbContext.Reminders
                .Where(r => r.UserId == ownerId && !r.IsPaid && !r.IsArchived && r.Date >= now)
                .ToListAsync())
                .Where(r => ReminderScheduleHelper.ShouldNotifyToday(r, now) && r.NotificationSentDate == null)
                .ToList();

            var taxLead = user.NotificationDaysBefore;
            var taxCutoff = now.AddDays(taxLead);
            var upcomingTaxes = await DbContext.TaxPayments
                .Where(t => t.UserId == ownerId && !t.IsPaid && t.DueDate >= now && t.DueDate <= taxCutoff)
                .ToListAsync();

            var items = upcomingReminders.Select(r => (user.Email, r.Name, r.Amount, r.Date, "reminder", (int)(r.Date - now).TotalDays))
                .Concat(upcomingTaxes.Select(t => (user.Email, t.Name, t.Amount, t.DueDate, "tax", (int)(t.DueDate - now).TotalDays)))
                .ToList();

            if (!items.Any())
            {
                _message = "Нет предстоящих платежей для уведомления";
                _showMessage = true;
                return;
            }

            var sent = await EmailService.SendAllUpcomingNotificationsAsync(items);
            _message = $"Отправлено {sent} уведомлений на {user.Email}";
            _showMessage = true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка: {ex.Message}";
            _showError = true;
        }
        finally
        {
            _sendingNotifications = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MarkPaid(int id)
    {
        var r = await DbContext.Reminders.FindAsync(id);
        if (r == null) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;

        await TransactionService.CreateAsync(new Transaction
        {
            Date = r.Date,
            Amount = -Math.Abs(r.Amount),
            Description = $"Оплата: {r.Name}",
            Category = r.Category ?? string.Empty,
            ProjectId = r.ProjectId
        }, user.Id);

        if (r.Frequency == ReminderFrequency.OneTime)
        {
            r.IsPaid = true;
            r.PaidDate = DateTime.Now;
        }
        else
        {
            r.Date = RecurringCalendarHelper.StepForward(r.Date, r.Frequency);
            r.NotificationSentDate = null;
        }

        r.SnoozedUntil = null;

        await DbContext.SaveChangesAsync();
        await LoadReminders();
    }


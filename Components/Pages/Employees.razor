@page "/employees"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using MiniFinance.Data.Models
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Сотрудники - MiniFinance</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="page-header">
            <div class="title">
                <h1>Сотрудники</h1>
                <div class="meta text-muted">Управление работниками и зарплатами</div>
            </div>
            <button class="btn btn-primary" @onclick="OpenAddDialog">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Добавить сотрудника
            </button>
        </div>

        @if (showMessage)
        {
            <div class="alert alert-success">@_message</div>
        }

        <!-- Summary Cards -->
        <div class="card-grid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:1.5rem">
            <div class="card">
                <div class="card-body">
                    <div class="metric-label">Всего сотрудников</div>
                    <div class="metric-value">@_totalEmployees</div>
                    <div class="metric-hint">активных: @_activeEmployees</div>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <div class="metric-label">Фонд зарплат</div>
                    <div class="metric-value" style="color:var(--danger)">@_totalSalary.ToString("N0") Br</div>
                    <div class="metric-hint">в месяц</div>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <div class="metric-label">Бухгалтеры</div>
                    <div class="metric-value">@_accountantCount</div>
                    <div class="metric-hint">менеджеров: @_managerCount</div>
                </div>
            </div>
        </div>

        <!-- Employees Table -->
        <div class="card">
            <div class="card-body" style="padding:0">
                @if (isLoading)
                {
                    <div class="center text-muted py-4">Загрузка...</div>
                }
                else if (!_employees.Any())
                {
                    <div class="empty-state">
                        <p>Нет сотрудников</p>
                        <button class="btn btn-primary mt-3" @onclick="OpenAddDialog">Добавить первого сотрудника</button>
                    </div>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>ФИО</th>
                                <th>Должность</th>
                                <th>Роль</th>
                                <th>Email</th>
                                <th>Телефон</th>
                                <th class="text-end">Зарплата</th>
                                <th>Статус</th>
                                <th class="text-center">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in _employees)
                            {
                                <tr class="@(emp.IsActive ? "" : "text-muted")">
                                    <td><strong>@emp.FullName</strong></td>
                                    <td>@emp.Position</td>
                                    <td>
                                        <span class="badge @(emp.Role switch { "Accountant" => "badge-info", "Manager" => "badge-warning", _ => "" })">@GetRoleName(emp.Role)</span>
                                    </td>
                                    <td>@emp.Email</td>
                                    <td>@emp.Phone</td>
                                    <td class="text-end">@emp.Salary.ToString("N2") Br</td>
                                    <td>
                                        @if (emp.IsActive)
                                        {
                                            <span class="badge badge-success">Активен</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">Уволен</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline" @onclick="() => OpenEditDialog(emp)" title="Редактировать">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        </button>
                                        @if (emp.IsActive)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => TerminateEmployee(emp.Id)" title="Уволить">Уволить</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline" @onclick="() => ReactivateEmployee(emp.Id)" title="Восстановить">Восстановить</button>
                                        }
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteEmployee(emp.Id)" title="Удалить">Удалить</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- Add/Edit Modal -->
        @if (showDialog)
        {
            <div class="modal-overlay" @onclick="CloseDialog">
                <div class="modal-content modal-lg" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h3>@(isEditing ? "Редактировать" : "Добавить") сотрудника</h3>
                        <button class="modal-close" @onclick="CloseDialog">&times;</button>
                    </div>
                    <div class="modal-body">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
                        <div style="grid-column:1/-1">
                            <label class="label">ФИО</label>
                            <input class="input" @bind="editForm.FullName" placeholder="Иванов Иван Иванович" />
                        </div>
                        <div>
                            <label class="label">Должность</label>
                            <input class="input" @bind="editForm.Position" placeholder="Бухгалтер" />
                        </div>
                        <div>
                            <label class="label">Роль</label>
                            <select class="input" @bind="editForm.Role">
                                <option value="Employee">Сотрудник</option>
                                <option value="Accountant">Бухгалтер</option>
                                <option value="Manager">Менеджер</option>
                            </select>
                        </div>
                        <div>
                            <label class="label">Email</label>
                            <input class="input" type="email" @bind="editForm.Email" placeholder="email@example.com" />
                        </div>
                        <div>
                            <label class="label">Телефон</label>
                            <input class="input" @bind="editForm.Phone" placeholder="+375 29 123 45 67" />
                        </div>
                        <div>
                            <label class="label">Зарплата (Br)</label>
                            <InputNumber class="input" @bind-Value="editForm.Salary" />
                        </div>
                        <div>
                            <label class="label">Дата приёма</label>
                            <InputDate class="input" @bind-Value="editForm.HireDate" />
                        </div>
                    </div>
                </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline" @onclick="CloseDialog">Отмена</button>
                        <button class="btn btn-primary" @onclick="SaveEmployee">@(isEditing ? "Сохранить" : "Добавить")</button>
                    </div>
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private List<Employee> _employees = new();
    private bool isLoading = true;
    private bool showMessage = false;
    private string _message = string.Empty;

    // Summary
    private int _totalEmployees;
    private int _activeEmployees;
    private int _accountantCount;
    private int _managerCount;
    private decimal _totalSalary;

    // Dialog
    private bool showDialog = false;
    private bool isEditing = false;
    private int editingId = 0;
    private EmployeeForm editForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        isLoading = true;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            _employees = await DbContext.Employees
                .Where(e => e.UserId == user.Id)
                .OrderByDescending(e => e.IsActive)
                .ThenBy(e => e.FullName)
                .ToListAsync();

            _totalEmployees = _employees.Count;
            _activeEmployees = _employees.Count(e => e.IsActive);
            _accountantCount = _employees.Count(e => e.Role == "Accountant" && e.IsActive);
            _managerCount = _employees.Count(e => e.Role == "Manager" && e.IsActive);
            _totalSalary = _employees.Where(e => e.IsActive).Sum(e => e.Salary);
        }
        isLoading = false;
    }

    private void OpenAddDialog()
    {
        isEditing = false;
        editingId = 0;
        editForm = new EmployeeForm
        {
            HireDate = DateTime.Today
        };
        showDialog = true;
    }

    private void OpenEditDialog(Employee emp)
    {
        isEditing = true;
        editingId = emp.Id;
        editForm = new EmployeeForm
        {
            FullName = emp.FullName,
            Position = emp.Position,
            Role = emp.Role,
            Email = emp.Email,
            Phone = emp.Phone,
            Salary = emp.Salary,
            HireDate = emp.HireDate
        };
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
    }

    private async Task SaveEmployee()
    {
        if (string.IsNullOrWhiteSpace(editForm.FullName)) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;

        if (isEditing)
        {
            var emp = await DbContext.Employees.FindAsync(editingId);
            if (emp == null || emp.UserId != user.Id) return;

            emp.FullName = editForm.FullName.Trim();
            emp.Position = editForm.Position.Trim();
            emp.Role = editForm.Role;
            emp.Email = editForm.Email.Trim();
            emp.Phone = editForm.Phone.Trim();
            emp.Salary = editForm.Salary;
            emp.HireDate = editForm.HireDate;
        }
        else
        {
            var emp = new Employee
            {
                UserId = user.Id,
                FullName = editForm.FullName.Trim(),
                Position = editForm.Position.Trim(),
                Role = editForm.Role,
                Email = editForm.Email.Trim(),
                Phone = editForm.Phone.Trim(),
                Salary = editForm.Salary,
                HireDate = editForm.HireDate,
                IsActive = true
            };
            DbContext.Employees.Add(emp);
        }

        await DbContext.SaveChangesAsync();
        _message = isEditing ? "Сотрудник обновлён" : "Сотрудник добавлен";
        showMessage = true;
        showDialog = false;
        await LoadEmployees();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        showMessage = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task TerminateEmployee(int id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Уволить сотрудника?");
        if (!ok) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;

        var emp = await DbContext.Employees.FindAsync(id);
        if (emp == null || emp.UserId != user.Id) return;

        emp.IsActive = false;
        emp.TerminationDate = DateTime.Today;
        await DbContext.SaveChangesAsync();
        _message = "Сотрудник уволен";
        showMessage = true;
        await LoadEmployees();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        showMessage = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReactivateEmployee(int id)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;

        var emp = await DbContext.Employees.FindAsync(id);
        if (emp == null || emp.UserId != user.Id) return;

        emp.IsActive = true;
        emp.TerminationDate = null;
        await DbContext.SaveChangesAsync();
        _message = "Сотрудник восстановлен";
        showMessage = true;
        await LoadEmployees();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        showMessage = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteEmployee(int id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Удалить сотрудника безвозвратно?");
        if (!ok) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;

        var emp = await DbContext.Employees.FindAsync(id);
        if (emp == null || emp.UserId != user.Id) return;

        DbContext.Employees.Remove(emp);
        await DbContext.SaveChangesAsync();
        _message = "Сотрудник удалён";
        showMessage = true;
        await LoadEmployees();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3000);
        showMessage = false;
        await InvokeAsync(StateHasChanged);
    }

    private static string GetRoleName(string role) => role switch
    {
        "Accountant" => "Бухгалтер",
        "Manager" => "Менеджер",
        _ => "Сотрудник"
    };

    private class EmployeeForm
    {
        public string FullName { get; set; } = string.Empty;
        public string Position { get; set; } = string.Empty;
        public string Role { get; set; } = "Employee";
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public decimal Salary { get; set; }
        public DateTime HireDate { get; set; }
    }
}

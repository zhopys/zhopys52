@page "/cash-forecast"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using MiniFinance.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject IForecastingService ForecastingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Прогноз кассовых разрывов — MiniFinance</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="page-header">
            <div class="title">
                <h1>Прогноз кассовых разрывов</h1>
                <div class="meta text-muted">Прогноз остатка, риски нехватки денег и сценарии на выбранный период</div>
            </div>
            <div class="page-actions">
                <select class="input" style="width:auto" @bind="forecastDays" @bind:after="LoadForecast">
                    <option value="30">30 дней</option>
                    <option value="60">60 дней</option>
                    <option value="90">90 дней</option>
                </select>
                <button class="btn btn-outline" @onclick="LoadForecast" disabled="@isLoading">Обновить</button>
            </div>
        </div>

            @if (isLoading) {
                <div class="loading-state">
                    <div class="spinner"></div>
                </div>
            }
            else if (!hasData) {
                <div class="empty-state">
                    <div class="empty-state-icon" aria-hidden="true">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--text-tertiary)">
                            <path d="M3 3v18h18"/>
                            <path d="M7 16l4-6 4 3 5-8"/>
                        </svg>
                    </div>
                    <div class="empty-state-title">Недостаточно данных</div>
                    <div class="empty-state-text">Добавьте транзакции и запланированные платежи, чтобы построить прогноз.</div>
                    <a href="/transactions" class="btn btn-outline mt-3">Перейти к транзакциям</a>
                </div>
            }
            else {
                @if (forecast.HasRisk) {
                    <div class="alert alert-danger d-flex align-items-center mb-4">
                        <span style="font-size: 1.5rem; margin-right: 12px;">⚠️</span>
                        <div>
                            <div class="fw-bold">Обнаружен риск: @GetRiskLabel(forecast.RiskLevel)</div>
                            <div class="small">Минимальный остаток составит @forecast.MinBalance.ToString("N0") Br.</div>
                        </div>
                    </div>
                }

                <div class="kpi-grid mb-4">
                    <div class="kpi-card">
                        <div class="kpi-label">Текущий баланс</div>
                        <div class="kpi-value">@forecast.CurrentBalance.ToString("N0") <span class="small muted">Br</span></div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-label">Дней до разрыва</div>
                        <div class="kpi-value @(forecast.Gaps.Any() ? "text-danger" : "text-success")">
                            @GetDaysToGap()
                        </div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-label">Итог периода</div>
                        <div class="kpi-value @(forecast.BaseScenario.FinalBalance < 0 ? "text-danger" : "text-success")">
                            @forecast.BaseScenario.FinalBalance.ToString("N0")
                        </div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr; @(GetWideLayoutStyles()) gap: 24px;">
                    <div style="min-width: 0;">
                        <div class="card chart-panel mb-4">
                            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span>Динамика остатков (Базовый сценарий)</span>
                                <div class="small text-muted d-flex gap-3 flex-wrap">
                                    <span><span class="chart-legend-dot" style="background:var(--chart-teal)"></span> Остаток</span>
                                    <span><span class="chart-legend-dot" style="background:rgba(239,68,68,.5)"></span> Разрыв</span>
                                    @if (minCashThreshold > 0)
                                    {
                                        <span><span class="chart-legend-dot" style="background:rgba(245,158,11,.8)"></span> Порог @minCashThreshold.ToString("N0") Br</span>
                                    }
                                </div>
                            </div>
                            <div class="card-body">
                                @if (forecast.BaseScenario.Points.Any())
                                {
                                    <div class="chart-canvas-wrap" style="height:260px">
                                        <canvas id="@_balanceChartId" aria-label="Динамика остатков"></canvas>
                                    </div>
                                }
                                else
                                {
                                    <div class="empty-state small">Нет точек для графика</div>
                                }
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header">Периоды дефицита средств</div>
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Период</th>
                                            <th>Длительность</th>
                                            <th>Дефицит</th>
                                            <th class="text-end">Статус</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var gap in forecast.Gaps) {
                                            <tr>
                                                <td class="fw-bold">@gap.StartDate.ToString("dd.MM") — @(gap.EndDate?.ToString("dd.MM") ?? "...")</td>
                                                <td>@gap.Duration дн.</td>
                                                <td class="text-danger fw-bold">@gap.MinBalance.ToString("N0") Br</td>
                                                <td class="text-end">
                                                    <span class="severity-badge @GetSeverityClass(gap.Severity)">
                                                        @GetSeverityLabel(gap.Severity)
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                        @if (!forecast.Gaps.Any()) {
                                            <tr>
                                                <td colspan="4" class="text-center py-5">
                                                    <div class="text-success fw-bold">Разрывов не обнаружено</div>
                                                    <div class="small text-muted">Ваша ликвидность в порядке</div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="card mb-4">
                            <div class="card-header">Сценарии прогноза</div>
                            <div class="card-body">
                                @foreach (var s in new[] { forecast.OptimisticScenario, forecast.BaseScenario, forecast.PessimisticScenario }) {
                                    <div class="mb-4">
                                        <div class="d-flex justify-content-between mb-1" style="font-size: 13px;">
                                            <span class="text-secondary">@s.Name</span>
                                            <span class="fw-bold">@s.FinalBalance.ToString("N0") Br</span>
                                        </div>
                                        <div style="height: 6px; background: var(--bg); border-radius: 10px; overflow: hidden;">
                                            <div style="height: 100%; width: @GetScenarioPercent(s.FinalBalance)%; background: @GetScenarioColor(s.Name); transition: width 0.6s ease;"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="card mb-4">
                            <div class="card-header">Сценарии «что если»</div>
                            <div class="card-body">
                                <label class="form-label">Рост расходов: @expenseAdjustPercent%</label>
                                <input type="range" min="0" max="30" step="5" @bind="expenseAdjustPercent" @bind:event="oninput" @onchange="LoadForecast" class="w-100" />
                                <label class="form-label mt-3">Задержка поступлений: @incomeDelayDays дн.</label>
                                <input type="range" min="0" max="14" step="1" @bind="incomeDelayDays" @bind:event="oninput" @onchange="LoadForecast" class="w-100" />
                                <div class="small text-muted mt-2">Порог остатка: @minCashThreshold.ToString("N0") BYN <a href="/settings">изменить</a></div>
                            </div>
                        </div>

                        <div class="card shadow-sm" style="background: var(--accent-weak); border-color: var(--accent); border-style: dashed;">
                            <div class="card-body">
                                <h3 style="color: var(--accent); font-size: 15px;" class="mb-2">Рекомендации</h3>
                                <ul class="recommendations small" style="margin:0;padding-left:1.2rem">
                                    @foreach (var rec in forecast.Recommendations)
                                    {
                                        <li>@rec</li>
                                    }
                                </ul>
                                @if (forecast.DaysBelowMinCash > 0 && minCashThreshold > 0)
                                {
                                    <p class="small text-danger mt-2">@forecast.DaysBelowMinCash дн. ниже порога @minCashThreshold.ToString("N0") BYN</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
    </Authorized>
</AuthorizeView>

@code {
    private bool isLoading = true;
    private bool hasData = false;
    private int forecastDays = 90;
    private decimal expenseAdjustPercent;
    private int incomeDelayDays;
    private decimal minCashThreshold = 1000;
    private AdvancedCashForecast forecast = new();
    private readonly string _balanceChartId = $"cashForecastBalance_{Guid.NewGuid():N}";

    protected override async Task OnInitializedAsync() => await LoadForecast();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && hasData)
            await RenderBalanceChartAsync();
    }

    private async Task LoadForecast() {
        isLoading = true;
        try {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (user == null) return;

            var tx = await DbContext.Transactions.Where(t => t.UserId == user.Id && t.IsConfirmed).ToListAsync();
            var rem = await DbContext.Reminders.Where(r => r.UserId == user.Id && !r.IsArchived).ToListAsync();
            var taxes = await DbContext.TaxPayments.Where(t => t.UserId == user.Id && !t.IsPaid).ToListAsync();

            var org = await DbContext.OrganizationSettings.AsNoTracking()
                .FirstOrDefaultAsync(s => s.UserId == user.Id);
            minCashThreshold = org?.MinCashBalance ?? 1000;

            if (!tx.Any()) {
                hasData = false;
                return;
            }

            forecast = ForecastingService.ForecastCashGapsAdvanced(
                tx, rem, taxes, forecastDays, expenseAdjustPercent, incomeDelayDays, minCashThreshold);
            hasData = true;
        }
        catch (Exception ex) {
            Console.WriteLine($"Error loading forecast: {ex.Message}");
        }
        finally {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RenderBalanceChartAsync()
    {
        var points = forecast.BaseScenario.Points;
        if (points == null || points.Count == 0) return;

        try
        {
            var labels = points.Select(p => p.Date.ToString("dd.MM")).ToArray();
            var balances = points.Select(p => (double)p.Balance).ToArray();
            var gapRanges = BuildGapIndexRanges(points, forecast.Gaps);
            await JS.InvokeVoidAsync("dashboardCharts.renderForecastChart",
                _balanceChartId, labels, balances, gapRanges, (double)minCashThreshold);
        }
        catch { }
    }

    private static int[][] BuildGapIndexRanges(List<ScenarioPoint> points, List<CashGap> gaps)
    {
        if (points.Count == 0 || gaps.Count == 0) return [];

        return gaps.Select(g =>
        {
            var endDate = (g.EndDate ?? g.StartDate).Date;
            var startIdx = points.FindIndex(p => p.Date.Date >= g.StartDate.Date);
            if (startIdx < 0) startIdx = 0;
            var endIdx = points.FindIndex(p => p.Date.Date >= endDate);
            if (endIdx < 0) endIdx = points.Count - 1;
            return new[] { startIdx, Math.Max(startIdx, endIdx) };
        }).ToArray();
    }

    private string GetDaysToGap() {
        var gap = forecast.Gaps.OrderBy(g => g.StartDate).FirstOrDefault();
        if (gap == null) return "Нет";
        var d = (gap.StartDate - DateTime.Today).Days;
        return d <= 0 ? "Сегодня" : $"{d} дн.";
    }

    private string GetWideLayoutStyles() => "grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));";

    private string GetRiskClass() => forecast.RiskLevel switch {
        "critical" or "high" => "alert-danger",
        "medium" => "alert-warning",
        _ => "alert-info"
    };

    private string GetRiskLabel(string l) => l switch {
        "critical" => "Критический",
        "high" => "Высокий",
        "medium" => "Средний",
        _ => "Низкий"
    };

    private string GetSeverityClass(GapSeverity s) => s switch {
        GapSeverity.Critical => "severity-critical",
        GapSeverity.High => "severity-high",
        GapSeverity.Medium => "severity-medium",
        _ => "severity-low"
    };

    private string GetSeverityLabel(GapSeverity s) => s switch {
        GapSeverity.Critical => "Критическая",
        GapSeverity.High => "Высокая",
        GapSeverity.Medium => "Средняя",
        _ => "Низкая"
    };

    private string GetScenarioColor(string n) => 
        n.Contains("Опт") ? "var(--success)" : 
        n.Contains("Пес") ? "var(--danger)" : "var(--accent)";

    private double GetScenarioPercent(decimal b) {
        var m = Math.Max(forecast.OptimisticScenario.FinalBalance, 1);
        return Math.Clamp((double)(b / m * 100), 10, 100);
    }
}

<style>
    .table thead th { border-top: none; }
    .kpi-card { transition: transform 0.2s; }
    .kpi-card:hover { transform: translateY(-2px); }
    .chart-legend-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: 4px;
        vertical-align: middle;
    }

    @@media (min-width: 992px) {
        .main { padding: 32px 48px; }
    }
</style>
@page "/account"
@page "/profile"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using MiniFinance.Services
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ApplicationDbContext DbContext
@inject IAccountProfileService AccountProfile
@inject ITwoFactorService TwoFactorService
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@attribute [Authorize]
@implements IDisposable

<PageTitle>Профиль — MiniFinance</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (currentUser == null)
        {
            <div class="loading-state"><div class="spinner"></div></div>
        }
        else
        {
            <div class="page-header">
                <div class="title">
                    <h1>Профиль</h1>
                    <div class="meta text-muted" style="display:flex;align-items:center;flex-wrap:wrap;gap:8px">
                        <span>@DisplayName · @userEmail</span>
                        @if (!string.IsNullOrEmpty(_userRole))
                        {
                            <RoleBadge Role="@_userRole" Title="Роль в MiniFinance" />
                        }
                    </div>
                </div>
            </div>

            @if (showMessage) { <div class="alert alert-success mb-3">@message</div> }
            @if (showError) { <div class="alert alert-error mb-3">@errorMessage</div> }

            <div class="hub-layout">
                <nav class="hub-nav card">
                    <button type="button" class="hub-nav-item @(_tab == "personal" ? "active" : "")" @onclick='() => SelectTab("personal")'>Личные данные</button>
                    <button type="button" class="hub-nav-item @(_tab == "security" ? "active" : "")" @onclick='() => SelectTab("security")'>Безопасность</button>
                    <button type="button" class="hub-nav-item @(_tab == "notifications" ? "active" : "")" @onclick='() => SelectTab("notifications")'>Уведомления</button>
                    <button type="button" class="hub-nav-item @(_tab == "data" ? "active" : "")" @onclick='() => SelectTab("data")'>Данные</button>
                </nav>

                <div class="hub-content">
                    @if (_tab == "personal")
                    {
                        <div class="card mb-3">
                            <div class="card-header">Личная информация</div>
                            <div class="card-body">
                                <EditForm Model="@profileModel" OnValidSubmit="SaveProfile" Context="profileForm">
                                    <RussianDataAnnotationsValidator />
                                    <RussianValidationSummary class="text-danger mb-2" />
                                    <div class="form-grid">
                                        <div class="form-group">
                                            <label class="form-label">Имя</label>
                                            <InputText class="form-input" @bind-Value="profileModel.FirstName" maxlength="@AuthFieldValidation.MaxNameLength" />
                                            <RussianValidationMessage For="() => profileModel.FirstName" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Фамилия</label>
                                            <InputText class="form-input" @bind-Value="profileModel.LastName" maxlength="@AuthFieldValidation.MaxNameLength" />
                                            <RussianValidationMessage For="() => profileModel.LastName" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Email</label>
                                            <InputText type="email" class="form-input" @bind-Value="profileModel.Email" maxlength="@AuthFieldValidation.MaxEmailLength" />
                                            <RussianValidationMessage For="() => profileModel.Email" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Телефон</label>
                                            <InputText class="form-input" @bind-Value="profileModel.Phone" placeholder="+375..." maxlength="@AuthFieldValidation.MaxPhoneLength" />
                                            <RussianValidationMessage For="() => profileModel.Phone" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Логин</label>
                                            <input class="form-input" value="@currentUser.UserName" disabled />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Роль</label>
                                            <div class="form-input" style="display:flex;align-items:center;min-height:42px;background:var(--bg-muted)">
                                                @if (!string.IsNullOrEmpty(_userRole))
                                                {
                                                    <RoleBadge Role="@_userRole" />
                                                }
                                            </div>
                                            <div class="small text-muted">
                                                @if (!string.IsNullOrEmpty(_userRole))
                                                {
                                                    @AppRoles.GetDescription(_userRole)
                                                }
                                                else
                                                {
                                                    <span>Роль назначает администратор в разделе «Команда»</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <button type="submit" class="btn btn-primary">Сохранить</button>
                                    </div>
                                </EditForm>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header">Сводка учёта</div>
                            <div class="card-body">
                                <div class="kpi-grid" style="grid-template-columns:repeat(auto-fit,minmax(140px,1fr))">
                                    <div>
                                        <div class="small text-muted">Баланс</div>
                                        <div class="fw-bold @(_balance >= 0 ? "text-success" : "text-danger")">@_balance.ToString("N0") <Byn /></div>
                                    </div>
                                    <div>
                                        <div class="small text-muted">Операций</div>
                                        <div class="fw-bold">@totalTransactions</div>
                                    </div>
                                    <div>
                                        <div class="small text-muted">С нами с</div>
                                        <div class="fw-bold">@(userCreatedDate?.ToString("dd.MM.yyyy") ?? "—")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_tab == "security")
                    {
                        <div class="card mb-3">
                            <div class="card-header">Пароль</div>
                            <div class="card-body">
                                @if (!isChangingPassword)
                                {
                                    <p class="text-muted small mb-3">Рекомендуется менять пароль раз в 3–6 месяцев.</p>
                                    <button class="btn btn-outline" @onclick="() => isChangingPassword = true">Изменить пароль</button>
                                }
                                else
                                {
                                    <EditForm Model="@passwordModel" OnValidSubmit="ChangePassword" Context="passwordForm">
                                        <RussianDataAnnotationsValidator />
                                        <RussianValidationSummary class="text-danger mb-2" />
                                        <div class="form-grid">
                                            <div class="form-group">
                                                <label class="form-label">Текущий пароль</label>
                                                <InputText type="password" class="form-input" @bind-Value="passwordModel.OldPassword" maxlength="@AuthFieldValidation.MaxPasswordLength" />
                                                <RussianValidationMessage For="() => passwordModel.OldPassword" />
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Новый пароль</label>
                                                <InputText type="password" class="form-input" @bind-Value="passwordModel.NewPassword" maxlength="@AuthFieldValidation.MaxPasswordLength" />
                                                <div class="small text-muted">Минимум @AuthFieldValidation.MinPasswordLength символов, хотя бы одна цифра</div>
                                                <RussianValidationMessage For="() => passwordModel.NewPassword" />
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Подтверждение</label>
                                                <InputText type="password" class="form-input" @bind-Value="passwordModel.ConfirmPassword" maxlength="@AuthFieldValidation.MaxPasswordLength" />
                                                <RussianValidationMessage For="() => passwordModel.ConfirmPassword" />
                                            </div>
                                        </div>
                                        <div class="mt-3" style="display:flex;gap:8px">
                                            <button type="submit" class="btn btn-primary">Сохранить пароль</button>
                                            <button type="button" class="btn btn-outline" @onclick="CancelChangePassword">Отмена</button>
                                        </div>
                                    </EditForm>
                                }
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header">Двухфакторная аутентификация (2FA)</div>
                            <div class="card-body">
                                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
                                    <div>
                                        <div class="fw-bold">@(_twoFactorEnabled ? "Включена" : "Отключена")</div>
                                        <div class="small text-muted">
                                            При входе на email приходит одноразовый код (без приложения-аутентификатора).
                                        </div>
                                    </div>
                                    <label class="form-check" style="display:flex;align-items:center;gap:10px;margin:0;cursor:pointer">
                                        <input type="checkbox"
                                               checked="@_twoFactorEnabled"
                                               disabled="@_twoFactorBusy"
                                               @onchange="OnTwoFactorToggle" />
                                        <span>@(_twoFactorEnabled ? "Выкл" : "Вкл")</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_tab == "notifications")
                    {
                        <div class="card">
                            <div class="card-header">Email-уведомления</div>
                            <div class="card-body">
                                <div class="form-grid">
                                    <label class="form-check" style="display:flex;align-items:center;gap:8px">
                                        <input type="checkbox" @bind="enableNotifications" />
                                        <span>Включить email-уведомления</span>
                                    </label>
                                    <label class="form-check" style="display:flex;align-items:center;gap:8px">
                                        <input type="checkbox" @bind="notifyTaxes" />
                                        <span>Налоги и сроки уплаты</span>
                                    </label>
                                    <label class="form-check" style="display:flex;align-items:center;gap:8px">
                                        <input type="checkbox" @bind="notifyBills" />
                                        <span>Счета к оплате</span>
                                    </label>
                                    <label class="form-check" style="display:flex;align-items:center;gap:8px">
                                        <input type="checkbox" @bind="notifyCashGaps" />
                                        <span>Прогноз кассовых разрывов</span>
                                    </label>
                                    <div class="form-group">
                                        <label class="form-label">Напоминать за (дней до срока)</label>
                                        <select class="form-input" @bind="notificationDaysBefore">
                                            <option value="7">7 дней</option>
                                            <option value="3">3 дня</option>
                                            <option value="1">1 день</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-primary" @onclick="SaveNotifications">Сохранить</button>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_tab == "data")
                    {
                        <div class="card mb-3">
                            <div class="card-header">Ваши данные в системе</div>
                            <div class="card-body">
                                @if (_dataSummary == null)
                                {
                                    <div class="loading-state"><div class="spinner"></div></div>
                                }
                                else
                                {
                                    <div class="kpi-grid" style="grid-template-columns:repeat(auto-fit,minmax(120px,1fr))">
                                        <div><div class="small text-muted">Операций</div><div class="fw-bold">@_dataSummary.Transactions</div></div>
                                        <div><div class="small text-muted">Проектов</div><div class="fw-bold">@_dataSummary.Projects</div></div>
                                        <div><div class="small text-muted">Напоминаний</div><div class="fw-bold">@_dataSummary.Reminders</div></div>
                                        <div><div class="small text-muted">Налогов</div><div class="fw-bold">@_dataSummary.TaxPayments</div></div>
                                        <div><div class="small text-muted">Контрагентов</div><div class="fw-bold">@_dataSummary.Counterparties</div></div>
                                        <div><div class="small text-muted">Долгов</div><div class="fw-bold">@_dataSummary.Debts</div></div>
                                        <div><div class="small text-muted">Тегов</div><div class="fw-bold">@_dataSummary.Tags</div></div>
                                        <div><div class="small text-muted">Вложений</div><div class="fw-bold">@_dataSummary.Attachments</div></div>
                                    </div>
                                    <p class="small text-muted mt-3 mb-0">
                                        Баланс: <span class="@(_dataSummary.Balance >= 0 ? "text-success" : "text-danger") fw-bold">@_dataSummary.Balance.ToString("N0") <Byn /></span>
                                    </p>
                                }
                            </div>
                        </div>

                        <div class="card mb-3">
                            <div class="card-header">Экспорт данных</div>
                            <div class="card-body">
                                <p class="text-muted small mb-3">
                                    JSON — полная копия (профиль, операции, проекты, напоминания, налоги, контрагенты, долги, теги).
                                    CSV — только операции для Excel или повторного импорта.
                                </p>
                                <div style="display:flex;flex-wrap:wrap;gap:8px">
                                    <button type="button" class="btn btn-outline" @onclick="DownloadJson">Скачать JSON</button>
                                    <button type="button" class="btn btn-outline" @onclick="DownloadCsv">Скачать CSV (операции)</button>
                                    <a href="/import" class="btn btn-outline">Импорт из CSV</a>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-3" style="border-color:var(--danger)">
                            <div class="card-header" style="color:var(--danger)">Удаление аккаунта</div>
                            <div class="card-body">
                                <p class="small text-muted mb-3">Действие необратимо. Сначала экспортируйте данные.</p>
                                @if (!_showDeleteConfirm)
                                {
                                    <button class="btn btn-outline-danger" @onclick="() => _showDeleteConfirm = true">Удалить аккаунт</button>
                                }
                                else
                                {
                                    <form method="post" action="/Account/Delete">
                                        @if (_deleteAfTokens is not null)
                                        {
                                            <input type="hidden" name="@_deleteAfTokens.FormFieldName" value="@_deleteAfTokens.RequestToken" />
                                        }
                                        <div class="form-group mb-2">
                                            <label class="form-label" for="delete-password">Подтвердите паролем</label>
                                            <input id="delete-password" type="password" name="password" class="form-input" autocomplete="current-password" required />
                                        </div>
                                        <div style="display:flex;gap:8px">
                                            <button type="submit" class="btn btn-danger">Удалить навсегда</button>
                                            <button type="button" class="btn btn-outline" @onclick="() => _showDeleteConfirm = false">Отмена</button>
                                        </div>
                                    </form>
                                }
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-body" style="display:flex;justify-content:space-between;align-items:center">
                                <span class="text-muted small">Завершить текущую сессию</span>
                                <button class="btn btn-outline-danger btn-sm" @onclick="Logout">Выйти</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="empty-state">
            <a href="/login" class="btn btn-primary">Войти</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private ApplicationUser? currentUser;
    private string userEmail = "";
    private string DisplayName => string.IsNullOrWhiteSpace($"{profileModel.FirstName} {profileModel.LastName}".Trim())
        ? currentUser?.UserName ?? ""
        : $"{profileModel.FirstName} {profileModel.LastName}".Trim();

    private string _tab = "personal";
    private bool showMessage;
    private string message = "";
    private bool showError;
    private string errorMessage = "";

    private bool isChangingPassword;
    private string _userRole = "";
    private bool _twoFactorEnabled;
    private bool _twoFactorBusy;
    private bool enableNotifications = true;
    private bool notifyTaxes = true;
    private bool notifyBills = true;
    private bool notifyCashGaps = true;
    private int notificationDaysBefore = 3;

    private bool _showDeleteConfirm;
    private AntiforgeryTokenSet? _deleteAfTokens;

    [SupplyParameterFromQuery(Name = "deleteError")]
    public string? DeleteErrorQuery { get; set; }

    [SupplyParameterFromQuery(Name = "deleteDetail")]
    public string? DeleteDetailQuery { get; set; }

    private decimal _balance;
    private int totalTransactions;
    private DateTime? userCreatedDate;
    private AccountDataSummaryDto? _dataSummary;

    private ProfileModel profileModel = new();
    private ChangePasswordModel passwordModel = new();

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        if (!string.IsNullOrWhiteSpace(TabQuery) && TabQuery is "personal" or "security" or "notifications" or "data")
            _tab = TabQuery;

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
            _deleteAfTokens = Antiforgery.GetAndStoreTokens(httpContext);

        ApplyDeleteQueryErrors();
        await LoadProfileAsync();
    }

    private void ApplyDeleteQueryErrors()
    {
        if (string.IsNullOrWhiteSpace(DeleteErrorQuery))
            return;

        _tab = "data";
        _showDeleteConfirm = true;
        showError = true;
        errorMessage = DeleteErrorQuery switch
        {
            "password" => "Введите пароль для подтверждения удаления.",
            "session" => "Сессия истекла. Обновите страницу (F5) и повторите.",
            "empty" => "Заполните пароль.",
            "failed" => string.IsNullOrWhiteSpace(DeleteDetailQuery)
                ? "Не удалось удалить аккаунт."
                : DeleteDetailQuery,
            _ => "Не удалось удалить аккаунт."
        };
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> _)
    {
        try
        {
            await LoadProfileAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Схема может завершаться при выходе / удалении аккаунта
        }
    }

    private async Task LoadProfileAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userRole = RoleAccessSnapshot.FromPrincipal(auth.User).PrimaryRole;

        currentUser = await UserManager.GetUserAsync(auth.User);
        if (currentUser == null) return;

        userEmail = currentUser.Email ?? "";
        userCreatedDate = currentUser.CreatedAt ?? DateTime.UtcNow;
        profileModel = new ProfileModel
        {
            FirstName = currentUser.FirstName ?? "",
            LastName = currentUser.LastName ?? "",
            Email = currentUser.Email ?? "",
            Phone = currentUser.PhoneNumber ?? ""
        };

        enableNotifications = currentUser.EnableNotifications;
        notifyTaxes = currentUser.NotifyTaxes;
        notifyBills = currentUser.NotifyBills;
        notifyCashGaps = currentUser.NotifyCashGaps;
        notificationDaysBefore = currentUser.NotificationDaysBefore;
        _twoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(currentUser);

        var txs = await DbContext.Transactions.Where(t => t.UserId == currentUser.Id).ToListAsync();
        totalTransactions = txs.Count;
        _balance = txs.Sum(t => t.Amount);
    }

    private async Task SelectTab(string tab)
    {
        _tab = tab;
        showMessage = false;
        showError = false;
        if (tab == "data" && currentUser != null)
            await LoadDataSummaryAsync();
    }

    private async Task LoadDataSummaryAsync()
    {
        if (currentUser == null) return;
        _dataSummary = await AccountProfile.GetDataSummaryAsync(currentUser.Id);
    }

    private void DownloadJson() =>
        NavigationManager.NavigateTo("/api/account/export", forceLoad: true);

    private void DownloadCsv() =>
        NavigationManager.NavigateTo("/api/account/export/csv", forceLoad: true);

    private async Task SaveProfile()
    {
        if (currentUser == null) return;
        showError = false;
        showMessage = false;
        currentUser.FirstName = profileModel.FirstName?.Trim();
        currentUser.LastName = profileModel.LastName?.Trim();
        currentUser.PhoneNumber = profileModel.Phone?.Trim();

        var email = AuthFieldValidation.NormalizeEmail(profileModel.Email);
        var emailCheck = AuthFieldValidation.ValidateEmail(email);
        if (!emailCheck.Ok)
        {
            errorMessage = emailCheck.Error ?? "Некорректный email";
            showError = true;
            return;
        }

        var phoneCheck = AuthFieldValidation.ValidatePhone(profileModel.Phone);
        if (!phoneCheck.Ok)
        {
            errorMessage = phoneCheck.Error ?? "Некорректный телефон";
            showError = true;
            return;
        }

        IdentityResult result;
        if (!string.Equals(currentUser.Email, email, StringComparison.OrdinalIgnoreCase))
        {
            result = await UserManager.SetEmailAsync(currentUser, email);
            if (result.Succeeded)
                result = await UserManager.SetUserNameAsync(currentUser, email);
        }
        else
        {
            result = IdentityResult.Success;
        }

        if (result.Succeeded)
            result = await UserManager.UpdateAsync(currentUser);

        if (result.Succeeded)
        {
            message = "Профиль сохранён";
            showMessage = true;
            userEmail = currentUser.Email ?? "";
        }
        else
        {
            errorMessage = IdentityErrorTranslator.Join(result.Errors);
            showError = true;
        }
    }

    private async Task SaveNotifications()
    {
        if (currentUser == null) return;
        currentUser.EnableNotifications = enableNotifications;
        currentUser.NotifyTaxes = notifyTaxes;
        currentUser.NotifyBills = notifyBills;
        currentUser.NotifyCashGaps = notifyCashGaps;
        currentUser.NotificationDaysBefore = notificationDaysBefore;
        var result = await UserManager.UpdateAsync(currentUser);
        if (result.Succeeded)
        {
            message = "Настройки уведомлений сохранены";
            showMessage = true;
        }
        else
        {
            errorMessage = IdentityErrorTranslator.Join(result.Errors);
            showError = true;
        }
    }

    private void CancelChangePassword()
    {
        isChangingPassword = false;
        passwordModel = new();
    }

    private async Task OnTwoFactorToggle(ChangeEventArgs e)
    {
        if (currentUser == null) return;
        var enable = e.Value is bool b && b;
        if (enable == _twoFactorEnabled) return;

        _twoFactorBusy = true;
        showError = false;
        showMessage = false;
        try
        {
            var (ok, error) = await TwoFactorService.SetEnabledAsync(currentUser, enable);
            if (ok)
            {
                _twoFactorEnabled = enable;
                message = enable ? "2FA включена. При входе код придёт на email." : "2FA отключена.";
                showMessage = true;
            }
            else
            {
                errorMessage = error ?? "Не удалось изменить настройку 2FA";
                showError = true;
            }
        }
        finally
        {
            _twoFactorBusy = false;
        }
    }

    private async Task ChangePassword()
    {
        if (currentUser == null) return;

        var newPwd = AuthFieldValidation.ValidatePassword(passwordModel.NewPassword);
        if (!newPwd.Ok)
        {
            errorMessage = newPwd.Error ?? "Некорректный пароль";
            showError = true;
            return;
        }

        if (!string.Equals(passwordModel.NewPassword, passwordModel.ConfirmPassword, StringComparison.Ordinal))
        {
            errorMessage = "Пароли не совпадают.";
            showError = true;
            return;
        }

        if (string.IsNullOrEmpty(passwordModel.OldPassword))
        {
            errorMessage = "Введите текущий пароль.";
            showError = true;
            return;
        }

        var result = await UserManager.ChangePasswordAsync(currentUser, passwordModel.OldPassword, passwordModel.NewPassword);
        if (result.Succeeded)
        {
            message = "Пароль изменён";
            showMessage = true;
            isChangingPassword = false;
            passwordModel = new();
        }
        else
        {
            errorMessage = IdentityErrorTranslator.Join(result.Errors);
            showError = true;
        }
    }

    private async Task Logout()
    {
        await SignInManager.SignOutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose() =>
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;

    public class ProfileModel
    {
        [StringLength(AuthFieldValidation.MaxNameLength, ErrorMessage = "Слишком длинное имя")]
        public string FirstName { get; set; } = "";

        [StringLength(AuthFieldValidation.MaxNameLength, ErrorMessage = "Слишком длинная фамилия")]
        public string LastName { get; set; } = "";

        [Required(ErrorMessage = "Email обязателен")]
        [ValidAuthEmail]
        public string Email { get; set; } = "";

        [ValidPhone]
        public string Phone { get; set; } = "";
    }

    public class ChangePasswordModel
    {
        [Required(ErrorMessage = "Введите текущий пароль")]
        [StringLength(AuthFieldValidation.MaxPasswordLength)]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Введите новый пароль")]
        [ValidAuthPassword]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Подтвердите пароль")]
        [Compare(nameof(NewPassword), ErrorMessage = "Пароли не совпадают.")]
        public string ConfirmPassword { get; set; } = "";
    }
}

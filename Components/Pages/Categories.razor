@page "/categories"
@rendermode InteractiveServer
@using MiniFinance.Data.Models
@using MiniFinance.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using MiniFinance.Data
@inject ApplicationDbContext DbContext
@inject ICategorizationService CategorizationService
@inject IJSRuntime JS
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>Категории - MiniFinance</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="page-header">
            <div class="title">
                <h1>Категории</h1>
                <div class="meta text-muted">Управление категориями расходов и доходов</div>
            </div>
            <div class="page-actions">
                <button class="btn btn-primary" @onclick="() => showAddForm = true">Добавить категорию</button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_catMessage))
        {
            <div class="alert @(_catError ? "alert-danger" : "alert-success") mb-3">@_catMessage</div>
        }

        @if (showAddForm)
        {
            <div class="card mb-3">
                <div class="card-header">Новая категория</div>
                <div class="card-body">
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem">
                        <div>
                            <label class="label">Название *</label>
                            <input class="input" placeholder="Название категории" @bind="newName" />
                        </div>
                        <div>
                            <label class="label">Тип</label>
                            <select class="input" @bind="newType">
                                <option value="@CategoryType.Expense">Расход</option>
                                <option value="@CategoryType.Income">Доход</option>
                            </select>
                        </div>
                        <div>
                            <label class="label">Иконка</label>
                            <input class="input" placeholder="receipt" @bind="newIcon" />
                        </div>
                        <div>
                            <label class="label">Цвет</label>
                            <input class="input" type="color" @bind="newColor" />
                        </div>
                        <div style="grid-column:1/-1">
                            <label class="label">Ключевые слова для авто-категоризации</label>
                            <input class="input" placeholder="аренда, rent, офис (через запятую)" @bind="newKeywords" />
                        </div>
                    </div>
                    <div style="margin-top:1rem;display:flex;gap:.5rem">
                        <button class="btn btn-primary" @onclick="CreateCategory">Сохранить</button>
                        <button class="btn btn-outline" @onclick="() => showAddForm = false">Отмена</button>
                    </div>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-body" style="padding:0">
                @if (categories == null)
                {
                    <div class="center text-muted py-4">Загрузка...</div>
                }
                else if (!categories.Any())
                {
                    <div class="empty-state">Нет категорий</div>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Название</th>
                                <th>Тип</th>
                                <th>Ключевые слова</th>
                                <th class="text-center">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in categories)
                            {
                                <tr>
                                    <td>
                                        @if (editId == cat.Id)
                                        {
                                            <input class="input" @bind="editName" />
                                        }
                                        else
                                        {
                                            @cat.Name
                                        }
                                    </td>
                                    <td>
                                        @if (editId == cat.Id)
                                        {
                                            <select class="input" @bind="editType" style="width:140px">
                                                <option value="@CategoryType.Expense">Расход</option>
                                                <option value="@CategoryType.Income">Доход</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <span class="badge @(cat.Type == CategoryType.Income ? "badge-success" : "badge-danger")">
                                                @((cat.Type == CategoryType.Income) ? "Доход" : "Расход")
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (editId == cat.Id)
                                        {
                                            <input class="input" @bind="editKeywords" placeholder="аренда, rent (через запятую)" />
                                        }
                                        else
                                        {
                                            @if (!string.IsNullOrWhiteSpace(cat.Keywords))
                                            {
                                                <span class="small text-muted">@cat.Keywords</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (editId == cat.Id)
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick="() => SaveEdit(cat.Id)">Сохранить</button>
                                            <button class="btn btn-sm btn-outline" @onclick="CancelEdit">Отмена</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline" @onclick="() => StartEdit(cat)">Изменить</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(cat.Id)">Удалить</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private List<Category>? categories;
    private string newName = string.Empty;
    private CategoryType newType = CategoryType.Expense;
    private string newKeywords = string.Empty;
    private string newIcon = string.Empty;
    private string newColor = "#7c3aed";
    private bool showAddForm = false;

    private int editId = 0;
    private string editName = string.Empty;
    private CategoryType editType = CategoryType.Expense;
    private string editKeywords = string.Empty;
    private string? _catMessage;
    private bool _catError;

    protected override async Task OnInitializedAsync()
    {
        await CategorizationService.EnsureDefaultCategoriesAsync();
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        categories = await DbContext.Categories.OrderBy(c => c.Name).ToListAsync();
        StateHasChanged();
    }

    private async Task CreateCategory()
    {
        _catMessage = null;
        if (string.IsNullOrWhiteSpace(newName))
        {
            _catMessage = "Укажите название категории";
            _catError = true;
            return;
        }
        try
        {
            var trimmed = newName.Trim();
            if (await DbContext.Categories.AnyAsync(c => c.Name.ToLower() == trimmed.ToLower()))
                throw new InvalidOperationException("Категория уже существует");

            DbContext.Categories.Add(new Category
            {
                Name = trimmed,
                Type = newType,
                Keywords = string.IsNullOrWhiteSpace(newKeywords) ? null : newKeywords.Trim(),
                Icon = string.IsNullOrWhiteSpace(newIcon) ? null : newIcon.Trim(),
                Color = string.IsNullOrWhiteSpace(newColor) ? null : newColor
            });
            await DbContext.SaveChangesAsync();
            newName = string.Empty;
            newType = CategoryType.Expense;
            newKeywords = string.Empty;
            showAddForm = false;
            _catMessage = "Категория добавлена";
            _catError = false;
            await LoadCategories();
        }
        catch (Exception ex)
        {
            _catMessage = ex.Message;
            _catError = true;
        }
    }

    private void StartEdit(Category c)
    {
        editId = c.Id;
        editName = c.Name;
        editType = c.Type;
        editKeywords = c.Keywords ?? string.Empty;
    }

    private void CancelEdit()
    {
        editId = 0;
        editName = string.Empty;
        editKeywords = string.Empty;
    }

    private async Task SaveEdit(int id)
    {
        _catMessage = null;
        if (string.IsNullOrWhiteSpace(editName))
        {
            _catMessage = "Укажите название категории";
            _catError = true;
            return;
        }
        try
        {
            await CategorizationService.UpdateCategoryAsync(id, editName, editType, editKeywords);
            CancelEdit();
            _catMessage = "Категория сохранена";
            _catError = false;
            await LoadCategories();
        }
        catch (Exception ex)
        {
            _catMessage = ex.Message;
            _catError = true;
        }
    }

    private async Task ConfirmDelete(int id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Удалить категорию?");
        if (!ok) return;

        var cat = await DbContext.Categories.FindAsync(id);
        if (cat == null) return;

        var used = await DbContext.Transactions.AnyAsync(t => t.Category == cat.Name);
        if (used)
        {
            // Reassign transactions to 'Прочее' category
            var other = await DbContext.Categories.FirstOrDefaultAsync(c => c.Name == "Прочее");
            if (other == null)
            {
                other = new Category { Name = "Прочее", Type = CategoryType.Expense, IsDefault = true };
                DbContext.Categories.Add(other);
                await DbContext.SaveChangesAsync();
            }

            var tx = await DbContext.Transactions.Where(t => t.Category == cat.Name).ToListAsync();
            foreach (var t in tx) t.Category = other.Name;
            await DbContext.SaveChangesAsync();
        }

        DbContext.Categories.Remove(cat);
        await DbContext.SaveChangesAsync();
        await LoadCategories();
    }
}

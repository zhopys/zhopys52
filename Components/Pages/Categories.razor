@page "/categories"
@rendermode InteractiveServer
@using MiniFinance.Data.Models
@using MiniFinance.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using MiniFinance.Data
@inject ApplicationDbContext DbContext
@inject ICategorizationService CategorizationService
@inject ConfirmDialogService ConfirmDialog
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDataScopeService DataScope
@attribute [Authorize(Policy = AuthorizationPolicies.CanAccessFinances)]

<PageTitle>Категории - MiniFinance</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="page-header">
            <div class="title">
                <h1>Категории</h1>
                <div class="meta text-muted">Расходы, доходы и правила авто-категоризации</div>
            </div>
            <div class="page-actions" style="display:flex;gap:.5rem;flex-wrap:wrap">
                <button type="button" class="btn btn-outline" @onclick="RunBulkRecategorize" disabled="@_busy">
                    Пересчитать категории
                </button>
                <button class="btn btn-primary" @onclick="OpenAddForm">Добавить категорию</button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_catMessage))
        {
            <div class="alert @(_catError ? "alert-danger" : "alert-success") mb-3">@_catMessage</div>
        }

        @if (showAddForm)
        {
            <div class="card mb-3">
                <div class="card-header">Новая категория</div>
                <div class="card-body">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Название *</label>
                            <input class="form-input" placeholder="Название категории" @bind="newName" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Тип</label>
                            <select class="form-input" @bind="newType">
                                <option value="@CategoryType.Expense">Расход</option>
                                <option value="@CategoryType.Income">Доход</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Цвет</label>
                            <input class="form-input" type="color" @bind="newColor" style="height:40px;padding:4px" />
                        </div>
                        <div class="form-group" style="grid-column:1/-1">
                            <label class="form-label">Иконка</label>
                            <div class="category-icon-picker">
                                @foreach (var ic in CategoryIconHelper.PickerIcons)
                                {
                                    <button type="button"
                                            class="category-icon-pick @(newIcon == ic.Key ? "active" : "")"
                                            title="@ic.Label"
                                            @onclick="() => newIcon = ic.Key">
                                        <i class="bi @ic.BiClass"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="form-group" style="grid-column:1/-1">
                            <label class="form-label">Ключевые слова для авто-категоризации</label>
                            <input class="form-input" placeholder="аренда, rent, офис (через запятую)" @bind="newKeywords" />
                        </div>
                    </div>
                    <div class="mt-3" style="display:flex;gap:.5rem">
                        <button class="btn btn-primary" @onclick="CreateCategory">Сохранить</button>
                        <button class="btn btn-outline" @onclick="CloseAddForm">Отмена</button>
                    </div>
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-body" style="padding:.75rem 1rem">
                <div style="display:flex;flex-wrap:wrap;gap:.75rem;align-items:center">
                    <input class="form-input" style="max-width:240px" placeholder="Поиск…" @bind="_search" @bind:event="oninput" />
                    <select class="form-input" style="max-width:160px" @bind="_filterType">
                        <option value="all">Все типы</option>
                        <option value="expense">Расходы</option>
                        <option value="income">Доходы</option>
                    </select>
                    <label class="small" style="display:flex;align-items:center;gap:.35rem;margin:0">
                        <input type="checkbox" @bind="_showHidden" />
                        Показать скрытые
                    </label>
                    <span class="small text-muted ms-auto">@FilteredCategories.Count() из @(categories?.Count ?? 0)</span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body" style="padding:0">
                @if (categories == null)
                {
                    <div class="center text-muted py-4">Загрузка...</div>
                }
                else if (!FilteredCategories.Any())
                {
                    <div class="empty-state">Нет категорий по фильтру</div>
                }
                else
                {
                    <div class="category-list">
                        @foreach (var cat in FilteredCategories)
                        {
                            var kwCount = CategoryIconHelper.SplitKeywords(cat.Keywords).Count();
                            <div class="category-list-item @(cat.IsHidden ? "is-hidden" : "")">
                                <CategoryIcon Category="@cat" Size="lg" />
                                <div class="category-list-main">
                                    <div class="category-list-title">
                                        <strong>@cat.Name</strong>
                                        <span class="badge @(cat.Type == CategoryType.Income ? "badge-success" : "badge-danger")">
                                            @((cat.Type == CategoryType.Income) ? "Доход" : "Расход")
                                        </span>
                                        @if (cat.IsDefault)
                                        {
                                            <span class="badge badge-info">Системная</span>
                                        }
                                        @if (cat.IsHidden)
                                        {
                                            <span class="badge">Скрыта</span>
                                        }
                                    </div>
                                    <div class="category-list-sub small text-muted">
                                        @if (kwCount > 0)
                                        {
                                            <span>@kwCount ключ. слов</span>
                                        }
                                        else
                                        {
                                            <span>без ключевых слов</span>
                                        }
                                        @if (cat.MonthlyBudget is > 0)
                                        {
                                            <span> · бюджет @cat.MonthlyBudget.Value.ToString("N0") <Byn />/мес</span>
                                        }
                                    </div>
                                </div>
                                <div class="category-list-actions">
                                    <button type="button" class="btn btn-sm btn-outline" @onclick="() => OpenDetail(cat.Id)">Подробнее</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(cat.Id)">Удалить</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <CategoryDetailsPanel CategoryId="@_detailId"
                              IsOpen="@_detailOpen"
                              OnClose="CloseDetail"
                              OnChanged="OnDetailChanged" />
    </Authorized>
</AuthorizeView>

@code {
    private List<Category>? categories;
    private string _dataUserId = "";
    private string newName = string.Empty;
    private CategoryType newType = CategoryType.Expense;
    private string newKeywords = string.Empty;
    private string newIcon = "tag";
    private string newColor = "#7c3aed";
    private bool showAddForm;
    private string _search = "";
    private string _filterType = "all";
    private bool _showHidden;
    private int _detailId;
    private bool _detailOpen;
    private bool _busy;
    private string? _catMessage;
    private bool _catError;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user == null) return;
        _dataUserId = await DataScope.GetDataOwnerUserIdAsync(user.Id);

        await CategorizationService.EnsureDefaultCategoriesAsync();
        await LoadCategories();
    }

    private IEnumerable<Category> FilteredCategories
    {
        get
        {
            if (categories == null) return Enumerable.Empty<Category>();
            var q = categories.AsEnumerable();
            if (!_showHidden)
                q = q.Where(c => !c.IsHidden);
            if (_filterType == "expense")
                q = q.Where(c => c.Type == CategoryType.Expense);
            else if (_filterType == "income")
                q = q.Where(c => c.Type == CategoryType.Income);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(c =>
                    c.Name.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (c.Keywords != null && c.Keywords.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }
            return q.OrderBy(c => c.Type).ThenBy(c => c.Name);
        }
    }

    private async Task LoadCategories()
    {
        categories = await DbContext.Categories.OrderBy(c => c.Type).ThenBy(c => c.Name).ToListAsync();
        StateHasChanged();
    }

    private void OpenAddForm()
    {
        showAddForm = true;
        newIcon = newType == CategoryType.Income ? "graph-up" : "tag";
        newColor = newType == CategoryType.Income ? "#22c55e" : "#7c3aed";
    }

    private void CloseAddForm() => showAddForm = false;

    private async Task CreateCategory()
    {
        _catMessage = null;
        if (string.IsNullOrWhiteSpace(newName))
        {
            _catMessage = "Укажите название категории";
            _catError = true;
            return;
        }
        try
        {
            var trimmed = newName.Trim();
            if (await DbContext.Categories.AnyAsync(c => c.Name.ToLower() == trimmed.ToLower()))
                throw new InvalidOperationException("Категория уже существует");

            DbContext.Categories.Add(new Category
            {
                Name = trimmed,
                Type = newType,
                Keywords = string.IsNullOrWhiteSpace(newKeywords) ? null : newKeywords.Trim(),
                Icon = string.IsNullOrWhiteSpace(newIcon) ? null : newIcon.Trim(),
                Color = string.IsNullOrWhiteSpace(newColor) ? null : newColor
            });
            await DbContext.SaveChangesAsync();
            newName = string.Empty;
            newType = CategoryType.Expense;
            newKeywords = string.Empty;
            newIcon = "tag";
            showAddForm = false;
            _catMessage = "Категория добавлена";
            _catError = false;
            await LoadCategories();
        }
        catch (Exception ex)
        {
            _catMessage = ex.Message;
            _catError = true;
        }
    }

    private void OpenDetail(int id)
    {
        _detailId = id;
        _detailOpen = true;
    }

    private void CloseDetail()
    {
        _detailId = 0;
        _detailOpen = false;
    }

    private async Task OnDetailChanged()
    {
        await LoadCategories();
        _catMessage = null;
    }

    private async Task RunBulkRecategorize()
    {
        if (string.IsNullOrEmpty(_dataUserId)) return;
        var ok = await ConfirmDialog.ShowAsync(new ConfirmDialogOptions
        {
            Title = "Пересчитать категории?",
            Message = "Категории будут назначены по ключевым словам в описании.",
            Detail = "Затронуты операции без категории и с «Прочее» / «Доход от услуг».",
            ConfirmText = "Пересчитать",
            IsDanger = false
        });
        if (!ok) return;

        _busy = true;
        _catMessage = null;
        try
        {
            var txs = await DbContext.Transactions
                .Where(t => t.UserId == _dataUserId &&
                            (string.IsNullOrEmpty(t.Category) ||
                             t.Category == CategoryDefaults.DefaultExpense ||
                             t.Category == CategoryDefaults.DefaultIncome ||
                             t.Category == "Прочее"))
                .ToListAsync();

            var updated = 0;
            foreach (var tx in txs)
            {
                var suggested = CategorizationService.CategorizeTransaction(tx.Description, tx.Amount);
                if (!string.Equals(tx.Category, suggested, StringComparison.Ordinal))
                {
                    tx.Category = suggested;
                    updated++;
                }
            }

            if (updated > 0)
                await DbContext.SaveChangesAsync();

            _catMessage = updated > 0
                ? $"Обновлено операций: {updated}"
                : "Нет операций для пересчёта";
            _catError = false;
        }
        catch (Exception ex)
        {
            _catMessage = ex.Message;
            _catError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmDelete(int id)
    {
        var ok = await ConfirmDialog.ShowAsync(new ConfirmDialogOptions
        {
            Title = "Удалить категорию?",
            Message = "Категория будет удалена.",
            Detail = "Операции с этой категорией будут перенесены в «Прочее».",
            ConfirmText = "Удалить",
            IsDanger = true
        });
        if (!ok) return;

        var cat = await DbContext.Categories.FindAsync(id);
        if (cat == null) return;

        var used = await DbContext.Transactions.AnyAsync(t => t.Category == cat.Name);
        if (used)
        {
            var other = await DbContext.Categories.FirstOrDefaultAsync(c => c.Name == "Прочее");
            if (other == null)
            {
                other = new Category { Name = "Прочее", Type = CategoryType.Expense, IsDefault = true, Icon = "more", Color = "#94a3b8" };
                DbContext.Categories.Add(other);
                await DbContext.SaveChangesAsync();
            }

            var tx = await DbContext.Transactions.Where(t => t.Category == cat.Name).ToListAsync();
            foreach (var t in tx) t.Category = other.Name;
            await DbContext.SaveChangesAsync();
        }

        DbContext.Categories.Remove(cat);
        await DbContext.SaveChangesAsync();
        if (_detailId == id)
            CloseDetail();
        _catMessage = "Категория удалена";
        _catError = false;
        await LoadCategories();
    }
}

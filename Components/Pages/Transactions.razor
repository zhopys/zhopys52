@page "/transactions"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MiniFinance.Data.Models
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject ICategorizationService CategorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JsRuntime
@attribute [Authorize]

<PageTitle>Транзакции - MiniFinance</PageTitle>

<AuthorizeView Context="authContext">
    <Authorized>
        <div class="page-header">
            <div class="title">
                <h1>Транзакции</h1>
                <div class="meta text-muted">Управление операциями и быстрый ввод</div>
            </div>
            <div class="page-actions">
                <button class="btn btn-outline" @onclick="ToggleQuickEntry">⚡ Быстрый ввод</button>
                <a class="btn btn-primary" href="/transactions/new">+ Новая</a>
            </div>
        </div>

        @if (showMessage)
        {
            <div class="alert alert-success" role="status" aria-live="polite">@_message</div>
        }

        @if (showQuickEntry)
        {
            <div class="card mb-3">
                <div class="card-header">Быстрый ввод</div>
                <div class="card-body">
                    <div class="quick-actions-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.5rem;">
                        <button class="btn btn-outline-danger" @onclick='() => QuickAddExpense("Аренда офиса", 1500, "Аренда", null)'>🏢 Аренда — 1500₽</button>
                        <button class="btn btn-outline-danger" @onclick='() => QuickAddExpense("Интернет и связь", 850, "Связь", null)'>📡 Связь — 850₽</button>
                        <button class="btn btn-outline-success" @onclick='() => QuickAddIncome("Оплата от клиента", 10000, "Продажи", null)'>💰 Продажа — 10000₽</button>
                        <button class="btn btn-outline" @onclick="ToggleQuickEntry">Закрыть</button>
                    </div>
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header">Добавить транзакцию</div>
            <div class="card-body">
                <EditForm Model="@_newTransaction" OnValidSubmit="@AddTransaction">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="form-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
                        <div>
                            <label class="label">Дата</label>
                            <InputDate id="date" class="input" @bind-Value="_newTransaction.Date" />
                        </div>
                        <div>
                            <label class="label">Сумма</label>
                            <InputNumber id="amount" class="input" @bind-Value="_newTransaction.Amount" @bind-Value:after="OnAmountChanged" />
                            <div class="small text-muted">- для расхода</div>
                        </div>
                        <div style="grid-column: span 2;">
                            <label class="label">Описание</label>
                            <InputText id="description" class="input" @bind-Value="_newTransaction.Description" @bind-Value:after="OnDescriptionChanged" />
                        </div>
                        <div>
                            <label class="label">Категория</label>
                            <input id="category" list="categoryList" class="input" @bind="_newTransaction.Category" aria-label="Категория" placeholder="Выберите или введите" />
                            <datalist id="categoryList">
                                @foreach (var c in GetUniqueCategories()) { <option value="@c"></option> }
                            </datalist>
                            @if (!string.IsNullOrEmpty(_suggestedCategory)) 
                            { 
                                <div class="small text-muted">💡 Рекомендация: @_suggestedCategory</div> 
                            }
                        </div>
                        <div>
                            <label class="label">Проект</label>
                            <select class="input" @bind="_newTransaction.ProjectId">
                                <option value="">— Без проекта —</option>
                                @foreach (var proj in _projects)
                                {
                                    <option value="@proj.Id">@proj.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div style="margin-top:1rem;display:flex;gap:.5rem">
                        <button type="submit" class="btn btn-primary">Добавить</button>
                        <button type="button" class="btn btn-outline" @onclick="ClearForm">Очистить</button>
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <div class="filters-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.5rem; align-items: center;">
                    <div>
                        <input type="text" class="input" placeholder="Поиск по описанию..." @bind="_searchQuery" @bind:event="oninput" aria-label="Поиск по описанию" />
                    </div>
                    <div>
                        <select class="input" @bind="_filterCategory">
                            <option value="">Все категории</option>
                            @foreach (var cat in GetUniqueCategories()) { <option value="@cat">@cat</option> }
                        </select>
                    </div>
                    <div>
                        <select class="input" @bind="_filterProject">
                            <option value="">Все проекты</option>
                            @foreach (var proj in _projects)
                            {
                                <option value="@proj.Id">@proj.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <select class="input" @bind="_filterType">
                            <option value="all">Все типы</option>
                            <option value="income">Доходы</option>
                            <option value="expense">Расходы</option>
                        </select>
                    </div>
                    <div>
                        <button class="btn btn-outline w-100" @onclick="ClearFilters">Сбросить</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span>Список транзакций <span class="text-muted">— Всего: @GetFilteredTransactions().Count()</span></span>
                    <div class="summary-stats" style="display: flex; gap: 1rem; font-size: 0.9rem;">
                        <span class="text-success">+@GetFilteredTransactions().Where(t => t.Amount > 0).Sum(t => t.Amount).ToString("N0") ₽</span>
                        <span class="text-danger">-@Math.Abs(GetFilteredTransactions().Where(t => t.Amount < 0).Sum(t => t.Amount)).ToString("N0") ₽</span>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (_transactions == null)
                {
                    <div class="center py-4">Загрузка...</div>
                }
                else if (!_transactions.Any())
                {
                    <div class="empty-state">Нет транзакций. Добавьте первую операцию.</div>
                }
                else
                {
                    var filtered = GetFilteredTransactions().ToList();
                    @if (!filtered.Any())
                    {
                        <div class="alert">Нет транзакций, соответствующих фильтрам.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Дата</th>
                                        <th>Описание</th>
                                        <th>Категория</th>
                                        <th>Проект</th>
                                        <th class="text-end">Сумма</th>
                                        <th class="text-center">Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in filtered)
                                    {
                                        var projectItem = _projects.FirstOrDefault(p => p.Id == t.ProjectId);
                                        <tr>
                                            <td><div class="muted">@t.Date.ToString("dd.MM.yyyy")</div></td>
                                            <td>
                                                @if (_editingId == t.Id)
                                                {
                                                    <input type="text" class="input" @bind="_editDescription" />
                                                }
                                                else { @t.Description }
                                            </td>
                                            <td>
                                                @if (_editingId == t.Id)
                                                {
                                                    <input type="text" class="input" @bind="_editCategory" />
                                                }
                                                else { <span class="badge">@t.Category</span> }
                                            </td>
                                            <td>
                                                @if (_editingId == t.Id)
                                                {
                                                    <select class="input" @bind="_editProjectId">
                                                        <option value="">— Без проекта —</option>
                                                        @foreach (var proj in _projects)
                                                        {
                                                            <option value="@proj.Id">@proj.Name</option>
                                                        }
                                                    </select>
                                                }
                                                else if (projectItem != null)
                                                {
                                                    <span class="project-badge" style="background: var(--primary-light); padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.85rem;">
                                                        📁 @projectItem.Name
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (_editingId == t.Id)
                                                {
                                                    <input type="number" step="0.01" class="input" @bind="_editAmount" style="width:120px" />
                                                }
                                                else
                                                {
                                                    <span class="fw-bold @(t.Amount >= 0 ? "text-success" : "text-danger")">
                                                        @(t.Amount >= 0 ? "+" : "")@t.Amount.ToString("N2") ₽
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (_editingId == t.Id)
                                                {
                                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveEdit(t.Id)" title="Сохранить изменения">Сохранить</button>
                                                    <button class="btn btn-sm btn-outline" @onclick="CancelEdit" title="Отменить редактирование">Отмена</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline" @onclick="() => StartEdit(t)" title="Редактировать транзакцию">✎</button>
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteTransaction(t.Id)" title="Удалить транзакцию">🗑</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4" class="text-end fw-bold">Итого:</td>
                                        <td class="text-end fw-bold"> 
                                            <span class="@(filtered.Sum(t => t.Amount) >= 0 ? "text-success" : "text-danger")">
                                                @filtered.Sum(t => t.Amount).ToString("N2") ₽
                                            </span>
                                        </td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private List<Transaction> _transactions = new();
    private List<Project> _projects = new();

    private Transaction _newTransaction { get; set; } = new() { Date = DateTime.Today };

    private string _suggestedCategory = string.Empty;
    private bool showQuickEntry = false;
    private bool showMessage = false;
    private string _message = string.Empty;

    // Фильтры
    private string _searchQuery = string.Empty;
    private string _filterCategory = string.Empty;
    private int? _filterProject = null;
    private string _filterType = "all";

    // Редактирование
    private int? _editingId = null;
    private string _editDescription = string.Empty;
    private string _editCategory = string.Empty;
    private decimal _editAmount = 0;
    private int? _editProjectId = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        await LoadProjects();
        await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            _transactions = await DbContext.Transactions
                .Where(t => t.UserId == user.Id)
                .OrderByDescending(t => t.Date)
                .ToListAsync();
        }
    }

    private async Task LoadProjects()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            _projects = await DbContext.Projects
                .OrderBy(p => p.Name)
                .ToListAsync();
        }
    }

    private void OnDescriptionChanged()
    {
        if (!string.IsNullOrWhiteSpace(_newTransaction.Description) && _newTransaction.Amount != 0)
        {
            _suggestedCategory = CategorizationService.CategorizeTransaction(
                _newTransaction.Description,
                _newTransaction.Amount);

            if (string.IsNullOrWhiteSpace(_newTransaction.Category))
            {
                _newTransaction.Category = _suggestedCategory;
            }
        }
    }

    private void OnAmountChanged()
    {
        OnDescriptionChanged();
    }

    private async Task AddTransaction()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            if (string.IsNullOrWhiteSpace(_newTransaction.Category))
            {
                _newTransaction.Category = CategorizationService.CategorizeTransaction(
                    _newTransaction.Description,
                    _newTransaction.Amount);
            }

            _newTransaction.UserId = user.Id;
            
            // Если ProjectId = 0 или пустая строка, устанавливаем null
            if (_newTransaction.ProjectId == 0)
            {
                _newTransaction.ProjectId = null;
            }

            DbContext.Transactions.Add(_newTransaction);
            await DbContext.SaveChangesAsync();

            await ShowMessageAsync($"✅ Транзакция добавлена: {_newTransaction.Description}");

            _newTransaction = new Transaction { Date = DateTime.Today };
            _suggestedCategory = string.Empty;
            await LoadTransactions();
        }
    }

    private async Task QuickAddExpense(string description, decimal amount, string category, int? projectId)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            var transaction = new Transaction
            {
                Date = DateTime.Today,
                Amount = -amount,
                Description = description,
                Category = category,
                ProjectId = projectId,
                UserId = user.Id
            };

            DbContext.Transactions.Add(transaction);
            await DbContext.SaveChangesAsync();

            await ShowMessageAsync($"✅ Расход добавлен: {description} (-{amount}₽)");
            await LoadTransactions();
        }
    }

    private async Task QuickAddIncome(string description, decimal amount, string category, int? projectId)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            var transaction = new Transaction
            {
                Date = DateTime.Today,
                Amount = amount,
                Description = description,
                Category = category,
                ProjectId = projectId,
                UserId = user.Id
            };

            DbContext.Transactions.Add(transaction);
            await DbContext.SaveChangesAsync();

            await ShowMessageAsync($"✅ Доход добавлен: {description} (+{amount}₽)");
            await LoadTransactions();
        }
    }

    private void StartEdit(Transaction t)
    {
        _editingId = t.Id;
        _editDescription = t.Description;
        _editCategory = t.Category;
        _editAmount = t.Amount;
        _editProjectId = t.ProjectId;
    }

    private async Task SaveEdit(int id)
    {
        var transaction = await DbContext.Transactions.FindAsync(id);
        if (transaction != null)
        {
            transaction.Description = _editDescription;
            transaction.Category = _editCategory;
            transaction.Amount = _editAmount;
            transaction.ProjectId = _editProjectId;

            await DbContext.SaveChangesAsync();
            await ShowMessageAsync("✅ Транзакция обновлена");

            _editingId = null;
            await LoadTransactions();
        }
    }

    private void CancelEdit()
    {
        _editingId = null;
    }

    private async Task DeleteTransaction(int id)
    {
        var transaction = await DbContext.Transactions.FindAsync(id);
        if (transaction != null)
        {
            DbContext.Transactions.Remove(transaction);
            await DbContext.SaveChangesAsync();

            await ShowMessageAsync("🗑️ Транзакция удалена");
            await LoadTransactions();
        }
    }

    private void ToggleQuickEntry()
    {
        showQuickEntry = !showQuickEntry;
    }

    private void ClearForm()
    {
        _newTransaction = new Transaction { Date = DateTime.Today };
        _suggestedCategory = string.Empty;
    }

    private async Task ShowMessageAsync(string msg, int autoHideMs = 4000)
    {
        _message = msg;
        showMessage = true;
        StateHasChanged();
        try
        {
            await Task.Delay(autoHideMs);
        }
        catch { }
        showMessage = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmDeleteTransaction(int id)
    {
        var ok = await JsRuntime.InvokeAsync<bool>("confirm", "Удалить транзакцию? Это действие нельзя отменить.");
        if (!ok) return;
        await DeleteTransaction(id);
    }

    private IEnumerable<Transaction> GetFilteredTransactions()
    {
        if (_transactions == null) return Enumerable.Empty<Transaction>();

        var filtered = _transactions.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            filtered = filtered.Where(t => t.Description.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_filterCategory))
        {
            filtered = filtered.Where(t => t.Category == _filterCategory);
        }

        if (_filterProject.HasValue && _filterProject.Value > 0)
        {
            filtered = filtered.Where(t => t.ProjectId == _filterProject.Value);
        }

        if (_filterType == "income")
        {
            filtered = filtered.Where(t => t.Amount > 0);
        }
        else if (_filterType == "expense")
        {
            filtered = filtered.Where(t => t.Amount < 0);
        }

        return filtered.OrderByDescending(t => t.Date);
    }

    private List<string> GetUniqueCategories()
    {
        return _transactions?.Select(t => t.Category).Distinct().OrderBy(c => c).ToList() ?? new List<string>();
    }

    private void ClearFilters()
    {
        _searchQuery = string.Empty;
        _filterCategory = string.Empty;
        _filterProject = null;
        _filterType = "all";
    }
}
@page "/transactions"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MiniFinance.Data.Models
@using MiniFinance.Services
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject ICategorizationService CategorizationService
@inject ITransactionService TransactionService
@inject ICounterpartyService CounterpartyService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDataScopeService DataScope
@inject IJSRuntime JsRuntime
@attribute [Authorize]

<PageTitle>Транзакции - MiniFinance</PageTitle>

<div class="page-header">
            <div class="title">
                <h1>Транзакции</h1>
                <div class="meta text-muted">@filteredCount операций · баланс @totalBalance.ToString("N2") Br</div>
            </div>
            <div class="page-actions">
                <button class="btn btn-primary" @onclick="OpenAddModal">Добавить</button>
                <a class="btn btn-outline" href="/import">Импорт CSV</a>
            </div>
        </div>

        @if (showMessage)
        {
            <div class="alert @(isErrorMessage ? "alert-danger" : "alert-success")">@_message</div>
        }

        @if (_pending.Any())
        {
            <div class="alert alert-warning mb-3">
                <strong>На утверждении:</strong> @_pending.Count операций
            </div>
        }

        @if (showAddModal)
        {
            <div class="card mb-3">
                <div class="card-header">Новая транзакция</div>
                <div class="card-body">
                    <EditForm Model="@_newTransaction" OnValidSubmit="@AddTransaction" Context="addForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem">
                            <div>
                                <label class="label">Дата *</label>
                                <InputDate class="input" @bind-Value="_newTransaction.Date" />
                            </div>
                            <div>
                                <label class="label">Сумма *</label>
                                <InputNumber class="input" @bind-Value="_newTransaction.Amount" @bind-Value:after="OnNewFieldChanged" />
                                <div class="small text-muted">− расход, + доход</div>
                            </div>
                            <div>
                                <label class="label">Описание *</label>
                                <InputText class="input" @bind-Value="_newTransaction.Description" @bind-Value:after="OnNewFieldChanged" />
                            </div>
                            <div>
                                <label class="label">Категория</label>
                                <InputSelect class="input" @bind-Value="_newTransaction.Category">
                                    <option value="">— авто —</option>
                                    @foreach (var c in categoryNames) { <option value="@c">@c</option> }
                                </InputSelect>
                                @if (!string.IsNullOrEmpty(_suggestedCategory))
                                {
                                    <div class="small text-muted">Подсказка: @_suggestedCategory</div>
                                }
                            </div>
                            <div>
                                <label class="label">Проект</label>
                                <InputSelect class="input" @bind-Value="_newProjectId">
                                    <option value="">— не указан —</option>
                                    @foreach (var p in userProjects)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div>
                                <label class="label">Контрагент</label>
                                <InputSelect class="input" @bind-Value="_newCounterpartyKey" @bind-Value:after="OnNewCounterpartyChanged">
                                    <option value="">— не указан —</option>
                                    @foreach (var cp in counterparties)
                                    {
                                        <option value="@($"id:{cp.Id}")">@cp.Name</option>
                                    }
                                    <option value="manual">Ввести вручную…</option>
                                </InputSelect>
                                @if (_newCounterpartyKey == "manual")
                                {
                                    <InputText class="input mt-1" placeholder="Название контрагента" @bind-Value="_newCounterpartyManual" />
                                }
                            </div>
                        </div>
                        <div style="margin-top:1rem;display:flex;gap:.5rem">
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                            <button type="button" class="btn btn-outline" @onclick="() => showAddModal = false">Отмена</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        @if (showEditModal)
        {
            <div class="card mb-3">
                <div class="card-header">Редактирование транзакции</div>
                <div class="card-body">
                    <EditForm Model="@_editTransaction" OnValidSubmit="@SaveEdit" Context="editForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem">
                            <div>
                                <label class="label">Дата *</label>
                                <InputDate class="input" @bind-Value="_editTransaction.Date" />
                            </div>
                            <div>
                                <label class="label">Сумма *</label>
                                <InputNumber class="input" @bind-Value="_editTransaction.Amount" />
                            </div>
                            <div>
                                <label class="label">Описание *</label>
                                <InputText class="input" @bind-Value="_editTransaction.Description" />
                            </div>
                            <div>
                                <label class="label">Категория</label>
                                <InputSelect class="input" @bind-Value="_editTransaction.Category">
                                    @foreach (var c in categoryNames) { <option value="@c">@c</option> }
                                </InputSelect>
                            </div>
                            <div>
                                <label class="label">Проект</label>
                                <InputSelect class="input" @bind-Value="_editProjectId">
                                    <option value="">— не указан —</option>
                                    @foreach (var p in userProjects)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div>
                                <label class="label">Контрагент</label>
                                <InputSelect class="input" @bind-Value="_editCounterpartyKey" @bind-Value:after="OnEditCounterpartyChanged">
                                    <option value="">— не указан —</option>
                                    @foreach (var cp in counterparties)
                                    {
                                        <option value="@($"id:{cp.Id}")">@cp.Name</option>
                                    }
                                    <option value="manual">Ввести вручную…</option>
                                </InputSelect>
                                @if (_editCounterpartyKey == "manual")
                                {
                                    <InputText class="input mt-1" placeholder="Название контрагента" @bind-Value="_editCounterpartyManual" />
                                }
                            </div>
                        </div>
                        <div style="margin-top:1rem;display:flex;gap:.5rem">
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                            <button type="button" class="btn btn-outline" @onclick="() => showEditModal = false">Отмена</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-body">
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:.5rem;align-items:end">
                    <div>
                        <label class="label">Поиск</label>
                        <input type="text" class="input" placeholder="Описание, категория, контрагент…" @bind="_searchQuery" @bind:event="oninput" @bind:after="ResetPage" />
                    </div>
                    <div>
                        <label class="label">Категория</label>
                        <select class="input" @bind="_filterCategory" @bind:after="ResetPage">
                            <option value="">Все</option>
                            @foreach (var cat in categoryNames) { <option value="@cat">@cat</option> }
                        </select>
                    </div>
                    <div>
                        <label class="label">Тип</label>
                        <select class="input" @bind="_filterType" @bind:after="ResetPage">
                            <option value="all">Все</option>
                            <option value="income">Доходы</option>
                            <option value="expense">Расходы</option>
                        </select>
                    </div>
                    <div>
                        <label class="label">Проект</label>
                        <select class="input" @bind="_filterProjectId" @bind:after="ResetPage">
                            <option value="">Все</option>
                            @foreach (var p in userProjects)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="label">С</label>
                        <input type="date" class="input" @bind="_filterDateFrom" @bind:after="ResetPage" />
                    </div>
                    <div>
                        <label class="label">По</label>
                        <input type="date" class="input" @bind="_filterDateTo" @bind:after="ResetPage" />
                    </div>
                    <div>
                        <button class="btn btn-outline w-100" @onclick="ClearFilters">Сбросить</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body" style="padding:0">
                @if (transactions.Count == 0)
                {
                    <div class="empty-state">Нет транзакций</div>
                }
                else if (!PagedTransactions.Any())
                {
                    <div class="empty-state">Нет транзакций по выбранным фильтрам</div>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Дата</th>
                                <th>Тип</th>
                                <th>Категория</th>
                                <th>Контрагент</th>
                                <th class="text-end">Сумма</th>
                                <th class="text-center">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in PagedTransactions)
                            {
                                <tr class="@(t.Amount < 0 ? "negative-balance" : null)" data-balance="@t.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <td class="text-muted">@t.Date.ToString("dd.MM.yyyy")</td>
                                    <td><span class="badge @(t.Amount >= 0 ? "badge-success" : "badge-danger")">@(t.Amount >= 0 ? "Доход" : "Расход")</span></td>
                                    <td>
                                        @{
                                            _categoryByName.TryGetValue(t.Category, out var catRow);
                                        }
                                        @if (catRow != null)
                                        {
                                            <CategoryBadge Category="@catRow" Name="@catRow.Name" />
                                        }
                                        else
                                        {
                                            <CategoryBadge Name="@t.Category" />
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(t.Counterparty) ? "—" : t.Counterparty)</td>
                                    <td class="text-end fw-bold amount @(t.Amount >= 0 ? "text-success" : "text-danger")">
                                        @(t.Amount >= 0 ? "+" : "")@t.Amount.ToString("N2") Br
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline" @onclick="() => OpenDetails(t.Id)">Подробнее</button>
                                        <button class="btn btn-sm btn-outline" @onclick="() => StartEdit(t)">Изменить</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(t.Id)">Удалить</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (TotalPages > 1)
                    {
                        <div style="padding:12px;display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border)">
                            <span class="small text-muted">Стр. @_currentPage из @TotalPages</span>
                            <div style="display:flex;gap:8px">
                                <button class="btn btn-sm btn-outline" disabled="@(_currentPage <= 1)" @onclick="PrevPage">Назад</button>
                                <button class="btn btn-sm btn-outline" disabled="@(_currentPage >= TotalPages)" @onclick="NextPage">Вперёд</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

<TransactionDetailsPanel TransactionId="@_selectedTxId"
                         UserId="@(_userId ?? string.Empty)"
                         AuthorName="@_authorName"
                         IsOpen="@(_selectedTxId != 0)"
                         OnClose="CloseDetails" />

@code {
    private const int PageSize = 25;
    private string? _userId;
    private string? _authorName;
    private int _selectedTxId;
    private List<Transaction> _pending = new();

    private List<Transaction> transactions = new();
    private List<string> categoryNames = new();
    private Dictionary<string, Category> _categoryByName = new(StringComparer.OrdinalIgnoreCase);
    private List<Project> userProjects = new();
    private List<CounterpartyRecord> counterparties = new();

    private string _newCounterpartyKey = "";
    private string _newCounterpartyManual = "";
    private string _editCounterpartyKey = "";
    private string _editCounterpartyManual = "";

    private bool showAddModal;
    private bool showEditModal;
    private bool showMessage;
    private bool isErrorMessage;
    private string _message = string.Empty;
    private string _suggestedCategory = string.Empty;

    private Transaction _newTransaction = new() { Date = DateTime.Today };
    private Transaction _editTransaction = new();
    private string? _newProjectId;
    private string? _editProjectId;

    private string _searchQuery = string.Empty;
    private string _filterCategory = string.Empty;
    private string _filterType = "all";
    private string _filterProjectId = string.Empty;
    private DateTime? _filterDateFrom;
    private DateTime? _filterDateTo;
    private int _currentPage = 1;

    private IEnumerable<Transaction> FilteredTransactions => ApplyFilters(transactions);
    private List<Transaction> PagedTransactions => FilteredTransactions
        .Skip((_currentPage - 1) * PageSize)
        .Take(PageSize)
        .ToList();
    private int filteredCount => FilteredTransactions.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(filteredCount / (double)PageSize));
    private decimal totalBalance => transactions.Sum(t => t.Amount);

    [SupplyParameterFromQuery(Name = "category")]
    public string? QueryCategory { get; set; }

    [SupplyParameterFromQuery(Name = "project")]
    public int? QueryProjectId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;

        if (!string.IsNullOrWhiteSpace(QueryCategory))
            _filterCategory = QueryCategory.Trim();

        if (QueryProjectId.HasValue)
            _filterProjectId = QueryProjectId.Value.ToString();

        _userId = user.Id;
        _authorName = user.Email;
        var dataOwnerId = await DataScope.GetDataOwnerUserIdAsync(user.Id);
        await CategorizationService.EnsureDefaultCategoriesAsync();
        categoryNames = await CategorizationService.GetCategoryNamesAsync();
        var cats = await DbContext.Categories.AsNoTracking().ToListAsync();
        _categoryByName = cats.ToDictionary(c => c.Name, StringComparer.OrdinalIgnoreCase);

        userProjects = await DbContext.Projects
            .Where(p => p.UserId == dataOwnerId || p.IsDefault)
            .OrderBy(p => p.Name)
            .ToListAsync();

        counterparties = await CounterpartyService.ListAsync(user.Id);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_userId == null) return;
        transactions = await TransactionService.ListAsync(_userId);
        _pending = await TransactionService.ListPendingApprovalAsync(_userId);
    }

    private void OpenDetails(int id) => _selectedTxId = id;
    private void CloseDetails() => _selectedTxId = 0;

    private IEnumerable<Transaction> ApplyFilters(IEnumerable<Transaction> source)
    {
        var q = source.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var s = _searchQuery.Trim();
            q = q.Where(t =>
                t.Description.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                t.Category.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                (t.Counterparty != null && t.Counterparty.Contains(s, StringComparison.OrdinalIgnoreCase)));
        }
        if (!string.IsNullOrWhiteSpace(_filterCategory))
            q = q.Where(t => t.Category == _filterCategory);
        if (_filterType == "income") q = q.Where(t => t.Amount > 0);
        else if (_filterType == "expense") q = q.Where(t => t.Amount < 0);
        if (int.TryParse(_filterProjectId, out var pid)) q = q.Where(t => t.ProjectId == pid);
        if (_filterDateFrom.HasValue) q = q.Where(t => t.Date >= _filterDateFrom.Value);
        if (_filterDateTo.HasValue) q = q.Where(t => t.Date <= _filterDateTo.Value);
        return q.OrderByDescending(t => t.Date).ThenByDescending(t => t.Id);
    }

    private void OpenAddModal()
    {
        _newTransaction = new Transaction { Date = DateTime.Today, UserId = _userId ?? "" };
        _newProjectId = null;
        _newCounterpartyKey = "";
        _newCounterpartyManual = "";
        _suggestedCategory = string.Empty;
        showAddModal = true;
    }

    private void OnNewCounterpartyChanged()
    {
        if (_newCounterpartyKey != "manual")
            _newCounterpartyManual = "";
    }

    private void OnEditCounterpartyChanged()
    {
        if (_editCounterpartyKey != "manual")
            _editCounterpartyManual = "";
    }

    private void ApplyCounterpartyToModel(Transaction tx, string key, string manual)
    {
        if (string.IsNullOrEmpty(key))
        {
            tx.CounterpartyId = null;
            tx.Counterparty = null;
            return;
        }

        if (key.StartsWith("id:", StringComparison.Ordinal) && int.TryParse(key.AsSpan(3), out var id))
        {
            tx.CounterpartyId = id;
            tx.Counterparty = counterparties.FirstOrDefault(c => c.Id == id)?.Name;
            return;
        }

        if (key == "manual" && !string.IsNullOrWhiteSpace(manual))
        {
            tx.CounterpartyId = null;
            tx.Counterparty = manual.Trim();
            return;
        }

        tx.CounterpartyId = null;
        tx.Counterparty = null;
    }

    private void OnNewFieldChanged()
    {
        if (!string.IsNullOrWhiteSpace(_newTransaction.Description) && _newTransaction.Amount != 0)
        {
            _suggestedCategory = CategorizationService.CategorizeTransaction(_newTransaction.Description, _newTransaction.Amount);
            if (string.IsNullOrWhiteSpace(_newTransaction.Category))
                _newTransaction.Category = _suggestedCategory;
        }
    }

    private async Task AddTransaction()
    {
        if (_userId == null) return;
        try
        {
            if (int.TryParse(_newProjectId, out var pid)) _newTransaction.ProjectId = pid;
            else _newTransaction.ProjectId = null;

            ApplyCounterpartyToModel(_newTransaction, _newCounterpartyKey, _newCounterpartyManual);
            _newTransaction.UserId = _userId;

            await TransactionService.CreateAsync(_newTransaction, _userId);
            counterparties = await CounterpartyService.ListAsync(_userId);
            ShowSuccess($"Транзакция добавлена: {_newTransaction.Description}");
            showAddModal = false;
            _newTransaction = new Transaction { Date = DateTime.Today };
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    private async Task ConfirmDelete(int id)
    {
        var ok = await JsRuntime.InvokeAsync<bool>("confirm", "Удалить транзакцию?");
        if (!ok || _userId == null) return;

        try
        {
            await TransactionService.DeleteAsync(id, _userId);
            ShowSuccess("Транзакция удалена");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    private void StartEdit(Transaction t)
    {
        _editTransaction = new Transaction
        {
            Id = t.Id,
            Date = t.Date,
            Amount = t.Amount,
            Description = t.Description,
            Category = t.Category,
            Counterparty = t.Counterparty,
            CounterpartyId = t.CounterpartyId,
            UserId = t.UserId,
            ProjectId = t.ProjectId,
            PaymentMethod = t.PaymentMethod,
            IsMandatory = t.IsMandatory,
            IsConfirmed = t.IsConfirmed
        };
        _editProjectId = t.ProjectId?.ToString();
        if (t.CounterpartyId.HasValue)
        {
            _editCounterpartyKey = $"id:{t.CounterpartyId.Value}";
            _editCounterpartyManual = "";
        }
        else if (!string.IsNullOrWhiteSpace(t.Counterparty))
        {
            _editCounterpartyKey = "manual";
            _editCounterpartyManual = t.Counterparty;
        }
        else
        {
            _editCounterpartyKey = "";
            _editCounterpartyManual = "";
        }
        showEditModal = true;
    }

    private async Task SaveEdit()
    {
        if (_userId == null) return;
        try
        {
            if (int.TryParse(_editProjectId, out var pid)) _editTransaction.ProjectId = pid;
            else _editTransaction.ProjectId = null;

            ApplyCounterpartyToModel(_editTransaction, _editCounterpartyKey, _editCounterpartyManual);
            await TransactionService.UpdateAsync(_editTransaction, _userId);
            counterparties = await CounterpartyService.ListAsync(_userId);
            ShowSuccess("Транзакция обновлена");
            showEditModal = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    private void ClearFilters()
    {
        _searchQuery = string.Empty;
        _filterCategory = string.Empty;
        _filterType = "all";
        _filterProjectId = string.Empty;
        _filterDateFrom = null;
        _filterDateTo = null;
        ResetPage();
    }

    private void ResetPage() => _currentPage = 1;
    private void PrevPage() { if (_currentPage > 1) _currentPage--; }
    private void NextPage() { if (_currentPage < TotalPages) _currentPage++; }

    private void ShowSuccess(string msg)
    {
        _message = msg;
        isErrorMessage = false;
        showMessage = true;
    }

    private void ShowError(string msg)
    {
        _message = msg;
        isErrorMessage = true;
        showMessage = true;
    }
}

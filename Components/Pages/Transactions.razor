@page "/transactions"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MiniFinance.Data.Models
@using MiniFinance.Services
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject ICategorizationService CategorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JsRuntime
@attribute [Authorize]

<PageTitle>Транзакции - MiniFinance</PageTitle>

<AuthorizeView Context="authContext">
    <Authorized>
        <div class="page-header">
            <div class="title">
                <h1>Транзакции</h1>
                <div class="meta text-muted">@transactions.Count операций</div>
            </div>
            <div class="page-actions">
                <button class="btn btn-primary" @onclick="() => showAddModal = true">Добавить</button>
                <a class="btn btn-outline" href="/import">Импорт CSV</a>
            </div>
        </div>

        @if (showMessage)
        {
            <div class="alert alert-success">@_message</div>
        }

        <!-- Add form -->
        @if (showAddModal)
        {
            <div class="card mb-3">
                <div class="card-header">Новая транзакция</div>
                <div class="card-body">
                    <EditForm Model="@_newTransaction" OnValidSubmit="@AddTransaction" Context="transForm">
                        <DataAnnotationsValidator />
                        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem">
                            <div>
                                <label class="label">Дата *</label>
                                <InputDate id="date" class="input" @bind-Value="_newTransaction.Date" />
                            </div>
                            <div>
                                <label class="label">Сумма *</label>
                                <InputNumber id="amount" class="input" @bind-Value="_newTransaction.Amount" @bind-Value:after="OnAmountChanged" />
                                <div class="small text-muted">− для расхода</div>
                            </div>
                            <div>
                                <label class="label">Описание *</label>
                                <InputText id="description" class="input" @bind-Value="_newTransaction.Description" @bind-Value:after="OnDescriptionChanged" />
                            </div>
                            <div>
                                <label class="label">Категория</label>
                                <input list="categoryList" class="input" @bind="_newTransaction.Category" placeholder="Выберите" />
                                <datalist id="categoryList">
                                    @foreach (var c in GetUniqueCategories()) { <option value="@c"></option> }
                                </datalist>
                                @if (!string.IsNullOrEmpty(_suggestedCategory))
                                {
                                    <div class="small text-muted">Подсказка: @_suggestedCategory</div>
                                }
                            </div>
                            <div>
                                <label class="label">Контрагент</label>
                                <InputText class="input" @bind-Value="_newTransaction.Counterparty" />
                            </div>
                        </div>
                        <div style="margin-top:1rem;display:flex;gap:.5rem">
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                            <button type="button" class="btn btn-outline" @onclick="() => showAddModal = false">Отмена</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        <!-- Edit form -->
        @if (showEditModal)
        {
            <div class="card mb-3">
                <div class="card-header">Редактирование транзакции</div>
                <div class="card-body">
                    <EditForm Model="@_editTransaction" OnValidSubmit="@SaveEdit" Context="editForm">
                        <DataAnnotationsValidator />
                        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem">
                            <div>
                                <label class="label">Дата *</label>
                                <InputDate id="editDate" class="input" @bind-Value="_editTransaction.Date" />
                            </div>
                            <div>
                                <label class="label">Сумма *</label>
                                <InputNumber id="editAmount" class="input" @bind-Value="_editTransaction.Amount" />
                            </div>
                            <div>
                                <label class="label">Описание *</label>
                                <InputText id="editDescription" class="input" @bind-Value="_editTransaction.Description" />
                            </div>
                            <div>
                                <label class="label">Категория</label>
                                <input list="editCategoryList" class="input" @bind="_editTransaction.Category" placeholder="Выберите" />
                                <datalist id="editCategoryList">
                                    @foreach (var c in GetUniqueCategories()) { <option value="@c"></option> }
                                </datalist>
                            </div>
                            <div>
                                <label class="label">Контрагент</label>
                                <InputText class="input" @bind-Value="_editTransaction.Counterparty" />
                            </div>
                        </div>
                        <div style="margin-top:1rem;display:flex;gap:.5rem">
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                            <button type="button" class="btn btn-outline" @onclick="() => showEditModal = false">Отмена</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        <!-- Filters -->
        <div class="card mb-3">
            <div class="card-body">
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.5rem;align-items:center">
                    <input type="text" class="input" placeholder="Поиск..." @bind="_searchQuery" @bind:event="oninput" />
                    <select class="input" @bind="_filterCategory">
                        <option value="">Все категории</option>
                        @foreach (var cat in GetUniqueCategories()) { <option value="@cat">@cat</option> }
                    </select>
                    <select class="input" @bind="_filterType">
                        <option value="all">Все типы</option>
                        <option value="income">Доходы</option>
                        <option value="expense">Расходы</option>
                    </select>
                    <button class="btn btn-outline w-100" @onclick="ClearFilters">Сбросить</button>
                </div>
            </div>
        </div>

        <!-- Transactions table -->
        <div class="card">
            <div class="card-body" style="padding:0">
                @if (transactions.Count == 0)
                {
                    <div class="empty-state">Нет транзакций</div>
                }
                else
                {
                    var filtered = GetFilteredTransactions().ToList();
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Дата</th>
                                <th>Тип</th>
                                <th>Категория</th>
                                <th>Контрагент</th>
                                <th class="text-end">Сумма</th>
                                <th class="text-center">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in filtered)
                            {
                                <tr>
                                    <td class="text-muted">@t.Date.ToString("dd.MM.yyyy")</td>
                                    <td><span class="badge @(t.Amount >= 0 ? "badge-success" : "badge-danger")">@(t.Amount >= 0 ? "Доход" : "Расход")</span></td>
                                    <td><span class="badge">@t.Category</span></td>
                                    <td>@(string.IsNullOrEmpty(t.Counterparty) ? "—" : t.Counterparty)</td>
                                    <td class="text-end fw-bold @(t.Amount >= 0 ? "text-success" : "text-danger")">
                                        @(t.Amount >= 0 ? "+" : "")@t.Amount.ToString("N2") Br
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline" @onclick="() => StartEdit(t)">Изменить</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(t.Id)">Удалить</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private List<Transaction> transactions = new();
    private bool showAddModal = false;
    private bool showEditModal = false;
    private bool showMessage = false;
    private string _message = string.Empty;
    private string _suggestedCategory = string.Empty;

    private Transaction _newTransaction { get; set; } = new() { Date = DateTime.Today };
    private Transaction _editTransaction { get; set; } = new();

    private string _searchQuery = string.Empty;
    private string _filterCategory = string.Empty;
    private string _filterType = "all";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            transactions = await DbContext.Transactions
                .Where(t => t.UserId == user.Id)
                .OrderByDescending(t => t.Date)
                .ToListAsync();
        }
    }

    private void OnDescriptionChanged()
    {
        if (!string.IsNullOrWhiteSpace(_newTransaction.Description) && _newTransaction.Amount != 0)
        {
            _suggestedCategory = CategorizationService.CategorizeTransaction(_newTransaction.Description, _newTransaction.Amount);
            if (string.IsNullOrWhiteSpace(_newTransaction.Category))
                _newTransaction.Category = _suggestedCategory;
        }
    }

    private void OnAmountChanged() => OnDescriptionChanged();

    private async Task AddTransaction()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;

        if (string.IsNullOrWhiteSpace(_newTransaction.Category))
            _newTransaction.Category = CategorizationService.CategorizeTransaction(_newTransaction.Description, _newTransaction.Amount);

        _newTransaction.UserId = user.Id;
        _newTransaction.CreatedAt = DateTime.UtcNow;

        DbContext.Transactions.Add(_newTransaction);
        await DbContext.SaveChangesAsync();

        _message = $"Транзакция добавлена: {_newTransaction.Description}";
        showMessage = true;
        _newTransaction = new Transaction { Date = DateTime.Today };
        _suggestedCategory = string.Empty;
        showAddModal = false;

        transactions = await DbContext.Transactions
            .Where(t => t.UserId == user.Id)
            .OrderByDescending(t => t.Date)
            .ToListAsync();

        await InvokeAsync(StateHasChanged);
        await Task.Delay(4000);
        showMessage = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmDelete(int id)
    {
        var ok = await JsRuntime.InvokeAsync<bool>("confirm", "Удалить транзакцию?");
        if (!ok) return;
        var t = await DbContext.Transactions.FindAsync(id);
        if (t != null)
        {
            DbContext.Transactions.Remove(t);
            await DbContext.SaveChangesAsync();
            _message = "Транзакция удалена";
            showMessage = true;
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (user != null)
            {
                transactions = await DbContext.Transactions
                    .Where(t => t.UserId == user.Id)
                    .OrderByDescending(t => t.Date)
                    .ToListAsync();
            }
        }
    }

    private void StartEdit(Transaction t)
    {
        _editTransaction = new Transaction
        {
            Id = t.Id,
            Date = t.Date,
            Amount = t.Amount,
            Description = t.Description,
            Category = t.Category,
            Counterparty = t.Counterparty,
            UserId = t.UserId,
            ProjectId = t.ProjectId,
            PaymentMethod = t.PaymentMethod,
            IsMandatory = t.IsMandatory
        };
        showEditModal = true;
    }

    private async Task SaveEdit()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;

        var t = await DbContext.Transactions.FindAsync(_editTransaction.Id);
        if (t == null) return;

        t.Date = _editTransaction.Date;
        t.Amount = _editTransaction.Amount;
        t.Description = _editTransaction.Description;
        t.Category = _editTransaction.Category;
        t.Counterparty = _editTransaction.Counterparty;
        t.UpdatedAt = DateTime.UtcNow;

        await DbContext.SaveChangesAsync();
        _message = "Транзакция обновлена";
        showMessage = true;
        showEditModal = false;

        transactions = await DbContext.Transactions
            .Where(t => t.UserId == user.Id)
            .OrderByDescending(t => t.Date)
            .ToListAsync();
    }

    private IEnumerable<Transaction> GetFilteredTransactions()
    {
        var filtered = transactions.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchQuery))
            filtered = filtered.Where(t => t.Description.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_filterCategory))
            filtered = filtered.Where(t => t.Category == _filterCategory);
        if (_filterType == "income")
            filtered = filtered.Where(t => t.Amount > 0);
        else if (_filterType == "expense")
            filtered = filtered.Where(t => t.Amount < 0);
        return filtered.OrderByDescending(t => t.Date);
    }

    private List<string> GetUniqueCategories() =>
        transactions?.Select(t => t.Category).Distinct().OrderBy(c => c).ToList() ?? new();

    private void ClearFilters()
    {
        _searchQuery = string.Empty;
        _filterCategory = string.Empty;
        _filterType = "all";
    }
}

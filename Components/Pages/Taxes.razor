    private string GetOrgMetaLine()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(_companyName))
            parts.Add(_companyName);
        if (!string.IsNullOrWhiteSpace(_companyUnp))
            parts.Add($"УНП {_companyUnp}");
        if (_taxSystem.HasValue)
            parts.Add(TaxSystemInfo.GetShortLabel(_taxSystem.Value));
        return parts.Count > 0
            ? string.Join(" · ", parts)
            : "Налоги, счета и платежи";
    }

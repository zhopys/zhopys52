    private async Task SaveBill()
    {
        ClearAlerts();
        _billFieldErrors.Clear();
        var validation = TaxFieldValidation.ValidateBill(_billName, _billAmount, _billDueDate);
        if (validation.HasErrors)
        {
            foreach (var field in new[] { "name", "amount", "dueDate" })
            {
                var err = validation.Get(field);
                if (err != null) _billFieldErrors.Set(field, err);
            }
            ShowError(validation.FirstError() ?? "Проверьте поля счёта");
            return;
        }

        try
        {
            if (_editBillId == 0)
            {
                DbContext.Reminders.Add(new Reminder
                {
                    Name = _billName.Trim(),
                    Amount = _billAmount,
                    Category = _billCategory,
                    Frequency = ReminderFrequency.OneTime,
                    Date = _billDueDate,
                    UserId = _userId,
                    IsPaid = false
                });
            }
            else
            {
                var bill = await DbContext.Reminders.FirstOrDefaultAsync(r => r.Id == _editBillId && r.UserId == _userId);
                if (bill == null || bill.IsPaid) { ShowError("Счёт не найден или уже оплачен"); return; }
                bill.Name = _billName.Trim();
                bill.Amount = _billAmount;
                bill.Category = _billCategory;
                bill.Date = _billDueDate;
            }
            await DbContext.SaveChangesAsync();
            ShowSuccess(_editBillId == 0 ? "Счёт добавлен" : "Счёт обновлён");
            _showBillForm = false;
            _editBillId = 0;
            ResetBillForm();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowError(TaxFieldValidation.TranslateError(ex));
        }
    }

    private async Task MarkBillPaid(int id)
    {
        var bill = await DbContext.Reminders.FirstOrDefaultAsync(r => r.Id == id && r.UserId == _userId);
        if (bill == null || bill.IsPaid) return;

        DbContext.Transactions.Add(new Transaction
        {
            UserId = _userId,
            Date = DateTime.Today,
            Amount = -Math.Abs(bill.Amount),
            Description = $"Оплата счёта: {bill.Name}",
            Category = bill.Category ?? "",
            IsConfirmed = true,
            ApprovalStatus = TransactionApprovalStatus.Approved,
            CreatedAt = DateTime.UtcNow
        });
        bill.IsPaid = true;
        bill.PaidDate = DateTime.Now;
        await DbContext.SaveChangesAsync();
        ShowSuccess("Счёт оплачен");
        await ReloadAsync();
    }

    private async Task DeleteBill(int id)
    {
        if (!await ConfirmDialog.ConfirmDeleteAsync("счёт / напоминание")) return;
        var bill = await DbContext.Reminders.FirstOrDefaultAsync(r => r.Id == id && r.UserId == _userId);
        if (bill == null) return;
        DbContext.Reminders.Remove(bill);
        await DbContext.SaveChangesAsync();
        await ReloadAsync();
    }


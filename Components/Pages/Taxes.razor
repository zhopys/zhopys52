    private async Task CreatePaymentsFromCalculator()
    {
        if (_calcResult == null || _calcResult.TaxAmount <= 0) return;
        ClearAlerts();
        try
        {
            var due = GetCalcDueDate();
            var (periodStart, _) = GetCalcPeriodBounds();
            var lines = _calcResult.Lines.Where(l => l.Amount > 0).ToList();
            if (lines.Count == 0)
                lines = [new TaxCalcLine { Name = _calcResult.SuggestedPaymentName, Amount = _calcResult.TaxAmount }];

            var created = 0;
            var skipped = new List<string>();
            foreach (var line in lines)
            {
                var paymentName = TaxPlannedPaymentHelper.BuildCalculatorPaymentName(
                    line.Name, _calcResult.SuggestedPaymentName, _calcPeriod, periodStart);
                var exists = _taxes.Any(t => TaxPlannedPaymentHelper.MatchesExisting(t, paymentName, due));
                if (exists)
                {
                    skipped.Add(paymentName);
                    continue;
                }
                await TaxService.AddTaxAsync(new TaxPayment
                {
                    UserId = _userId,
                    Name = paymentName,
                    Amount = line.Amount,
                    DueDate = due
                });
                created++;
            }

            if (created > 0)
            {
                var skipNote = skipped.Count > 0 ? $" (пропущено дубликатов: {skipped.Count})" : "";
                ShowSuccess(created > 1
                    ? $"Создано {created} плановых платежа, срок {due:dd.MM.yyyy}{skipNote}"
                    : $"Платёж создан, срок {due:dd.MM.yyyy}{skipNote}");
                _calcResult = null;
            }
            else
                ShowError(skipped.Count > 0
                    ? "Такие платежи уже есть в плане на этот срок"
                    : "Нет строк с суммой больше нуля");

            await ReloadAsync();
        }
        catch (Exception ex) { ShowError(TaxFieldValidation.TranslateError(ex)); }
    }

    private async Task ApplyCalcLineToTaxForm(TaxCalcLine? line)
    {
        if (_calcResult == null || _calcResult.TaxAmount <= 0) return;
        line ??= _calcResult.Lines.FirstOrDefault(l => l.Amount > 0)
            ?? new TaxCalcLine { Name = _calcResult.SuggestedPaymentName, Amount = _calcResult.TaxAmount };
        if (line.Amount <= 0) return;

        _editTaxId = 0;
        _taxAmount = line.Amount;
        (_taxTypeSelect, _customTaxName) = TaxFormHelper.MapToFormFields(line.Name, _calcResult.SuggestedPaymentName);
        _taxDueDate = GetCalcDueDate();
        var (periodStart, _) = GetCalcPeriodBounds();
        _taxPaymentFullName = TaxPlannedPaymentHelper.BuildCalculatorPaymentName(
            line.Name, _calcResult.SuggestedPaymentName, _calcPeriod, periodStart);
        _taxFieldErrors.Clear();
        _showPartialForm = false;
        await OpenTaxFormAsync(scroll: true);
        ShowSuccess("Проверьте сумму и срок в форме ниже, затем нажмите «Добавить»");
    }


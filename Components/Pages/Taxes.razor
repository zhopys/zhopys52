    private async Task SaveTax()
    {
        ClearAlerts();
        _taxFieldErrors.Clear();
        var validation = TaxFieldValidation.ValidateTaxPayment(_taxTypeSelect, _customTaxName, _taxAmount, _taxDueDate, _taxPaymentFullName);
        if (validation.HasErrors)
        {
            foreach (var field in new[] { "type", "customName", "amount", "dueDate" })
            {
                var err = validation.Get(field);
                if (err != null) _taxFieldErrors.Set(field, err);
            }
            ShowError(validation.FirstError() ?? "Проверьте поля формы");
            return;
        }

        var name = ResolveTaxName();

        try
        {
            if (_editTaxId == 0)
            {
                await TaxService.AddTaxAsync(new TaxPayment
                {
                    Name = name,
                    Amount = _taxAmount,
                    DueDate = _taxDueDate,
                    UserId = _userId
                });
                ShowSuccess($"Налог «{name}» добавлен");
            }
            else
            {
                var existing = _taxes.FirstOrDefault(t => t.Id == _editTaxId);
                if (existing == null)
                {
                    ShowError("Платёж не найден");
                    return;
                }
                if (existing.IsPaid)
                {
                    ShowError("Нельзя изменить уже оплаченный платёж");
                    return;
                }
                await TaxService.UpdateTaxAsync(new TaxPayment
                {
                    Id = _editTaxId,
                    Name = name,
                    Amount = _taxAmount,
                    DueDate = _taxDueDate
                }, _userId);
                ShowSuccess("Изменения сохранены");
            }
            _showTaxForm = false;
            _editTaxId = 0;
            ResetTaxForm();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowError(TaxFieldValidation.TranslateError(ex));
        }
    }

    private void RunTaxCalculator()
    {
        _calcError = null;
        _calcFieldErrors.Clear();
        var system = _taxSystem ?? TaxSystem.USN;
        var input = new TaxCalculatorInput
        {
            System = system,
            TaxpayerKind = _taxpayerKind,
            Income = _calcIncome,
            Expenses = _calcExpenses,
            IncomeFromIndividuals = _calcIncomeFromFl,
            IncomeFromLegalEntities = _calcIncomeFromYur,
            UnifiedTaxAmount = _unifiedTaxAmount,
            IncludeFsznEstimate = _calcIncludeFszn
        };

        var validation = TaxFieldValidation.ValidateCalculatorInput(input, _taxSystem);
        if (!validation.Ok)
        {
            _calcError = validation.Error;
            _calcResult = null;
            return;
        }

        _calcResult = TaxCalculatorHelper.Calculate(input);
        if (_calcResult.TaxAmount <= 0)
            _calcError = _calcResult.Description;
    }


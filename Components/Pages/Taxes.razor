                </div>
                <div class="mt-3" style="display:flex;gap:.5rem;justify-content:flex-end">
                    <button class="btn btn-primary" @onclick="SaveTax">@(_editTaxId == 0 ? "Добавить" : "Сохранить")</button>
                    <button class="btn btn-outline" @onclick="CancelTaxForm">Отмена</button>
                </div>
            </div>
        </div>
    }

    <TaxPaymentDetailsPanel TaxId="@_taxDetailId" UserId="@_userId" IsOpen="@_taxDetailOpen"
                            OnClose="CloseTaxDetail" OnChanged="ReloadAsync" OnEdit="EditTaxFromDetail" />
}
else
{
    @if (_bills != null)
    {
        var upcomingBills = _bills.Where(b => !b.IsPaid && b.Date >= DateTime.Today).ToList();
        if (upcomingBills.Any())
        {
            <div class="kpi-grid mb-3">
                <div class="kpi-card">
                    <div class="kpi-label">Счетов к оплате</div>
                    <div class="kpi-value">@upcomingBills.Count</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Сумма</div>
                    <div class="kpi-value">@upcomingBills.Sum(b => b.Amount).ToString("N0") <Byn /></div>
                </div>
            </div>
        }
    }

    <div class="card mb-3">
        <div class="card-body" style="padding:.5rem">
            <div class="tab-bar">
                <button class="tab @(_billFilter == "upcoming" ? "active" : "")" @onclick="@(() => SetBillFilter("upcoming"))">Предстоящие</button>
                <button class="tab @(_billFilter == "overdue" ? "active" : "")" @onclick="@(() => SetBillFilter("overdue"))">
                    Просроченные
                    @if (_billOverdueCount > 0) { <span class="tab-count tab-count-danger">@_billOverdueCount</span> }
                </button>
                <button class="tab @(_billFilter == "paid" ? "active" : "")" @onclick="@(() => SetBillFilter("paid"))">Оплаченные</button>
                <button class="tab @(_billFilter == "all" ? "active" : "")" @onclick="@(() => SetBillFilter("all"))">Все</button>
            </div>
        </div>
    </div>

    @if (_showBillForm)
    {
        <div class="card mb-3">
            <div class="card-header">@(_editBillId == 0 ? "Новый счёт" : "Редактирование счёта")</div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Название *</label>
                        <input class="form-input @(_billFieldErrors.Get("name") != null ? "input-invalid" : "")" @bind="_billName" placeholder="Аренда, связь, поставщик..." maxlength="@TaxFieldValidation.MaxBillNameLength" />
                        @if (_billFieldErrors.Get("name") is { } billNameErr)
                        {
                            <div class="validation-message">@billNameErr</div>
                        }
                    </div>
                    <div class="form-group">
                        <label class="form-label">Сумма *</label>
                        <input type="number" class="form-input @(_billFieldErrors.Get("amount") != null ? "input-invalid" : "")" @bind="_billAmount" step="0.01" min="0.01" />
                        @if (_billFieldErrors.Get("amount") is { } billAmountErr)
                        {
                            <div class="validation-message">@billAmountErr</div>
                        }
                    </div>
                    <div class="form-group">
                        <label class="form-label">Категория</label>
                        <select class="form-input" @bind="_billCategory">
                            <option value="">—</option>
                            @foreach (var c in _categories) { <option value="@c">@c</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Срок оплаты *</label>
                        <input type="date" class="form-input @(_billFieldErrors.Get("dueDate") != null ? "input-invalid" : "")" @bind="_billDueDate" />
                        @if (_billFieldErrors.Get("dueDate") is { } billDueErr)
                        {
                            <div class="validation-message">@billDueErr</div>
                        }
                    </div>
                </div>
                <div class="mt-3" style="display:flex;gap:.5rem;justify-content:flex-end">
                    <button class="btn btn-primary" @onclick="SaveBill">@(_editBillId == 0 ? "Добавить" : "Сохранить")</button>
                    <button class="btn btn-outline" @onclick="CancelBillForm">Отмена</button>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <span class="text-muted small">@GetFilteredBills().Count() записей · разовые счета</span>
            <span class="small text-muted">Повторяющиеся платежи — в <a href="/reminders">напоминаниях</a></span>
        </div>
        <div class="card-body" style="padding:0">
            @if (_loading)
            {
                <div class="loading-state"><div class="spinner"></div></div>
            }
            else if (!GetFilteredBills().Any())
            {
                <div class="empty-state">
                    <div class="empty-state-title">Нет счетов</div>
                    <button class="btn btn-primary" @onclick="OpenBillForm">Добавить счёт</button>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Категория</th>
                            <th>Срок</th>
                            <th class="text-end">Сумма</th>
                            <th>Статус</th>
                            <th class="text-center">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in GetFilteredBills())
                        {
                            var overdue = !bill.IsPaid && bill.Date.Date < DateTime.Today;
                            var days = (int)(bill.Date.Date - DateTime.Today).TotalDays;
                            <tr class="@(overdue ? "row-overdue" : "")">
                                <td><strong>@bill.Name</strong></td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(bill.Category) ? "—" : bill.Category)</td>
                                <td>
                                    <div class="@(overdue ? "text-danger" : "")">@bill.Date.ToString("dd.MM.yyyy")</div>
                                    @if (!bill.IsPaid) { <div class="small @(overdue ? "text-danger" : "text-muted")">@FormatDaysUntil(days)</div> }
                                </td>
                                <td class="text-end fw-bold">@bill.Amount.ToString("N2") <Byn /></td>
                                <td>
                                    @if (bill.IsPaid) { <span class="badge badge-success">Оплачено</span> }
                                    else if (overdue) { <span class="badge badge-danger">Просрочено</span> }
                                    else { <span class="badge badge-info">К оплате</span> }
                                </td>
                                <td class="text-center" style="white-space:nowrap">
                                    @if (!bill.IsPaid)
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => MarkBillPaid(bill.Id)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                        </button>
                                        <button class="btn btn-sm btn-outline" @onclick="() => EditBill(bill)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBill(bill.Id)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private string _userId = "";
    private bool _isTaxOnly;
    private TaxPeriodTotalsDto? _calcPeriodSummary;
    private TaxPeriodAnalysisDto? _periodAnalysis;
    private bool _showExcludedTaxLines;
    private Dictionary<int, TaxPayment> _linkedByTransaction = new();
    private int _taxDetailId;
    private bool _taxDetailOpen;
    private List<TaxPayment> _taxes = new();
    private List<Reminder>? _bills;
    private List<string> _categories = new();
    private TaxSummaryDto? _summary;
    private TaxSystem? _taxSystem;
    private TaxpayerKind _taxpayerKind = TaxpayerKind.LegalEntity;
    private string _companyName = "";
    private string _companyUnp = "";

    private bool _loading = true;
    private string _message = "";
    private bool _showMessage;
    private string _errorMessage = "";
    private bool _showError;

    private string _mainTab = "taxes";
    private string _taxFilter = "upcoming";
    private string _billFilter = "upcoming";
    private int _taxUpcomingCount;
    private int _billOverdueCount;

    private bool _showTaxForm;
    private bool _taxFormHighlight;
    private int _editTaxId;
    private string _taxTypeSelect = "УСН";
    private string _customTaxName = "";
    private string _taxPaymentFullName = "";
    private decimal _taxAmount;
    private DateTime _taxDueDate = DateTime.Today.AddMonths(1);

    private decimal _calcIncome;
    private decimal _calcExpenses;
    private decimal _calcIncomeFromFl;
    private decimal _calcIncomeFromYur;
    private decimal _unifiedTaxAmount;
    private bool _calcIncludeFszn;
    private string _calcPeriod = "quarter";
    private string? _calcError;
    private TaxCalculationResult? _calcResult;

    private readonly TaxFieldValidation.FieldErrors _taxFieldErrors = new();
    private readonly TaxFieldValidation.FieldErrors _partialFieldErrors = new();
    private readonly TaxFieldValidation.FieldErrors _billFieldErrors = new();
    private readonly TaxFieldValidation.FieldErrors _ruleFieldErrors = new();
    private readonly TaxFieldValidation.FieldErrors _calcFieldErrors = new();

    private List<TaxRulePreview> _autoRulePreviews = new();
    private bool _showAutoRuleForm;
    private TaxAutoRule _editRule = new();
    private int _editRulePeriodInt = 1;
    private string? _ruleFormulaPreview;
    private bool _autoRulesBusy;
    private bool _showPartialForm;
    private TaxPayment? _partialTax;
    private decimal _partialAmount;
    private string _partialReceipt = "";

    private bool _showBillForm;
    private int _editBillId;
    private string _billName = "";
    private decimal _billAmount;
    private string _billCategory = "";
    private DateTime _billDueDate = DateTime.Today.AddMonths(1);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user == null) return;
        _userId = await DataScope.GetDataOwnerUserIdAsync(user.Id);
        var ctx = await UserContext.GetContextAsync(user.Id);
        _isTaxOnly = UserContext.IsTaxSpecialistOnly(ctx);
        if (_isTaxOnly)
            _mainTab = "taxes";
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        var ctx = await TaxService.GetPageContextAsync(_userId);
        _summary = ctx.Summary;
        _taxSystem = ctx.TaxSystem;
        _taxpayerKind = ctx.TaxpayerKind;
        _companyName = ctx.CompanyName;
        _companyUnp = ctx.CompanyUnp;
        _taxes = await TaxService.GetTaxesAsync(_userId);
        _linkedByTransaction = _taxes
            .Where(t => t.SourceTransactionId.HasValue)
            .GroupBy(t => t.SourceTransactionId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.CreatedAt).First());
        _taxUpcomingCount = _taxes.Count(t => !t.IsPaid && t.DueDate.Date >= DateTime.Today);

        if (!_isTaxOnly)
        {
            _bills = await DbContext.Reminders
                .Where(r => r.UserId == _userId && r.Frequency == ReminderFrequency.OneTime)
                .OrderBy(r => r.IsPaid)
                .ThenBy(r => r.Date)
                .ToListAsync();

            _billOverdueCount = _bills.Count(b => !b.IsPaid && b.Date.Date < DateTime.Today);
            _categories = await DbContext.Categories.Select(c => c.Name).ToListAsync();
        }
        else
        {
            _bills = new List<Reminder>();
            _billOverdueCount = 0;
            _categories = new List<string>();
        }

        if (_taxSystem.HasValue)
            await TaxAutoRuleService.SyncRulesForTaxSystemAsync(_userId, _taxSystem.Value);
        else
            await TaxAutoRuleService.EnsureDefaultRulesAsync(_userId, null);
        _autoRulePreviews = await TaxAutoRuleService.PreviewAsync(_userId);

        await LoadPeriodAnalysis();
        _loading = false;
    }

    private async Task LoadPeriodAnalysis()
    {
        if (!_taxSystem.HasValue) return;
        var (start, end) = GetCalcPeriodBounds();
        _periodAnalysis = await FinanceSummary.GetPeriodAnalysisAsync(
            _userId, start, end, _taxSystem.Value, _taxpayerKind, _calcIncludeFszn);
        _calcPeriodSummary = new TaxPeriodTotalsDto
        {
            PeriodStart = start,
            PeriodEnd = end,
            Income = _periodAnalysis.Income,
            Expenses = _periodAnalysis.Expenses,
            OperationCount = _periodAnalysis.OperationCount,
            ExcludedCount = _periodAnalysis.ExcludedCount,
            AccruedTax = _periodAnalysis.AccruedTaxTotal
        };
        ApplyAnalysisToCalculator();
    }

    private async Task SetCalcPeriod(string period)
    {
        _calcPeriod = period;
        await LoadPeriodAnalysis();
    }

    private string PeriodPillClass(string period) =>
        "taxes-period-pill" + (_calcPeriod == period ? " active" : "");

    private async Task OnCalcPeriodChanged() => await LoadPeriodAnalysis();

    private string GetRegimeRateHint() => _taxSystem switch
    {
        TaxSystem.USN => "6% от выручки",
        TaxSystem.OSN => _taxpayerKind == TaxpayerKind.IndividualEntrepreneur ? "16% от прибыли" : "20% от прибыли",
        TaxSystem.NPD => "4% с физлиц, 8% с юрлиц",
        TaxSystem.UnifiedTax => "фиксированная сумма",
        _ => ""
    };

    private static string GetStatusPillClass(string status) => status switch
    {
        "Оплачено" => "success",
        "Частично оплачено" => "warning",
        "Просрочено" => "danger",
        _ => "info"
    };

    private async Task OnFsznToggled() => await LoadPeriodAnalysis();

    private IReadOnlyList<TransactionTaxSuggestion> GetLineSuggestions(TransactionTaxLine line)
    {
        if (!_taxSystem.HasValue)
            return Array.Empty<TransactionTaxSuggestion>();
        return TransactionTaxLinkHelper.GetSuggestions(line, _taxSystem.Value, _taxpayerKind);
    }

    private TaxPayment? GetLinkedPayment(int transactionId) =>
        _linkedByTransaction.GetValueOrDefault(transactionId);

    private async Task CreatePaymentFromLine(TransactionTaxLine line, TransactionTaxSuggestion suggestion)
    {
        if (!_taxSystem.HasValue || suggestion.Amount <= 0)
            return;

        if (GetLinkedPayment(line.TransactionId) != null)
        {
            ShowError("По этой операции платёж уже создан");
            return;
        }

        ClearAlerts();
        try
        {
            var name = TransactionTaxLinkHelper.BuildPaymentName(suggestion, line);
            await TaxService.AddTaxAsync(new TaxPayment
            {
                UserId = _userId,
                Name = name,
                Amount = suggestion.Amount,
                DueDate = suggestion.DueDate,
                SourceTransactionId = line.TransactionId
            });
            ShowSuccess($"Платёж «{name}» добавлен, срок {DisplayDateHelper.Short(suggestion.DueDate)}");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowError(TaxFieldValidation.TranslateError(ex));
        }
    }

    private void ApplyAnalysisToCalculator()
    {
        if (_periodAnalysis == null) return;
        _calcIncome = _periodAnalysis.TaxableIncome + _periodAnalysis.IncomeFromIndividuals + _periodAnalysis.IncomeFromLegalEntities;
        _calcExpenses = _periodAnalysis.DeductibleExpenses;
        if (_taxSystem == TaxSystem.NPD)
        {
            _calcIncomeFromFl = _periodAnalysis.IncomeFromIndividuals;
            _calcIncomeFromYur = _periodAnalysis.IncomeFromLegalEntities;
        }
        _calcResult = _periodAnalysis.Calculation;
        if (_calcResult.TaxAmount <= 0 && !string.IsNullOrEmpty(_calcResult.Description))
            _calcError = _calcResult.Description;
        else
            _calcError = null;
    }

    private string GetPeriodLabel() => _calcPeriod switch
    {
        "month" => "за прошлый месяц",
        "year" => "за прошлый год",
        _ => "за прошлый квартал"
    };

    private IEnumerable<TransactionTaxLine> GetVisibleTaxLines() =>
        _periodAnalysis?.Lines.Where(l => _showExcludedTaxLines
            || l.Treatment is not (TransactionTaxTreatment.Excluded or TransactionTaxTreatment.TaxPayment))
        ?? Enumerable.Empty<TransactionTaxLine>();

    private static string GetFilterLabel(string name, int count) =>
        count > 0 ? $"{name} ({count})" : name;

    private void SetMainTab(string tab) => _mainTab = tab;

    private void SetTaxFilter(string filter) => _taxFilter = filter;

    private void SetBillFilter(string filter) => _billFilter = filter;

    private IEnumerable<TaxPayment> GetFilteredTaxes()
    {
        var today = DateTime.Today;
        return _taxFilter switch
        {
            "upcoming" => _taxes.Where(t => !t.IsPaid && t.DueDate.Date >= today),
            "overdue" => _taxes.Where(t => !t.IsPaid && t.DueDate.Date < today),
            "paid" => _taxes.Where(t => t.IsPaid),
            _ => _taxes
        };
    }

    private IEnumerable<Reminder> GetFilteredBills()
    {
        if (_bills == null) return Enumerable.Empty<Reminder>();
        var today = DateTime.Today;
        return _billFilter switch
        {
            "upcoming" => _bills.Where(b => !b.IsPaid && b.Date.Date >= today),
            "overdue" => _bills.Where(b => !b.IsPaid && b.Date.Date < today),
            "paid" => _bills.Where(b => b.IsPaid),
            _ => _bills
        };
    }

    private static string FormatDaysUntil(int days)
    {
        if (days < 0) return $"Просрочено на {Math.Abs(days)} дн.";
        if (days == 0) return "Сегодня";
        if (days == 1) return "Завтра";
        return $"Через {days} дн.";
    }

    private string GetTaxEmptyTitle() => _taxFilter switch
    {
        "overdue" => "Нет просроченных налогов",
        "paid" => "Нет оплаченных записей",
        "upcoming" => "Нет предстоящих платежей",
        _ => "Нет налоговых платежей"
    };

    private string GetTaxEmptyText() => _taxFilter switch
    {
        "overdue" => "Отлично — просроченных налогов нет.",
        "paid" => "Здесь появятся оплаченные платежи.",
        "upcoming" when _calcResult?.TaxAmount > 0 =>
            $"Расчёт готов: {_calcResult.TaxAmount:N0} {BynCurrency.Suffix}. Нажмите кнопку выше — создадим напоминание.",
        _ => "Создайте платёж — система напомнит о сроке и запишет оплату в учёт."
    };

    private static IEnumerable<TaxHintDto> GetTaxHints(TaxSystem system)
    {
        switch (system)
        {
            case TaxSystem.NPD:
                yield return new("НПД за месяц", "НПД", 0);
                break;
            case TaxSystem.UnifiedTax:
                yield return new("Единый налог", "Единый налог", 0);
                break;
            case TaxSystem.OSN:
                yield return new("Подоходный / прибыль", "Подоходный", 0);
                yield return new("НДС (оценка)", "НДС", 0);
                yield return new("ФСЗН за месяц", "ФСЗН", 0);
                break;
            default:
                yield return new("УСН за квартал", "УСН", 0);
                yield return new("ФСЗН за месяц", "ФСЗН", 0);
                break;
        }
    }

    private async Task ApplyTaxHint(TaxHintDto hint)
    {
        _editTaxId = 0;
        _taxAmount = 0;
        _taxPaymentFullName = "";
        _taxTypeSelect = hint.Name is "УСН" or "НДС" or "ФСЗН" or "Подоходный" or "НПД" or "Единый налог"
            ? hint.Name
            : "Другое";
        if (_taxTypeSelect == "Другое") _customTaxName = hint.Label;
        else _customTaxName = "";
        SetTaxDuePreset(hint.DuePresetDays);
        if (hint.Name == "УСН")
            _taxDueDate = TaxDueDateHelper.GetCalculatorDueDate(TaxSystem.USN, "quarter", DateTime.Today);
        else
            _taxDueDate = TaxDueDateHelper.DueAfterPeriodEnd(DateTime.Today, 1, 25);

        if (_taxSystem.HasValue)
        {
            RunTaxCalculator();
            if (_calcResult?.TaxAmount > 0)
            {
                var line = _calcResult.Lines.FirstOrDefault(l => l.Amount > 0);
                if (line != null)
                {
                    _taxAmount = line.Amount;
                    (_taxTypeSelect, _customTaxName) = TaxFormHelper.MapToFormFields(line.Name, _calcResult.SuggestedPaymentName);
                    var (periodStart, _) = GetCalcPeriodBounds();
                    _taxPaymentFullName = TaxPlannedPaymentHelper.BuildCalculatorPaymentName(
                        line.Name, _calcResult.SuggestedPaymentName, _calcPeriod, periodStart);
                }
            }
        }

        await OpenTaxFormAsync(scroll: true);
    }


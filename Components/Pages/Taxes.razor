                    <div class="form-group">
                        <label class="form-label">Сумма *</label>
                        <input type="number" class="form-input @(_taxFieldErrors.Get("amount") != null ? "input-invalid" : "")" @bind="_taxAmount" step="0.01" min="0.01" />
                        @if (_taxFieldErrors.Get("amount") is { } amountErr)
                        {
                            <div class="validation-message">@amountErr</div>
                        }
                    </div>
                    <div class="form-group">
                        <label class="form-label">Срок уплаты *</label>
                        <input type="date" class="form-input @(_taxFieldErrors.Get("dueDate") != null ? "input-invalid" : "")" @bind="_taxDueDate" />
                        @if (_taxFieldErrors.Get("dueDate") is { } dueDateErr)
                        {
                            <div class="validation-message">@dueDateErr</div>

                    <div class="form-group">
                        <label class="form-label">Чек / документ</label>
                        <input class="form-input @(_partialFieldErrors.Get("receipt") != null ? "input-invalid" : "")" @bind="_partialReceipt" placeholder="Номер платёжки, ссылка на файл" maxlength="@TaxFieldValidation.MaxReceiptLength" />
                        @if (_partialFieldErrors.Get("receipt") is { } receiptErr)

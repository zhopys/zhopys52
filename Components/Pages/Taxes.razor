@page "/taxes"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using MiniFinance.Data.Models
@using MiniFinance.Services
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject ITaxService TaxService
@inject ITaxAutoRuleService TaxAutoRuleService
@inject ITaxFinanceSummaryService FinanceSummary
@inject IUserContextService UserContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDataScopeService DataScope
@inject ConfirmDialogService ConfirmDialog
@inject IJSRuntime JS
@inject NavigationManager Navigation
@attribute [Authorize(Policy = AuthorizationPolicies.CanManageTaxes)]

<PageTitle>Налоги — MiniFinance</PageTitle>

<div class="page-header">
    <div class="title">
        <h1>@(_isTaxOnly ? "Налоги" : "Налоги и счета")</h1>
        <div class="meta text-muted">@GetOrgMetaLine()</div>
    </div>
    <div class="page-actions">
        <a href="/payment-calendar" class="btn btn-outline btn-sm">Календарь</a>
        @if (!_isTaxOnly)
        {
            <a href="/settings" class="btn btn-outline btn-sm">Настройки</a>
        }
        @if (_mainTab == "taxes")
        {
            <button type="button" class="btn btn-outline btn-sm" @onclick="ExportTaxPdf">PDF</button>
            <button type="button" class="btn btn-primary btn-sm" @onclick="OpenTaxForm">Добавить платёж</button>
        }
        else if (!_isTaxOnly)
        {
            <button class="btn btn-primary btn-sm" @onclick="OpenBillForm">Добавить счёт</button>
        }
    </div>
</div>

@if (_showMessage)
{
    <div class="alert alert-success">@_message</div>
}
@if (_showError)
{
    <div class="alert alert-error">@_errorMessage</div>
}
@if (_isTaxOnly)
{
    <div class="alert alert-info mb-3 small">Налог считается по подтверждённым операциям. Оплата создаёт проводку автоматически.</div>
}
@if (!_isTaxOnly)
{
    <div class="taxes-segment">
        <button class="@(_mainTab == "taxes" ? "active" : "")" @onclick="@(() => SetMainTab("taxes"))">
            Налоги @if (_summary?.OverdueCount > 0) { <span class="seg-count">@_summary.OverdueCount</span> }
        </button>
        <button class="@(_mainTab == "bills" ? "active" : "")" @onclick="@(() => SetMainTab("bills"))">
            Счета @if (_billOverdueCount > 0) { <span class="seg-count">@_billOverdueCount</span> }
        </button>
    </div>
}

@if (_mainTab == "taxes")
{
    <section class="taxes-hero">
        <div class="taxes-hero-top">
            <div>
                <p class="taxes-hero-label">Начислено @GetPeriodLabel()</p>
                <div class="taxes-hero-amount">@(_periodAnalysis?.AccruedTaxTotal.ToString("N2") ?? "0,00") <Byn /></div>
                @if (_periodAnalysis != null)
                {
                    <p class="taxes-hero-period">
                        @DisplayDateHelper.Range(_periodAnalysis.PeriodStart, _periodAnalysis.PeriodEnd)
                        · @_periodAnalysis.OperationCount операций
                    </p>
                }
                @if (_taxSystem.HasValue)
                {
                    <p class="taxes-hero-regime">@TaxSystemInfo.GetShortLabel(_taxSystem.Value) — @GetRegimeRateHint()</p>
                }
            </div>
            <div class="taxes-period-pills">
                <button type="button" class="@PeriodPillClass("month")" @onclick='() => SetCalcPeriod("month")'>Месяц</button>
                <button type="button" class="@PeriodPillClass("quarter")" @onclick='() => SetCalcPeriod("quarter")'>Квартал</button>
                <button type="button" class="@PeriodPillClass("year")" @onclick='() => SetCalcPeriod("year")'>Год</button>
            </div>
        </div>
        @if (_summary != null)
        {
            <div class="taxes-hero-metrics taxes-hero-metrics-compact">
                <div class="taxes-metric-card">
                    <div class="taxes-metric-label">К уплате</div>
                    <div class="taxes-metric-value danger">@_summary.UnpaidTotal.ToString("N0") <Byn /></div>
                </div>
                <div class="taxes-metric-card">
                    <div class="taxes-metric-label">Ближайший срок</div>
                    @if (_summary.NextDueDate.HasValue)
                    {
                        <div class="taxes-metric-value">@_summary.NextDueAmount.ToString("N0") <Byn /></div>
                        <div class="taxes-metric-sub">@_summary.NextDueName · @DisplayDateHelper.Short(_summary.NextDueDate.Value)</div>
                    }
                    else
                    {
                        <div class="taxes-metric-value muted">Нет платежей</div>
                    }
                </div>
            </div>
        }
    </section>

    <div class="taxes-layout">
        <section class="taxes-section taxes-section-payments">
            <div class="taxes-payments-head">
                <div>
                    <h2>Платежи</h2>
                    <p class="taxes-section-desc">Запланируйте и отметьте уплату — проводка создастся сама</p>
                </div>
                <div class="taxes-filter-bar">
                    <button class="@(_taxFilter == "upcoming" ? "active" : "")" @onclick="@(() => SetTaxFilter("upcoming"))">
                        @GetFilterLabel("Предстоящие", _taxUpcomingCount)
                    </button>
                    <button class="@(_taxFilter == "overdue" ? "active" : "")" @onclick="@(() => SetTaxFilter("overdue"))">
                        @GetFilterLabel("Просроченные", _summary?.OverdueCount ?? 0)
                    </button>
                    <button class="@(_taxFilter == "paid" ? "active" : "")" @onclick="@(() => SetTaxFilter("paid"))">Оплаченные</button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="taxes-empty"><div class="spinner"></div></div>
            }
            else if (!GetFilteredTaxes().Any())
            {
                <div class="taxes-empty">
                    <div class="taxes-empty-title">@GetTaxEmptyTitle()</div>
                    <div class="taxes-empty-text">@GetTaxEmptyText()</div>
                    @if (_calcResult?.TaxAmount > 0)
                    {
                        <button type="button" class="btn btn-primary btn-sm" @onclick="CreatePaymentsFromCalculator">
                            Создать на @_calcResult.TaxAmount.ToString("N0") <Byn />
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary btn-sm" @onclick="OpenTaxForm">Добавить платёж</button>
                    }
                </div>
            }
            else
            {
                <div class="taxes-payment-list">
                    @foreach (var tax in GetFilteredTaxes())
                    {
                        var overdue = !tax.IsPaid && tax.DueDate.Date < DateTime.Today;
                        var days = (int)(tax.DueDate.Date - DateTime.Today).TotalDays;
                        var statusLabel = TaxCalculatorHelper.GetPaymentStatusLabel(tax);
                        <article class="taxes-payment-card @(overdue ? "overdue" : tax.IsPaid ? "paid" : "")">
                            <div class="taxes-payment-main">
                                <div class="taxes-payment-name">@tax.Name</div>
                                <div class="taxes-payment-date @(overdue ? "text-danger" : "")">
                                    @DisplayDateHelper.Short(tax.DueDate)
                                    @if (!tax.IsPaid) { <span>· @FormatDaysUntil(days)</span> }
                                </div>
                            </div>
                            <div class="taxes-payment-side">
                                <div class="taxes-payment-amount">@tax.Amount.ToString("N2") <Byn /></div>
                                <span class="taxes-status-pill @(GetStatusPillClass(statusLabel))">@statusLabel</span>
                            </div>
                            <div class="taxes-payment-actions">
                                @if (!tax.IsPaid)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => MarkPaid(tax.Id)">Оплатить</button>
                                    <button class="btn btn-sm btn-outline" @onclick="() => OpenPartialPay(tax)">Частично</button>
                                    <button class="btn btn-sm btn-outline" @onclick="async () => await EditTax(tax)">Изменить</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline" @onclick="() => OpenTaxDetail(tax.Id)">Подробнее</button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="taxes-section taxes-section-ops">
            <div class="taxes-section-head">
                <div>
                    <h2>Операции и налоги</h2>
                    <p class="taxes-section-desc">Из операции можно создать плановый платёж</p>
                </div>
                @if (_periodAnalysis != null && _periodAnalysis.Lines.Count > 0)
                {
                    <div class="taxes-chips">
                        <span class="taxes-chip">База <strong>@_periodAnalysis.Income.ToString("N0")</strong></span>
                        @if (TaxSystemInfo.UsesExpenses(_taxSystem))
                        {
                            <span class="taxes-chip">Расходы <strong>@_periodAnalysis.Expenses.ToString("N0")</strong></span>
                        }
                    </div>
                }
            </div>

            @if (_periodAnalysis == null)
            {
                <div class="taxes-empty"><span class="text-muted">Загрузка…</span></div>
            }
            else if (_periodAnalysis.Lines.Count == 0)
            {
                <div class="taxes-empty">
                    <div class="taxes-empty-title">Пока нет операций</div>
                    <div class="taxes-empty-text">Импортируйте выписку или добавьте доход вручную — налог посчитается сам.</div>
                    <div class="taxes-empty-actions">
                        <a href="/import" class="btn btn-primary btn-sm">Импорт</a>
                        <a href="/transactions" class="btn btn-outline btn-sm">Операции</a>
                    </div>
                </div>
            }
            else
            {
                <div class="taxes-op-list">
                    @foreach (var line in GetVisibleTaxLines().Take(12))
                    {
                        var suggestions = GetLineSuggestions(line);
                        var linked = GetLinkedPayment(line.TransactionId);
                        <div class="taxes-op-item" title="@line.Note">
                            <div class="taxes-op-date">@DisplayDateHelper.MonthDay(line.Date)</div>
                            <div class="taxes-op-info">
                                <div class="taxes-op-title">@line.Description</div>
                                <div class="taxes-tx-sub">@(string.IsNullOrWhiteSpace(line.Counterparty) ? line.Category : line.Counterparty)</div>
                            </div>
                            <div class="taxes-op-nums">
                                <span class="@(line.Amount > 0 ? "income" : "expense")">@line.Amount.ToString("N0")</span>
                                @if (line.AccruedTax > 0)
                                {
                                    <span class="taxes-op-tax">+@line.AccruedTax.ToString("N2")</span>
                                }
                            </div>
                            <div class="taxes-op-action">
                                @if (linked != null)
                                {
                                    <span class="taxes-op-linked">@linked.Name</span>
                                }
                                else if (suggestions.Count > 0)
                                {
                                    @foreach (var suggestion in suggestions)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline taxes-op-btn"
                                                title="@suggestion.Hint"
                                                @onclick="() => CreatePaymentFromLine(line, suggestion)">
                                            @suggestion.PaymentType @suggestion.Amount.ToString("N0")
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (GetVisibleTaxLines().Count() > 12)
                {
                    <div class="taxes-footnote">Показано 12 из @GetVisibleTaxLines().Count() · <button type="button" class="taxes-link-btn" @onclick="ExportTaxPdf">Скачать PDF со всеми</button></div>
                }
                @if (_periodAnalysis.ExcludedCount > 0)
                {
                    <div class="taxes-footnote">
                        @_periodAnalysis.ExcludedCount без налога (переводы, уплаты).
                        <button type="button" class="taxes-link-btn" @onclick="() => _showExcludedTaxLines = !_showExcludedTaxLines">
                            @(_showExcludedTaxLines ? "Скрыть" : "Показать")
                        </button>
                    </div>
                }
            }
            @if (_taxSystem.HasValue)
            {
                <details class="taxes-regime-inline">
                    <summary>Как считается @TaxSystemInfo.GetLabel(_taxSystem)</summary>
                    <p class="mt-2 mb-1">@TaxSystemInfo.GetDescription(_taxSystem.Value)</p>
                    <p class="mb-0 small text-muted">@TaxSystemInfo.GetMnsHint()</p>
                </details>
            }
        </section>
    </div>

    <details class="taxes-advanced">
        <summary>Плановый платёж и автоматизация</summary>
        <div class="taxes-advanced-body">
            <div class="form-grid">
                @if (_taxSystem == TaxSystem.UnifiedTax)
                {
                    <div class="form-group">
                        <label class="form-label">Единый налог за период (<Byn />)</label>
                        <input type="number" class="form-input" @bind="_unifiedTaxAmount" step="10" min="0" />
                    </div>
                }
                else if (_taxSystem == TaxSystem.NPD)
                {
                    <div class="form-group">
                        <label class="form-label">Доход от физлиц (<Byn />)</label>
                        <input type="number" class="form-input" @bind="_calcIncomeFromFl" step="100" min="0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Доход от юрлиц и ИП (<Byn />)</label>
                        <input type="number" class="form-input" @bind="_calcIncomeFromYur" step="100" min="0" />
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label class="form-label">Выручка / доход за период (<Byn />)</label>
                        <input type="number" class="form-input @(_calcFieldErrors.Get("income") != null ? "input-invalid" : "")" @bind="_calcIncome" step="100" min="0" />
                        @if (_calcFieldErrors.Get("income") is { } incomeErr)
                        {
                            <div class="validation-message">@incomeErr</div>
                        }
                    </div>
                    @if (TaxSystemInfo.UsesExpenses(_taxSystem))
                    {
                        <div class="form-group">
                            <label class="form-label">Расходы (документально)</label>
                            <input type="number" class="form-input" @bind="_calcExpenses" step="100" min="0" />
                        </div>
                    }
                    @if (_taxSystem is TaxSystem.USN or TaxSystem.OSN)
                    {
                        <div class="form-group" style="display:flex;align-items:center;gap:.5rem">
                            <input type="checkbox" id="calcFszn" @bind="_calcIncludeFszn" @bind:after="OnFsznToggled" />
                            <label for="calcFszn" class="form-label mb-0">Добавить оценку ФСЗН (~35% от выручки)</label>
                        </div>
                    }
                }
                <div class="form-group" style="display:flex;align-items:flex-end;gap:.5rem;flex-wrap:wrap">
                    <button type="button" class="btn btn-outline" @onclick="FillCalcFromPeriodSummary">Подставить из операций</button>
                    <button class="btn btn-primary" @onclick="RunTaxCalculator">Пересчитать</button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_calcError))
            {
                <div class="alert alert-error mt-3 mb-0 small">@_calcError</div>
            }
            else if (_calcResult != null && _calcResult.TaxAmount > 0)
            {
                <div class="taxes-calc-result">
                    <div class="taxes-calc-amount">@_calcResult.TaxAmount.ToString("N2") <Byn /> <span class="text-muted small">~@_calcResult.EffectiveRate%</span></div>
                    <div class="small text-muted mt-1">@_calcResult.Description</div>
                    <div class="taxes-calc-actions">
                        <button class="btn btn-sm btn-primary" @onclick="CreatePaymentsFromCalculator">
                            @(_calcResult.Lines.Count(l => l.Amount > 0) > 1 ? "Создать все" : "Создать платёж")
                        </button>
                        <button type="button" class="btn btn-sm btn-outline" @onclick="() => ApplyCalcLineToTaxForm(null)">Изменить вручную</button>
                    </div>
                </div>
            }
            else if (_calcResult != null)
            {
                <div class="small text-muted mt-3">@_calcResult.Description</div>
            }

            @if (_taxSystem.HasValue && GetTaxHints(_taxSystem.Value).Any())
            {
                <div class="mt-4" style="display:flex;flex-wrap:wrap;gap:6px;align-items:center">
                    <span class="small text-muted">Быстро:</span>
                    @foreach (var hint in GetTaxHints(_taxSystem.Value))
                    {
                        <button type="button" class="btn btn-sm btn-outline" @onclick="async () => await ApplyTaxHint(hint)">@hint.Label</button>
                    }
                </div>
            }

            <div class="mt-4 pt-4" style="border-top:1px solid var(--border)">
                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:12px">
                    <span class="small fw-bold">Автоправила</span>
                    <div style="display:flex;gap:6px">
                        <button type="button" class="btn btn-sm btn-outline" @onclick="OpenNewAutoRule">+ Правило</button>
                        <button type="button" class="btn btn-sm btn-outline" @onclick="GenerateAutoTaxPayments" disabled="@_autoRulesBusy">
                            @(_autoRulesBusy ? "…" : "Создать по правилам")
                        </button>
                    </div>
                </div>
                <p class="small text-muted mb-3">Формулы: <code>income</code>, <code>expenses</code>, <code>profit</code></p>
            @if (_autoRulePreviews.Count == 0 && !_showAutoRuleForm)
            {
                <div class="text-muted small">Нет правил. Нажмите «Добавить правило» или откройте страницу снова — подставятся типовые формулы для @TaxSystemInfo.GetLabel(_taxSystem).</div>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Правило</th>
                            <th>Плановый платёж</th>
                            <th>Формула</th>
                            <th>Период</th>
                            <th class="text-end">Сумма</th>
                            <th>Срок</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _autoRulePreviews)
                        {
                            <tr class="@(!string.IsNullOrEmpty(p.Error) ? "row-overdue" : "")">
                                <td><strong>@p.Rule.Name</strong></td>
                                <td class="small">@(string.IsNullOrEmpty(p.PlannedPaymentName) ? "—" : p.PlannedPaymentName)</td>
                                <td><code class="small">@p.Rule.Formula</code></td>
                                <td class="small text-muted">@FormatRulePeriod(p.Rule.Period)<br />@DisplayDateHelper.Range(p.PeriodStart, p.PeriodEnd)</td>
                                <td class="text-end">
                                    @if (!string.IsNullOrEmpty(p.Error))
                                    {
                                        <span class="text-danger small">@p.Error</span>
                                    }
                                    else
                                    {
                                        <span>@p.CalculatedAmount.ToString("N2") <Byn /></span>
                                        <div class="small text-muted">доход @p.Income.ToString("N0") / расх. @p.Expenses.ToString("N0") · @p.OperationCount оп.</div>
                                    }
                                </td>
                                <td>@p.DueDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-end" style="white-space:nowrap">
                                    @if (string.IsNullOrEmpty(p.Error) && p.CalculatedAmount > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline" title="Открыть форму" @onclick="() => ApplyRulePreviewToForm(p)">Форма</button>
                                        <button type="button" class="btn btn-sm btn-outline" title="Создать плановый платёж" @onclick="() => CreatePaymentFromRulePreview(p)">+</button>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline" @onclick="() => EditAutoRule(p.Rule)">Изм.</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAutoRule(p.Rule.Id)">×</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (_showAutoRuleForm)
            {
                <div class="mt-3 pt-3" style="border-top:1px solid var(--border)">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Название правила</label>
                            <input class="form-input @(_ruleFieldErrors.Get("name") != null ? "input-invalid" : "")" @bind="_editRule.Name" placeholder="УСН 6%" />
                            @if (_ruleFieldErrors.Get("name") is { } ruleNameErr)
                            {
                                <div class="validation-message">@ruleNameErr</div>
                            }
                        </div>
                        <div class="form-group">
                            <label class="form-label">Вид платежа</label>
                            <select class="form-input @(_ruleFieldErrors.Get("paymentName") != null ? "input-invalid" : "")" @bind="_editRule.PaymentName">
                                <option value="УСН">УСН</option>
                                <option value="НДС">НДС</option>
                                <option value="ФСЗН">ФСЗН</option>
                                <option value="Подоходный">Подоходный</option>
                                <option value="НПД">НПД</option>
                                <option value="Единый">Единый налог</option>
                                <option value="Другое">Другое</option>
                            </select>
                            @if (_ruleFieldErrors.Get("paymentName") is { } payNameErr)
                            {
                                <div class="validation-message">@payNameErr</div>
                            }
                        </div>
                        <div class="form-group" style="grid-column:1/-1">
                            <label class="form-label">Формула</label>
                            <input class="form-input @(_ruleFieldErrors.Get("formula") != null ? "input-invalid" : "")" @bind="_editRule.Formula" placeholder="income * 0.06" />
                            @if (_ruleFieldErrors.Get("formula") is { } formulaErr)
                            {
                                <div class="validation-message">@formulaErr</div>
                            }
                        </div>
                        <div class="form-group">
                            <label class="form-label">Период расчёта</label>
                            <select class="form-input" @bind="_editRulePeriodInt">
                                <option value="0">Месяц</option>
                                <option value="1">Квартал</option>
                                <option value="2">Год</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Срок: день месяца</label>
                            <input type="number" class="form-input @(_ruleFieldErrors.Get("dueDay") != null ? "input-invalid" : "")" @bind="_editRule.DueDayOfMonth" min="1" max="28" />
                            @if (_ruleFieldErrors.Get("dueDay") is { } dueDayErr)
                            {
                                <div class="validation-message">@dueDayErr</div>
                            }
                        </div>
                        <div class="form-group">
                            <label class="form-label">Срок: +месяцев после периода</label>
                            <input type="number" class="form-input @(_ruleFieldErrors.Get("dueOffset") != null ? "input-invalid" : "")" @bind="_editRule.DueMonthOffset" min="0" max="3" />
                            @if (_ruleFieldErrors.Get("dueOffset") is { } dueOffsetErr)
                            {
                                <div class="validation-message">@dueOffsetErr</div>
                            }
                        </div>
                        <div class="form-group" style="display:flex;align-items:center;gap:.5rem">
                            <input type="checkbox" id="ruleEnabled" @bind="_editRule.IsEnabled" />
                            <label for="ruleEnabled" class="form-label mb-0">Активно</label>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_ruleFormulaPreview))
                    {
                        <div class="small text-muted mt-2">Проверка (доход 1000 / расход 200): @_ruleFormulaPreview</div>
                    }
                    <div class="mt-3" style="display:flex;gap:.5rem;justify-content:flex-end">
                        <button class="btn btn-primary" @onclick="SaveAutoRule">Сохранить правило</button>
                        <button class="btn btn-outline" @onclick="CancelAutoRuleForm">Отмена</button>
                    </div>
                </div>
            }
            </div>
        </div>
    </details>

    @if (_showPartialForm && _partialTax != null)
    {
        <div class="taxes-form-panel">
            <div class="taxes-form-panel-head">Частичная оплата · @_partialTax.Name</div>
            <div class="taxes-form-panel-body">
                <div class="form-grid">
                    <div class="form-group">

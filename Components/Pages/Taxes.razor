                    @if (_billOverdueCount > 0) { <span class="tab-count tab-count-danger">@_billOverdueCount</span> }
                </button>
                <button class="tab @(_billFilter == "paid" ? "active" : "")" @onclick="@(() => SetBillFilter("paid"))">Оплаченные</button>
                <button class="tab @(_billFilter == "all" ? "active" : "")" @onclick="@(() => SetBillFilter("all"))">Все</button>
            </div>
        </div>
    </div>

    @if (_showBillForm)
    {
        <div class="card mb-3">
            <div class="card-header">@(_editBillId == 0 ? "Новый счёт" : "Редактирование счёта")</div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Название *</label>
                        <input class="form-input" @bind="_billName" placeholder="Аренда, связь, поставщик..." />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Сумма *</label>
                        <input type="number" class="form-input" @bind="_billAmount" step="0.01" min="0.01" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Категория</label>
                        <select class="form-input" @bind="_billCategory">
                            <option value="">—</option>
                            @foreach (var c in _categories) { <option value="@c">@c</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Срок оплаты *</label>
                        <input type="date" class="form-input" @bind="_billDueDate" />
                    </div>
                </div>
                <div class="mt-3" style="display:flex;gap:.5rem;justify-content:flex-end">
                    <button class="btn btn-primary" @onclick="SaveBill">@(_editBillId == 0 ? "Добавить" : "Сохранить")</button>
                    <button class="btn btn-outline" @onclick="CancelBillForm">Отмена</button>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <span class="text-muted small">@GetFilteredBills().Count() записей · разовые счета</span>
            <span class="small text-muted">Повторяющиеся платежи — в <a href="/reminders">напоминаниях</a></span>
        </div>
        <div class="card-body" style="padding:0">
            @if (_loading)
            {
                <div class="loading-state"><div class="spinner"></div></div>
            }
            else if (!GetFilteredBills().Any())
            {
                <div class="empty-state">
                    <div class="empty-state-title">Нет счетов</div>
                    <button class="btn btn-primary" @onclick="OpenBillForm">Добавить счёт</button>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Категория</th>
                            <th>Срок</th>
                            <th class="text-end">Сумма</th>
                            <th>Статус</th>
                            <th class="text-center">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in GetFilteredBills())
                        {
                            var overdue = !bill.IsPaid && bill.Date.Date < DateTime.Today;
                            var days = (int)(bill.Date.Date - DateTime.Today).TotalDays;
                            <tr class="@(overdue ? "row-overdue" : "")">
                                <td><strong>@bill.Name</strong></td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(bill.Category) ? "—" : bill.Category)</td>
                                <td>
                                    <div class="@(overdue ? "text-danger" : "")">@bill.Date.ToString("dd.MM.yyyy")</div>
                                    @if (!bill.IsPaid) { <div class="small @(overdue ? "text-danger" : "text-muted")">@FormatDaysUntil(days)</div> }
                                </td>
                                <td class="text-end fw-bold">@bill.Amount.ToString("N2") Br</td>
                                <td>
                                    @if (bill.IsPaid) { <span class="badge badge-success">Оплачено</span> }
                                    else if (overdue) { <span class="badge badge-danger">Просрочено</span> }
                                    else { <span class="badge badge-info">К оплате</span> }
                                </td>
                                <td class="text-center" style="white-space:nowrap">
                                    @if (!bill.IsPaid)
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => MarkBillPaid(bill.Id)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                        </button>
                                        <button class="btn btn-sm btn-outline" @onclick="() => EditBill(bill)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBill(bill.Id)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private string _userId = "";
    private bool _isTaxOnly;
    private TaxPeriodTotalsDto? _calcPeriodSummary;
    private int _taxDetailId;
    private bool _taxDetailOpen;
    private List<TaxPayment> _taxes = new();
    private List<Reminder>? _bills;
    private List<string> _categories = new();
    private TaxSummaryDto? _summary;
    private TaxSystem? _taxSystem;
    private TaxpayerKind _taxpayerKind = TaxpayerKind.LegalEntity;
    private string _companyName = "";
    private string _companyUnp = "";

    private bool _loading = true;
    private string _message = "";
    private bool _showMessage;
    private string _errorMessage = "";
    private bool _showError;

    private string _mainTab = "taxes";
    private string _taxFilter = "upcoming";
    private string _billFilter = "upcoming";
    private int _taxUpcomingCount;
    private int _billOverdueCount;

    private bool _showTaxForm;
    private bool _taxFormHighlight;
    private int _editTaxId;
    private string _taxTypeSelect = "НДС";
    private string _customTaxName = "";
    private decimal _taxAmount;
    private DateTime _taxDueDate = DateTime.Today.AddMonths(1);

    private decimal _calcIncome;
    private decimal _calcExpenses;
    private decimal _calcIncomeFromFl;
    private decimal _calcIncomeFromYur;
    private decimal _unifiedTaxAmount;
    private string _calcPeriod = "quarter";
    private TaxCalculationResult? _calcResult;

    private List<TaxRulePreview> _autoRulePreviews = new();
    private bool _showAutoRuleForm;
    private TaxAutoRule _editRule = new();
    private int _editRulePeriodInt = 1;
    private string? _ruleFormulaPreview;
    private bool _autoRulesBusy;
    private bool _showPartialForm;
    private TaxPayment? _partialTax;
    private decimal _partialAmount;
    private string _partialReceipt = "";

    private bool _showBillForm;
    private int _editBillId;
    private string _billName = "";
    private decimal _billAmount;
    private string _billCategory = "";
    private DateTime _billDueDate = DateTime.Today.AddMonths(1);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user == null) return;
        _userId = await DataScope.GetDataOwnerUserIdAsync(user.Id);
        var ctx = await UserContext.GetContextAsync(user.Id);
        _isTaxOnly = UserContext.IsTaxSpecialistOnly(ctx);
        if (_isTaxOnly)
            _mainTab = "taxes";
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        var ctx = await TaxService.GetPageContextAsync(_userId);
        _summary = ctx.Summary;
        _taxSystem = ctx.TaxSystem;
        _taxpayerKind = ctx.TaxpayerKind;
        _companyName = ctx.CompanyName;
        _companyUnp = ctx.CompanyUnp;
        _taxes = await TaxService.GetTaxesAsync(_userId);
        _taxUpcomingCount = _taxes.Count(t => !t.IsPaid && t.DueDate.Date >= DateTime.Today);

        if (!_isTaxOnly)
        {
            _bills = await DbContext.Reminders
                .Where(r => r.UserId == _userId && r.Frequency == ReminderFrequency.OneTime)
                .OrderBy(r => r.IsPaid)
                .ThenBy(r => r.Date)
                .ToListAsync();

            _billOverdueCount = _bills.Count(b => !b.IsPaid && b.Date.Date < DateTime.Today);
            _categories = await DbContext.Categories.Select(c => c.Name).ToListAsync();
        }
        else
        {
            _bills = new List<Reminder>();
            _billOverdueCount = 0;
            _categories = new List<string>();
        }

        if (_taxSystem.HasValue)
            await TaxAutoRuleService.SyncRulesForTaxSystemAsync(_userId, _taxSystem.Value);
        else
            await TaxAutoRuleService.EnsureDefaultRulesAsync(_userId, null);
        _autoRulePreviews = await TaxAutoRuleService.PreviewAsync(_userId);

        _loading = false;
    }

    private void SetMainTab(string tab) => _mainTab = tab;

    private void SetTaxFilter(string filter) => _taxFilter = filter;

    private void SetBillFilter(string filter) => _billFilter = filter;

    private IEnumerable<TaxPayment> GetFilteredTaxes()
    {
        var today = DateTime.Today;
        return _taxFilter switch
        {
            "upcoming" => _taxes.Where(t => !t.IsPaid && t.DueDate.Date >= today),
            "overdue" => _taxes.Where(t => !t.IsPaid && t.DueDate.Date < today),
            "paid" => _taxes.Where(t => t.IsPaid),
            _ => _taxes
        };
    }

    private IEnumerable<Reminder> GetFilteredBills()
    {
        if (_bills == null) return Enumerable.Empty<Reminder>();
        var today = DateTime.Today;
        return _billFilter switch
        {
            "upcoming" => _bills.Where(b => !b.IsPaid && b.Date.Date >= today),
            "overdue" => _bills.Where(b => !b.IsPaid && b.Date.Date < today),
            "paid" => _bills.Where(b => b.IsPaid),
            _ => _bills
        };
    }

    private static string FormatDaysUntil(int days)
    {
        if (days < 0) return $"Просрочено на {Math.Abs(days)} дн.";
        if (days == 0) return "Сегодня";
        if (days == 1) return "Завтра";
        return $"Через {days} дн.";
    }

    private string GetTaxEmptyTitle() => _taxFilter switch
    {
        "overdue" => "Нет просроченных налогов",
        "paid" => "Нет оплаченных записей",
        "upcoming" => "Нет предстоящих платежей",
        _ => "Нет налоговых платежей"
    };

    private string GetTaxEmptyText() => _taxFilter == "upcoming"
        ? "Добавьте плановый платёж или используйте шаблоны сроков выше"
        : "Измените фильтр или добавьте новую запись";

    private static IEnumerable<TaxHintDto> GetTaxHints(TaxSystem system)
    {
        switch (system)
        {
            case TaxSystem.NPD:
                yield return new("НПД за месяц", "НПД", 0);
                break;
            case TaxSystem.UnifiedTax:
                yield return new("Единый налог", "Единый", 0);
                break;
            case TaxSystem.OSN:
                yield return new("Подоходный / прибыль", "Подоходный", 0);
                yield return new("НДС (оценка)", "НДС", 0);
                yield return new("ФСЗН за месяц", "ФСЗН", 0);
                break;
            default:
                yield return new("УСН за квартал", "УСН", 0);
                yield return new("ФСЗН за месяц", "ФСЗН", 0);
                break;
        }
    }

    private async Task ApplyTaxHint(TaxHintDto hint)
    {
        _editTaxId = 0;
        _taxAmount = 0;
        _taxTypeSelect = hint.Name is "УСН" or "НДС" or "ФСЗН" or "Подоходный" ? hint.Name : "Другое";
        if (_taxTypeSelect == "Другое") _customTaxName = hint.Label;
        else _customTaxName = "";
        SetTaxDuePreset(hint.DuePresetDays);
        if (hint.Name == "УСН")
            _taxDueDate = TaxDueDateHelper.GetCalculatorDueDate(TaxSystem.USN, "quarter", DateTime.Today);
        else
            _taxDueDate = TaxDueDateHelper.DueAfterPeriodEnd(DateTime.Today, 1, 25);
        await OpenTaxFormAsync(scroll: true);
    }

    private async Task OpenTaxForm()
    {
        _editTaxId = 0;
        ResetTaxForm();
        await OpenTaxFormAsync(scroll: true);
    }

    private void OpenBillForm()
    {
        _showBillForm = true;
        if (_editBillId == 0) ResetBillForm();
    }

    private void CancelTaxForm()
    {
        _showTaxForm = false;
        _editTaxId = 0;
        ResetTaxForm();
    }

    private void CancelBillForm()
    {
        _showBillForm = false;
        _editBillId = 0;
        ResetBillForm();
    }

    private void ResetTaxForm()
    {
        _taxTypeSelect = GetDefaultTaxTypeSelect();
        _customTaxName = "";
        _taxAmount = 0;
        _taxDueDate = DateTime.Today.AddMonths(1);
    }

    private string GetDefaultTaxTypeSelect() => _taxSystem switch
    {
        TaxSystem.USN => "УСН",
        TaxSystem.OSN => "НДС",
        _ => "УСН"
    };

    private void ResetBillForm()
    {
        _billName = "";
        _billAmount = 0;
        _billCategory = "";
        _billDueDate = DateTime.Today.AddMonths(1);
    }

    private void OnTaxTypeChanged() { }

    private string ResolveTaxName() => TaxFormHelper.ResolvePaymentName(_taxTypeSelect, _customTaxName);

    private void SetTaxDuePreset(int days) => _taxDueDate = DateTime.Today.AddDays(days);

    private void SetTaxDueEndOfMonth()
    {
        var d = DateTime.Today;
        _taxDueDate = new DateTime(d.Year, d.Month, DateTime.DaysInMonth(d.Year, d.Month));
    }

    private void SetTaxDueQuarterEnd()
    {
        var d = DateTime.Today;
        var quarter = (d.Month - 1) / 3;
        var endMonth = (quarter + 1) * 3;
        _taxDueDate = new DateTime(d.Year, endMonth, DateTime.DaysInMonth(d.Year, endMonth));
    }

    private async Task EditTax(TaxPayment tax)
    {
        _editTaxId = tax.Id;
        if (TaxFormHelper.IsKnownTypeName(tax.Name))
        {
            _taxTypeSelect = tax.Name;
            _customTaxName = "";
        }
        else
            (_taxTypeSelect, _customTaxName) = TaxFormHelper.MapToFormFields(tax.Name);

        _taxAmount = tax.Amount;
        _taxDueDate = tax.DueDate;
        _showPartialForm = false;
        await OpenTaxFormAsync(scroll: true);
    }

    private async Task EditTaxFromDetail(int taxId)
    {
        var tax = _taxes.FirstOrDefault(t => t.Id == taxId);
        if (tax != null)
            await EditTax(tax);
    }

    private void EditBill(Reminder bill)
    {
        _editBillId = bill.Id;
        _billName = bill.Name;
        _billAmount = bill.Amount;
        _billCategory = bill.Category ?? "";
        _billDueDate = bill.Date;
        _showBillForm = true;
    }

    private async Task SaveTax()
    {
        ClearAlerts();
        var name = ResolveTaxName();
        if (_taxAmount <= 0)
        {
            ShowError("Укажите сумму больше нуля");
            return;
        }

        try
        {
            if (_editTaxId == 0)
            {
                await TaxService.AddTaxAsync(new TaxPayment
                {
                    Name = name,
                    Amount = _taxAmount,
                    DueDate = _taxDueDate,
                    UserId = _userId
                });
                ShowSuccess($"Налог «{name}» добавлен");
            }
            else
            {
                var existing = _taxes.FirstOrDefault(t => t.Id == _editTaxId);
                if (existing == null)
                {
                    ShowError("Платёж не найден");
                    return;
                }
                if (existing.IsPaid)
                {
                    ShowError("Нельзя изменить уже оплаченный платёж");
                    return;
                }
                await TaxService.UpdateTaxAsync(new TaxPayment
                {
                    Id = _editTaxId,
                    Name = name,
                    Amount = _taxAmount,
                    DueDate = _taxDueDate
                }, _userId);
                ShowSuccess("Изменения сохранены");
            }
            _showTaxForm = false;
            _editTaxId = 0;
            ResetTaxForm();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    private void RunTaxCalculator()
    {
        var system = _taxSystem ?? TaxSystem.USN;
        _calcResult = TaxCalculatorHelper.Calculate(new TaxCalculatorInput
        {
            System = system,
            TaxpayerKind = _taxpayerKind,
            Income = _calcIncome,
            Expenses = _calcExpenses,
            IncomeFromIndividuals = _calcIncomeFromFl,
            IncomeFromLegalEntities = _calcIncomeFromYur,
            UnifiedTaxAmount = _unifiedTaxAmount
        });
    }

    private async Task FillCalcFromPeriodSummary()
    {
        var (start, end) = GetCalcPeriodBounds();
        _calcPeriodSummary = await FinanceSummary.GetPeriodTotalsAsync(_userId, start, end);
        _calcIncome = _calcPeriodSummary.Income;
        _calcExpenses = _calcPeriodSummary.Expenses;
        if (_taxSystem == TaxSystem.NPD)
            _calcIncomeFromYur = _calcPeriodSummary.Income;
        RunTaxCalculator();
    }

    private void ExportTaxPdf()
    {
        var (start, end) = GetCalcPeriodBounds();
        var qs = $"start={start:yyyy-MM-dd}&end={end:yyyy-MM-dd}";
        Navigation.NavigateTo($"/api/taxes/export/pdf?{qs}", forceLoad: true);
    }

    private (DateTime Start, DateTime End) GetCalcPeriodBounds() =>
        TaxDueDateHelper.GetPeriodBounds(_calcPeriod, DateTime.Today);

    private DateTime GetCalcDueDate() =>
        TaxDueDateHelper.GetCalculatorDueDate(_taxSystem, _calcPeriod, DateTime.Today);

    private async Task CreatePaymentsFromCalculator()
    {
        if (_calcResult == null || _calcResult.TaxAmount <= 0) return;
        ClearAlerts();
        try
        {
            var due = GetCalcDueDate();
            var lines = _calcResult.Lines.Count > 0
                ? _calcResult.Lines
                : new List<TaxCalcLine> { new() { Name = _calcResult.SuggestedPaymentName, Amount = _calcResult.TaxAmount } };
            foreach (var line in lines)
            {
                if (line.Amount <= 0) continue;
                await TaxService.AddTaxAsync(new TaxPayment
                {
                    UserId = _userId,
                    Name = line.Name,
                    Amount = line.Amount,
                    DueDate = due
                });
            }
            ShowSuccess(lines.Count > 1
                ? $"Создано {lines.Count} плановых платежа до {due:dd.MM.yyyy}"
                : $"Платёж «{lines[0].Name}» на {lines[0].Amount:N2} Br создан");
            _calcResult = null;
            await ReloadAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
    }

    private async Task ApplyCalcLineToTaxForm(TaxCalcLine? line)
    {
        if (_calcResult == null || _calcResult.TaxAmount <= 0) return;
        line ??= _calcResult.Lines.FirstOrDefault(l => l.Amount > 0)
            ?? new TaxCalcLine { Name = _calcResult.SuggestedPaymentName, Amount = _calcResult.TaxAmount };
        if (line.Amount <= 0) return;

        _editTaxId = 0;
        _taxAmount = line.Amount;
        (_taxTypeSelect, _customTaxName) = TaxFormHelper.MapToFormFields(line.Name, _calcResult.SuggestedPaymentName);
        _taxDueDate = GetCalcDueDate();
        _showPartialForm = false;
        await OpenTaxFormAsync(scroll: true);
        ShowSuccess("Проверьте сумму и срок в форме ниже, затем нажмите «Добавить»");
    }

    private async Task ApplyRulePreviewToForm(TaxRulePreview preview)
    {
        if (!string.IsNullOrEmpty(preview.Error) || preview.CalculatedAmount <= 0)
        {
            ShowError(preview.Error ?? "Сумма по правилу равна нулю");
            return;
        }

        _editTaxId = 0;
        var paymentName = preview.Rule.Period switch
        {
            TaxRulePeriod.Monthly => $"{preview.Rule.PaymentName} {preview.PeriodStart:MMM yyyy}",
            TaxRulePeriod.Yearly => $"{preview.Rule.PaymentName} {preview.PeriodStart:yyyy}",
            _ => $"{preview.Rule.PaymentName} Q{(preview.PeriodStart.Month - 1) / 3 + 1} {preview.PeriodStart:yyyy}"
        };

        (_taxTypeSelect, _customTaxName) = TaxFormHelper.MapToFormFields(paymentName, preview.Rule.PaymentName);
        _taxAmount = preview.CalculatedAmount;
        _taxDueDate = preview.DueDate;
        _showPartialForm = false;
        await OpenTaxFormAsync(scroll: true);
    }

    private async Task CreatePaymentFromRulePreview(TaxRulePreview preview)
    {
        ClearAlerts();
        try
        {
            var result = await TaxAutoRuleService.CreatePaymentFromPreviewAsync(_userId, preview);
            if (result.CreatedCount > 0)
                ShowSuccess(result.Messages.FirstOrDefault() ?? "Платёж создан");
            else
                ShowError(result.Messages.FirstOrDefault() ?? "Платёж не создан");
            await ReloadAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
    }

    private async Task OpenTaxFormAsync(bool scroll)
    {
        _showTaxForm = true;
        _taxFormHighlight = true;
        await InvokeAsync(StateHasChanged);
        if (scroll)
            await ScrollToTaxFormAsync();
        _ = ClearTaxFormHighlightSoonAsync();
    }

    private async Task ScrollToTaxFormAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("uiEnhance.scrollToId", "tax-payment-form");
        }
        catch
        {
            // ignore if JS not ready
        }
    }

    private async Task ClearTaxFormHighlightSoonAsync()
    {
        await Task.Delay(2500);
        _taxFormHighlight = false;
        await InvokeAsync(StateHasChanged);
    }

    private static string ShortLineLabel(string name) =>
        name.Length > 28 ? name[..25] + "…" : name;

    private static string FormatRulePeriod(TaxRulePeriod period) => period switch
    {
        TaxRulePeriod.Monthly => "Месяц",
        TaxRulePeriod.Yearly => "Год",
        _ => "Квартал"
    };

    private void OpenNewAutoRule()
    {
        var (payName, formula, period) = _taxSystem switch
        {
            TaxSystem.OSN => ("Подоходный", "max(0, income - expenses) * 0.16", TaxRulePeriod.Quarterly),
            TaxSystem.NPD => ("НПД", "income * 0.08", TaxRulePeriod.Monthly),
            TaxSystem.UnifiedTax => ("Единый", "0", TaxRulePeriod.Monthly),
            _ => ("УСН", "income * 0.06", TaxRulePeriod.Quarterly)
        };
        _editRule = new TaxAutoRule
        {
            Name = _taxSystem switch
            {
                TaxSystem.OSN => "ОСН (оценка)",
                TaxSystem.NPD => "НПД 8%",
                TaxSystem.UnifiedTax => "Единый налог",
                _ => "УСН 6% (выручка)"
            },
            PaymentName = payName,
            Formula = formula,
            Period = period,
            DueDayOfMonth = 25,
            DueMonthOffset = 1,
            IsEnabled = true
        };
        _editRulePeriodInt = (int)period;
        _ruleFormulaPreview = PreviewRuleFormula(_editRule.Formula);
        _showAutoRuleForm = true;
    }

    private void EditAutoRule(TaxAutoRule rule)
    {
        _editRule = new TaxAutoRule
        {
            Id = rule.Id,
            Name = rule.Name,
            PaymentName = rule.PaymentName,
            Formula = rule.Formula,
            Period = rule.Period,
            DueDayOfMonth = rule.DueDayOfMonth,
            DueMonthOffset = rule.DueMonthOffset,
            IsEnabled = rule.IsEnabled,
            SortOrder = rule.SortOrder
        };
        _editRulePeriodInt = (int)rule.Period;
        _ruleFormulaPreview = PreviewRuleFormula(rule.Formula);
        _showAutoRuleForm = true;
    }

    private void CancelAutoRuleForm() => _showAutoRuleForm = false;

    private string? PreviewRuleFormula(string formula)
    {
        var r = TaxFormulaEvaluator.TryEvaluate(formula, new TaxFormulaContext { Income = 1000, Expenses = 200 });
        return r.Ok ? $"{r.Value:N2} Br" : r.Error;
    }

    private async Task SaveAutoRule()
    {
        ClearAlerts();
        _editRule.Period = (TaxRulePeriod)_editRulePeriodInt;
        try
        {
            await TaxAutoRuleService.SaveAsync(_editRule, _userId);
            _showAutoRuleForm = false;
            ShowSuccess("Правило сохранено");
            await ReloadAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
    }

    private async Task DeleteAutoRule(int id)
    {
        if (!await ConfirmDialog.ConfirmDeleteAsync("правило авто-расчёта")) return;
        await TaxAutoRuleService.DeleteAsync(id, _userId);
        await ReloadAsync();
    }

    private async Task GenerateAutoTaxPayments()
    {
        ClearAlerts();
        _autoRulesBusy = true;
        try
        {
            var result = await TaxAutoRuleService.GeneratePaymentsAsync(_userId);
            if (result.CreatedCount > 0)
            {
                var extra = result.SkippedCount > 0 ? $" (пропущено: {result.SkippedCount})" : "";
                ShowSuccess($"Создано платежей: {result.CreatedCount}{extra}");
            }
            else if (result.Messages.Count > 0)
                ShowSuccess(string.Join(" · ", result.Messages.Take(5)));
            else
                ShowSuccess("Новых платежей не требуется — проверьте правила и сводку за период");
            await ReloadAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _autoRulesBusy = false; }
    }


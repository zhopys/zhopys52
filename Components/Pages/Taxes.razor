                            <button type="button" class="btn btn-sm btn-outline" @onclick="() => SetTaxDuePreset(0)">Сегодня</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="() => SetTaxDuePreset(7)">+7 дн.</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="SetTaxDueEndOfMonth">Конец месяца</button>
                            <button type="button" class="btn btn-sm btn-outline" @onclick="SetTaxDueQuarterEnd">Конец квартала</button>

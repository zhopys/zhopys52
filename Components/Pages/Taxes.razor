    private async Task GenerateAutoTaxPayments()
    {
        ClearAlerts();
        _autoRulesBusy = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await TaxAutoRuleService.GeneratePaymentsAsync(_userId);
            if (result.CreatedCount > 0)
            {
                var parts = new List<string> { $"Создано: {result.CreatedCount}" };
                if (result.SkippedCount > 0) parts.Add($"уже в плане: {result.SkippedCount}");
                if (result.ErrorCount > 0) parts.Add($"без суммы: {result.ErrorCount}");
                ShowSuccess(string.Join(", ", parts));
            }
            else if (result.ErrorCount > 0 && result.SkippedCount == 0)
                ShowError(string.Join(" · ", result.Messages.Take(6)));
            else if (result.Messages.Count > 0)
                ShowError(string.Join(" · ", result.Messages.Take(6)));
            else
                ShowError("Нет активных правил с суммой — включите правила и подставьте сводку за период");
            await ReloadAsync();
        }
        catch (Exception ex) { ShowError(TaxFieldValidation.TranslateError(ex)); }
        finally
        {
            _autoRulesBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }


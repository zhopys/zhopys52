@page "/debts"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using MiniFinance.Data
@using MiniFinance.Data.Models
@using MiniFinance.Services
@inject IDebtService DebtService
@inject ICounterpartyService CounterpartyService
@inject IJSRuntime JS
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider Auth
@attribute [Authorize(Policy = AuthorizationPolicies.CanAccessFinances)]

<PageTitle>Долги — MiniFinance</PageTitle>

<div class="page-header">
    <div class="title">
        <h1>Долги</h1>
        <div class="meta text-muted">Дебиторка и кредиторка</div>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" @onclick="OpenCreate">Добавить долг</button>
    </div>
</div>

@if (_summary != null)
{
    <div class="reports-tax-summary mb-3">
        <div class="reports-tax-kpi">
            <span class="reports-tax-kpi-label">Нам должны</span>
            <span class="reports-tax-kpi-value text-success">@_summary.TotalReceivable.ToString("N0") Br</span>
        </div>
        <div class="reports-tax-kpi">
            <span class="reports-tax-kpi-label">Мы должны</span>
            <span class="reports-tax-kpi-value text-danger">@_summary.TotalPayable.ToString("N0") Br</span>
        </div>
        <div class="reports-tax-kpi">
            <span class="reports-tax-kpi-label">Чистая позиция</span>
            <span class="reports-tax-kpi-value">@_summary.NetPosition.ToString("N0") Br</span>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_formError))
{
    <div class="alert alert-danger mb-3">@_formError</div>
}
@if (!string.IsNullOrEmpty(_payMessage))
{
    <div class="alert @(_payError ? "alert-danger" : "alert-success") mb-3">@_payMessage</div>
}

@if (_showForm)
{
    <div class="card mb-3">
        <div class="card-header">Новый долг</div>
        <div class="card-body">
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem">
                <div>
                    <label class="label">Тип</label>
                    <select class="input" @bind="_form.Type">
                        <option value="@DebtType.Receivable">Нам должны (дебиторка)</option>
                        <option value="@DebtType.Payable">Мы должны (кредиторка)</option>
                    </select>
                </div>
                <div>
                    <label class="label">Контрагент *</label>
                    <select class="input" @bind="_counterpartyKey" @bind:after="OnCounterpartyKeyChanged">
                        <option value="">— выберите —</option>
                        @foreach (var cp in _counterparties)
                        {
                            <option value="@($"id:{cp.Id}")">@cp.Name</option>
                        }
                        <option value="manual">Ввести вручную…</option>
                    </select>
                    @if (_counterpartyKey == "manual")
                    {
                        <input class="input mt-1" placeholder="Название" @bind="_counterpartyManual" />
                    }
                </div>
                <div><label class="label">Сумма *</label><input type="number" class="input" @bind="_form.Amount" /></div>
                <div><label class="label">Срок</label><input type="date" class="input" @bind="_dueDate" /></div>
            </div>
            <div class="mt-3" style="display:flex;gap:.5rem">
                <button class="btn btn-primary" @onclick="Save">Сохранить</button>
                <button class="btn btn-outline" @onclick="() => _showForm = false">Отмена</button>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-body" style="padding:0">
        @if (_debts == null) { <div class="empty-state small">Загрузка...</div> }
        else if (!_debts.Any()) { <div class="empty-state">Нет открытых долгов</div> }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Контрагент</th><th>Тип</th><th class="text-end">Сумма</th><th class="text-end">Оплачено</th><th>Срок</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var d in _debts)
                    {
                        <tr>
                            <td>@d.CounterpartyName</td>
                            <td>@(d.Type == DebtType.Receivable ? "Дебиторка" : "Кредиторка")</td>
                            <td class="text-end">@d.Amount.ToString("N0")</td>
                            <td class="text-end">@d.PaidAmount.ToString("N0")</td>
                            <td>@(d.DueDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                            <td class="text-end" style="white-space:nowrap">
                                <button class="btn btn-sm btn-outline" @onclick="() => OpenDetail(d.Id)">Подробнее</button>
                                <button class="btn btn-sm btn-outline" @onclick="() => Pay(d)">Погасить</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<DebtDetailsPanel DebtId="@_detailId" UserId="@_userId" IsOpen="@_detailOpen"
                 OnClose="CloseDetail" OnChanged="ReloadAsync" />

@code {
    private string _userId = "";
    private int _detailId;
    private bool _detailOpen;
    private List<Debt>? _debts;
    private List<CounterpartyRecord> _counterparties = new();
    private DebtSummaryDto? _summary;
    private bool _showForm;
    private Debt _form = new() { Type = DebtType.Receivable };
    private DateTime? _dueDate;
    private string _counterpartyKey = "";
    private string _counterpartyManual = "";
    private string _formError = "";
    private string _payMessage = "";
    private bool _payError;

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user == null) return;
        _userId = user.Id;
        _counterparties = await CounterpartyService.ListAsync(_userId);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _debts = await DebtService.ListAsync(_userId);
        _summary = await DebtService.GetSummaryAsync(_userId);
    }

    private void OpenCreate()
    {
        _form = new Debt { Type = DebtType.Receivable };
        _dueDate = null;
        _counterpartyKey = "";
        _counterpartyManual = "";
        _showForm = true;
    }

    private void OnCounterpartyKeyChanged()
    {
        if (_counterpartyKey != "manual")
            _counterpartyManual = "";
    }

    private void ApplyCounterpartyToDebt()
    {
        if (string.IsNullOrEmpty(_counterpartyKey))
            throw new InvalidOperationException("Выберите контрагента.");

        if (_counterpartyKey.StartsWith("id:", StringComparison.Ordinal) && int.TryParse(_counterpartyKey.AsSpan(3), out var id))
        {
            _form.CounterpartyId = id;
            _form.CounterpartyName = _counterparties.FirstOrDefault(c => c.Id == id)?.Name ?? "";
            return;
        }

        if (_counterpartyKey == "manual" && !string.IsNullOrWhiteSpace(_counterpartyManual))
        {
            _form.CounterpartyId = null;
            _form.CounterpartyName = _counterpartyManual.Trim();
            return;
        }

        throw new InvalidOperationException("Укажите контрагента.");
    }

    private async Task Save()
    {
        _formError = "";
        try
        {
            ApplyCounterpartyToDebt();
            _form.DueDate = _dueDate;
            await DebtService.CreateAsync(_form, _userId);
            _counterparties = await CounterpartyService.ListAsync(_userId);
            _showForm = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
    }

    private void OpenDetail(int id) { _detailId = id; _detailOpen = true; }
    private void CloseDetail() { _detailId = 0; _detailOpen = false; }

    private async Task Pay(Debt d)
    {
        _payMessage = "";
        var remaining = d.Amount - d.PaidAmount;
        if (remaining <= 0)
        {
            _payMessage = "Долг уже погашен";
            _payError = true;
            return;
        }

        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Погасить {remaining:N0} Br по контрагенту «{d.CounterpartyName}»? Будет создана транзакция.");
        if (!ok) return;

        try
        {
            await DebtService.RecordPaymentAsync(d.Id, remaining, _userId);
            _payMessage = $"Долг погашен: {d.CounterpartyName} — {remaining:N0} Br";
            _payError = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _payMessage = ex.Message;
            _payError = true;
        }
    }
}

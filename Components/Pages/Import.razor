@page "/import"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@using MiniFinance.Data.Models
@using MiniFinance.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject ApplicationDbContext DbContext
@inject ICsvParser CsvParser
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>Импорт транзакций - MiniFinance</PageTitle>

<AuthorizeView Context="authContext">
    <Authorized>
        <div class="page-header" style="margin-bottom: 1.5rem;">
            <div class="title">
                <h1>Импорт транзакций</h1>
                <div class="meta text-muted">Загрузите CSV файл с транзакциями</div>
            </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
            <div class="card-header">Формат CSV</div>
            <div class="card-body">
                <div class="alert alert-info">
                    <p><code>Дата,Сумма,Описание,Категория</code></p>
                    <p>Пример: <code>2024-01-15,-1500.00,Аренда офиса,Аренда</code></p>
                    <p>Сумма: положительная — доход, отрицательная — расход</p>
                </div>

                <EditForm Model="@uploadModel" OnValidSubmit="@HandleImport">
                    <div style="margin-bottom: 1rem;">
                        <label for="file" class="label">Выберите файл:</label>
                        <InputFile id="file" class="input" OnChange="@OnFileSelected" accept=".csv" />
                        <small class="text-muted">Поддерживается формат CSV</small>
                    </div>

                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert @(isError ? "alert-danger" : "alert-success")" style="margin-bottom: 1rem;">
                            @message
                        </div>
                    }

                    @if (importCount > 0)
                    {
                        <div class="card" style="margin-bottom: 1rem; background: var(--bg);">
                            <div class="card-body" style="padding: 1rem;">
                                <div>Импортировано транзакций: <strong>@importCount</strong></div>
                            </div>
                        </div>
                    }

                    <button type="submit" class="btn btn-primary" disabled="@(isProcessing || selectedFile == null)">
                        @(isProcessing ? "Импорт..." : "Импортировать")
                    </button>
                </EditForm>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private ApplicationUser? _currentUser;
    private class UploadModel { }
    private UploadModel uploadModel = new();

    private IBrowserFile? selectedFile;
    private string message = string.Empty;
    private bool isError = false;
    private bool isProcessing = false;
    private int importCount;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _currentUser = await UserManager.GetUserAsync(authState.User);
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        message = $"Выбран файл: {selectedFile.Name} ({selectedFile.Size / 1024:N0} КБ)";
        isError = false;
        importCount = 0;
    }

    private async Task HandleImport()
    {
        if (selectedFile == null)
        {
            message = "Пожалуйста, выберите файл";
            isError = true;
            return;
        }

        isProcessing = true;
        message = "Импорт...";
        importCount = 0;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (user == null)
            {
                message = "Ошибка авторизации";
                isError = true;
                return;
            }

            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var transactions = await CsvParser.ParseAsync(stream, user.Id);

            if (!transactions.Any())
            {
                message = "Не найдено транзакций в файле. Проверьте формат.";
                isError = true;
                return;
            }

            await DbContext.Transactions.AddRangeAsync(transactions);
            await DbContext.SaveChangesAsync();

            importCount = transactions.Count;
            message = $"Успешно импортировано {transactions.Count} транзакций!";
            isError = false;
            selectedFile = null;
        }
        catch (Exception ex)
        {
            message = $"Ошибка при импорте: {ex.Message}";
            isError = true;
        }
        finally
        {
            isProcessing = false;
        }
    }
}

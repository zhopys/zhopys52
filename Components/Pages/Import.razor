@page "/import"
@rendermode InteractiveServer
@using MiniFinance.Data
@using MiniFinance.Data.Models
@using MiniFinance.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject ICsvParser CsvParser
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ITransactionService TransactionService
@inject ICategorizationService CategorizationService
@attribute [Authorize]

<PageTitle>Импорт транзакций - MiniFinance</PageTitle>

<div class="page-header" style="margin-bottom: 1.5rem;">
            <div class="title">
                <h1>Импорт транзакций</h1>
                <div class="meta text-muted">CSV с разделителем «;» или «,», кодировка UTF-8</div>
            </div>
        </div>

        <div class="card" style="margin-bottom: 1.5rem;">
            <div class="card-header">Формат CSV</div>
            <div class="card-body">
                <div class="alert alert-info">
                    <p><code>Date;Amount;Description;Category</code></p>
                    <p>Пример: <code>2025-01-15;-1500.00;Аренда офиса;Аренда</code></p>
                    <p>Сумма: положительная — доход, отрицательная — расход. Дубликаты (дата+сумма+описание) пропускаются.</p>
                </div>

                <EditForm Model="@uploadModel" OnValidSubmit="@HandleImport">
                    <div style="margin-bottom: 1rem;">
                        <label class="label">Выберите файл:</label>
                        <InputFile class="input" OnChange="@OnFileSelected" accept=".csv,text/csv" />
                    </div>

                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert @(isError ? "alert-danger" : "alert-success")" style="margin-bottom: 1rem;">
                            @message
                            @if (importErrors.Any())
                            {
                                <ul class="mt-2 mb-0 small">
                                    @foreach (var err in importErrors.Take(10))
                                    {
                                        <li>@err</li>
                                    }
                                    @if (importErrors.Count > 10)
                                    {
                                        <li>…и ещё @(importErrors.Count - 10) ошибок</li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    <div style="display:flex;gap:.5rem;flex-wrap:wrap">
                        <button type="submit" class="btn btn-primary" disabled="@(isProcessing || selectedFile == null)">
                            @(isProcessing ? "Разбор..." : "Предпросмотр")
                        </button>
                        <button type="button" class="btn btn-outline" @onclick="DownloadSample">Скачать пример CSV</button>
                    </div>
                </EditForm>

                @if (showPreview && parsedPreview.Any())
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            Предпросмотр (@previewDisplayCount из @totalParsed)
                            @if (skippedDuplicates > 0) { <span class="text-muted small"> · дубликатов: @skippedDuplicates</span> }
                            @if (skippedInvalid > 0) { <span class="text-muted small"> · ошибок строк: @skippedInvalid</span> }
                        </div>
                        <div class="card-body" style="padding:0">
                            <table class="table">
                                <thead>
                                    <tr><th>Дата</th><th class="text-end">Сумма</th><th>Описание</th><th>Категория</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in parsedPreview.Take(50))
                                    {
                                        <tr class="@(p.Amount < 0 ? "negative-balance" : null)">
                                            <td>@p.Date.ToString("dd.MM.yyyy")</td>
                                            <td class="text-end">@p.Amount.ToString("N2")</td>
                                            <td>@p.Description</td>
                                            <td>@p.Category</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div style="padding:1rem;display:flex;gap:.5rem">
                                <button class="btn btn-primary" @onclick="ConfirmImport" disabled="@isProcessing">
                                    Подтвердить импорт (@totalParsed)
                                </button>
                                <button class="btn btn-outline" @onclick="CancelPreview">Отмена</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

@code {
    private class UploadModel { }
    private UploadModel uploadModel = new();

    private IBrowserFile? selectedFile;
    private string message = string.Empty;
    private bool isError;
    private bool isProcessing;
    private bool showPreview;

    private List<Transaction> allPending = new();
    private List<Transaction> parsedPreview = new();
    private List<string> importErrors = new();
    private int totalParsed;
    private int previewDisplayCount;
    private int skippedDuplicates;
    private int skippedInvalid;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        message = $"Выбран файл: {selectedFile.Name} ({selectedFile.Size / 1024:N0} КБ)";
        isError = false;
        showPreview = false;
        allPending.Clear();
    }

    private async Task HandleImport()
    {
        if (selectedFile == null)
        {
            message = "Выберите файл CSV";
            isError = true;
            return;
        }

        isProcessing = true;
        message = "Разбор файла...";
        importErrors.Clear();

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (user == null)
            {
                message = "Ошибка авторизации";
                isError = true;
                return;
            }

            await CategorizationService.EnsureDefaultCategoriesAsync();
            var existingHashes = await TransactionService.GetExistingHashesAsync(user.Id);

            await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            var parseResult = await CsvParser.ParseAsync(stream, user.Id, existingHashes);

            allPending = parseResult.Transactions;
            parsedPreview = allPending;
            totalParsed = allPending.Count;
            previewDisplayCount = Math.Min(50, totalParsed);
            skippedDuplicates = parseResult.SkippedDuplicates;
            skippedInvalid = parseResult.SkippedInvalid;

            importErrors.AddRange(parseResult.Errors.Select(e => $"Строка {e.LineNumber}: {e.Message}"));

            if (!allPending.Any())
            {
                message = "Не найдено валидных транзакций. Проверьте формат файла.";
                isError = true;
                showPreview = false;
                return;
            }

            showPreview = true;
            message = $"Готово к импорту: {totalParsed} транзакций. Пропущено дубликатов: {skippedDuplicates}, ошибок строк: {skippedInvalid}.";
            isError = skippedInvalid > 0;
        }
        catch (Exception ex)
        {
            message = $"Ошибка при разборе: {ex.Message}";
            isError = true;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ConfirmImport()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null)
        {
            message = "Ошибка авторизации";
            isError = true;
            return;
        }

        isProcessing = true;
        message = "Импорт...";

        var result = await TransactionService.ImportManyAsync(allPending, user.Id);
        importErrors = result.Errors;

        message = $"Импорт завершён. Успешно: {result.SuccessCount}, ошибок: {result.FailedCount}.";
        isError = result.FailedCount > 0;
        showPreview = false;
        allPending.Clear();
        parsedPreview.Clear();
        isProcessing = false;
    }

    private void CancelPreview()
    {
        showPreview = false;
        allPending.Clear();
        parsedPreview.Clear();
        message = "Импорт отменён";
        isError = false;
    }

    private void DownloadSample()
    {
        JS.InvokeVoidAsync("downloadFile", "/samples/sample_import.csv", "sample_import.csv");
    }
}


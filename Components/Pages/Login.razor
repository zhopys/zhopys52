@page "/login"
@attribute [Microsoft.AspNetCore.Components.LayoutAttribute(typeof(MiniFinance.Components.Layout.EmptyLayout))]

@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using MiniFinance.Components.Account
@using MiniFinance.Components.Account.Shared
@using MiniFinance.Services
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject NavigationManager NavigationManager

<PageTitle>Вход — MiniFinance</PageTitle>

<div class="login-page">
    <div class="login-container">
        <div class="login-header">
            <h1>MiniFinance</h1>
            <p class="text-muted">Вход в учётную запись</p>
        </div>

        <StatusMessage />

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success" role="alert">@_successMessage</div>
        }

        @if (_unconfirmedError)
        {
            <div class="alert alert-danger" role="alert">
                Подтвердите email. <a href="@_resendLink">Отправить ссылку</a>
            </div>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }

        <form method="post" action="/Account/Login">
            @if (_afTokens is not null)
            {
                <input type="hidden" name="@_afTokens.FormFieldName" value="@_afTokens.RequestToken" />
            }
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "")" />

            <div class="form-group">
                <label class="label" for="email">Email</label>
                <input type="email"
                       id="email"
                       name="email"
                       class="input"
                       value="@_email"
                       autocomplete="username"
                       placeholder="name@example.com"
                       maxlength="@AuthFieldValidation.MaxEmailLength"
                       required />
            </div>

            <div class="form-group">
                <label class="label" for="password">Пароль</label>
                <input type="password"
                       id="password"
                       name="password"
                       class="input"
                       autocomplete="current-password"
                       placeholder="Минимум 8 символов, цифра"
                       minlength="@AuthFieldValidation.MinPasswordLength"
                       maxlength="@AuthFieldValidation.MaxPasswordLength"
                       required />
            </div>

            <div class="form-group" style="display:flex;align-items:center;gap:.5rem">
                <input type="checkbox" id="rememberMe" name="rememberMe" value="true" style="accent-color:var(--accent)" />
                <label for="rememberMe">Запомнить меня</label>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;margin-top:1rem">Войти</button>
        </form>

        <div class="login-footer">
            <a href="Account/ForgotPassword">Забыли пароль?</a>
            <a href="@_registerLink">Регистрация</a>
            <a href="@_resendLink">Подтвердить email</a>
        </div>
    </div>
</div>

@code {
    private string _email = "";
    private string? _errorMessage;
    private string? _successMessage;
    private bool _unconfirmedError;
    private string _registerLink = "/Account/Register";
    private string _resendLink = "/Account/ResendEmailConfirmation";
    private AntiforgeryTokenSet? _afTokens;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "confirmed")]
    private string? Confirmed { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    private string? EmailFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorFromQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _email = EmailFromQuery?.Trim().ToLowerInvariant() ?? "";

        _registerLink = NavigationManager.GetUriWithQueryParameters(
            "/Account/Register",
            new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl });

        _resendLink = string.IsNullOrWhiteSpace(_email)
            ? "/Account/ResendEmailConfirmation"
            : NavigationManager.GetUriWithQueryParameters(
                "/Account/ResendEmailConfirmation",
                new Dictionary<string, object?> { ["email"] = _email });

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
        {
            _afTokens = Antiforgery.GetAndStoreTokens(httpContext);

            if (HttpMethods.IsGet(httpContext.Request.Method))
            {
                await httpContext.SignOutAsync(IdentityConstants.ExternalScheme);
            }

            if (httpContext.User.Identity?.IsAuthenticated == true)
            {
                var target = AccountUrls.SanitizeReturnUrl(ReturnUrl) ?? "/";
                NavigationManager.NavigateTo(target, forceLoad: true);
                return;
            }
        }

        ApplyQueryMessages();
    }

    private void ApplyQueryMessages()
    {
        if (Confirmed == "1")
            _successMessage = "Email подтверждён. Войдите с паролем.";

        _unconfirmedError = ErrorFromQuery == "unconfirmed";
        _errorMessage = ErrorFromQuery switch
        {
            "empty" => "Введите email и пароль.",
            "invalid_email" => "Укажите корректный email (например name@example.com).",
            "password_invalid" => $"Пароль: не менее {AuthFieldValidation.MinPasswordLength} символов и хотя бы одна цифра.",
            "password_too_long" => $"Пароль не длиннее {AuthFieldValidation.MaxPasswordLength} символов.",
            "invalid" => "Неверный email или пароль.",
            "unconfirmed" => null,
            "invalid_link" => "Некорректная ссылка.",
            "session_expired" => "Сессия истекла — обновите страницу (F5).",
            "user_not_found" => "Пользователь не найден.",
            "confirm_failed" => "Не удалось подтвердить email.",
            "invalid_code" => "Ссылка устарела.",
            "2fa_email" => "Не удалось отправить код 2FA на email. Проверьте настройки почты или отключите 2FA в профиле.",
            _ => _errorMessage
        };
    }
}

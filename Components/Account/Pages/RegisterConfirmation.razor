@page "/Account/RegisterConfirmation"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Components.LayoutAttribute(typeof(MiniFinance.Components.Layout.EmptyLayout))]

@using MiniFinance.Data
@using MiniFinance.Components.Account.Shared

@inject NavigationManager NavigationManager

<PageTitle>Регистрация — проверьте почту</PageTitle>

<div class="login-page">
    <div class="login-container">
        <h1>Проверьте почту</h1>

        @if (string.IsNullOrEmpty(Email))
        {
            <p class="text-muted">Email не указан.</p>
        }
        else
        {
            <p role="alert">
                На адрес <strong>@Email</strong> отправлено письмо со ссылкой для подтверждения.
                После подтверждения войдите в систему.
            </p>
            <p class="text-muted small" style="margin-top:1rem">
                Не пришло письмо? Проверьте «Спам» или
                <a href="@ResendUrl">отправьте ссылку повторно</a>.
            </p>
        }

        <p style="margin-top:1.5rem"><a href="/login" class="btn btn-primary" style="width:100%">Перейти ко входу</a></p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string ResendUrl => string.IsNullOrWhiteSpace(Email)
        ? "/Account/ResendEmailConfirmation"
        : NavigationManager.GetUriWithQueryParameters(
            "/Account/ResendEmailConfirmation",
            new Dictionary<string, object?> { ["email"] = Email });
}

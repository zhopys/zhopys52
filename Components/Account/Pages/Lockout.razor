@page "/Account/Lockout"
@attribute [Microsoft.AspNetCore.Components.LayoutAttribute(typeof(MiniFinance.Components.Layout.EmptyLayout))]

<PageTitle>Блокировка — MiniFinance</PageTitle>

<div class="login-page">
    <div class="login-container">
        <h1 class="text-danger">Учётная запись заблокирована</h1>
        <p class="text-muted">Слишком много неудачных попыток входа. Повторите через 15 минут.</p>
        <a href="/login" class="btn btn-primary mt-3">Ко входу</a>
    </div>
</div>

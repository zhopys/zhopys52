@page "/Account/ForgotPasswordConfirmation"
@attribute [Microsoft.AspNetCore.Components.LayoutAttribute(typeof(MiniFinance.Components.Layout.EmptyLayout))]

<PageTitle>Письмо отправлено — MiniFinance</PageTitle>

<div class="login-page">
    <div class="login-container">
        <h1>Проверьте почту</h1>
        <p role="alert" class="text-muted">
            Если учётная запись с указанным email существует и подтверждена, мы отправили ссылку для сброса пароля.
            Откройте письмо и перейдите по ссылке. Проверьте также папку «Спам».
        </p>
        <p class="login-footer mt-3"><a href="/login">Вернуться ко входу</a></p>
    </div>
</div>

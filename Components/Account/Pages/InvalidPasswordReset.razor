@page "/Account/InvalidPasswordReset"
@attribute [Microsoft.AspNetCore.Components.LayoutAttribute(typeof(MiniFinance.Components.Layout.EmptyLayout))]

<PageTitle>Ссылка недействительна — MiniFinance</PageTitle>

<div class="login-page">
    <div class="login-container">
        <h1 class="text-danger">Ссылка недействительна</h1>
        <p role="alert" class="text-muted">
            Ссылка для сброса пароля устарела или уже была использована. Запросите новую ссылку на странице восстановления пароля.
        </p>
        <a href="/Account/ForgotPassword" class="btn btn-primary mt-3" style="width:100%">Запросить ссылку снова</a>
        <p class="login-footer mt-3"><a href="/login">Вернуться ко входу</a></p>
    </div>
</div>

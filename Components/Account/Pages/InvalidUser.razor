@page "/Account/InvalidUser"
@attribute [Microsoft.AspNetCore.Components.LayoutAttribute(typeof(MiniFinance.Components.Layout.EmptyLayout))]

@using MiniFinance.Components.Account.Shared

<PageTitle>Ошибка учётной записи — MiniFinance</PageTitle>

<div class="login-page">
    <div class="login-container">
        <h1 class="text-danger">Ошибка учётной записи</h1>
        <StatusMessage />
        <p class="login-footer mt-3"><a href="/login">Вернуться ко входу</a></p>
    </div>
</div>

@page "/Account/ResetPasswordConfirmation"
@attribute [Microsoft.AspNetCore.Components.LayoutAttribute(typeof(MiniFinance.Components.Layout.EmptyLayout))]

<PageTitle>Пароль изменён — MiniFinance</PageTitle>

<div class="login-page">
    <div class="login-container">
        <h1>Пароль изменён</h1>
        <p role="alert" class="text-muted">
            Новый пароль сохранён. Теперь можно войти в систему.
        </p>
        <a href="/login" class="btn btn-primary mt-3" style="width:100%">Войти</a>
    </div>
</div>

@page "/Account/LoginWith2fa"
@attribute [Microsoft.AspNetCore.Components.LayoutAttribute(typeof(MiniFinance.Components.Layout.EmptyLayout))]

@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Identity
@using MiniFinance.Data
@using MiniFinance.Services

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject NavigationManager NavigationManager

<PageTitle>Двухфакторный вход — MiniFinance</PageTitle>

<div class="login-page">
    <div class="login-container">
        <div class="login-header">
            <h1>MiniFinance</h1>
            <p class="text-muted">Код из письма отправлен на @maskedEmail</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(_infoMessage))
        {
            <div class="alert alert-success" role="alert">@_infoMessage</div>
        }

        <form method="post" action="/Account/LoginWith2fa/Verify">
            @if (_afTokens is not null)
            {
                <input type="hidden" name="@_afTokens.FormFieldName" value="@_afTokens.RequestToken" />
            }
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "")" />
            <input type="hidden" name="rememberMe" value="@(RememberMe ? "true" : "false")" />

            <div class="form-group">
                <label class="label" for="twoFactorCode">Код из email</label>
                <input type="text"
                       id="twoFactorCode"
                       name="twoFactorCode"
                       class="input"
                       autocomplete="one-time-code"
                       placeholder="000000"
                       maxlength="8"
                       inputmode="numeric"
                       pattern="[0-9]{6}"
                       required />
                <div class="small text-muted">6 цифр из письма «Код входа — MiniFinance»</div>
            </div>

            <div class="form-group" style="display:flex;align-items:center;gap:.5rem">
                <input type="checkbox" id="remember-machine" name="rememberMachine" value="true" style="accent-color:var(--accent)" />
                <label for="remember-machine">Запомнить это устройство</label>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;margin-top:1rem">Войти</button>
        </form>

        <div class="login-footer" style="margin-top:1rem;display:flex;flex-direction:column;gap:8px">
            <form method="post" action="/Account/LoginWith2fa/Resend">
                @if (_afTokens is not null)
                {
                    <input type="hidden" name="@_afTokens.FormFieldName" value="@_afTokens.RequestToken" />
                }
                <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "")" />
                <input type="hidden" name="rememberMe" value="@(RememberMe ? "true" : "false")" />
                <button type="submit" class="btn btn-outline" style="width:100%">Отправить код повторно</button>
            </form>
            <a href="/login">Вернуться ко входу</a>
        </div>
    </div>
</div>

@code {
    private string maskedEmail = "";
    private string? _errorMessage;
    private string? _infoMessage;
    private AntiforgeryTokenSet? _afTokens;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool RememberMe { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sent")]
    private string? SentQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
            _afTokens = Antiforgery.GetAndStoreTokens(httpContext);

        var user = await SignInManager.GetTwoFactorAuthenticationUserAsync();
        if (user is null)
        {
            NavigationManager.NavigateTo("/login?error=session_expired", forceLoad: true);
            return;
        }

        var email = await UserManager.GetEmailAsync(user) ?? "";
        maskedEmail = MaskEmail(email);

        if (SentQuery == "1")
            _infoMessage = "Новый код отправлен на email.";

        _errorMessage = ErrorQuery switch
        {
            "invalid_code" => "Неверный или просроченный код. Запросите новый.",
            "send_failed" => "Не удалось отправить код. Проверьте настройки почты.",
            "session" => "Сессия истекла. Войдите снова.",
            _ => null
        };
    }

    private static string MaskEmail(string email)
    {
        var at = email.IndexOf('@');
        if (at <= 1) return email;
        return email[0] + new string('*', Math.Min(at - 1, 5)) + email[at..];
    }
}

@page "/Account/LoginWith2fa"
@attribute [Microsoft.AspNetCore.Components.LayoutAttribute(typeof(MiniFinance.Components.Layout.EmptyLayout))]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using MiniFinance.Data
@using MiniFinance.Services

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ITwoFactorService TwoFactorService
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWith2fa> Logger

<PageTitle>Двухфакторный вход — MiniFinance</PageTitle>

<div class="login-page">
    <div class="login-container">
        <div class="login-header">
            <h1>MiniFinance</h1>
            <p class="text-muted">Код из письма отправлен на @maskedEmail</p>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-danger" role="alert">@message</div>
        }
        @if (!string.IsNullOrEmpty(infoMessage))
        {
            <div class="alert alert-success" role="alert">@infoMessage</div>
        }

        <EditForm Model="Input" FormName="login-with-2fa" OnValidSubmit="OnValidSubmitAsync" method="post">
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <input type="hidden" name="RememberMe" value="@RememberMe" />
            <RussianDataAnnotationsValidator />
            <RussianValidationSummary class="text-danger" role="alert" />
            <div class="form-group">
                <label class="label" for="Input_TwoFactorCode">Код из email</label>
                <InputText @bind-Value="Input.TwoFactorCode" id="Input_TwoFactorCode" class="input" autocomplete="one-time-code" placeholder="000000" maxlength="8" inputmode="numeric" />
                <RussianValidationMessage For="() => Input.TwoFactorCode" class="text-danger" />
            </div>
            <div class="form-group" style="display:flex;align-items:center;gap:.5rem">
                <InputCheckbox @bind-Value="Input.RememberMachine" id="remember-machine" />
                <label for="remember-machine">Запомнить это устройство</label>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;margin-top:1rem">Войти</button>
        </EditForm>

        <div class="login-footer" style="margin-top:1rem">
            <button type="button" class="btn btn-outline" style="width:100%" disabled="@_resending" @onclick="ResendCodeAsync">
                @(_resending ? "Отправка…" : "Отправить код повторно")
            </button>
            <a href="/login">Вернуться ко входу</a>
        </div>
    </div>
</div>

@code {
    private string? message;
    private string? infoMessage;
    private string maskedEmail = "";
    private bool _resending;
    private ApplicationUser user = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool RememberMe { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await SignInManager.GetTwoFactorAuthenticationUserAsync()
            ?? throw new InvalidOperationException("Unable to load two-factor authentication user.");

        var email = await UserManager.GetEmailAsync(user) ?? "";
        maskedEmail = MaskEmail(email);
    }

    private async Task OnValidSubmitAsync()
    {
        var codeCheck = AuthFieldValidation.ValidateTwoFactorCode(Input.TwoFactorCode);
        if (!codeCheck.Ok)
        {
            message = codeCheck.Error;
            return;
        }

        var code = Input.TwoFactorCode!.Replace(" ", string.Empty).Replace("-", string.Empty);
        var result = await SignInManager.TwoFactorSignInAsync(
            TokenOptions.DefaultEmailProvider, code, RememberMe, Input.RememberMachine);
        var userId = await UserManager.GetUserIdAsync(user);

        if (result.Succeeded)
        {
            Logger.LogInformation("User with ID '{UserId}' logged in with 2fa.", userId);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User with ID '{UserId}' account locked out.", userId);
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            Logger.LogWarning("Invalid 2FA code for user with ID '{UserId}'.", userId);
            message = "Неверный или просроченный код. Запросите новый.";
        }
    }

    private async Task ResendCodeAsync()
    {
        message = null;
        infoMessage = null;
        _resending = true;
        try
        {
            var (ok, error) = await TwoFactorService.SendLoginCodeAsync(user);
            if (ok)
                infoMessage = "Новый код отправлен на email.";
            else
                message = error ?? "Не удалось отправить код.";
        }
        finally
        {
            _resending = false;
        }
    }

    private static string MaskEmail(string email)
    {
        var at = email.IndexOf('@');
        if (at <= 1) return email;
        return email[0] + new string('*', Math.Min(at - 1, 5)) + email[at..];
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Введите код")]
        [ValidTwoFactorCode]
        [DataType(DataType.Text)]
        [Display(Name = "Код")]
        public string? TwoFactorCode { get; set; }

        [Display(Name = "Запомнить устройство")]
        public bool RememberMachine { get; set; }
    }
}

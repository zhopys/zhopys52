@page "/Account/Register"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Components.LayoutAttribute(typeof(MiniFinance.Components.Layout.EmptyLayout))]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using MiniFinance.Data
@using MiniFinance.Components.Account
@using MiniFinance.Services

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IOptions<AppSettings> AppOptions

<PageTitle>Регистрация — MiniFinance</PageTitle>

<div class="login-page">
    <div class="login-container">
        <div class="login-header">
            <h1>MiniFinance</h1>
            <p class="text-muted">Создать учётную запись</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(_infoMessage))
        {
            <div class="alert alert-success">@_infoMessage</div>
        }
        @if (_showResendHint)
        {
            <div class="alert alert-warning">
                Email зарегистрирован, но не подтверждён.
                <a href="@_resendUrl">Отправить письмо повторно</a>
            </div>
        }

        <EditForm EditContext="_editContext" method="post" OnSubmit="RegisterUser" FormName="register">
            <RussianDataAnnotationsValidator />
            <RussianValidationSummary class="text-danger" role="alert" />

            <div class="form-group">
                <label class="label">Email</label>
                <InputText @bind-Value="Input.Email" class="input" autocomplete="username" placeholder="name@example.com" />
                <RussianValidationMessage For="() => Input.Email" />
            </div>

            <div class="form-group">
                <label class="label">Пароль</label>
                <InputText type="password" @bind-Value="Input.Password" class="input" autocomplete="new-password" placeholder="Мин. 8 символов" />
                <RussianValidationMessage For="() => Input.Password" />
                <ul class="small text-muted" style="margin:6px 0 0;padding-left:1.1rem;line-height:1.5">
                    <li>Не менее @AuthFieldValidation.MinPasswordLength символов</li>
                    <li>Цифра, заглавная и строчная буква</li>
                    <li>Без пробелов</li>
                </ul>
            </div>

            <div class="form-group">
                <label class="label">Подтверждение пароля</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" class="input" autocomplete="new-password" placeholder="Повторите пароль" />
                <RussianValidationMessage For="() => Input.ConfirmPassword" />
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;margin-top:1rem" disabled="@_submitting">
                @if (_submitting) { <span class="spinner" style="width:14px;height:14px;border-width:2px"></span> }
                Зарегистрироваться
            </button>
        </EditForm>

        <div class="login-footer">
            <a href="/login">Уже есть аккаунт? Войти</a>
        </div>
    </div>
</div>

@code {
    private EditContext _editContext = default!;
    private string? _errorMessage;
    private string? _infoMessage;
    private bool _submitting;
    private bool _showResendHint;
    private string _resendUrl = "/Account/ResendEmailConfirmation";

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
        _editContext = new EditContext(Input);
    }

    public async Task RegisterUser()
    {
        if (!_editContext.Validate()) return;

        _submitting = true;
        _errorMessage = null;
        _infoMessage = null;
        _showResendHint = false;

        ApplicationUser? createdUser = null;

        try
        {
            var email = AuthFieldValidation.NormalizeEmail(Input.Email);
            var emailCheck = AuthFieldValidation.ValidateEmail(email);
            if (!emailCheck.Ok)
            {
                _errorMessage = emailCheck.Error;
                return;
            }

            var pwdCheck = AuthFieldValidation.ValidatePassword(Input.Password);
            if (!pwdCheck.Ok)
            {
                _errorMessage = pwdCheck.Error;
                return;
            }

            if (!string.Equals(Input.Password, Input.ConfirmPassword, StringComparison.Ordinal))
            {
                _errorMessage = "Пароли не совпадают.";
                return;
            }
            var existing = await UserManager.FindByEmailAsync(email);
            if (existing != null)
            {
                if (existing.EmailConfirmed)
                {
                    _errorMessage = "Пользователь с таким email уже зарегистрирован. Войдите или восстановите пароль.";
                }
                else
                {
                    _resendUrl = NavigationManager.GetUriWithQueryParameters(
                        "/Account/ResendEmailConfirmation",
                        new Dictionary<string, object?> { ["email"] = email });
                    _showResendHint = true;
                }
                return;
            }

            var user = new ApplicationUser
            {
                UserName = email,
                Email = email,
                CreatedAt = DateTime.UtcNow,
                EnableNotifications = true
            };

            var result = await UserManager.CreateAsync(user, Input.Password);
            if (!result.Succeeded)
            {
                _errorMessage = IdentityErrorTranslator.Join(result.Errors);
                return;
            }

            createdUser = user;

            var roleResult = await UserManager.AddToRoleAsync(user, AppRoles.Administrator);
            if (!roleResult.Succeeded)
            {
                await UserManager.DeleteAsync(user);
                createdUser = null;
                _errorMessage = IdentityErrorTranslator.Join(roleResult.Errors);
                return;
            }

            Logger.LogInformation("User {Email} registered.", email);

            var token = await UserManager.GenerateEmailConfirmationTokenAsync(user);
            var userId = await UserManager.GetUserIdAsync(user);
            var appBase = IdentityEmailLinks.GetAppBaseUri(AppOptions.Value, NavigationManager.BaseUri);
            var confirmUrl = IdentityEmailLinks.BuildConfirmEmailUrl(
                appBase,
                userId!,
                token,
                ReturnUrl);

            await EmailSender.SendConfirmationLinkAsync(user, email, confirmUrl);

            if (UserManager.Options.SignIn.RequireConfirmedAccount)
            {
                RedirectManager.RedirectTo(
                    "Account/RegisterConfirmation",
                    new Dictionary<string, object?> { ["email"] = email, ["returnUrl"] = ReturnUrl });
                return;
            }

            await SignInManager.SignInAsync(user, isPersistent: false);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Registration failed for {Email}", Input.Email);
            if (createdUser != null)
            {
                try { await UserManager.DeleteAsync(createdUser); }
                catch (Exception deleteEx) { Logger.LogWarning(deleteEx, "Failed to rollback user {UserId}", createdUser.Id); }
            }

            _errorMessage = ex.Message.Contains("Почта не настроена", StringComparison.OrdinalIgnoreCase)
                ? "Не удалось отправить письмо подтверждения. Проверьте настройки SMTP или обратитесь к администратору."
                : ex.Message.Contains("Authentication", StringComparison.OrdinalIgnoreCase)
                    || ex.Message.Contains("535", StringComparison.Ordinal)
                    ? "Не удалось отправить письмо подтверждения. Проверьте логин и пароль SMTP."
                    : "Ошибка регистрации. Попробуйте позже.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Email обязателен")]
        [ValidAuthEmail]
        [StringLength(AuthFieldValidation.MaxEmailLength, ErrorMessage = "Слишком длинный email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Пароль обязателен")]
        [ValidAuthPassword]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Подтвердите пароль")]
        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Пароли не совпадают.")]
        public string ConfirmPassword { get; set; } = "";
    }
}

@page "/Account/AccessDenied"
@attribute [Microsoft.AspNetCore.Components.LayoutAttribute(typeof(MiniFinance.Components.Layout.EmptyLayout))]
@using Microsoft.AspNetCore.Components.Authorization
@using MiniFinance.Services
@inject AuthenticationStateProvider Auth

<PageTitle>Доступ запрещён — MiniFinance</PageTitle>

<div class="login-page">
    <div class="login-container">
        <h1 class="text-danger">Доступ запрещён</h1>
        <p class="text-muted">@_message</p>
        @if (!string.IsNullOrEmpty(_hint))
        {
            <p class="small text-muted">@_hint</p>
        }
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:1rem">
            <a href="@_homeLink" class="btn btn-primary">@_homeLabel</a>
            <a href="/profile" class="btn btn-outline">Профиль</a>
        </div>
    </div>
</div>

@code {
    private string _message = AccessDeniedMessages.Default;
    private string? _hint;
    private string _homeLink = "/";
    private string _homeLabel = "На главную";

    [SupplyParameterFromQuery(Name = "message")]
    public string? MessageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "policy")]
    public string? PolicyQuery { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? FromQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(MessageQuery))
            _message = MessageQuery;
        else if (!string.IsNullOrWhiteSpace(PolicyQuery))
            _message = AccessDeniedMessages.ForPolicy(PolicyQuery);
        else if (!string.IsNullOrWhiteSpace(FromQuery))
            _message = AccessDeniedMessages.ForPath(FromQuery);

        _hint = PolicyQuery switch
        {
            AuthorizationPolicies.CanManageTaxes =>
                "Бухгалтер работает с операциями и отчётами; налоги — у налогового специалиста или администратора.",
            AuthorizationPolicies.CanAccessFinances or AuthorizationPolicies.CanImport =>
                "Налоговый специалист: разделы «Налоги» и «Отчёты». Бухгалтер — операции и импорт.",
            AuthorizationPolicies.CanManageUsers or AuthorizationPolicies.CanManageSettings =>
                "Управление пользователями и настройками — только у администратора.",
            _ => null
        };

        var state = await Auth.GetAuthenticationStateAsync();
        ApplyHomeLink(RoleAccessSnapshot.FromPrincipal(state.User));
    }

    private void ApplyHomeLink(RoleAccessSnapshot snap)
    {
        if (snap.CanManageTaxes && !snap.CanAccessFinances)
        {
            _homeLink = "/taxes";
            _homeLabel = "К разделу «Налоги»";
        }
        else if (snap.CanAccessFinances)
        {
            _homeLink = "/";
            _homeLabel = "На главную";
        }
        else if (snap.CanViewReports)
        {
            _homeLink = "/reports";
            _homeLabel = "К отчётам";
        }
    }
}

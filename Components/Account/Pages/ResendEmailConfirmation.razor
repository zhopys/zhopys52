@page "/Account/ResendEmailConfirmation"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Components.LayoutAttribute(typeof(MiniFinance.Components.Layout.EmptyLayout))]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using MiniFinance.Data
@using MiniFinance.Components.Account

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject ILogger<ResendEmailConfirmation> Logger

<PageTitle>Повторная отправка — MiniFinance</PageTitle>

<div class="login-page">
    <div class="login-container">
        <h1>Подтверждение email</h1>
        <p class="text-muted">Введите email — мы отправим новую ссылку.</p>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_success ? "alert-success" : "alert-danger")">@_message</div>
        }

        <EditForm EditContext="_editContext" FormName="resend-email-confirmation" OnSubmit="OnSubmitAsync" method="post">
            <RussianDataAnnotationsValidator />
            <RussianValidationSummary class="text-danger" role="alert" />
            <div class="form-group">
                <label class="label">Email</label>
                <InputText @bind-Value="Input.Email" class="input" placeholder="name@example.com" />
                <RussianValidationMessage For="() => Input.Email" />
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;margin-top:1rem" disabled="@_submitting">
                @if (_submitting) { <span class="spinner" style="width:14px;height:14px;border-width:2px"></span> }
                Отправить письмо
            </button>
        </EditForm>

        <p class="login-footer mt-3"><a href="/login">Вернуться ко входу</a></p>
    </div>
</div>

@code {
    private EditContext _editContext = default!;
    private string? _message;
    private bool _success;
    private bool _submitting;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
        if (!string.IsNullOrWhiteSpace(Email))
            Input.Email = Email.Trim().ToLowerInvariant();
        _editContext = new EditContext(Input);
    }

    private async Task OnSubmitAsync()
    {
        if (!_editContext.Validate()) return;

        _submitting = true;
        _message = null;
        _success = false;

        try
        {
            var email = Input.Email.Trim().ToLowerInvariant();
            var user = await UserManager.FindByEmailAsync(email);

            if (user is null)
            {
                _success = true;
                _message = "Если аккаунт существует, письмо отправлено. Проверьте почту и папку «Спам».";
                return;
            }

            if (user.EmailConfirmed)
            {
                _success = true;
                _message = "Email уже подтверждён. Можно войти в систему.";
                return;
            }

            var userId = await UserManager.GetUserIdAsync(user);
            var token = await UserManager.GenerateEmailConfirmationTokenAsync(user);
            var confirmUrl = IdentityEmailLinks.BuildConfirmEmailUrl(
                NavigationManager.BaseUri,
                userId!,
                token);

            await EmailSender.SendConfirmationLinkAsync(user, email, confirmUrl);
            _success = true;
            _message = "Письмо отправлено. Проверьте почту и папку «Спам».";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Resend confirmation failed");
            _message = "Не удалось отправить письмо. Попробуйте позже.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Email обязателен")]
        [ValidAuthEmail]
        [StringLength(AuthFieldValidation.MaxEmailLength)]
        public string Email { get; set; } = "";
    }
}

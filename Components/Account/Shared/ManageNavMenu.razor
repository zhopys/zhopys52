@using Microsoft.AspNetCore.Identity
@using MiniFinance.Data

@inject SignInManager<ApplicationUser> SignInManager

<div style="display:flex;flex-direction:column;gap:4px">
    <NavLink class="hub-nav-item" href="Account/Manage" Match="NavLinkMatch.All">Профиль</NavLink>
    <NavLink class="hub-nav-item" href="Account/Manage/Email">Email</NavLink>
    <NavLink class="hub-nav-item" href="Account/Manage/ChangePassword">Пароль</NavLink>
    @if (hasExternalLogins)
    {
        <NavLink class="hub-nav-item" href="Account/Manage/ExternalLogins">Внешние входы</NavLink>
    }
    <NavLink class="hub-nav-item" href="/account?tab=security">Двухфакторная аутентификация</NavLink>
    <NavLink class="hub-nav-item" href="Account/Manage/PersonalData">Персональные данные</NavLink>
</div>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}

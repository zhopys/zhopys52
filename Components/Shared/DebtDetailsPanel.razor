@using MiniFinance.Data.Models
@using MiniFinance.Services
@inject IDebtService DebtService

<DetailsDrawer IsOpen="@IsOpen" Wide="true" CssClass="details-drawer-entity" OnClose="OnClose">
    <HeaderContent>
        @if (_detail != null)
        {
            var d = _detail.Debt;
            <div class="entity-drawer-head">
                <div class="entity-drawer-amount @(d.Type == DebtType.Receivable ? "is-income" : "is-expense")">
                    @_detail.Remaining.ToString("N2") <Byn class="entity-drawer-currency" />
                </div>
                <div class="entity-drawer-head-text">
                    <h3 class="entity-drawer-title">@d.CounterpartyName</h3>
                    <div class="entity-drawer-sub">
                        @TypeLabel(d.Type)
                        @if (d.DueDate.HasValue)
                        {
                            <span> · срок @d.DueDate.Value.ToString("dd.MM.yyyy")</span>
                        }
                    </div>
                    <div class="entity-drawer-badges">
                        @if (d.IsSettled)
                        {
                            <span class="badge badge-success">Погашен</span>
                        }
                        else if (d.DueDate.HasValue && d.DueDate.Value.Date < DateTime.Today)
                        {
                            <span class="badge badge-danger">Просрочен</span>
                        }
                        else
                        {
                            <span class="badge badge-info">Открыт</span>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <span class="text-muted">Долг</span>
        }
    </HeaderContent>
    <Actions>
        @if (_detail != null && !_detail.Debt.IsSettled && _detail.Remaining > 0)
        {
            <button type="button" class="btn btn-sm btn-primary" @onclick="PayFull">Погасить полностью</button>
        }
    </Actions>
    <ChildContent>
        @if (_error != null)
        {
            <div class="alert alert-error small entity-drawer-alert">@_error</div>
        }
        else if (_loading)
        {
            <div class="entity-drawer-loading">
                <div class="spinner"></div>
                <span>Загрузка…</span>
            </div>
        }
        else if (_detail != null)
        {
            var d = _detail.Debt;

            <div class="entity-drawer-block entity-drawer-block-highlight">
                <div class="entity-drawer-progress-head">
                    <span>Погашено</span>
                    <strong>@_detail.ProgressPercent%</strong>
                </div>
                <div class="entity-drawer-progress-track">
                    <div class="entity-drawer-progress-fill" style="width:@(_detail.ProgressPercent)%"></div>
                </div>
                <div class="entity-drawer-progress-foot">
                    <span>Оплачено <strong>@d.PaidAmount.ToString("N2") <Byn /></strong></span>
                    <span>из @d.Amount.ToString("N2") <Byn /></span>
                </div>
            </div>

            <div class="reports-tax-summary entity-drawer-kpis">
                <div class="reports-tax-kpi">
                    <span class="reports-tax-kpi-label">Сумма долга</span>
                    <span class="reports-tax-kpi-value">@d.Amount.ToString("N0") <Byn /></span>
                </div>
                <div class="reports-tax-kpi">
                    <span class="reports-tax-kpi-label">Оплачено</span>
                    <span class="reports-tax-kpi-value text-success">@d.PaidAmount.ToString("N0") <Byn /></span>
                </div>
                <div class="reports-tax-kpi">
                    <span class="reports-tax-kpi-label">Остаток</span>
                    <span class="reports-tax-kpi-value @(_detail.Remaining > 0 ? "text-danger" : "text-success")">@_detail.Remaining.ToString("N0") <Byn /></span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(d.Description))
            {
                <div class="entity-drawer-block">
                    <div class="entity-drawer-block-title">Описание</div>
                    <p class="entity-drawer-note-plain">@d.Description</p>
                </div>
            }

            <div class="entity-drawer-block">
                <div class="entity-drawer-block-title">Связанные платежи</div>
                @if (!_detail.RelatedTransactions.Any())
                {
                    <p class="entity-drawer-muted">Платежи появятся после погашения или привязки операций</p>
                }
                else
                {
                    <div class="entity-drawer-table-wrap">
                        <table class="table table-sm entity-drawer-table">
                            <thead>
                                <tr>
                                    <th>Дата</th>
                                    <th>Описание</th>
                                    <th class="text-end">Сумма</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in _detail.RelatedTransactions)
                                {
                                    <tr>
                                        <td class="text-muted">@t.Date.ToString("dd.MM.yyyy")</td>
                                        <td>@t.Description</td>
                                        <td class="text-end fw-bold @(t.Amount >= 0 ? "text-success" : "text-danger")">
                                            @t.Amount.ToString("N2") <Byn />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </ChildContent>
</DetailsDrawer>

@code {
    [Parameter] public int DebtId { get; set; }
    [Parameter] public string UserId { get; set; } = "";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private DebtDetailDto? _detail;
    private bool _loading;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen || DebtId <= 0 || string.IsNullOrEmpty(UserId))
        {
            _detail = null;
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _detail = await DebtService.GetDetailAsync(DebtId, UserId); }
        catch (Exception ex) { _detail = null; _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task PayFull()
    {
        if (_detail == null || _detail.Remaining <= 0) return;
        try
        {
            await DebtService.RecordPaymentAsync(DebtId, _detail.Remaining, UserId);
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string TypeLabel(DebtType t) =>
        t == DebtType.Receivable ? "Нам должны" : "Мы должны";
}

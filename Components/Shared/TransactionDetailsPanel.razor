@using MiniFinance.Data.Models
@using MiniFinance.Services
@using Microsoft.EntityFrameworkCore
@using MiniFinance.Data
@inject ApplicationDbContext DbContext
@inject ITagService TagService
@inject IAttachmentService AttachmentService
@inject ICommentService CommentService
@inject ITransactionService TransactionService
@inject IUserContextService UserContext

<DetailsDrawer IsOpen="@IsOpen" Wide="true" CssClass="details-drawer-entity" OnClose="OnClose">
    <HeaderContent>
        @if (_tx != null)
        {
            <div class="entity-drawer-head">
                <div class="entity-drawer-amount @(_tx.Amount >= 0 ? "is-income" : "is-expense")">
                    @(_tx.Amount >= 0 ? "+" : "")@_tx.Amount.ToString("N2") <Byn class="entity-drawer-currency" />
                </div>
                <div class="entity-drawer-head-text">
                    <h3 class="entity-drawer-title">@_tx.Description</h3>
                    <div class="entity-drawer-sub">@_tx.Date.ToString("dd MMMM yyyy")</div>
                </div>
            </div>
        }
        else
        {
            <span class="text-muted">Операция</span>
        }
    </HeaderContent>
    <Actions>
        @if (_tx != null && _canApprove && _status == TransactionApprovalStatus.Pending)
        {
            <button type="button" class="btn btn-sm btn-primary" @onclick="Approve">Утвердить</button>
            <button type="button" class="btn btn-sm btn-outline" @onclick="Reject">Отклонить</button>
        }
    </Actions>
    <ChildContent>
        @if (_tx == null && TransactionId > 0)
        {
            <div class="entity-drawer-loading">
                <div class="spinner"></div>
                <span>Загрузка…</span>
            </div>
        }
        else if (_tx != null)
        {
            @if (_status == TransactionApprovalStatus.Pending)
            {
                <div class="alert alert-warning small entity-drawer-alert">Ожидает утверждения</div>
            }
            else if (_status == TransactionApprovalStatus.Rejected)
            {
                <div class="alert alert-error small entity-drawer-alert">Отклонена</div>
            }

            <div class="entity-drawer-block">
                <div class="entity-drawer-block-title">Основное</div>
                <div class="entity-drawer-fields">
                    <div class="entity-drawer-field">
                        <span class="entity-drawer-label">Тип</span>
                        <span class="badge @(_tx.Amount >= 0 ? "badge-success" : "badge-danger")">
                            @(_tx.Amount >= 0 ? "Доход" : "Расход")
                        </span>
                    </div>
                    <div class="entity-drawer-field">
                        <span class="entity-drawer-label">Категория</span>
                        @if (_category != null)
                        {
                            <CategoryBadge Category="@_category" Name="@_category.Name" />
                        }
                        else
                        {
                            <CategoryBadge Name="@_tx.Category" />
                        }
                    </div>
                    <div class="entity-drawer-field">
                        <span class="entity-drawer-label">Контрагент</span>
                        <span>@(_tx.Counterparty ?? _tx.CounterpartyEntity?.Name ?? "—")</span>
                    </div>
                    <div class="entity-drawer-field">
                        <span class="entity-drawer-label">Проект</span>
                        <span>@(_tx.Project?.Name ?? "—")</span>
                    </div>
                    <div class="entity-drawer-field">
                        <span class="entity-drawer-label">Оплата</span>
                        <span>@PaymentLabel(_tx.PaymentMethod)</span>
                    </div>
                    <div class="entity-drawer-field">
                        <span class="entity-drawer-label">Статус</span>
                        <span class="badge @ApprovalBadgeClass(_tx.ApprovalStatus)">@ApprovalLabel(_tx.ApprovalStatus)</span>
                    </div>
                    @if (_tx.IsMandatory)
                    {
                        <div class="entity-drawer-field">
                            <span class="entity-drawer-label">Обязательный</span>
                            <span>Да</span>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_tx.Notes))
                {
                    <div class="entity-drawer-note">@_tx.Notes</div>
                }
            </div>

            <div class="entity-drawer-block">
                <div class="entity-drawer-block-title">Теги</div>
                <div class="entity-drawer-inline-form">
                    <input class="form-input" @bind="_tagsInput" placeholder="через запятую" />
                    <button type="button" class="btn btn-sm btn-outline" @onclick="SaveTags">Сохранить</button>
                </div>
                @if (_tagNames.Any())
                {
                    <div class="entity-drawer-chips">
                        @foreach (var t in _tagNames)
                        {
                            <span class="filter-chip">@t</span>
                        }
                    </div>
                }
                else
                {
                    <p class="entity-drawer-muted">Теги не заданы</p>
                }
            </div>

            <div class="entity-drawer-block">
                <div class="entity-drawer-block-title">Чеки и документы</div>
                <label class="entity-drawer-file-label">
                    <span class="btn btn-sm btn-outline">Прикрепить файл</span>
                    <InputFile OnChange="OnFileSelected" accept=".pdf,.jpg,.jpeg,.png,.webp" class="entity-drawer-file-input" />
                </label>
                @if (_attachments.Any())
                {
                    <ul class="entity-drawer-list">
                        @foreach (var a in _attachments)
                        {
                            <li class="entity-drawer-list-item">
                                <a href="@AttachmentService.GetPublicUrl(a)" target="_blank" rel="noopener" class="entity-drawer-link">
                                    <i class="bi bi-paperclip"></i> @a.FileName
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Удалить" @onclick="() => DeleteAttachment(a.Id)">×</button>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="entity-drawer-muted">Нет вложений</p>
                }
            </div>

            <div class="entity-drawer-block">
                <div class="entity-drawer-block-title">Комментарии</div>
                @if (_comments.Any())
                {
                    <div class="entity-drawer-comments">
                        @foreach (var c in _comments)
                        {
                            <div class="entity-drawer-comment">
                                <div class="entity-drawer-comment-meta">
                                    <strong>@(c.AuthorName ?? "Сотрудник")</strong>
                                    <span>@c.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                                <div class="entity-drawer-comment-text">@c.Text</div>
                            </div>
                        }
                    </div>
                }
                <div class="entity-drawer-inline-form entity-drawer-inline-form-stack">
                    <textarea class="form-input" rows="2" @bind="_newComment" placeholder="Новый комментарий…"></textarea>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="AddComment">Добавить</button>
                </div>
            </div>
        }
    </ChildContent>
</DetailsDrawer>

@code {
    [Parameter] public int TransactionId { get; set; }
    [Parameter] public string UserId { get; set; } = "";
    [Parameter] public string? AuthorName { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Transaction? _tx;
    private Category? _category;
    private List<string> _tagNames = new();
    private string _tagsInput = "";
    private List<TransactionAttachment> _attachments = new();
    private List<TransactionComment> _comments = new();
    private string _newComment = "";
    private TransactionApprovalStatus _status;
    private bool _canApprove;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen || TransactionId <= 0 || string.IsNullOrEmpty(UserId))
        {
            _tx = null;
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var ctx = await UserContext.GetContextAsync(UserId);
        _canApprove = UserContext.CanApproveTransactions(ctx);
        _tx = await TransactionService.GetAsync(TransactionId, UserId);
        _status = _tx?.ApprovalStatus ?? TransactionApprovalStatus.Approved;
        _category = _tx == null || string.IsNullOrWhiteSpace(_tx.Category)
            ? null
            : await DbContext.Categories.AsNoTracking()
                .FirstOrDefaultAsync(c => c.Name == _tx.Category);
        _tagNames = (await TagService.GetTransactionTagNamesAsync(TransactionId, UserId)).ToList();
        _tagsInput = string.Join(", ", _tagNames);
        _attachments = await AttachmentService.ListAsync(TransactionId, UserId);
        _comments = await CommentService.ListAsync(TransactionId, UserId);
    }

    private async Task SaveTags()
    {
        var names = _tagsInput.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        await TagService.SetTransactionTagsAsync(TransactionId, UserId, names);
        await LoadAsync();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        await using var stream = file.OpenReadStream(10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        ms.Position = 0;
        await AttachmentService.UploadAsync(TransactionId, UserId, ms, file.Name, file.ContentType);
        await LoadAsync();
    }

    private async Task DeleteAttachment(int id)
    {
        await AttachmentService.DeleteAsync(id, UserId);
        await LoadAsync();
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(_newComment)) return;
        await CommentService.AddAsync(TransactionId, UserId, _newComment, AuthorName);
        _newComment = "";
        await LoadAsync();
    }

    private async Task Approve() { await TransactionService.ApproveAsync(TransactionId, UserId); await LoadAsync(); }
    private async Task Reject() { await TransactionService.RejectAsync(TransactionId, UserId); await LoadAsync(); }

    private static string PaymentLabel(PaymentMethod? m) => m switch
    {
        PaymentMethod.Cash => "Наличные",
        PaymentMethod.Card => "Карта",
        PaymentMethod.EWallet => "Электронный кошелёк",
        PaymentMethod.BankTransfer => "Безналичный",
        _ => "—"
    };

    private static string ApprovalLabel(TransactionApprovalStatus s) => TransactionApprovalHelper.Label(s);

    private static string ApprovalBadgeClass(TransactionApprovalStatus s) => TransactionApprovalHelper.BadgeClass(s);
}

@using System.ComponentModel.DataAnnotations
@using MiniFinance.Services
@using MiniFinance.Components.Shared.Validation
@implements IDisposable
@inject IServiceProvider ServiceProvider

@code {
    private ValidationMessageStore? _messageStore;

    [CascadingParameter]
    private EditContext? CurrentEditContext { get; set; }

    protected override void OnInitialized()
    {
        if (CurrentEditContext == null)
            throw new InvalidOperationException($"{nameof(RussianDataAnnotationsValidator)} requires a cascading parameter of type {nameof(EditContext)}.");

        _messageStore = new ValidationMessageStore(CurrentEditContext);
        CurrentEditContext.OnValidationRequested += HandleValidationRequested;
        CurrentEditContext.OnFieldChanged += (_, _) => CurrentEditContext.Validate();
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs args)
    {
        if (CurrentEditContext == null || _messageStore == null)
            return;

        var context = new ValidationContext(CurrentEditContext.Model, ServiceProvider, null);
        var results = new List<ValidationResult>();
        Validator.TryValidateObject(CurrentEditContext.Model, context, results, validateAllProperties: true);

        _messageStore.Clear();

        foreach (var result in results)
        {
            if (string.IsNullOrEmpty(result.ErrorMessage))
                continue;

            var members = result.MemberNames.Any() ? result.MemberNames : [string.Empty];
            foreach (var member in members)
            {
                var field = string.IsNullOrEmpty(member)
                    ? default
                    : new FieldIdentifier(CurrentEditContext.Model, member);
                var message = RussianValidationMessages.Translate(result.ErrorMessage, field);
                _messageStore.Add(field, message);
            }
        }
    }

    public void Dispose()
    {
        if (CurrentEditContext != null)
            CurrentEditContext.OnValidationRequested -= HandleValidationRequested;
    }
}

@using MiniFinance.Services

<div class="card mb-3">
    <div class="card-header">Отчёт о прибылях и убытках</div>
    <div class="card-body" style="padding:0">
        @if (Report == null)
        {
            <div class="empty-state">Нет данных за выбранный период</div>
        }
        else
        {
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Статья</th>
                        <th class="text-end">Сумма</th>
                        <th class="text-end">Доля</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="table-section-row">
                        <td colspan="3"><strong>Доходы</strong></td>
                    </tr>
                    @if (Report.IncomeByCategory.Any())
                    {
                        @foreach (var cat in Report.IncomeByCategory)
                        {
                            <tr>
                                <td class="ps-3">@cat.Category</td>
                                <td class="text-end text-success">@cat.Amount.ToString("N0") <Byn /></td>
                                <td class="text-end text-muted">@cat.Percentage.ToString("F0")%</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td class="ps-3 text-muted" colspan="3">Нет доходов</td></tr>
                    }
                    <tr class="fw-bold">
                        <td>Итого доходы</td>
                        <td class="text-end text-success">@Report.TotalIncome.ToString("N0") <Byn /></td>
                        <td class="text-end text-muted">100%</td>
                    </tr>

                    <tr class="table-section-row">
                        <td colspan="3"><strong>Расходы</strong></td>
                    </tr>
                    @if (Report.ExpenseByCategory.Any())
                    {
                        @foreach (var cat in Report.ExpenseByCategory)
                        {
                            <tr>
                                <td class="ps-3">@cat.Category</td>
                                <td class="text-end text-danger">@cat.Amount.ToString("N0") <Byn /></td>
                                <td class="text-end text-muted">@cat.Percentage.ToString("F0")%</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td class="ps-3 text-muted" colspan="3">Нет расходов</td></tr>
                    }
                    <tr class="fw-bold">
                        <td>Итого расходы</td>
                        <td class="text-end text-danger">@Report.TotalExpense.ToString("N0") <Byn /></td>
                        <td class="text-end text-muted">100%</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td>Чистая прибыль</td>
                        <td class="text-end @(Report.NetProfit >= 0 ? "text-success" : "text-danger")">@Report.NetProfit.ToString("N0") <Byn /></td>
                        <td class="text-end text-muted">@Report.ProfitMargin.ToString("F1")%</td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>

@code {
    [Parameter] public ProfitLossReport? Report { get; set; }
}

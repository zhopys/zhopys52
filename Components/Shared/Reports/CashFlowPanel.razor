@using MiniFinance.Services
@inject NavigationManager Navigation

<div class="card mb-3">
    <div class="card-header">Денежный поток</div>
    <div class="card-body" style="padding:0">
        @if (Statement == null)
        {
            <div class="empty-state">Нет данных за выбранный период</div>
        }
        else if (Statement.TransactionCount == 0)
        {
            <div class="empty-state">Нет транзакций за период — импортируйте выписку или добавьте операции</div>
        }
        else
        {
            <div class="cashflow-rules-note">
                Вид деятельности определяется по <strong>категории</strong> и <strong>описанию</strong> каждой транзакции.
                Обычные доходы и расходы — операционная; оборудование и активы — инвестиционная; кредиты и займы — финансовая.
            </div>

            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Вид деятельности</th>
                        <th class="text-end">Поступления</th>
                        <th class="text-end">Выплаты</th>
                        <th class="text-end">Нетто</th>
                        <th class="text-end">Операций</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var block in Statement.ActivityDetails)
                    {
                        <tr class="cashflow-activity-row">
                            <td>
                                <div class="fw-bold">@CashFlowActivityHelper.GetLabel(block.Activity)</div>
                                <div class="small text-muted">@CashFlowActivityHelper.GetHint(block.Activity)</div>
                            </td>
                            <td class="text-end text-success">@block.Income.ToString("N0") <Byn /></td>
                            <td class="text-end text-danger">@block.Expense.ToString("N0") <Byn /></td>
                            <td class="text-end fw-bold @(block.NetFlow >= 0 ? "text-success" : "text-danger")">@block.NetFlow.ToString("N0") <Byn /></td>
                            <td class="text-end">
                                @if (block.TransactionCount > 0)
                                {
                                    <a class="cashflow-tx-link" href="@BuildActivityUrl(block.Activity)">@block.TransactionCount</a>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td>Чистый денежный поток</td>
                        <td class="text-end text-success">@Statement.ActivityDetails.Sum(a => a.Income).ToString("N0") <Byn /></td>
                        <td class="text-end text-danger">@Statement.ActivityDetails.Sum(a => a.Expense).ToString("N0") <Byn /></td>
                        <td class="text-end @(Statement.NetCashFlow >= 0 ? "text-success" : "text-danger")">@Statement.NetCashFlow.ToString("N0") <Byn /></td>
                        <td class="text-end">
                            <a class="cashflow-tx-link" href="@BuildAllUrl()">@Statement.TransactionCount</a>
                        </td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>

@if (Statement != null && Statement.CategoryDetails.Any())
{
    <div class="card mb-3">
        <div class="card-header">Из чего складывается поток — по категориям транзакций</div>
        <div class="card-body" style="padding:0">
            @foreach (var block in Statement.ActivityDetails.Where(a => a.Categories.Any()))
            {
                <div class="cashflow-activity-block">
                    <div class="cashflow-activity-block-title">
                        @CashFlowActivityHelper.GetLabel(block.Activity)
                        <a class="small ms-2" href="@BuildActivityUrl(block.Activity)">все операции →</a>
                    </div>
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Категория</th>
                                <th class="text-end">Поступления</th>
                                <th class="text-end">Выплаты</th>
                                <th class="text-end">Нетто</th>
                                <th class="text-end">Оп.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in block.Categories)
                            {
                                <tr>
                                    <td>
                                        <a href="@BuildCategoryUrl(row.Category)">@row.Category</a>
                                    </td>
                                    <td class="text-end text-success">@(row.Income > 0 ? $"{row.Income:N0}" : "—")</td>
                                    <td class="text-end text-danger">@(row.Expense > 0 ? $"{row.Expense:N0}" : "—")</td>
                                    <td class="text-end fw-bold @(row.NetFlow >= 0 ? "text-success" : "text-danger")">@row.NetFlow.ToString("N0")</td>
                                    <td class="text-end text-muted">@row.TransactionCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (MonthlyCashflow.Any())
{
    <div class="card mb-3">
        <div class="card-header">Помесячная динамика</div>
        <div class="card-body" style="padding:0">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Месяц</th>
                        <th class="text-end">Поступления</th>
                        <th class="text-end">Выплаты</th>
                        <th class="text-end">Остаток нарастающим</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in MonthlyCashflow)
                    {
                        <tr class="@(c.Balance < 0 ? "negative-balance" : null)" data-balance="@c.Balance.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            <td class="text-muted">@c.Date.ToString("MMMM yyyy", RuCulture)</td>
                            <td class="text-end text-success">@c.Income.ToString("N2") <Byn /></td>
                            <td class="text-end text-danger">@c.Expense.ToString("N2") <Byn /></td>
                            <td class="text-end fw-bold @(c.Balance >= 0 ? "text-success" : "text-danger")">
                                @c.Balance.ToString("N2") <Byn />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public CashFlowStatementReport? Statement { get; set; }
    [Parameter] public List<CashflowEntry> MonthlyCashflow { get; set; } = new();

    private static readonly System.Globalization.CultureInfo RuCulture = new("ru-RU");

    private string BuildAllUrl()
    {
        if (Statement == null) return "/transactions";
        return $"/transactions?from={Statement.StartDate:yyyy-MM-dd}&to={Statement.EndDate:yyyy-MM-dd}";
    }

    private string BuildActivityUrl(CashFlowActivity activity)
    {
        if (Statement == null) return "/transactions";
        return $"/transactions?from={Statement.StartDate:yyyy-MM-dd}&to={Statement.EndDate:yyyy-MM-dd}&activity={CashFlowActivityHelper.GetSlug(activity)}";
    }

    private string BuildCategoryUrl(string category)
    {
        if (Statement == null) return "/transactions";
        var cat = Uri.EscapeDataString(category);
        return $"/transactions?from={Statement.StartDate:yyyy-MM-dd}&to={Statement.EndDate:yyyy-MM-dd}&category={cat}";
    }
}

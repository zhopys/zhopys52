@using MiniFinance.Services
@inject NavigationManager Navigation

<div class="reports-kpi-grid mb-3">
    @if (Loading)
    {
        @for (var i = 0; i < 7; i++)
        {
            <div class="kpi-card skeleton-card reports-kpi">
                <div class="skeleton-line" style="width:60%"></div>
                <div class="skeleton-line" style="width:80%;height:28px;margin-top:8px"></div>
                <div class="skeleton-line" style="width:40%;margin-top:8px"></div>
            </div>
        }
    }
    else
    {
        @foreach (var k in Metrics)
        {
            var expanded = _expandedKey == k.Key;
            var drillUrl = BuildDrillUrl(k);
            <div class="kpi-card reports-kpi kpi-card-interactive kpi-key-@k.Key @(expanded ? "kpi-card-expanded" : "")"
                 role="button"
                 tabindex="0"
                 title="@k.Hint"
                 @onclick="() => ToggleExpand(k.Key)"
                 @onkeydown="e => OnCardKey(e, k.Key)">
                <div class="kpi-card-accent" aria-hidden="true"></div>
                <div class="kpi-label">@k.Label</div>
                @if (expanded && !string.IsNullOrWhiteSpace(k.Hint))
                {
                    <div class="kpi-hint kpi-hint-visible">@k.Hint</div>
                }
                <div class="kpi-value @GetValueClass(k)">
                    @if (k.Format == "percent")
                    {
                        <span class="kpi-amount">@k.Value.ToString("F1")</span><span class="kpi-unit">%</span>
                    }
                    else
                    {
                        <span class="kpi-amount">@FormatMoney(k.Value)</span>
                        <span class="kpi-unit"><Byn Class="kpi-byn" /></span>
                    }
                </div>
                @if (ShowComparison(k))
                {
                    <div class="kpi-footer @GetDeltaClass(k)">@FormatComparison(k)</div>
                }
                @if (PeriodHasNoActivity && k.Format == "currency" && k.Value == 0 && k.Key != "freeCash")
                {
                    <div class="kpi-empty-hint">Нет операций в периоде</div>
                }
                @if (expanded)
                {
                    <div class="kpi-card-actions" @onclick:stopPropagation="true">
                        @if (!string.IsNullOrEmpty(drillUrl))
                        {
                            <a class="btn btn-sm btn-outline" href="@drillUrl">Операции →</a>
                        }
                        @if (k.Key == "freeCash")
                        {
                            <a class="btn btn-sm btn-outline" href="/cash-forecast">Прогноз кассы</a>
                        }
                        @if (k.Key == "roi")
                        {
                            <a class="btn btn-sm btn-outline" href="/projects">Проекты</a>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<KpiMetricDto> Metrics { get; set; } = Array.Empty<KpiMetricDto>();
    [Parameter] public bool Loading { get; set; }
    [Parameter] public DateTime? PeriodStart { get; set; }
    [Parameter] public DateTime? PeriodEnd { get; set; }
    [Parameter] public string CompareMode { get; set; } = "mom";
    [Parameter] public bool PeriodHasNoActivity { get; set; }

    private string? _expandedKey;

    private void ToggleExpand(string key) =>
        _expandedKey = _expandedKey == key ? null : key;

    private void OnCardKey(KeyboardEventArgs e, string key)
    {
        if (e.Key is "Enter" or " ")
            ToggleExpand(key);
    }

    private static string FormatMoney(decimal value) =>
        value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("ru-RU"));

    private bool ShowComparison(KpiMetricDto k) =>
        CompareMode != "none" && k.Key != "roi" && k.Format != "percent";

    private string FormatComparison(KpiMetricDto k)
    {
        if (k.Value == k.PreviousValue)
            return "Без изменений";

        var diff = k.Value - k.PreviousValue;
        var absPrev = Math.Abs(k.PreviousValue);

        if (absPrev < 1m)
            return diff > 0 ? "Появились поступления" : "Расходы в периоде";

        if (Math.Abs(k.ChangePercent) >= 120m || (absPrev < 100m && Math.Abs(diff) >= 30m))
            return $"{(diff >= 0 ? "+" : "−")}{FormatMoney(Math.Abs(diff))} к пред. периоду";

        return $"{(k.ChangePercent >= 0 ? "+" : "−")}{Math.Abs(k.ChangePercent):F0}% к пред. периоду";
    }

    private string? BuildDrillUrl(KpiMetricDto k)
    {
        if (!PeriodStart.HasValue || !PeriodEnd.HasValue) return null;
        var from = PeriodStart.Value.ToString("yyyy-MM-dd");
        var to = PeriodEnd.Value.ToString("yyyy-MM-dd");

        return k.Key switch
        {
            "revenue" => $"/transactions?from={from}&to={to}&type=income",
            "opex" or "capex" => $"/transactions?from={from}&to={to}&type=expense",
            "netProfit" or "ebitda" => $"/transactions?from={from}&to={to}",
            _ => null
        };
    }

    private static string GetDeltaClass(KpiMetricDto k)
    {
        if (k.Value == k.PreviousValue) return "kpi-flat";
        return k.Trend switch
        {
            "up" => k.Key is "opex" or "capex" ? "kpi-bad" : "kpi-good",
            "down" => k.Key is "opex" or "capex" ? "kpi-good" : "kpi-bad",
            _ => "kpi-flat"
        };
    }

    private static string GetValueClass(KpiMetricDto k)
    {
        if (k.Format == "percent") return "";
        return k.Key switch
        {
            "revenue" or "netProfit" or "ebitda" => k.Value >= 0 ? "text-success" : "text-danger",
            "freeCash" => k.Value >= 0 ? "text-success" : "text-danger",
            _ => ""
        };
    }
}

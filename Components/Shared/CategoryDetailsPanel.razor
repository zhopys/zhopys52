@using MiniFinance.Data.Models
@using MiniFinance.Services
@inject ICategorizationService CategorizationService
@inject IDataScopeService DataScope
@inject AuthenticationStateProvider AuthenticationStateProvider

<DetailsDrawer IsOpen="@IsOpen" Wide="true" CssClass="details-drawer-category" OnClose="OnClose">
    <HeaderContent>
        @if (_cat != null)
        {
            var accent = CategoryIconHelper.ResolveColor(_cat.Color, _cat.Name, _cat.Type);
            <div class="detail-panel-hero" style="--detail-accent:@accent">
                <div class="detail-panel-hero-icon">
                    <CategoryIcon Category="@_cat" Size="lg" />
                </div>
                <div class="detail-panel-hero-text">
                    <span class="detail-panel-eyebrow">Категория</span>
                    <h3 class="detail-panel-title">@_cat.Name</h3>
                    <div class="detail-panel-badges">
                        <span class="detail-badge @(_cat.Type == CategoryType.Income ? "detail-badge-income" : "detail-badge-expense")">
                            @(_cat.Type == CategoryType.Income ? "Доход" : "Расход")
                        </span>
                        @if (_cat.IsDefault)
                        {
                            <span class="detail-badge detail-badge-muted">Системная</span>
                        }
                        @if (_cat.IsHidden)
                        {
                            <span class="detail-badge detail-badge-muted">Скрыта</span>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <span class="detail-panel-eyebrow">Категория</span>
        }
    </HeaderContent>
    <Actions>
        @if (_cat != null)
        {
            <div class="detail-panel-toolbar">
                @if (!_editing)
                {
                    <button type="button" class="detail-toolbar-btn" @onclick="StartEdit">
                        <i class="bi bi-pencil"></i> Изменить
                    </button>
                    <button type="button" class="detail-toolbar-btn" @onclick="ToggleHidden">
                        <i class="bi @(_cat.IsHidden ? "bi-eye" : "bi-eye-slash")"></i>
                        @(_cat.IsHidden ? "Показать" : "Скрыть")
                    </button>
                    <a class="detail-toolbar-btn" href="@TransactionsLink">
                        <i class="bi bi-list-ul"></i> Операции
                    </a>
                }
                else
                {
                    <button type="button" class="detail-toolbar-btn detail-toolbar-btn-primary" @onclick="SaveEdit">
                        <i class="bi bi-check-lg"></i> Сохранить
                    </button>
                    <button type="button" class="detail-toolbar-btn" @onclick="CancelEdit">
                        Отмена
                    </button>
                }
            </div>
        }
    </Actions>
    <ChildContent>
        @if (_cat == null && CategoryId > 0)
        {
            <div class="detail-panel-loading">
                <div class="detail-panel-spinner"></div>
                <span>Загрузка…</span>
            </div>
        }
        else if (_cat != null)
        {
            @if (!string.IsNullOrEmpty(_panelMessage))
            {
                <div class="detail-panel-toast @(_panelError ? "is-error" : "is-success")">@_panelMessage</div>
            }

            @if (_editing)
            {
                <div class="detail-panel-section">
                    <div class="detail-panel-section-head">
                        <i class="bi bi-sliders"></i>
                        <span>Редактирование</span>
                    </div>
                    <div class="detail-panel-section-body detail-edit-grid">
                        <div class="form-group">
                            <label class="form-label">Название</label>
                            <input class="form-input" @bind="_editName" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Тип</label>
                            <select class="form-input" @bind="_editType">
                                <option value="@CategoryType.Expense">Расход</option>
                                <option value="@CategoryType.Income">Доход</option>
                            </select>
                        </div>
                        <div class="form-group detail-edit-full">
                            <label class="form-label">Иконка</label>
                            <div class="category-icon-picker">
                                @foreach (var ic in CategoryIconHelper.PickerIcons)
                                {
                                    <button type="button"
                                            class="category-icon-pick @(_editIcon == ic.Key ? "active" : "")"
                                            title="@ic.Label"
                                            @onclick="() => _editIcon = ic.Key">
                                        <i class="bi @ic.BiClass"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Цвет</label>
                            <input type="color" class="form-input detail-color-input" @bind="_editColor" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Бюджет / мес. (Br)</label>
                            <input type="number" class="form-input" @bind="_editBudget" step="100" min="0" />
                        </div>
                        <div class="form-group detail-edit-full">
                            <label class="form-label">Ключевые слова</label>
                            <input class="form-input" @bind="_editKeywords" placeholder="аренда, rent, офис" />
                        </div>
                        <div class="form-group detail-edit-full">
                            <label class="form-label">Описание</label>
                            <textarea class="form-input" rows="2" @bind="_editDescription"></textarea>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @if (_stats != null)
                {
                    <div class="detail-panel-stats">
                        <div class="detail-stat-card">
                            <i class="bi bi-receipt detail-stat-icon"></i>
                            <span class="detail-stat-label">Всего операций</span>
                            <span class="detail-stat-value">@_stats.TransactionCount</span>
                        </div>
                        <div class="detail-stat-card">
                            <i class="bi bi-calendar3 detail-stat-icon"></i>
                            <span class="detail-stat-label">За месяц</span>
                            <span class="detail-stat-value">@_stats.MonthTransactionCount</span>
                        </div>
                        <div class="detail-stat-card detail-stat-card-accent">
                            <i class="bi bi-cash-stack detail-stat-icon"></i>
                            <span class="detail-stat-label">Оборот (мес.)</span>
                            <span class="detail-stat-value @(_stats.MonthAmount >= 0 ? "is-positive" : "is-negative")">
                                @_stats.MonthAmount.ToString("N0") Br
                            </span>
                        </div>
                    </div>

                    @if (_cat.MonthlyBudget is > 0)
                    {
                        var spent = Math.Abs(_stats.MonthAmount);
                        var budget = _cat.MonthlyBudget.Value;
                        var pct = budget > 0 ? Math.Min(100, (int)(spent / budget * 100)) : 0;
                        <div class="detail-panel-section detail-budget-card">
                            <div class="detail-budget-head">
                                <span>Бюджет месяца</span>
                                <strong>@pct%</strong>
                            </div>
                            <div class="detail-budget-amounts">
                                <span>@spent.ToString("N0") Br</span>
                                <span class="text-muted">из @budget.ToString("N0") Br</span>
                            </div>
                            <div class="detail-budget-track">
                                <div class="detail-budget-fill @(pct >= 100 ? "is-over" : "")" style="width:@(pct)%"></div>
                            </div>
                        </div>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(_cat.Description))
                {
                    <div class="detail-panel-section">
                        <div class="detail-panel-section-head">
                            <i class="bi bi-card-text"></i>
                            <span>Описание</span>
                        </div>
                        <p class="detail-panel-desc">@_cat.Description</p>
                    </div>
                }

                <div class="detail-panel-section">
                    <div class="detail-panel-section-head">
                        <i class="bi bi-tags"></i>
                        <span>Ключевые слова</span>
                    </div>
                    @if (CategoryIconHelper.SplitKeywords(_cat.Keywords).Any())
                    {
                        <div class="detail-keyword-chips">
                            @foreach (var kw in CategoryIconHelper.SplitKeywords(_cat.Keywords))
                            {
                                <span class="detail-keyword-chip">@kw</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="detail-panel-empty-hint">Не заданы — добавьте слова из выписок для авто-категоризации.</p>
                    }
                </div>

                <div class="detail-panel-section detail-test-section">
                    <div class="detail-panel-section-head">
                        <i class="bi bi-magic"></i>
                        <span>Проверка авто-категоризации</span>
                    </div>
                    <p class="detail-panel-empty-hint">Введите фрагмент описания операции — увидите, в какую категорию попадёт платёж.</p>
                    <input class="form-input" @bind="_testDescription" placeholder="Например: оплата аренды офиса" />
                    <button type="button" class="btn btn-sm btn-primary mt-2" @onclick="RunTest">
                        <i class="bi bi-play-fill"></i> Проверить
                    </button>
                    @if (_testResult != null)
                    {
                        <div class="detail-test-outcome @(_testMatches ? "is-match" : "is-mismatch")">
                            <span class="detail-test-outcome-label">Результат</span>
                            <span class="detail-test-outcome-value">@_testResult</span>
                            @if (_testMatches)
                            {
                                <span class="detail-test-outcome-badge"><i class="bi bi-check-circle-fill"></i> Совпадает</span>
                            }
                            else
                            {
                                <span class="detail-test-outcome-badge"><i class="bi bi-arrow-right-circle"></i> Другая категория</span>
                            }
                        </div>
                    }
                </div>
            }
        }
    </ChildContent>
</DetailsDrawer>

@code {
    [Parameter] public int CategoryId { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private Category? _cat;
    private CategoryStatsDto? _stats;
    private string _dataUserId = "";
    private bool _editing;
    private string _editName = "";
    private CategoryType _editType;
    private string _editKeywords = "";
    private string _editIcon = "tag";
    private string _editColor = "#64748b";
    private string _editDescription = "";
    private decimal? _editBudget;
    private string _testDescription = "";
    private string? _testResult;
    private bool _testMatches;
    private string? _panelMessage;
    private bool _panelError;

    private string TransactionsLink => _cat == null
        ? "/transactions"
        : $"/transactions?category={Uri.EscapeDataString(_cat.Name)}";

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen || CategoryId <= 0)
        {
            _cat = null;
            return;
        }

        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _dataUserId = await DataScope.GetDataOwnerUserIdAsync(userId);

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _panelMessage = null;
        _cat = await CategorizationService.GetCategoryAsync(CategoryId);
        if (_cat == null) return;

        if (!string.IsNullOrEmpty(_dataUserId))
            _stats = await CategorizationService.GetCategoryStatsAsync(CategoryId, _dataUserId);

        if (!_editing)
            ResetEditFields();
    }

    private void ResetEditFields()
    {
        if (_cat == null) return;
        var (icon, color) = CategoryIconHelper.Resolve(_cat);
        _editName = _cat.Name;
        _editType = _cat.Type;
        _editKeywords = _cat.Keywords ?? "";
        _editIcon = icon;
        _editColor = color;
        _editDescription = _cat.Description ?? "";
        _editBudget = _cat.MonthlyBudget;
    }

    private void StartEdit()
    {
        ResetEditFields();
        _editing = true;
        _testResult = null;
    }

    private void CancelEdit()
    {
        _editing = false;
        _panelMessage = null;
    }

    private async Task SaveEdit()
    {
        if (_cat == null) return;
        try
        {
            await CategorizationService.UpdateCategoryAsync(new CategoryUpdateRequest
            {
                Id = _cat.Id,
                Name = _editName,
                Type = _editType,
                Keywords = _editKeywords,
                Icon = _editIcon,
                Color = _editColor,
                Description = _editDescription,
                MonthlyBudget = _editBudget
            });
            _editing = false;
            _panelMessage = "Изменения сохранены";
            _panelError = false;
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _panelMessage = ex.Message;
            _panelError = true;
        }
    }

    private async Task ToggleHidden()
    {
        if (_cat == null) return;
        await CategorizationService.SetCategoryHiddenAsync(_cat.Id, !_cat.IsHidden);
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private void RunTest()
    {
        if (string.IsNullOrWhiteSpace(_testDescription))
        {
            _testResult = null;
            return;
        }
        var amount = _cat?.Type == CategoryType.Income ? 100m : -100m;
        _testResult = CategorizationService.CategorizeTransaction(_testDescription, amount);
        _testMatches = string.Equals(_testResult, _cat?.Name, StringComparison.OrdinalIgnoreCase);
    }
}

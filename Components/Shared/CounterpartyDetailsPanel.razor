@using MiniFinance.Services
@inject ICounterpartyService CounterpartyService
@using CounterpartySvc = MiniFinance.Services.CounterpartyService

<DetailsDrawer IsOpen="@IsOpen" Wide="true" CssClass="details-drawer-entity" OnClose="OnClose">
    <HeaderContent>
        @if (_detail != null)
        {
            <div class="d-flex align-items-center gap-2">
                <img src="@CounterpartySvc.GetDisplayLogoUrl(_detail.Record)" alt="" class="cp-avatar" width="40" height="40" referrerpolicy="no-referrer" />
                <div>
                    <h3 class="mb-0">@_detail.Record.Name</h3>
                    <div class="small text-muted">@TypeLabel(_detail.Record.Type)</div>
                </div>
            </div>
        }
        else if (_loading)
        {
            <span>Загрузка…</span>
        }
    </HeaderContent>
    <Actions>
        @if (_detail != null)
        {
            <button type="button" class="btn btn-sm btn-outline" @onclick="EditClicked">Изменить</button>
            <a href="/transactions" class="btn btn-sm btn-outline">Все операции</a>
            @if (_detail.OpenDebts.Any())
            {
                <a href="/debts" class="btn btn-sm btn-outline">Долги</a>
            }
        }
    </Actions>
    <ChildContent>
        @if (_error != null)
        {
            <div class="alert alert-danger">@_error</div>
        }
        else if (_detail != null)
        {
            <div class="detail-kpi-row mb-3">
                <div class="detail-kpi">
                    <span class="detail-kpi-label">Доход</span>
                    <span class="detail-kpi-value text-success">@_detail.TotalIncome.ToString("N2") <Byn /></span>
                </div>
                <div class="detail-kpi">
                    <span class="detail-kpi-label">Расход</span>
                    <span class="detail-kpi-value text-danger">@_detail.TotalExpense.ToString("N2") <Byn /></span>
                </div>
                <div class="detail-kpi">
                    <span class="detail-kpi-label">Сальдо</span>
                    <span class="detail-kpi-value @(_detail.NetBalance >= 0 ? "text-success" : "text-danger")">@_detail.NetBalance.ToString("N2") <Byn /></span>
                </div>
                <div class="detail-kpi">
                    <span class="detail-kpi-label">Операций</span>
                    <span class="detail-kpi-value">@_detail.TransactionCount</span>
                </div>
            </div>

            @if (_detail.OpenReceivable > 0 || _detail.OpenPayable > 0)
            {
                <div class="detail-kpi-row mb-3">
                    <div class="detail-kpi">
                        <span class="detail-kpi-label">Нам должны</span>
                        <span class="detail-kpi-value text-success">@_detail.OpenReceivable.ToString("N2") <Byn /></span>
                    </div>
                    <div class="detail-kpi">
                        <span class="detail-kpi-label">Мы должны</span>
                        <span class="detail-kpi-value text-danger">@_detail.OpenPayable.ToString("N2") <Byn /></span>
                    </div>
                </div>
            }

            <DetailFields Columns="2">
                <DetailField Label="Контакт">@(_detail.Record.ContactPerson ?? "—")</DetailField>
                <DetailField Label="Email">
                    @if (!string.IsNullOrWhiteSpace(_detail.Record.Email))
                    {
                        <a href="mailto:@_detail.Record.Email">@_detail.Record.Email</a>
                    }
                    else { <span>—</span> }
                </DetailField>
                <DetailField Label="Телефон">
                    @if (!string.IsNullOrWhiteSpace(_detail.Record.Phone))
                    {
                        <a href="tel:@_detail.Record.Phone">@_detail.Record.Phone</a>
                    }
                    else { <span>—</span> }
                </DetailField>
                <DetailField Label="УНП">@(_detail.Record.TaxId ?? "—")</DetailField>
                <DetailField Label="Первая операция">@(_detail.FirstTransactionDate?.ToString("dd.MM.yyyy") ?? "—")</DetailField>
                <DetailField Label="Последняя операция">@(_detail.LastTransactionDate?.ToString("dd.MM.yyyy") ?? "—")</DetailField>
                <DetailField Label="Средний чек">@(_detail.TransactionCount > 0 ? $"{_detail.AvgTransactionAmount:N2} <Byn />" : "—")</DetailField>
                <DetailField Label="В справочнике с">@_detail.Record.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</DetailField>
            </DetailFields>

            @if (!string.IsNullOrWhiteSpace(_detail.Record.Notes))
            {
                <DetailField Label="Заметки" ValueClass="mt-2">
                    <div class="small">@_detail.Record.Notes</div>
                </DetailField>
            }

            @if (_detail.CategoryStats.Any())
            {
                <h4 class="detail-section-title">По категориям</h4>
                <table class="table table-sm">
                    <thead><tr><th>Категория</th><th class="text-end">Доход</th><th class="text-end">Расход</th><th class="text-end">Оп.</th></tr></thead>
                    <tbody>
                        @foreach (var cat in _detail.CategoryStats.Take(12))
                        {
                            <tr>
                                <td>@cat.Category</td>
                                <td class="text-end text-success">@(cat.Income > 0 ? cat.Income.ToString("N0") : "—")</td>
                                <td class="text-end text-danger">@(cat.Expense > 0 ? cat.Expense.ToString("N0") : "—")</td>
                                <td class="text-end text-muted">@cat.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (_detail.OpenDebts.Any())
            {
                <h4 class="detail-section-title">Открытые долги</h4>
                <table class="table table-sm">
                    <thead><tr><th>Тип</th><th>Описание</th><th class="text-end">Остаток</th><th>Срок</th></tr></thead>
                    <tbody>
                        @foreach (var d in _detail.OpenDebts)
                        {
                            <tr>
                                <td>@(d.Type == DebtType.Receivable ? "Нам должны" : "Мы должны")</td>
                                <td class="small">@(d.Description ?? "—")</td>
                                <td class="text-end">@((d.Amount - d.PaidAmount).ToString("N2")) <Byn /></td>
                                <td>@(d.DueDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <h4 class="detail-section-title">Последние операции</h4>
            @if (!_detail.Transactions.Any())
            {
                <p class="text-muted small">Нет связанных транзакций</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead><tr><th>Дата</th><th>Описание</th><th>Категория</th><th class="text-end">Сумма</th></tr></thead>
                    <tbody>
                        @foreach (var t in _detail.Transactions.Take(30))
                        {
                            <tr>
                                <td class="text-muted">@t.Date.ToString("dd.MM.yyyy")</td>
                                <td>@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                                <td><span class="badge badge-outline">@t.Category</span></td>
                                <td class="text-end @(t.Amount >= 0 ? "text-success" : "text-danger")">@t.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </ChildContent>
</DetailsDrawer>

@code {
    [Parameter] public int CounterpartyId { get; set; }
    [Parameter] public string UserId { get; set; } = "";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }

    private CounterpartyDetailDto? _detail;
    private bool _loading;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen || CounterpartyId <= 0 || string.IsNullOrEmpty(UserId))
        {
            _detail = null;
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _detail = await CounterpartyService.GetDetailAsync(CounterpartyId, UserId);
        }
        catch (Exception ex)
        {
            _detail = null;
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private Task EditClicked() => OnEdit.InvokeAsync(CounterpartyId);

    private static string TypeLabel(CounterpartyType t) => t switch
    {
        CounterpartyType.Client => "Клиент",
        CounterpartyType.Supplier => "Поставщик",
        _ => "Клиент и поставщик"
    };
}
